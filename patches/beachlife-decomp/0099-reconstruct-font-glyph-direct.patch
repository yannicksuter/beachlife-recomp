+// FUNCTION: BEACHLIFE 0x0049fdd0
+void ScreenFontRenderer::DrawGlyphDirect(const unsigned char* source, int source_stride,
+    unsigned short* destination, int destination_stride,
+    int source_x, int source_y, int destination_x, int destination_y,
+    int width, int height, const unsigned short*)
+{
+    const unsigned char* input = source + (source_y + height - 1) * source_stride + source_x;
+    unsigned short* output = destination + ((destination_y + height - 1) * destination_stride + destination_x) * 2;
+    unsigned int value = word_10;
+    unsigned int colour = screen_request_renderer->ConvertColour(
+        (value >> 16) & 255, (value >> 8) & 255, value & 255);
+
+    if (state_14 != 0)
+    {
+        if (screen_request_renderer->format_44 == 1)
+        {
+            while (height != 0)
+            {
+                int remaining = width;
+                while (remaining != 0)
+                {
+                    if ((*input & 1) != 0)
+                    {
+                        *output = 0xffff;
+                    }
+                    if ((*input & 2) != 0)
+                    {
+                        *output = 0;
+                    }
+                    output += 2;
+                    ++input;
+                    --remaining;
+                }
+                output -= (destination_stride + width) * 2;
+                input -= source_stride + width;
+                --height;
+            }
+        }
+        else
+        {
+            while (height != 0)
+            {
+                int remaining = width;
+                while (remaining != 0)
+                {
+                    if ((*input & 1) != 0)
+                    {
+                        *output = 0xffff;
+                    }
+                    if ((*input & 2) != 0)
