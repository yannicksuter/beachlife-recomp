+                        *output = 0;
+                    }
+                    output += 2;
+                    ++input;
+                    --remaining;
+                }
+                output -= (destination_stride + width) * 2;
+                input -= source_stride + width;
+                --height;
+            }
+        }
+    }
+    else
+    {
+        while (height != 0)
+        {
+            int remaining = width;
+            while (remaining != 0)
+            {
+                if ((*input & 1) != 0)
+                {
+                    *output = static_cast<unsigned short>(colour);
+                }
+                output += 2;
+                ++input;
+                --remaining;
+            }
