+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x00411a60
+unsigned int ScreenRequestRenderer::ConvertColour(int red, int green, int blue)
+{
+    if (format_44 == 0)
+    {
+        unsigned int packed = static_cast<unsigned int>(red) & 0xfff8u;
+        packed <<= 5;
+        packed |= static_cast<unsigned char>(green) & 0xfcu;
+        packed <<= 3;
+        return packed | ((blue >> 3) & 0x1f);
+    }
+
+    unsigned int packed = static_cast<unsigned char>(red) & 0xf8u;
+    packed <<= 5;
+    packed |= static_cast<unsigned char>(green) & 0xf8u;
+    packed <<= 2;
+    return packed | ((blue >> 3) & 0x1f);
+}
