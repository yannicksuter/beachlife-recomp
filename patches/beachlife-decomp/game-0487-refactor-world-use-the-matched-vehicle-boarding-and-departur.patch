+// The circuit is a script entry table; its words hold the tile coordinates.
+static ScreenPoint CircuitTile(void* circuit, int index)
+{
+    WindowDeactivationState::ScriptEntry* entries = static_cast<WindowDeactivationState::ScriptEntry*>(circuit);
+    return ScreenPoint(static_cast<int>(entries[index].first), static_cast<int>(entries[index].second));
+}
+
+// Retail subtracts and squares in x87 precision and takes the table square root
+// of the float sum.
+static float MapDistance(const ScreenMapPosition& from, const ScreenMapPosition& to)
+{
+    long double x = static_cast<long double>(to.x) - from.x;
+    long double y = static_cast<long double>(to.y) - from.y;
+    return VehicleSquareRoot(static_cast<float>(x * x + y * y));
+}
+
+static void FlagVehicleCell(ScreenTerrainCell* cell, bool set)
+{
+    if (set)
+        cell->flags_48 |= 0x10;
+    else
+        cell->flags_48 &= ~0x10u;
+}
+
+static void SetNeighbourFlags(WorldVehicleEntity* entity)
+{
+    ScreenTerrainCell* cells[8];
+    screen_terrain_grid->Neighbours(entity->current_grid_964, cells);
+    for (int i = 0; i < 8; ++i)
+        cells[i]->flags_48 |= 0x10;
+}
+
+static void ClearNeighbourFlags(WorldVehicleEntity* entity)
+{
+    ScreenTerrainCell* cells[8];
+    screen_terrain_grid->Neighbours(entity->current_grid_964, cells);
+    for (int i = 0; i < 8; ++i)
+        cells[i]->flags_48 &= ~0x10u;
+}
+
+static void VehicleEnter_footprint(WorldVehicleEntity* entity, ScreenPoint tile, int heading, bool set)
+{
+    ScreenTerrainCell* cells[8];
+    screen_terrain_grid->Neighbours(tile, cells);
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    ScreenTerrainCell* center = &grid->cells_0c[grid->TileIndex(tile.x, tile.y)];
+    FlagVehicleCell(center, set);
+    switch (heading)
+    {
+    case 1:
+    case 5:
+        FlagVehicleCell(cells[0], set);
+        FlagVehicleCell(cells[4], set);
+        break;
+    case 3:
+    case 7:
+        FlagVehicleCell(cells[2], set);
+        FlagVehicleCell(cells[6], set);
+        break;
+    }
+}
+
+static void VehicleEnter_sound(WorldVehicleEntity* entity, const char* name)
+{
+    WindowAudioVector point = { entity->position_30.x, entity->position_30.y, 0.0f };
+    window_audio_state->PlaySoundAtPosition(name, 1.0f, &point, 1, -1);
+}
