index 0000000000000000000000000000000000000000..1d4c0a938621b90388a94d2b86a8a647b27f4211
--- /dev/null
+++ b/src/startup_screen_clip.cpp
@@ -0,0 +1,31 @@
+#include "startup_screen_clip.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x004b2eb0
+void ClipScreenRectangles(ScreenRectangle* destination, ScreenRectangle* source)
+{
+    // The renderer stores its size unsigned, but the clip compares signed.
+    int width = screen_request_renderer->width;
+    int height = screen_request_renderer->height;
+
+    if (destination->left < 0)
+    {
+        source->left -= destination->left;
+        destination->left = 0;
+    }
+    if (destination->right > width)
+    {
+        source->right += width - destination->right;
+        destination->right = width;
+    }
+    if (destination->top < 0)
+    {
+        source->top -= destination->top;
+        destination->top = 0;
+    }
+    if (destination->bottom > height)
+    {
+        source->bottom += height - destination->bottom;
+        destination->bottom = height;
+    }
+}
