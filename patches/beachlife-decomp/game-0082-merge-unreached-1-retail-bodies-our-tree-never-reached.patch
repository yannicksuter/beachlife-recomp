+template <class Order>
+void AdjustHeap(GameSaveRecord** first, int hole, int count, GameSaveRecord* value, Order order)
+{
+    int top = hole;
+    int child = 2 * hole + 2;
+    while (child < count)
+    {
+        if (order(first[child], first[child - 1]))
+            --child;
+        first[hole] = first[child];
+        hole = child;
+        child = 2 * hole + 2;
+    }
+    if (child == count)
+    {
+        first[hole] = first[child - 1];
+        hole = child - 1;
+    }
+    int parent = (hole - 1) / 2;
+    while (hole > top && order(first[parent], value))
+    {
+        first[hole] = first[parent];
+        hole = parent;
+        parent = (hole - 1) / 2;
+    }
+    first[hole] = value;
+}
+
+template <class Order>
+void MakeHeap(GameSaveRecord** first, GameSaveRecord** last, Order order)
+{
+    int count = static_cast<int>(last - first);
+    if (count < 2)
+        return;
+    int parent = (count - 2) / 2;
+    for (;;)
+    {
+        AdjustHeap(first, parent, count, first[parent], order);
+        if (parent == 0)
+            return;
+        --parent;
+    }
+}
+
+template <class Order>
+void SortHeap(GameSaveRecord** first, GameSaveRecord** last, Order order)
+{
+    while (last - first > 1)
+    {
+        --last;
+        GameSaveRecord* value = *last;
+        *last = *first;
+        AdjustHeap(first, 0, static_cast<int>(last - first), value, order);
+    }
+}
+
+template <class Order>
+void UnguardedInsert(GameSaveRecord** position, GameSaveRecord* value, Order order)
+{
+    GameSaveRecord** previous = position - 1;
+    while (order(value, *previous))
+    {
+        *position = *previous;
+        position = previous;
+        --previous;
+    }
+    *position = value;
+}
+
+template <class Order>
+void Insert(GameSaveRecord** first, GameSaveRecord** position, GameSaveRecord* value, Order order)
+{
+    if (order(value, *first))
+    {
+        CopyPointerRangeBackward(first, position, position + 1);
+        *first = value;
+    }
+    else
+        UnguardedInsert(position, value, order);
+}
+
+template <class Order>
+void Introsort(GameSaveRecord** first, GameSaveRecord** last, int depth, Order order,
+    void (*fallback)(GameSaveRecord**, GameSaveRecord**, Order) = 0)
+{
+    while (last - first > 16)
+    {
+        if (depth == 0)
+        {
+            if (fallback)
+            {
+                fallback(first, last, order);
+                return;
+            }
+            MakeSaveRecordHeap(first, last, order);
+            while (last - first > 1)
+            {
+                --last;
+                PopSaveRecordHeap(first, last, last, *last, order);
+            }
+            return;
+        }
+        --depth;
+        GameSaveRecord* a = *first;
+        GameSaveRecord* b = first[(last - first) / 2];
+        GameSaveRecord* c = last[-1];
+        GameSaveRecord* pivot;
+        if (order(a, b))
+            pivot = order(b, c) ? b : order(a, c) ? c
+                                                  : a;
+        else
+            pivot = order(a, c) ? a : order(b, c) ? c
+                                                  : b;
+        GameSaveRecord** left = first;
+        GameSaveRecord** right = last;
+        for (;;)
+        {
+            while (order(*left, pivot))
+                ++left;
+            do
+                --right;
+            while (order(pivot, *right));
+            if (left >= right)
+                break;
+            GameSaveRecord* value = *left;
+            *left = *right;
+            *right = value;
+            ++left;
+        }
+        IntrosortSaveRecords(left, last, 0, depth, order);
+        last = left;
+    }
+}
+
+template <class Order>
+void SortFallback(GameSaveRecord** first, GameSaveRecord** last, Order order)
+{
+    MakeSaveRecordHeap(first, last, order);
+    SortSaveRecordHeap(first, last, order);
+}
+
+void RefreshFallback(GameSaveRecord** first, GameSaveRecord** last, SaveRecordTimeOrder order)
+{
+    PartialSortSaveRecords(first, last, last, 0, order);
+}
+
+template <class Order>
+void Sort(GameSaveRecord** first, GameSaveRecord** last, Order order,
+    void (*fallback)(GameSaveRecord**, GameSaveRecord**, Order) = SortFallback<Order>)
+{
+    if (first == last)
+        return;
+    int depth = 0;
+    for (int count = static_cast<int>(last - first); count != 1; count >>= 1)
+        ++depth;
+    Introsort(first, last, depth * 2, order, fallback);
+    if (last - first > 16)
