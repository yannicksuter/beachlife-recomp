+#include "startup_input_state.h"
+#include "startup_world_subsystems.h"
+
+#include <cassert>
+#include <cstdlib>
+#include <new>
+#include <set>
+#include "node_storage.h"
+
+WorldSubsystem44* world_subsystem_44;
+ScreenModeCommandQueue* screen_mode_commands;
+InputState* startup_input_state;
+
+static std::set<void*> allocations;
+static int allocation_countdown;
+static int cursor_release_count;
+PoolChunkLink* volatile pool_chunk_buckets[16];
+volatile LONG pool_lock_word;
+void AcquirePoolLock(volatile LONG* lock)
+{
+    assert(*lock == 0);
+    *lock = 1;
+}
+
+void* AllocatePoolBytes(unsigned int bytes)
+{
+    if (allocation_countdown-- == 0)
+        throw std::bad_alloc();
+    void* memory = std::malloc(bytes);
+    assert(memory);
+    allocations.insert(memory);
+    return memory;
+}
+
+void* RefillPool(unsigned int bytes)
+{
+    return AllocatePoolBytes(bytes);
+}
+
+void ReturnPool(void* memory, unsigned int)
+{
+    assert(allocations.erase(memory) == 1);
+    std::free(memory);
+}
+
+extern "C" BOOL WINAPI ClipCursor(const RECT* rectangle)
+{
+    assert(rectangle == nullptr);
+    assert(startup_input_state != nullptr);
+    ++cursor_release_count;
+    return TRUE;
+}
+
+template <class T>
+static void CheckAllocationFailures(T*& registration, int allocations_to_test)
+{
+    for (int failure = 0; failure < allocations_to_test; ++failure)
+    {
+        allocation_countdown = failure;
+        bool threw = false;
+        try
+        {
+            T object;
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        assert(threw);
+        assert(registration == nullptr);
+        assert(allocations.empty());
+    }
+    allocation_countdown = -1;
+    {
+        T object;
+        assert(registration == &object);
+    }
+    assert(registration == nullptr);
+    assert(allocations.empty());
+}
+
+int main()
+{
+    CheckAllocationFailures(world_subsystem_44, 3);
+    CheckAllocationFailures(screen_mode_commands, 2);
+    {
+        InputState input(800, 600, 1);
+        assert(startup_input_state == &input);
+    }
+    assert(startup_input_state == nullptr);
+    assert(cursor_release_count == 1);
+}
