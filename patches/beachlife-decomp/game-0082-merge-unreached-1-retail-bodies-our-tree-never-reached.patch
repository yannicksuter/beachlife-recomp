+#include "startup_renderer_rectangle_queue.h"
+#include <cassert>
+#include <cstdlib>
+#include <new>
+#include <unordered_map>
+#include <vector>
+
+PoolChunkLink* volatile pool_chunk_buckets[16];
+volatile LONG pool_lock_word;
+static std::unordered_map<void*, unsigned int> live_blocks;
+static std::vector<unsigned int> sizes;
+static int allocation_countdown = -1;
+
+void AcquirePoolLock(volatile LONG* lock)
+{
+    assert(*lock == 0);
+    *lock = 1;
+}
+
+void* RefillPool(unsigned int bytes)
+{
+    if (allocation_countdown == 0)
+        throw std::bad_alloc();
+    if (allocation_countdown > 0)
+        --allocation_countdown;
+    void* storage = std::malloc(bytes);
+    assert(storage);
+    live_blocks.emplace(storage, bytes);
+    sizes.push_back(bytes);
+    return storage;
+}
+
+void ReturnPool(void* storage, unsigned int bytes)
+{
+    assert(live_blocks.at(storage) == bytes);
+    live_blocks.erase(storage);
+    std::free(storage);
+}
+
+int main()
+{
+    {
+        RendererRectangleQueue queue;
+        assert(sizes.size() == 2);
+        assert(sizes[0] == 8 * sizeof(ScreenRectangle*));
+        assert(sizes[1] == 128);
+        for (int i = 0; i < 257; ++i)
+            queue.PushBack({ i, -i, i + 3, i + 7 });
+        for (int i = 0; i < 257; ++i)
+        {
+            const RendererRectangleQueue& read = queue;
+            assert(read.At(i).left == i);
+            assert(read.At(i).top == -i);
+            assert(read.At(i).right == i + 3);
+            assert(read.At(i).bottom == i + 7);
+        }
+        for (int i = 256; i >= 0; --i)
+        {
+            assert(queue.At(i).left == i);
+            queue.PopBack();
+        }
+        for (int i = 0; i < 7; ++i)
+            queue.PushBack({ i, i + 1, i + 2, i + 3 });
+        queue.PushBack(queue.At(0));
+        assert(queue.At(7).left == 0 && queue.At(7).bottom == 3);
+    }
+    assert(live_blocks.empty());
+    for (int failure = 0; failure <= 10; ++failure)
+    {
+        allocation_countdown = failure;
+        bool threw = false;
+        try
+        {
+            RendererRectangleQueue queue;
+            for (int i = 0; i < 70; ++i)
+                queue.PushBack({ i, i, i, i });
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        assert(threw == (failure < 10));
+        assert(pool_lock_word == 0);
+        assert(live_blocks.empty());
+    }
+    for (int failure = 0; failure < 6; ++failure)
+    {
+        allocation_countdown = failure;
+        WorldDequeStorage<ScreenRectangle, RendererRectangleIterator> storage = { };
+        try
+        {
+            storage.InitializeMap(33);
+            assert(false);
+        }
+        catch (const std::bad_alloc&)
+        {
+        }
+        assert(pool_lock_word == 0);
+        assert(live_blocks.empty());
+        assert(storage.map == 0);
+    }
+}
diff --git a/tests/save_record_sort.cpp b/tests/save_record_sort.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1d55b3d95282951b81043d8698b00c05f730bf87
--- /dev/null
+++ b/tests/save_record_sort.cpp
@@ -0,0 +1,108 @@
+#include "startup_game_save_sort.h"
+#include "startup_pointer_copy_backward.h"
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <numeric>
+#include <vector>
+
+template <class Order>
+static void CheckSorted(const std::vector<GameSaveRecord*>& pointers, Order order)
+{
+    assert(std::is_sorted(pointers.begin(), pointers.end(), order));
+    auto unique = pointers;
+    std::sort(unique.begin(), unique.end());
+    assert(std::adjacent_find(unique.begin(), unique.end()) == unique.end());
+}
+
+static void TestTies()
+{
+    std::array<GameSaveRecord, 17> records = { };
+    std::array<GameSaveRecord*, 17> pointers;
+    for (unsigned int i = 0; i < pointers.size(); ++i)
+    {
+        records[i].word_00 = i;
+        records[i].time_04 = 100;
+        pointers[i] = &records[i];
+    }
+    SortSaveRecords(pointers.data(), pointers.data() + pointers.size(), SaveRecordTimeOrder());
+    // The retail partition swaps both endpoints even when all keys are equal.
+    // Its subsequent strict insertion comparisons preserve that reversal.
+    for (unsigned int i = 0; i < pointers.size(); ++i)
+        assert(pointers[i] == &records[16 - i]);
+
+    for (unsigned int i = 0; i < pointers.size(); ++i)
+        pointers[i] = &records[i];
+    SortRefreshedSaveRecords(pointers.data(), pointers.data() + pointers.size());
+    for (unsigned int i = 0; i < pointers.size(); ++i)
+        assert(pointers[i] == &records[16 - i]);
+
+    // At the retail 16-element cutoff, insertion sorting keeps equal keys.
+    for (unsigned int i = 0; i < pointers.size(); ++i)
+        pointers[i] = &records[i];
+    SortSaveRecords(pointers.data(), pointers.data() + 16, SaveRecordTimeOrder());
+    for (unsigned int i = 0; i < pointers.size(); ++i)
+        assert(pointers[i] == &records[i]);
+
+    MakeSaveRecordHeap(pointers.data(), pointers.data() + 4, SaveRecordTimeOrder());
+    SortSaveRecordHeap(pointers.data(), pointers.data() + 4, SaveRecordTimeOrder());
+    const unsigned int heap_order[] = { 1, 3, 0, 2 };
+    for (unsigned int i = 0; i < 4; ++i)
+        assert(pointers[i] == &records[heap_order[i]]);
+}
+
+static void TestRanges()
+{
+    std::uint32_t random = 0x63b54a21u;
+    for (unsigned int size : { 0u, 1u, 2u, 15u, 16u, 17u, 32u, 65u, 257u })
+    {
+        std::vector<GameSaveRecord> records(size);
+        std::vector<GameSaveRecord*> input;
+        for (auto& record : records)
+        {
+            random = random * 1664525u + 1013904223u;
+            record.word_00 = random;
+            record.time_04 = static_cast<int>(random ^ 0x80000000u);
+            input.push_back(&record);
+        }
+        auto pointers = input;
+        SortSaveRecords(pointers.data(), pointers.data() + size, SaveRecordNumberOrder());
+        CheckSorted(pointers, SaveRecordNumberOrder());
+        pointers = input;
+        SortSaveRecords(pointers.data(), pointers.data() + size, SaveRecordTimeOrder());
+        CheckSorted(pointers, SaveRecordTimeOrder());
+        auto refreshed = input;
+        SortRefreshedSaveRecords(refreshed.data(), refreshed.data() + size);
+        assert(refreshed == pointers);
+        pointers = input;
+        MakeSaveRecordHeap(pointers.data(), pointers.data() + size, SaveRecordNumberOrder());
+        SortSaveRecordHeap(pointers.data(), pointers.data() + size, SaveRecordNumberOrder());
+        CheckSorted(pointers, SaveRecordNumberOrder());
+        pointers = input;
+        MakeSaveRecordHeap(pointers.data(), pointers.data() + size, SaveRecordTimeOrder());
+        SortSaveRecordHeap(pointers.data(), pointers.data() + size, SaveRecordTimeOrder());
+        CheckSorted(pointers, SaveRecordTimeOrder());
+        if (size > 16)
+        {
+            pointers = input;
+            IntrosortSaveRecords(pointers.data(), pointers.data() + size, 0, 0, SaveRecordTimeOrder());
+            CheckSorted(pointers, SaveRecordTimeOrder());
+            pointers = input;
+            IntrosortSaveRecords(pointers.data(), pointers.data() + size, 0, 0, SaveRecordNumberOrder());
+            CheckSorted(pointers, SaveRecordNumberOrder());
+            pointers = input;
+            PartialSortSaveRecords(pointers.data(), pointers.data() + size / 2, pointers.data() + size, 0, SaveRecordTimeOrder());
+            assert(std::is_sorted(pointers.begin(), pointers.begin() + size / 2, SaveRecordTimeOrder()));
+            auto expected = input;
+            std::sort(expected.begin(), expected.end(), SaveRecordTimeOrder());
+            assert(std::equal(pointers.begin(), pointers.begin() + size / 2, expected.begin()));
+        }
+    }
+}
+
+int main()
+{
+    TestTies();
+    TestRanges();
+}
diff --git a/tests/stable_pointer_sort.cpp b/tests/stable_pointer_sort.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d53bf0af5715378c0e6043d9d5480cb4a618b0b8
--- /dev/null
+++ b/tests/stable_pointer_sort.cpp
@@ -0,0 +1,138 @@
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <vector>
+
+struct SortValue
+{
+    unsigned int key;
+    unsigned int sequence;
+};
+struct SortOrder
+{
+    bool operator()(SortValue* left, SortValue* right) const { return left->key < right->key; }
+};
+
+void InPlaceStableSortPointers(SortValue** first, SortValue** last, SortOrder order);
+void AdaptiveStableSortPointers(SortValue** first, SortValue** last, SortValue** buffer, int capacity, SortOrder order);
+void InsertionSortPointers(SortValue** first, SortValue** last, SortOrder order);
+void MergePointersWithoutBuffer(SortValue** first, SortValue** middle, SortValue** last, int left, int right, SortOrder order);
+void MergePointersAdaptive(SortValue** first, SortValue** middle, SortValue** last, int left, int right, SortValue** buffer, int capacity, SortOrder order);
+void InsertSortedPointer(SortValue** first, SortValue** position, SortValue* value, SortOrder order);
+void ChunkInsertionSortPointers(SortValue** first, SortValue** last, int chunk, SortOrder order);
+void MergePointerPass(SortValue** first, SortValue** last, SortValue** output, int run, SortOrder order);
+SortValue** MergePointerRanges(SortValue** first, SortValue** last, SortValue** second, SortValue** second_last, SortValue** output, SortOrder order);
+SortValue** LowerBoundPointer(SortValue** first, SortValue** last, SortValue* const& value, SortOrder order);
+SortValue** UpperBoundPointer(SortValue** first, SortValue** last, SortValue* const& value, SortOrder order);
+
+#include "startup_stable_pointer_sort.h"
+
+void InPlaceStableSortPointers(SortValue** first, SortValue** last, SortOrder order)
+{
+    stable_pointer_sort::InPlace(first, last, order);
+}
+
+void AdaptiveStableSortPointers(SortValue** first, SortValue** last, SortValue** buffer, int capacity, SortOrder order)
+{
+    stable_pointer_sort::Adaptive(first, last, buffer, capacity, order);
+}
+
+void InsertionSortPointers(SortValue** first, SortValue** last, SortOrder order)
+{
+    stable_pointer_sort::InsertionSort(first, last, order);
+}
+
+void MergePointersWithoutBuffer(SortValue** first, SortValue** middle, SortValue** last, int left, int right, SortOrder order)
+{
+    stable_pointer_sort::MergeWithoutBuffer(first, middle, last, left, right, order);
+}
+
+void MergePointersAdaptive(SortValue** first, SortValue** middle, SortValue** last, int left, int right, SortValue** buffer, int capacity, SortOrder order)
+{
+    stable_pointer_sort::MergeAdaptive(first, middle, last, left, right, buffer, capacity, order);
+}
+
+void InsertSortedPointer(SortValue** first, SortValue** position, SortValue* value, SortOrder order)
+{
+    stable_pointer_sort::Insert(first, position, value, order);
+}
+
+void ChunkInsertionSortPointers(SortValue** first, SortValue** last, int chunk, SortOrder order)
+{
+    stable_pointer_sort::ChunkInsertionSort(first, last, chunk, order);
+}
+
+void MergePointerPass(SortValue** first, SortValue** last, SortValue** output, int run, SortOrder order)
+{
+    stable_pointer_sort::MergePass(first, last, output, run, order);
+}
+
+SortValue** MergePointerRanges(SortValue** first, SortValue** last, SortValue** second, SortValue** second_last, SortValue** output, SortOrder order)
+{
+    return stable_pointer_sort::Merge(first, last, second, second_last, output, order);
+}
+
+SortValue** LowerBoundPointer(SortValue** first, SortValue** last, SortValue* const& value, SortOrder order)
+{
+    return stable_pointer_sort::LowerBound(first, last, value, order);
+}
+
+SortValue** UpperBoundPointer(SortValue** first, SortValue** last, SortValue* const& value, SortOrder order)
+{
+    return stable_pointer_sort::UpperBound(first, last, value, order);
+}
+
+static void CheckRotations()
+{
+    std::array<SortValue, 66> values = { };
+    for (unsigned int size = 0; size < values.size(); ++size)
+        for (unsigned int middle = 0; middle <= size; ++middle)
+        {
+            std::vector<SortValue*> actual;
+            for (unsigned int i = 0; i < size; ++i)
+                actual.push_back(&values[i]);
+            // Keep an actual array element for the empty-range case.
+            actual.push_back(nullptr);
+            auto expected = actual;
+            std::rotate(expected.begin(), expected.begin() + middle, expected.begin() + size);
+            SortValue** result = RotatePointerRange(actual.data(), actual.data() + middle, actual.data() + size);
+            assert(result == actual.data() + size - middle);
+            assert(actual == expected);
+        }
+}
+
+int main()
+{
+    CheckRotations();
+    std::uint32_t random = 0xa927cd13u;
+    for (unsigned int size = 0; size <= 257; ++size)
+    {
+        std::vector<SortValue> values(size);
+        std::vector<SortValue*> original;
+        for (unsigned int i = 0; i < size; ++i)
+        {
+            random = random * 1664525u + 1013904223u;
+            values[i] = { random % 11u, i };
+            original.push_back(&values[i]);
+        }
+        auto expected = original;
+        std::stable_sort(expected.begin(), expected.end(), SortOrder());
+        // A spare element makes zero-length pointer ranges well defined.
+        original.push_back(nullptr);
+        expected.push_back(nullptr);
+        auto actual = original;
+        stable_pointer_sort::Sort(actual.data(), actual.data() + size, SortOrder());
+        assert(actual == expected);
+        for (unsigned int capacity : { 0u, 1u, 2u, 3u, 7u, 15u, size })
+        {
+            actual = original;
+            std::vector<SortValue*> buffer(capacity + 1);
+            if (capacity == 0)
+                InPlaceStableSortPointers(actual.data(), actual.data() + size, SortOrder());
+            else
+                AdaptiveStableSortPointers(actual.data(), actual.data() + size, buffer.data(), capacity, SortOrder());
+            assert(actual == expected);
+        }
+    }
+}
