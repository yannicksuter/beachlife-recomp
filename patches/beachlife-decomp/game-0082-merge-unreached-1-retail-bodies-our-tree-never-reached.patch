+#include "startup_world_id_set.h"
+#include "node_storage.h"
+#include <cassert>
+#include <cstdlib>
+#include <new>
+
+PoolChunkLink* volatile pool_chunk_buckets[16];
+volatile LONG pool_lock_word;
+static int live_blocks;
+static int fail_after = -1;
+void AcquirePoolLock(volatile LONG* lock)
+{
+    assert(*lock == 0);
+    *lock = 1;
+}
+void* RefillPool(unsigned int bytes)
+{
+    if (fail_after == 0)
+        throw std::bad_alloc();
+    if (fail_after > 0)
+        --fail_after;
+    void* result = std::malloc(bytes);
+    assert(result);
+    ++live_blocks;
+    return result;
+}
+char* AcquirePoolChunk(unsigned int bytes, int& count)
+{
+    count = 1;
+    return static_cast<char*>(RefillPool(bytes));
+}
+void ReturnPool(void* value, unsigned int bytes)
+{
+    assert(bytes == sizeof(WorldIdSetNode));
+    --live_blocks;
+    std::free(value);
+}
+static int CheckNode(WorldIdSetNode* node, WorldIdSetNode* parent, unsigned int& count,
+    unsigned int& previous, bool& first)
+{
+    if (!node)
+        return 1;
+    assert(node->parent == parent);
+    if (!node->color)
+    {
+        assert(!node->left || node->left->color);
+        assert(!node->right || node->right->color);
+    }
+    int left = CheckNode(node->left, node, count, previous, first);
+    assert(first || previous < node->value);
+    first = false;
+    previous = node->value;
+    ++count;
+    int right = CheckNode(node->right, node, count, previous, first);
+    assert(left == right);
+    return left + !!node->color;
+}
+static void Check(WorldIdSet& tree)
+{
+    assert(tree.head->color == 0);
+    if (tree.count)
+        assert(tree.head->parent->color == 1);
+    unsigned int count = 0, previous = 0;
+    bool first = true;
+    CheckNode(tree.head->parent, tree.head, count, previous, first);
+    assert(count == tree.count);
+    if (count)
+    {
+        assert(tree.head->right->value == previous);
+        assert(PreviousWorldIdNode(tree.head) == tree.head->right);
+        auto node = tree.head->right;
+        while (node != tree.head->left)
+        {
+            auto prior = PreviousWorldIdNode(node);
+            assert(prior->value < node->value);
+            node = prior;
+        }
+    }
+}
+int main()
+{
+    for (unsigned int order = 0; order < 3; ++order)
+    {
+        WorldIdSet tree;
+        Check(tree);
+        for (unsigned int i = 0; i < 257; ++i)
+        {
+            unsigned int value = order == 0 ? i : order == 1 ? 256 - i
+                                                             : (i * 101) % 257;
+            auto result = tree.Insert(value);
+            assert(result.inserted && result.node->value == value);
+            assert(tree.count == i + 1);
+            Check(tree);
+            fail_after = 0;
+            auto duplicate = tree.Insert(value);
+            fail_after = -1;
+            assert(!duplicate.inserted && duplicate.node == result.node);
+        }
+        assert(tree.Insert(~0u).inserted);
+        assert(tree.Insert(0x80000000u).inserted);
+        Check(tree);
+    }
+    assert(live_blocks == 0);
+    for (int failure = 0; failure <= 17; ++failure)
+    {
+        fail_after = failure;
+        bool threw = false;
+        try
+        {
+            WorldIdSet tree;
+            for (unsigned int i = 0; i < 16; ++i)
+                tree.Insert(i);
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        fail_after = -1;
+        assert(threw == (failure < 17));
+        assert(live_blocks == 0 && pool_lock_word == 0);
+    }
+}
