--- /dev/null
+++ b/src/startup_table_staff_heap.cpp
@@ -0,0 +1,49 @@
+#include "startup_screen_table_sort.h"
+
+static void AdjustStaffRowHeap(ScreenRequestContext** first, int hole, int count, ScreenRequestContext* value)
+{
+    int top = hole;
+    int child = 2 * hole + 2;
+    while (child < count)
+    {
+        if (first[child]->id_28 < first[child - 1]->id_28)
+            --child;
+        first[hole] = first[child];
+        hole = child;
+        child = 2 * hole + 2;
+    }
+    if (child == count)
+    {
+        first[hole] = first[child - 1];
+        hole = child - 1;
+    }
+    int parent = (hole - 1) / 2;
+    while (hole > top && first[parent]->id_28 < value->id_28)
+    {
+        first[hole] = first[parent];
+        hole = parent;
+        parent = (hole - 1) / 2;
+    }
+    first[hole] = value;
+}
+
+// FUNCTION: BEACHLIFE 0x004c0380
+void MakeStaffRowHeap(ScreenRequestContext** first, ScreenRequestContext** last, ScreenTableStaffOrder)
+{
+    int count = first == last ? 0 : static_cast<int>(last - first);
+    if (count < 2)
+        return;
+    for (int parent = (count - 2) / 2;; --parent)
+    {
+        AdjustStaffRowHeap(first, parent, count, first[parent]);
+        if (parent == 0)
+            return;
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x004bf870
+void PopStaffRowHeap(ScreenRequestContext** first, ScreenRequestContext** last, ScreenRequestContext** output, ScreenRequestContext* value, ScreenTableStaffOrder)
+{
+    *output = *first;
+    AdjustStaffRowHeap(first, 0, static_cast<int>(last - first), value);
+}
