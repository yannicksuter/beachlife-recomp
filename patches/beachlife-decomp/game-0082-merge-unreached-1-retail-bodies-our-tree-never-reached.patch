+    void* result = std::malloc(bytes);
+    assert(result);
+    ++live_blocks;
+    return result;
+}
+
+void* operator new(std::size_t bytes)
+{
+    return Allocate(bytes);
+}
+void operator delete(void* value) noexcept
+{
+    if (value)
+    {
+        --live_blocks;
+        std::free(value);
