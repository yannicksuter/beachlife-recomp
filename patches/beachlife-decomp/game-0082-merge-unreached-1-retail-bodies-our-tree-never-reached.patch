+    void* storage = std::malloc(bytes);
+    assert(storage);
+    live_blocks.emplace(storage, bytes);
+    return storage;
+}
+
+void ReturnPool(void* storage, unsigned int bytes)
+{
+    assert(live_blocks.at(storage) == bytes);
+    live_blocks.erase(storage);
+    std::free(storage);
+}
+
+int main()
+{
+    {
+        OverlayPendingDeque queue;
+        assert(queue.Empty());
+        for (unsigned int i = 0; i < 201; ++i)
+            queue.PushBack(i);
+        for (unsigned int i = 0; i < 129; ++i)
+        {
+            assert(queue.Front() == i);
+            queue.PopFront();
+        }
+        for (unsigned int i = 201; i < 301; ++i)
+            queue.PushBack(i);
+        assert(queue.Size() == 172);
+        for (unsigned int i = 129; i < 301; ++i)
+        {
+            assert(queue.At(0) == i && queue.Front() == i);
+            queue.PopFront();
+        }
+        assert(queue.Empty());
+        for (unsigned int i = 0; i < 70; ++i)
+            queue.PushBack(i);
+        queue.Clear();
+        assert(queue.Empty());
+        queue.PushBack(~0u);
+        assert(queue.Front() == ~0u);
+    }
+    assert(live_blocks.empty());
+    for (int failure = 0; failure <= 4; ++failure)
+    {
+        allocation_countdown = failure;
+        bool threw = false;
+        try
+        {
+            OverlayPendingDeque queue;
+            for (unsigned int i = 0; i < 70; ++i)
+                queue.PushBack(i);
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        assert(threw == (failure < 4));
+        assert(pool_lock_word == 0 && live_blocks.empty());
+    }
+}
