+{
+    ::operator delete(value);
+}
+
+void* AllocatePoolBytes(unsigned int bytes)
+{
+    return Allocate(bytes);
+}
+void* operator new(std::size_t bytes, const std::nothrow_t&) noexcept
+{
+    try
+    {
+        return ::operator new(bytes);
+    }
+    catch (...)
+    {
+        return nullptr;
+    }
+}
+WorldSubsystem44* world_subsystem_44;
+
+template <class T, class Iterator = WorldDequeIterator<T> >
+struct TestDeque : WorldDequeStorage<T, Iterator>
+{
+    TestDeque() { this->InitializeEmpty(); }
+    ~TestDeque() { this->Destroy(); }
+};
+
+template <class T>
+static void CheckInsert(T* values)
+{
+    for (int count = 0; count <= 65; ++count)
+    {
+        for (int inserted = 0; inserted <= count; ++inserted)
+        {
+            TestDeque<T> queue;
+            for (int i = 0; i < count; ++i)
+                WorldDequePushBack(queue, values[i]);
+            T source = count ? queue.At(0) : values[66];
+            auto position = queue.Insert(WorldDequeAdvance(queue.begin, inserted), count ? queue.At(0) : values[66]);
+            assert(WorldDequeDistance(position, queue.begin) == inserted);
+            assert(WorldDequeDistance(queue.end, queue.begin) == count + 1);
+            for (int i = 0; i <= count; ++i)
+                assert(queue.At(i) == (i == inserted ? source : values[i - (i > inserted)]));
+            auto after = EraseWorldDeque(queue, position);
+            assert(WorldDequeDistance(after, queue.begin) == inserted);
+            for (int i = 0; i < count; ++i)
+                assert(queue.At(i) == values[i]);
+        }
+    }
+    {
+        TestDeque<T> queue;
+        for (int i = 0; i < 137; ++i)
+            queue.Insert(queue.begin, values[i % 97]);
+        for (int i = 0; i < 137; ++i)
+            assert(queue.At(i) == values[(136 - i) % 97]);
+    }
+}
+
+int main()
+{
+    const int baseline = live_blocks;
+    int objects[97] = { };
+    WorldEventRecord* events[97];
+    WorldWeatherEvent* weather[97];
+    VariableThought* thoughts[97];
+    for (int i = 0; i < 97; ++i)
+    {
+        events[i] = reinterpret_cast<WorldEventRecord*>(objects + i);
+        weather[i] = reinterpret_cast<WorldWeatherEvent*>(objects + i);
+        thoughts[i] = reinterpret_cast<VariableThought*>(objects + i);
+    }
+    CheckInsert(events);
+    CheckInsert(weather);
+    for (int erased = 0; erased < 97; ++erased)
+    {
+        TestDeque<VariableThought*, ScreenContextRowIterator> queue;
+        for (int i = 0; i < 97; ++i)
+            WorldDequePushBack(queue, thoughts[i]);
+        auto result = queue.Erase(WorldDequeAdvance(queue.begin, erased));
+        assert(WorldDequeDistance(result, queue.begin) == erased);
+        for (int i = 0; i < 96; ++i)
+            assert(queue.At(i) == thoughts[i + (i >= erased)]);
+    }
+    assert(live_blocks == baseline);
+    for (int failure = 0; failure <= 4; ++failure)
+    {
+        fail_after = failure;
+        bool threw = false;
+        try
+        {
+            WorldDequeStorage<unsigned int> queue;
+            queue.Initialize(WorldDequeAllocator(), 65);
+            assert(WorldDequeDistance(queue.end, queue.begin) == 65);
+            queue.Destroy();
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        fail_after = -1;
+        assert(threw == (failure < 4));
+        assert(live_blocks == baseline && pool_lock_word == 0);
+    }
+    for (int failure = 0; failure <= 4; ++failure)
+    {
+        fail_after = failure;
+        bool threw = false;
+        try
+        {
+            WorldSubsystem44 subsystem;
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        fail_after = -1;
+        assert(threw == (failure < 4));
+        assert(world_subsystem_44 == nullptr);
+        assert(live_blocks == baseline && pool_lock_word == 0);
+    }
+}
