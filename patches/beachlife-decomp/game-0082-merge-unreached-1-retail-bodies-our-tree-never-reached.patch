+#include "startup_pointer_vector_owners.h"
+#include "pool_chunk_acquire.h"
+#include <windows.h>
+#include <cassert>
+#include <cstdlib>
+#include <new>
+
+PoolChunkLink* volatile pool_chunk_buckets[16];
+volatile LONG pool_lock_word;
+static int fail_after = -1;
+static int live_blocks;
+
+static void* Allocate(unsigned int bytes)
+{
+    if (fail_after == 0)
+        throw std::bad_alloc();
+    if (fail_after > 0)
+        --fail_after;
+    void* result = std::malloc(bytes);
+    assert(result);
+    ++live_blocks;
+    return result;
+}
+
+void* operator new(std::size_t bytes)
+{
+    return Allocate(bytes);
+}
+void operator delete(void* value) noexcept
+{
+    if (value)
+    {
+        --live_blocks;
+        std::free(value);
+    }
+}
+void AcquirePoolLock(volatile LONG* lock)
+{
+    assert(*lock == 0);
+    *lock = 1;
+}
+void* RefillPool(unsigned int bytes)
+{
+    return Allocate(bytes);
+}
+void ReturnPool(void* value, unsigned int)
+{
+    ::operator delete(value);
+}
+
+void* AllocatePoolBytes(unsigned int bytes)
+{
+    return Allocate(bytes);
+}
+
+int main()
+{
+    const int baseline = live_blocks;
+    int values[257] = { };
+    {
+        BuildingNameStorage pointers;
+        assert(pointers.Empty());
+        for (int i = 0; i < 257; ++i)
+        {
+            pointers.PushBack(reinterpret_cast<VariableEntity*>(values + i));
+            assert(pointers.Size() == static_cast<unsigned int>(i + 1));
+            for (int j = 0; j <= i; ++j)
+                assert(pointers[j] == reinterpret_cast<VariableEntity*>(values + j));
+        }
+        pointers.Clear();
+        assert(pointers.Empty());
+    }
+    assert(live_blocks == baseline);
+    for (unsigned int count = 1; count <= 256; count *= 2)
+    {
+        StaffNameStorage pointers;
+        for (unsigned int i = 0; i < count; ++i)
+            pointers.PushBack(reinterpret_cast<VariableEntity*>(values + i));
+        assert(pointers.end == pointers.limit);
+        auto first = pointers[0];
+        pointers.PushBack(pointers[0]);
+        assert(pointers[count] == first);
+    }
+    assert(live_blocks == baseline);
+    for (int failure = 0; failure <= 10; ++failure)
+    {
+        fail_after = failure;
+        bool threw = false;
+        try
+        {
+            RendererSurfaceStorage pointers;
+            for (int i = 0; i < 257; ++i)
+                pointers.PushBack(reinterpret_cast<ScreenSurfacePosition*>(values + i));
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        fail_after = -1;
+        assert(threw == (failure < 10));
+        assert(live_blocks == baseline);
+    }
+    {
+        PlaylistSelectionStorage pointers;
+        for (int i = 0; i < 17; ++i)
+            pointers.PushBack(reinterpret_cast<ScreenLoadPanel13cEntry*>(values + i));
+    }
+    assert(live_blocks == baseline);
+    for (int value : values)
+        assert(value == 0);
+}
