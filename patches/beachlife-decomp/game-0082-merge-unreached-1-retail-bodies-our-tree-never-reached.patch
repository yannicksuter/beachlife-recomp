+template <class Node, class Value>
+Node* AllocatePointerListNode(const Value& value, Value Node::* payload)
+{
+    const unsigned int block_size = (sizeof(Node) + 7u) & ~7u;
+    const unsigned int bucket_index = (block_size - 1) / 8;
