+    CircularListNode* node = sentinel.next;
+    for (WorldTransportRecord& record : records)
+    {
+        assert(static_cast<WorldTransportNode*>(node)->record == &record);
+        assert(node->next->previous == node);
+        node = node->next;
+    }
+    assert(node == &sentinel);
+    while (sentinel.next != &sentinel)
+    {
+        CircularListIterator first;
+        first.node = sentinel.next;
+        list.Erase(first);
+    }
+
+    WorldCleaningRequest request = { };
+    WorldCleaningRequest* request_pointer = &request;
+    CircularListIterator first = list.Insert(end, request_pointer);
+    assert(reinterpret_cast<WorldCleaningRequest*>(static_cast<CircularListValueNode*>(first.node)->entry) == &request);
