diff --git a/tests/event_schedule_entry.cpp b/tests/event_schedule_entry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7c6013a9c4f153e7ab88bf183a5a4367c28a325e
--- /dev/null
+++ b/tests/event_schedule_entry.cpp
@@ -0,0 +1,67 @@
+#include "startup_variable_state.h"
+
+#include <cassert>
+#include <cstdlib>
+#include <new>
+#include <vector>
+
+static std::vector<void*> allocations;
+static std::vector<void*> released;
+static int allocation_countdown;
+
+// Inject failures at the pool refill boundary while exercising real deque lifetimes.
+PoolChunkLink* volatile pool_chunk_buckets[16];
+volatile LONG pool_lock_word;
+
+void AcquirePoolLock(volatile LONG* lock)
+{
+    assert(*lock == 0);
+    *lock = 1;
+}
+
+void* RefillPool(unsigned int bytes)
+{
+    if (allocation_countdown-- == 0)
+        throw std::bad_alloc();
+    void* memory = std::malloc(bytes);
+    assert(memory);
+    allocations.push_back(memory);
+    return memory;
+}
+
+void ReturnPool(void* memory, unsigned int)
+{
+    released.push_back(memory);
+    std::free(memory);
+}
+
+int main()
+{
+    for (int failure = 0; failure <= 12; ++failure)
+    {
+        allocations.clear();
+        released.clear();
+        allocation_countdown = failure;
+        bool threw = false;
+        try
+        {
+            VariableEventSchedule::Entry entries[3];
+            for (auto& entry : entries)
+            {
+                assert(entry.staff_00.begin.current == entry.staff_00.end.current);
+                assert(entry.guests_2c.begin.current == entry.guests_2c.end.current);
+                entry.staff_00.At(0) = 42;
+                entry.guests_2c.At(0) = 17;
+            }
+        }
+        catch (const std::bad_alloc&)
+        {
+            threw = true;
+        }
+        assert(pool_lock_word == 0);
+        assert(threw == (failure < 12));
+        assert(allocations.size() == released.size());
+        for (unsigned int i = 0; i < released.size(); ++i)
+            assert(released[i] == allocations[allocations.size() - 1 - i]);
+    }
+}
diff --git a/tests/motion_vectors.cpp b/tests/motion_vectors.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..36421d950131b705c95168f0c8475b80b323ea46
--- /dev/null
+++ b/tests/motion_vectors.cpp
@@ -0,0 +1,20 @@
+#include "startup_screen_point.h"
+#include <cassert>
+#include <cmath>
+
+int main()
+{
+    ScreenMapPosition position = { 6.0f, -12.0f };
+    ScreenMapPosition scaled = position * 0.25f;
+    assert(scaled.x == 1.5f && scaled.y == -3.0f);
+    ScreenMapPosition sum = scaled + ScreenMapPosition { -2.0f, 4.0f };
+    assert(sum.x == -0.5f && sum.y == 1.0f);
+
+    // The reciprocal estimate has one refinement and deliberately differs
+    // from the exact quotient for a divisor of three.
+    ScreenMapPosition quotient = position / 3.0f;
+    assert(quotient.x == 1.96875f && quotient.y == -3.9375f);
+    ScreenMapPosition zeros = ScreenMapPosition { -0.0f, 0.0f } / 2.0f;
+    assert(zeros.x == 0.0f && std::signbit(zeros.x));
+    assert(zeros.y == 0.0f && !std::signbit(zeros.y));
+}
