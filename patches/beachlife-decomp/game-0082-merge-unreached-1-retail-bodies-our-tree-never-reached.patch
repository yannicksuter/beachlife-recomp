+
+// The retail pointer specializations share one physical memmove body.
+// FUNCTION: BEACHLIFE 0x004450e0
+template <class T>
+T** CopyPointerRangeBackward(T** first, T** last, T** output_end)
+{
+    if (last - first > 0)
+    {
+        T** destination = output_end - (last - first);
