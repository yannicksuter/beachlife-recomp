+    first = assignments.Insert(end, repair_assignment_pointer);
+    assert(static_cast<WorldRepairNode<WorldRepairAssignment>*>(first.node)->entry == &repair_assignment);
+    list.Erase(first);
+    assert(sentinel.next == &sentinel && sentinel.previous == &sentinel);
+    assert(pool_lock_word == 0);
