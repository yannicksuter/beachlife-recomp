@@ -0,0 +1,64 @@
+#ifndef STARTUP_TICKER_STORAGE_H
+#define STARTUP_TICKER_STORAGE_H
+
+#include "startup_world_deque_operations.h"
+
+struct TickerQueuedMessage;
+struct TickerHistoryMessage;
+
+template <class Message>
+struct TickerDeque : WorldDequeStorage<Message*>
+{
+    using Storage = WorldDequeStorage<Message*>;
+    using Iterator = WorldDequeIterator<Message*>;
+
+    TickerDeque() { this->InitializeEmpty(); }
+    ~TickerDeque();
+    bool Empty() const { return this->begin.current == this->end.current; }
+    unsigned int Size() const { return WorldDequeDistance(this->end, this->begin); }
+    Message* Front() const { return *this->begin.current; }
+    Message*& operator[](int index) { return this->At(index); }
+    Iterator Erase(Iterator position) { return EraseWorldDeque(static_cast<Storage&>(*this), position); }
+    void PopFront()
+    {
+        if (this->begin.current == this->begin.last - 1)
+            this->PopFrontBlock();
+        else
+            ++this->begin.current;
+    }
+    void PushBack(Message* const& value)
+    {
+        if (this->end.current == this->end.last - 1)
+            this->AppendBlock(value);
+        else
+        {
+            if (this->end.current)
+                ::new (this->end.current) Message*(value);
+            ++this->end.current;
+        }
+    }
+};
+
+template <>
+TickerDeque<TickerQueuedMessage>::~TickerDeque();
+template <>
+TickerDeque<TickerHistoryMessage>::~TickerDeque();
+template <>
+void WorldDequeStorage<TickerQueuedMessage*>::InitializeMap(unsigned int count);
+template <>
+void WorldDequeStorage<TickerHistoryMessage*>::InitializeMap(unsigned int count);
+template <>
+void WorldDequeStorage<TickerQueuedMessage*>::CreateNodes(TickerQueuedMessage*** first, TickerQueuedMessage*** last);
+template <>
+void WorldDequeStorage<TickerHistoryMessage*>::CreateNodes(TickerHistoryMessage*** first, TickerHistoryMessage*** last);
+template <>
+void WorldDequeStorage<TickerQueuedMessage*>::AppendBlock(TickerQueuedMessage* const& value);
+template <>
+void WorldDequeStorage<TickerHistoryMessage*>::AppendBlock(TickerHistoryMessage* const& value);
+
+WorldDequeIterator<TickerQueuedMessage*> FindQueuedMessage(WorldDequeIterator<TickerQueuedMessage*> first,
+    WorldDequeIterator<TickerQueuedMessage*> last, unsigned int id);
+WorldDequeIterator<TickerQueuedMessage*> FindQueuedMessage(WorldDequeIterator<TickerQueuedMessage*> first,
+    WorldDequeIterator<TickerQueuedMessage*> last, const char* key);
+
+#endif
