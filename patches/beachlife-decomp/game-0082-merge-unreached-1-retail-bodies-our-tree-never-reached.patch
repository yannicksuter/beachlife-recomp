+    list.Erase(first);
+
+    WorldRepairEntry repair = { };
+    WorldRepairEntry* repair_pointer = &repair;
+    WorldRepairList repairs = { &sentinel };
+    first = repairs.Insert(end, repair_pointer);
+    assert(static_cast<WorldRepairNode<WorldRepairEntry>*>(first.node)->entry == &repair);
+    list.Erase(first);
