+    }
+    ++cursor;
+    ScreenRectangle rectangle;
+    ReadRectangle(rectangle, 0);
+    char name[64];
+    ReadText(name);
+    ScreenTabItem* item = new ScreenTabItem(rectangle, name);
+    RegisterItem(item, 0);
+
+    const char* data = buffer;
+    if (data[cursor - 1] == ',')
+    {
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+        char text[64];
+        ReadText(text);
+        item->SetOwnedText(text);
+        screen_text_lookup->LookupText(text);
+    }
+
+    data = buffer;
+    while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+    if (data[cursor] == '>')
+    {
+        ++cursor;
+    }
+    else
+    {
+        StartupFatal("GUI_Parse::process_tab - Script Error \r\nNo close symbol at file offset - %u", cursor);
+    }
+
