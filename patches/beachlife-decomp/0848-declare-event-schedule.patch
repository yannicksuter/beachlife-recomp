+#ifndef STARTUP_WORLD_DEQUE_H
+#define STARTUP_WORLD_DEQUE_H
+
+// Shared x86 deque storage; operations retain their separate retail bodies.
+struct WorldDequeAllocator
+{
+};
+
+template <class T>
+struct WorldDequeIterator
+{
+    T* current;
+    T* first;
+    T* last;
+    T** node;
+
+    WorldDequeIterator(); // 0x00426c60.
+    WorldDequeIterator(T* position, T* block_first, T* block_last, T** slot);
+    void Advance(int count);                             // 0x00426ce0.
+    WorldDequeIterator Advanced(int count) const;        // 0x00426c70.
+    void Increment();                                    // 0x00427830.
+    void Decrement();                                    // 0x00427800.
+    int Distance(const WorldDequeIterator& other) const; // 0x00427a60.
+};
+
+template <class T, class Iterator = WorldDequeIterator<T> >
+struct WorldDequeStorage
+{
+    typedef T value_type;
+    Iterator begin;
+    Iterator end;
+    T** map;
+    unsigned int map_count;
+
+    Iterator Erase(Iterator position);
+    Iterator Insert(Iterator position, const T& value);
+    void AppendBlock(const T& value);
+    void ReserveMap(unsigned int count, unsigned char front);
+    void PushFrontBlock(const T& value);
+    Iterator MakeHole(Iterator position);
+    Iterator InsertMiddle(Iterator position, const T& value);
+    WorldDequeStorage* Initialize(const WorldDequeAllocator&, unsigned int count);
+    void InitializeMap(unsigned int count);
+    void CreateNodes(T** first, T** last);
+    void Destroy();
+};
+
+#endif
