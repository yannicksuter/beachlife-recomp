new file mode 100644
index 0000000000000000000000000000000000000000..51bf0a9ffdc85c4dbcf08c2b6f7fcf08ede66dc9
--- /dev/null
+++ b/src/startup_gui_parse_image.cpp
@@ -0,0 +1,41 @@
+#include "startup_gui_parser.h"
+#include "startup_screen_image_item.h"
+#include "startup_screen_text.h"
+
+void StartupFatal(const char* format, ...);
+
+// FUNCTION: BEACHLIFE 0x004acc90
+void GuiParserState::ParseImage()
+{
+    const char* data = buffer;
+    if (data[cursor] != '(')
+    {
+        StartupFatal("GUIManager::process_image - Script Error \r\nNo open bracket found at file offset - %u", cursor);
+        return;
+    }
+    ++cursor;
+    while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+
+    ScreenRectangle rectangle;
+    ReadRectangle(rectangle, current_context);
+    char resource_name[64];
+    ReadText(resource_name);
+    ScreenImageItem* item = new ScreenImageItem(rectangle, resource_name);
+    RegisterItem(item, 0);
+
+    data = buffer;
+    if (data[cursor - 1] == ',')
+    {
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+        char text[64];
+        ReadText(text);
+        item->SetOwnedText(text);
+        screen_text_lookup->LookupText(text);
+    }
+}
