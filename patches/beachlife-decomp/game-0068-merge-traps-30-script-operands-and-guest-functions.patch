+
+// FUNCTION: BEACHLIFE 0x00424900
+unsigned int WorldSubsystem4c::FindGuestFeature(unsigned int* feature, unsigned char* found,
+    unsigned int* broken, unsigned int* closed, unsigned int* beach_closed,
+    unsigned char* unavailable, unsigned int gender, unsigned int desire,
+    const ScreenPoint* tile, unsigned int previous, unsigned int guest)
+{
+    if (!counts_6c[desire])
+    {
+        if (desire != 10 || window_deactivation_state->CanBuild(variable_catalog->FindBuilding("SOUVSHOP")))
+            ++messages_d4[desire];
+        *found = 0;
+        *unavailable = 0;
+        *broken = 0;
+        *closed = 0;
+        *beach_closed = 0;
+        return 0;
+    }
+
+    *broken = 0;
+    bool selected = false;
+    unsigned char has_unavailable = 0;
+    float best_score = -1.0f;
+    // Retail only assigns these selection words when a candidate is chosen.
+    unsigned int selected_id;
+    unsigned int selected_feature;
+    for (unsigned int i = 0; i < counts_6c[desire]; ++i)
+    {
+        WorldBuildingEntity* building = variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding();
+        if (building->id_28 == previous)
+        {
+            if (!selected)
+                has_unavailable = 1;
+            continue;
+        }
+
+        bool accessible = FeatureUnavailable(data_04[desire][i].id_00, data_04[desire][i].index_04);
+        if (building->FlagAt00460370() && accessible)
+        {
+            ScreenPoint candidate = data_04[desire][i].tile_0c;
+            float distance = static_cast<float>(std::abs(tile->y - candidate.y) + std::abs(tile->x - candidate.x));
+            float rating = building->FeatureRating(data_04[desire][i].index_04, gender ? 1 : 0);
+            long double random = static_cast<long double>(std::rand()) * 3.0518509447574615e-5f * -0.0009000000427477062f;
+            long double score = 1.0f - static_cast<long double>(distance) * 0.00390625f + random + rating + 0.0010000000474974513f;
+            if (score > best_score)
+            {
+                best_score = static_cast<float>(score);
+                selected_id = data_04[desire][i].id_00;
+                selected_feature = data_04[desire][i].index_04;
+                selected = true;
+            }
+            continue;
+        }
+
+        char key[256];
+        long double condition = static_cast<long double>(static_cast<int>(3u - building->power_state_33c)) * 0.33f;
+        // Retail compares the scaled condition with 3.0f.
+        if (condition == 3.0f)
+        {
+            if (!selected)
+                selected_id = data_04[desire][i].id_00;
+            ++*broken;
+            std::strcpy(key, "GUEST_THOUGHT_BROKEN_");
+            std::strcat(key, variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding()->building_60->name_04);
+        }
+        else if (building->FlagAt00460380())
+        {
+            if (!selected && !*broken)
+                selected_id = data_04[desire][i].id_00;
+            ++*closed;
+            std::strcpy(key, "GUEST_THOUGHT_CLOSED_");
+            std::strcat(key, variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding()->building_60->name_04);
+        }
+        else if (!accessible)
+        {
+            if (!selected && !*broken && !*closed)
+            {
+                selected_id = data_04[desire][i].id_00;
+                selected_feature = data_04[desire][i].index_04;
+            }
+            ++*beach_closed;
+            std::strcpy(key, "GUEST_THOUGHT_BEACH_CLOSED_");
+            building = variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding();
+            std::strcat(key, variable_catalog->FeatureKey(building->building_60->features_1fc[data_04[desire][i].index_04]));
+        }
+        else
+        {
+            has_unavailable = 1;
+            continue;
+        }
+
+        char number[2];
+        std::sprintf(number, "%d", std::rand() % 3 + 1);
+        std::strcat(key, number);
+        const unsigned short* text = screen_text_lookup->LookupText(key);
+        variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding()->AddThought(text, guest);
+    }
+    if (selected)
+    {
+        *found = 1;
+        *feature = selected_feature;
+        *unavailable = 0;
+        return selected_id;
+    }
+    *feature = selected_feature;
+    *unavailable = has_unavailable;
+    *found = 0;
+    return selected_id;
+}
