+static void TestOperands()
+{
+    WorldSubsystem20 parser;
+    Parse(parser, "Set Var7 3.25; Add Var7 gUeStCoUnT; Message UnknownMessage Me Flag3 RandDWORD8;");
+    auto* set = static_cast<WorldActionArithmeticData*>(captured[0].action->data_08);
+    assert(set->left_00.kind == 0xc2 && *reinterpret_cast<unsigned int*>(set->left_00.data) == 7);
+    assert(set->right_08.kind == 0xe8 && *reinterpret_cast<float*>(set->right_08.data) == 3.25f);
+    auto* add = static_cast<WorldActionArithmeticData*>(captured[1].action->data_08);
+    assert(add->right_08.kind == 0xb9);
+    auto* message = static_cast<WorldActionCommandData*>(captured[2].action->data_08);
+    assert(message->operands_04[0].kind == 0xe2);
+    assert(message->operands_04[1].kind == 0xbc && *reinterpret_cast<unsigned int*>(message->operands_04[1].data) == 3);
+    assert(message->operands_04[2].kind == 0xe3 && *reinterpret_cast<unsigned int*>(message->operands_04[2].data) == 8);
+    ClearActions();
+
+    char quoted[] = "\"visitor\"";
+    WorldScriptOperand operand = parser.ParseOperand(quoted);
+    assert(operand.kind == 0x36 && std::strcmp(quoted, "\"visitor") == 0);
+    quoted[1] = 'X';
+    assert(std::strcmp(reinterpret_cast<const char*>(operand.data), "visitor") == 0);
+    ReleaseWorldScriptOperand(&operand);
+    for (const char* input : { "BeerActiveSmileys", "DefaultBeerbar", "BuildingCountHOTEL", "EventActiveparty" })
+    {
+        std::string token = input;
+        operand = parser.ParseOperand(token.data());
+        const char* suffix = operand.kind == 0xd2 ? "Smileys" : operand.kind == 0xd3 ? "bar"
+                                                          : operand.kind == 0xd4     ? "HOTEL"
+                                                                                     : "party";
+        token.assign(token.size(), 'X');
+        assert(std::strcmp(reinterpret_cast<const char*>(operand.data), suffix) == 0);
+        ReleaseWorldScriptOperand(&operand);
+    }
+    char random[] = "Random-2";
+    operand = parser.ParseOperand(random);
+    assert(operand.kind == 0xe4 && *reinterpret_cast<unsigned int*>(operand.data) == 0xfffffffeu);
+    ReleaseWorldScriptOperand(&operand);
+    char objective[] = "ScenarioObj4";
+    operand = parser.ParseOperand(objective);
+    assert(operand.kind == 0xc6 && *reinterpret_cast<unsigned int*>(operand.data) == 4);
+    ReleaseWorldScriptOperand(&operand);
+    for (const char* input : { "var7", "-1", ".5", "UnknownOperand" })
+    {
+        std::string token = input;
+        bool rejected = false;
+        try
+        {
+            parser.ParseOperand(token.data());
+        }
+        catch (const std::runtime_error& error)
+        {
+            rejected = std::strstr(error.what(), "not a number") != 0;
+        }
+        assert(rejected);
+    }
