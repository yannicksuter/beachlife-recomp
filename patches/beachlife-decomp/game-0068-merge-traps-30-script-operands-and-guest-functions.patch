+// FUNCTION: BEACHLIFE 0x0045c810
+void WorldBuildingEntity::AddThought(const unsigned short* text, unsigned int guest)
+{
+    auto& thoughts = thoughts_428;
+    if (static_cast<unsigned int>(WorldDequeDistance(thoughts.end, thoughts.begin)) >= 8)
+    {
+        VariableThought* oldest = *WorldDequeAdvance(thoughts.end, -1).current;
+        if (oldest)
+        {
+            ReleaseOwnedAllocation(oldest->data_00);
+            ::operator delete(oldest);
+        }
+        if (thoughts.end.current != thoughts.end.first)
+            --thoughts.end.current;
+        else
+        {
+            thoughts.FreeSlots(thoughts.end.first, 32 * sizeof(VariableThought*));
+            --thoughts.end.node;
+            thoughts.end.first = *thoughts.end.node;
+            thoughts.end.last = thoughts.end.first + 32;
+            thoughts.end.current = thoughts.end.last - 1;
+        }
+    }
+
+    VariableThought* thought = new (std::nothrow) VariableThought;
+    if (thought)
+        thought->data_00 = 0;
+    thought->target_04 = guest;
+    thought->data_00 = ::operator new((wcslen(text) + 1) * sizeof(unsigned short), std::nothrow);
+    wcscpy(static_cast<unsigned short*>(thought->data_00), text);
+    WorldDequePushFront(thoughts, thought);
+}
