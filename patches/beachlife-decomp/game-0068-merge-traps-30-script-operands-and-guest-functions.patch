+        result.kind = 0xd1;
+    else if (!_stricmp(token, "GuestsDrowned"))
+        result.kind = 0xd7;
+    else if (!_stricmp(token, "GuestsEaten"))
+        result.kind = 0xd6;
+    else if (!_stricmp(token, "FinesCollected"))
+        result.kind = 0xd8;
+    else if (!_stricmp(token, "GuestShagCount"))
+        result.kind = 0xd9;
+    else if (!_stricmp(token, "GuestPissedCount"))
+        result.kind = 0xda;
+    else if (!_stricmp(token, "WeatherDayOffset"))
+        result.kind = 0xdb;
+    else if (!_stricmp(token, "IncomeToday"))
+        result.kind = 0xdc;
+    else if (!_stricmp(token, "GuestSafetyLevel"))
+        result.kind = 0xdd;
+    else if (!_stricmp(token, "BarsBuilt"))
+        result.kind = 0xde;
+    else if (!_stricmp(token, "DisasterDayOffset"))
+        result.kind = 0xdf;
+    else if (token[0] == '"')
+    {
+        char* text = static_cast<char*>(::operator new(std::strlen(token) - 1, std::nothrow));
+        token[std::strlen(token) - 1] = 0;
+        std::strcpy(text, token + 1);
+        result = { 0x36, reinterpret_cast<std::uintptr_t>(text) };
+    }
+    else
+    {
+        unsigned int prefix = 0;
+        if (!std::strncmp(token, "RandDWORD", 9))
+        {
+            result.kind = 0xe3;
+            prefix = 9;
+        }
+        else if (!std::strncmp(token, "Random", 6))
+        {
+            result.kind = 0xe4;
+            prefix = 6;
+        }
+        else if (!std::strncmp(token, "Flag", 4))
+        {
+            result.kind = 0xbc;
+            prefix = 4;
+        }
+        else if (!std::strncmp(token, "Var", 3))
+        {
+            result.kind = 0xc2;
+            prefix = 3;
+        }
+        else if (!std::strncmp(token, "ScenarioObj", 11))
+        {
+            result.kind = 0xc6;
+            prefix = 11;
+        }
+        if (prefix)
+        {
+            unsigned int* value = new (std::nothrow) unsigned int;
+            *value = std::atoi(token + prefix);
+            result.data = reinterpret_cast<std::uintptr_t>(value);
+            return result;
+        }
+
+        if (!std::strncmp(token, "BeerActive", 10))
+        {
+            result.kind = 0xd2;
+            prefix = 10;
+        }
+        else if (!std::strncmp(token, "DefaultBeer", 11))
+        {
+            result.kind = 0xd3;
+            prefix = 11;
+        }
+        else if (!std::strncmp(token, "BuildingCount", 13))
+        {
+            result.kind = 0xd4;
+            prefix = 13;
+        }
+        else if (!std::strncmp(token, "EventActive", 11))
+        {
+            result.kind = 0xd5;
+            prefix = 11;
+        }
+        if (prefix)
+        {
+            char* text = static_cast<char*>(::operator new(std::strlen(token) - prefix + 1, std::nothrow));
+            std::strcpy(text, token + prefix);
+            result.data = reinterpret_cast<std::uintptr_t>(text);
+            return result;
+        }
+
+        if (token[0] < '0' || token[0] > '9')
+            StartupFatal("Data in world script has not been defined and is not a number : %s", token);
+        float* value = new (std::nothrow) float;
+        *value = static_cast<float>(std::atof(token));
+        result = { 0xe8, reinterpret_cast<std::uintptr_t>(value) };
+    }
+    return result;
+}
