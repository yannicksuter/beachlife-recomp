@@ -0,0 +1,37 @@
+#ifndef STARTUP_WORLD_GUEST_ACTION_HELPERS_H
+#define STARTUP_WORLD_GUEST_ACTION_HELPERS_H
+
+#include "startup_world_motion_inlines.h"
+#include "startup_screen_mode_world.h"
+#include "startup_screen_position_inlines.h"
+#include "startup_screen_text.h"
+#include "window_activation.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+inline ScreenModeCommand MakeGuestCommand(unsigned int sender, unsigned int recipient,
+    unsigned int kind, unsigned int first = 0, unsigned int second = 0)
+{
+    ScreenModeCommand command;
+    command.words[0] = sender;
+    command.words[1] = recipient;
+    command.words[2] = kind;
+    command.words[3] = first;
+    command.words[4] = second;
+    return command;
+}
+
+inline void SendGuestWalk(unsigned int id, unsigned int kind, ScreenWorldPosition position)
+{
+    ScreenModeCommand command = MakeGuestCommand(id, id, kind, static_cast<int>(position.x), static_cast<int>(position.y));
+    screen_mode_commands->QueueCommand(&command);
+}
+
+inline unsigned int RandomGuestThought(const char* prefix)
+{
+    char key[256];
+    sprintf(key, "%s%d", prefix, rand() % 3 + 1);
+    return screen_text_lookup->LookupTextIndex(key);
+}
+
+#endif
diff --git a/src/startup_world_motion_inlines.h b/src/startup_world_motion_inlines.h
new file mode 100644
index 0000000..f28800f
--- /dev/null
+++ b/src/startup_world_motion_inlines.h
@@ -0,0 +1,54 @@
+#ifndef STARTUP_WORLD_MOTION_INLINES_H
+#define STARTUP_WORLD_MOTION_INLINES_H
+
+#include "startup_world_motion_helpers.h"
+#include "startup_screen_position_inlines.h"
+#include <string.h>
+
+inline float MotionFloat(unsigned int word)
+{
+    float value;
+    memcpy(&value, &word, sizeof(value));
+    return value;
+}
+
+inline unsigned int MotionWord(float value)
+{
+    unsigned int word;
+    memcpy(&word, &value, sizeof(word));
+    return word;
+}
+
+inline float MotionSquareRoot(float value)
+{
+    unsigned int word = MotionWord(value);
+    if (!word)
+        return 0.0f;
+    unsigned int exponent = (((word + 0xc0800000u) >> 1) + 0x3f800000u) & 0x7f800000u;
+    return MotionFloat(square_root_mantissas[(word >> 8) & 0xffff] | exponent);
+}
+
+inline float MotionReciprocal(float value)
+{
+    float estimate = MotionFloat(0x7f000000u - MotionWord(value));
+    return static_cast<float>((2.0L - static_cast<long double>(value) * estimate) * estimate);
+}
+
+inline ScreenWorldPosition MotionDestination(const WorldMovingEntity* entity)
+{
+    return ScreenWorldPosition(MotionFloat(entity->word_8c), MotionFloat(entity->word_90), MotionFloat(entity->word_94));
+}
+
+inline void StoreMotionDestination(WorldMovingEntity* entity, ScreenWorldPosition position)
+{
+    entity->word_8c = MotionWord(position.x);
+    entity->word_90 = MotionWord(position.y);
+    entity->word_94 = MotionWord(position.z);
+}
+
+inline void StoreMotionOpaqueWord(unsigned char* destination, unsigned int word)
+{
+    memcpy(destination, &word, sizeof(word));
+}
+
+#endif
