+
+inline ScreenMapPosition PerformerBuildingPoint(WorldBuildingEntity* owner, ScreenMapPosition offset)
+{
+    unsigned int rotation = owner->keyline_state_44->word_18;
+    unsigned int height = owner->BuildingDefinition()->footprint_y_1d8;
+    unsigned int width = owner->BuildingDefinition()->footprint_x_1d4;
+    ScreenPoint tile = owner->TilePosition();
+    return CurrentScreenTerrain()->BuildingOffset(tile.x, tile.y, width, height, offset, rotation);
+}
