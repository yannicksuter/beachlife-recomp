+
+float WorldSquareRoot(float value);                                       // 0x00430850.
+int WorldDirection(ScreenMapPosition direction, unsigned int directions); // 0x00430890.
+void ClearVehicleApproach(int x, int y, int direction);                   // 0x00497640.
+void RestoreVehicleApproach(int x, int y, int direction);                 // 0x00497740.
+void ClearVehicleReturn(int x, int y, int direction);                     // 0x00497840.
+void RestoreVehicleReturn(int x, int y, int direction);                   // 0x00497940.
+
+inline float VehicleSquareRoot(float squared)
+{
+    unsigned int bits = MotionWord(squared);
+    if (!bits)
+        return 0.0f;
+    unsigned int exponent = (((bits + 0xc0800000u) >> 1) + 0x3f800000u) & 0x7f800000u;
+    return MotionFloat(square_root_mantissas[(bits >> 8) & 0xffff] | exponent);
+}
+
+inline void SelectVehicleVariant(ScreenDialogResource* resource, int variant)
+{
+    resource->SelectVariant(variant);
+}
+
+inline ScreenWorldPosition VehicleRoutePosition(void* route)
+{
+    WorldRoutePosition* cursor = static_cast<WorldRoutePosition*>(route);
+    ScreenPoint point = cursor->data_00->points_0c[cursor->index_08];
+    return overlay_map->TilePosition(&point);
+}
+
+#endif
