+// FUNCTION: BEACHLIFE 0x004c41e0
+void ScreenListBoxPrefix::ClearEntries()
+{
+    ScreenListBoxEntry** entry = entries.begin;
+    while (entry != entries.end)
+    {
+        ScreenListBoxEntry* row = *entry;
+        if (row->item->kind_28 != 0)
+        {
+            delete row;
+            if (entry + 1 != entries.end)
+            {
+                CopyTrivial(entry + 1, entries.end, entry);
+            }
+            --entries.end;
+        }
+        else
+        {
+            row->flag_8 = 0;
+            ++entry;
+        }
+    }
+    word_68 = 0;
+    word_64 = 0;
+    word_88 = 0;
+    if (owned_item_8c != 0)
+    {
+        delete owned_item_8c;
+        owned_item_8c = 0;
+    }
+    MarkPrepared();
+}
