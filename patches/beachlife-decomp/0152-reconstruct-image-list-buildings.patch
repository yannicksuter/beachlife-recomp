+#include "startup_variable_state.h"
+#include "window_activation.h"
+
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0043cad0
+bool WindowDeactivationState::CanBuild(unsigned int index)
+{
+    unsigned int available = buildable_count_180;
+    if (available == 0)
+        return false;
+
+    // Original x86 inline index span; its owning array extent is not recovered.
+    const unsigned int* listed = reinterpret_cast<const unsigned int*>(
+        reinterpret_cast<const unsigned char*>(this) + 0x184);
+    unsigned int offset = 0;
+    while (*listed != index)
+    {
+        ++offset;
+        ++listed;
+        if (offset == available)
+            return false;
+    }
+
+    VariableBuilding* building = variable_catalog->Building(index);
+    if (building->unique_1ec == 1)
+    {
+        VariableWorldPrefix* world = world_10;
+        unsigned int remaining = world->buildings_04;
+        VariableEntity** position = world->buildings_12120;
+        while (remaining != 0)
+        {
+            if (strcmp((*position)->name_06, building->name_04) == 0)
+                return false;
+            ++position;
+            --remaining;
+        }
+    }
+
+    const char* required = building->required_320;
+    if (strcmp(required, "NONE") == 0)
+        return true;
+
+    VariableWorldPrefix* world = world_10;
+    unsigned int remaining = world->buildings_04;
+    VariableEntity** position = world->buildings_12120;
+    while (remaining != 0)
+    {
+        if (strcmp((*position)->name_06, required) == 0)
+            return true;
+        ++position;
+        --remaining;
+    }
+    return false;
+}
