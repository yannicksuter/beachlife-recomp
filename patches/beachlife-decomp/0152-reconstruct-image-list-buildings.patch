+#include "node_storage.h"
+#include "pool_allocate.h"
+#include "pool_return.h"
+#include "startup_screen_image_list.h"
+
+// FUNCTION: BEACHLIFE 0x004c3a30
+void ScreenImageListVector60::InsertOverflow(ScreenImageListFrame** position,
+    ScreenImageListFrame* const& value, const ScreenImageListTrueType& plain,
+    unsigned int count, bool at_end)
+{
+    unsigned int size = static_cast<unsigned int>(end - begin);
+    unsigned int length = size + MaxUnsigned(size, count);
+    ScreenImageListFrame** storage;
+    if (length != 0)
+    {
+        unsigned int bytes = length * sizeof(ScreenImageListFrame*);
+        storage = static_cast<ScreenImageListFrame**>(
+            bytes > 128 ? ::operator new(bytes) : AllocatePoolBytes(bytes));
+    }
+    else
+    {
+        storage = 0;
+    }
+
+    ScreenImageListFrame** next
+        = static_cast<ScreenImageListFrame**>(CopyTrivial(begin, position, storage));
+    for (unsigned int remaining = count; remaining != 0; --remaining)
+    {
+        // The reference is read on every iteration, including an aliased value.
+        ::new (next) ScreenImageListFrame*(value);
+        ++next;
+    }
+    if (!at_end)
+        next = static_cast<ScreenImageListFrame**>(CopyTrivial(position, end, next));
+
+    ScreenImageListFrame** old_begin = begin;
+    if (old_begin)
+    {
+        unsigned int bytes
+            = static_cast<unsigned int>(capacity.data - old_begin) * sizeof(ScreenImageListFrame*);
+        if (bytes > 128)
+            ::operator delete(old_begin);
+        else
+            ReturnPool(old_begin, bytes);
+    }
+
+    end = next;
+    begin = storage;
+    capacity.data = storage + length;
+}
