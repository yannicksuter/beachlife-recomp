+++ b/src/pool_allocate.cpp
@@ -0,0 +1,41 @@
+#include "pool_allocate.h"
+#include "pool_chunk_acquire.h"
+#include "pool_lock_acquire_inline.h"
+#include "pool_lock_guard.h"
+
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x00412240
+void* AllocatePoolBytes(unsigned int bytes)
+{
+    PoolChunkLink* volatile* bucket = pool_chunk_buckets + (bytes - 1) / 8;
+    AcquirePoolLockBody(&pool_lock_word);
+    PoolLockGuard guard;
+    PoolChunkLink* result = *bucket;
+    if (result != 0)
+    {
+        *bucket = result->next;
+        return result;
+    }
+
+    unsigned int block_size = (bytes + 7) & ~7u;
+    int count = 20;
+    unsigned char* chunk = reinterpret_cast<unsigned char*>(AcquirePoolChunk(block_size, count));
+    if (count != 1)
+    {
+        PoolChunkLink* next = ::new (chunk + block_size) PoolChunkLink;
+        pool_chunk_buckets[(block_size - 1) / 8] = next;
+        for (int index = 1;; ++index)
+        {
+            PoolChunkLink* current = next;
+            if (count - 1 == index)
+            {
+                current->next = 0;
+                break;
+            }
+            next = ::new (chunk + block_size * (index + 1)) PoolChunkLink;
+            current->next = next;
+        }
+    }
+    return chunk;
+}
