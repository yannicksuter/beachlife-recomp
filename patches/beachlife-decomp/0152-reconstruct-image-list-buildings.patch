+void ScreenImageList::PopulateBuildings(int kind, const char* thumbnail, const char* grey_thumbnail)
+{
+    unsigned int count = variable_catalog->building_count_0c;
+    for (unsigned int index = 0; index < count; ++index)
+    {
+        VariableBuilding* building = variable_catalog->Building(index);
+        if (building->list_kind_1c8 != kind)
+            continue;
+        char text[0x80];
+        sprintf(text, "BUILD_TIPTEXT_%s", building->name_04);
+        _strupr(text);
+        if (window_deactivation_state->IsBuildingGreyed(index))
+        {
+            ScreenImageListFrame* frame = new ScreenImageListFrame;
+            frame->thumbnail_00 = grey_thumbnail;
+            frame->preview_frame_04 = building->preview_frame_1c4;
+            frame->feature_0c = index;
+            frame->text_08 = new char[strlen(text) + 1];
+            strcpy(frame->text_08, text);
+            vector_60.PushBack(frame);
+        }
+        else if (window_deactivation_state->CanBuild(index))
+        {
+            ScreenImageListFrame* frame = new ScreenImageListFrame;
+            frame->thumbnail_00 = thumbnail;
+            frame->preview_frame_04 = building->preview_frame_1c4;
+            frame->feature_0c = index;
+            frame->text_08 = new char[strlen(text) + 1];
+            strcpy(frame->text_08, text);
+
+            // The count of this building: red when none, black when all are
+            // ready, orange otherwise.
+            frame->counted_94 = 1;
+            unsigned int ready = window_deactivation_state->CountReadyBuildings(index);
+            unsigned int total = window_deactivation_state->CountBuildings(index);
+            swprintf(frame->count_10, L"%d", total);
+            if (total)
+            {
+                if (ready != total)
+                    frame->colour_90 = 0xff8000;
+                else
+                    frame->colour_90 = 0;
+            }
+            else
+            {
+                frame->colour_90 = 0xffff0000;
+            }
+
+            // Library push_back, expanded here with its growth path.
+            ScreenImageListFrame** position = vector_60.end;
+            if (position != vector_60.capacity.data)
+            {
+                ::new (position) ScreenImageListFrame*(frame);
+                ++vector_60.end;
+            }
+            else
+            {
+                unsigned int length;
+                {
+                    unsigned int minimum = 1;
+                    unsigned int size = static_cast<unsigned int>(position - vector_60.begin);
+                    length = size + MaxUnsigned(size, minimum);
+                }
+                ScreenImageListFrame** storage;
+                if (length != 0)
+                {
+                    unsigned int bytes = length * sizeof(ScreenImageListFrame*);
+                    storage = static_cast<ScreenImageListFrame**>(bytes > 128 ? ::operator new(bytes) : AllocatePoolBytes(bytes));
+                }
+                else
+                {
+                    storage = 0;
+                }
+                ScreenImageListFrame** stored
+                    = static_cast<ScreenImageListFrame**>(CopyTrivial(vector_60.begin, position, storage));
+                *stored = frame;
+                position = stored + 1;
+                if (vector_60.begin)
+                    ReleaseRendererRectangleStorage(vector_60.begin,
+                        static_cast<unsigned int>(vector_60.capacity.data - vector_60.begin) * sizeof(ScreenImageListFrame*));
+                vector_60.begin = storage;
+                vector_60.end = position;
+                vector_60.capacity.data = storage + length;
+            }
+        }
+    }
+}
