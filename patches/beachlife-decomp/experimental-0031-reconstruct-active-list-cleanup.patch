diff --git a/src/startup_list_clear.cpp b/src/startup_list_clear.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_list_clear.cpp
@@ -0,0 +1,17 @@
+#include "startup_list.h"
+#include "pool_return.h"
+
+// FUNCTION: BEACHLIFE 0x004e81d0
+void CircularList::Clear()
+{
+    CircularListNode* node = head->next;
+    while (node != head)
+    {
+        CircularListNode* released = node;
+        node = node->next;
+        if (released != 0)
+            ReturnPool(released, sizeof(CircularListValueNode));
+    }
+    head->next = head;
+    head->previous = head;
+}
