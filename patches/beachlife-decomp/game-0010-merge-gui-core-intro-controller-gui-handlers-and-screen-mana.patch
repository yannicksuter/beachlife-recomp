@@ -0,0 +1,38 @@
+#include "startup_frame_clock.h"
+#include "startup_input_motion.h"
+#include "startup_input_state.h"
+#include "startup_intro.h"
+#include "startup_screen_manager.h"
+
+// GLOBAL: BEACHLIFE 0x004f4da8
+const float intro_duration = 5.0f;
+
+// FUNCTION: BEACHLIFE 0x004e8ba0
+int IntroController::Update()
+{
+    float delta = startup_frame_clock->delta_seconds;
+    if (delta > 0.1f)
+    {
+        delta = 0.1f;
+    }
+    elapsed += delta;
+    if (elapsed > intro_duration)
+    {
+        elapsed = 0.0f;
+        switch (stage)
+        {
+        case 0:
+            stage = 1;
+            screen_manager->RequestScreen("FrontScreen", 0, 0);
+            break;
+        case 1:
+            screen_request_game->controller_selection.SelectPendingController(1);
+            break;
+        }
+    }
+    if (startup_input_state->ReadFirstButtonTransition() == 1)
+    {
+        elapsed = intro_duration;
+    }
+    return 0;
+}
