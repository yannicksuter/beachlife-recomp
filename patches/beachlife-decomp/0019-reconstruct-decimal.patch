+        float factor = 1.0f;
+        ++index;
+        while (buffer[index] >= '0' && buffer[index] <= '9')
+        {
+            factor *= 0.1f;
+            result += (buffer[index] - '0') * factor;
+            ++index;
+        }
+    }
+    return result * sign;
+}
