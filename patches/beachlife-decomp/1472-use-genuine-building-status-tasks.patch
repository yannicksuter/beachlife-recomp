@@ -0,0 +1,20 @@
+#ifndef STARTUP_BUILDING_STATUS_LIST_H
+#define STARTUP_BUILDING_STATUS_LIST_H
+
+#include "startup_building_status.h"
+
+// Matching retention of the task list's out-of-line vendor members: insert
+// 0x00424540 and its node constructor 0x00424570.
+struct BuildingStatusListRetention : BuildingStatusList
+{
+    static void Insert(BuildingStatusListRetention* self, BuildingStatusEntry* const& entry);
+};
+
+// The task search as retail's /Ob1 methods make it: begin(), end() and the
+// search stay out of line and the found node is read from the result.
+inline std::_List_node_base* FindBuildingStatusNode(BuildingStatusList& tasks, unsigned int id)
+{
+    return FindListRecord(tasks.begin(), tasks.end(), ListRecordIdEquals<BuildingStatusEntry>(id))._M_node;
+}
+
+#endif
