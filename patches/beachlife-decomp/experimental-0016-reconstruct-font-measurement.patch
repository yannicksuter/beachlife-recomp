+#include "startup_screen_text.h"
+#include "startup_screen_font_data.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0049fbc0
+unsigned int ScreenFontRenderer::MeasureWrappedText(const unsigned short* text,
+    unsigned int width, unsigned int spacing)
+{
+    ScreenFontData* data = data_1c;
+    const unsigned short* cursor = text;
+    const unsigned short* line_start = text;
+    const unsigned short* word_start = text;
+    unsigned int line_characters = 0;
+    unsigned int word_characters = 0;
+    unsigned int line_width = spacing;
+    unsigned int maximum_width = 0;
+    unsigned short scratch[256];
+
+    while (*cursor != 0)
+    {
+        unsigned int current = *cursor;
+        unsigned short advance = static_cast<unsigned short>(
+            data->glyphs[current][2] - data->glyphs[current][0]);
+        unsigned int next = cursor[1];
+        if (next != 0)
+        {
+            advance = static_cast<unsigned short>(
+                advance + data->kerning[current * 255 + next]);
+        }
+        line_width += advance;
+
+        if (cursor != text && current != ' ' && cursor[-1] == ' ')
+        {
+            word_start = cursor;
+            word_characters = 0;
+        }
+        if (current != ' ')
+            ++word_characters;
+
+        if (line_width > width && line_characters > word_characters)
+        {
+            memset(scratch, 0, sizeof(scratch));
+            unsigned int copy_bytes = (line_characters - word_characters) * 2;
+            memcpy(scratch, line_start, copy_bytes);
+
+            const unsigned short* copied = scratch;
+            unsigned int copied_width = 0;
+            while (*copied != 0)
+            {
+                current = *copied;
+                advance = static_cast<unsigned short>(
+                    data->glyphs[current][2] - data->glyphs[current][0]);
+                next = copied[1];
+                if (next != 0)
+                {
+                    advance = static_cast<unsigned short>(
+                        advance + data->kerning[current * 255 + next]);
+                }
+                copied_width += advance;
+                ++copied;
+            }
+            if (copied_width > maximum_width)
+                maximum_width = copied_width;
+
+            cursor = word_start;
+            line_start = cursor;
+            line_characters = 0;
+            word_characters = 0;
+            line_width = spacing;
+        }
+        else
+        {
+            ++cursor;
+            ++line_characters;
+        }
+    }
+
+    unsigned int remaining_width = 0;
+    while (*line_start != 0)
+    {
+        unsigned int current = *line_start;
+        unsigned short advance = static_cast<unsigned short>(
+            data->glyphs[current][2] - data->glyphs[current][0]);
+        unsigned int next = line_start[1];
+        if (next != 0)
+        {
+            advance = static_cast<unsigned short>(
+                advance + data->kerning[current * 255 + next]);
+        }
+        remaining_width += advance;
+        ++line_start;
+    }
+    if (remaining_width > maximum_width)
+        return remaining_width;
+    return maximum_width;
+}
