+
+    while (*cursor != 0)
+    {
+        unsigned int current = *cursor;
+        unsigned short advance = static_cast<unsigned short>(
+            data->glyphs[current][2] - data->glyphs[current][0]);
+        unsigned int next = cursor[1];
+        if (next != 0)
+        {
+            advance = static_cast<unsigned short>(
+                advance + data->kerning[current * 255 + next]);
+        }
+        line_width += advance;
+
+        if (cursor != text && current != ' ' && cursor[-1] == ' ')
+        {
+            word_start = cursor;
+            word_characters = 0;
+        }
+        if (current != ' ')
+            ++word_characters;
+
+        if (line_width > width && line_characters > word_characters)
+        {
+            ++breaks;
+            cursor = word_start;
+            line_characters = 0;
+            word_characters = 0;
