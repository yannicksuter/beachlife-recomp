@@ -0,0 +1,15 @@
+#include "startup_screen_children.h"
+
+// FUNCTION: BEACHLIFE 0x004a55c0
+ScreenChildIterator ScreenChildRing::Insert(ScreenChildIterator position, ScreenItem* const& item)
+{
+    ScreenChildNode* node = CreateNode(item);
+    ScreenChildNode* previous = position.node->previous;
+    node->next = position.node;
+    node->previous = previous;
+    previous->next = node;
+    position.node->previous = node;
+    ScreenChildIterator result;
+    result.node = node;
+    return result;
+}
diff --git a/src/startup_screen_child_node.cpp b/src/startup_screen_child_node.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_screen_child_node.cpp
@@ -0,0 +1,59 @@
+#include "startup_screen_children.h"
+#include "pool_chunk_acquire.h"
+#include "pool_lock_acquire.h"
+#include "pool_lock_guard.h"
+#include "pool_return.h"
+
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004a55f0
+ScreenChildNode* ScreenChildRing::CreateNode(ScreenItem* const& item)
+{
+    const unsigned int block_size = screen_child_node_slot_bytes;
+    const unsigned int bucket_index = (block_size - 1u) / 8u;
+    PoolChunkLink* block;
+    {
+        AcquirePoolLock(&pool_lock_word);
+        PoolLockGuard guard;
+        block = pool_chunk_buckets[bucket_index];
+        if (block)
+        {
+            pool_chunk_buckets[bucket_index] = block->next;
+        }
+        else
+        {
+            int count = 20;
+            // Restore the actual storage-provider array type before arithmetic.
+            unsigned char* chunk = reinterpret_cast<unsigned char*>(AcquirePoolChunk(block_size, count));
+            block = reinterpret_cast<PoolChunkLink*>(chunk);
+            if (count != 1)
+            {
+                PoolChunkLink* next = ::new (chunk + block_size) PoolChunkLink;
+                pool_chunk_buckets[bucket_index] = next;
+                for (int index = 1;; ++index)
+                {
+                    PoolChunkLink* current = next;
+                    if (count - 1 == index)
+                    {
+                        current->next = 0;
+                        break;
+                    }
+                    next = ::new (chunk + block_size * (index + 1)) PoolChunkLink;
+                    current->next = next;
+                }
+            }
+        }
+    }
+    // Begin the complete node lifetime before constructing its pointer payload.
+    ScreenChildNode* result = ::new (static_cast<void*>(block)) ScreenChildNode;
+    try
+    {
+        new (&result->item) ScreenItem*(item);
+    }
+    catch (...)
+    {
+        ReturnPool(result, block_size);
+        throw;
+    }
+    return result;
+}
diff --git a/src/startup_screen_child_ring_clear.cpp b/src/startup_screen_child_ring_clear.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_screen_child_ring_clear.cpp
@@ -0,0 +1,19 @@
+#include "startup_screen_children.h"
+#include "pool_return.h"
+
+// Same borrowed-node clear operation inlined at 0x004a5810 and 0x004c7456.
+// The qualified pool-return source expresses its actual lock/free-list effect;
+// no original out-of-line Clear entry or byte-matching result is claimed.
+void ScreenChildRing::Clear()
+{
+    ScreenChildNode* node = head->next;
+    while (node != head)
+    {
+        ScreenChildNode* released = node;
+        node = node->next;
+        if (released != 0)
+            ReturnPool(released, sizeof(ScreenChildNode));
+    }
+    head->next = head;
+    head->previous = head;
+}
diff --git a/src/startup_screen_child_ring_constructor.cpp b/src/startup_screen_child_ring_constructor.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_screen_child_ring_constructor.cpp
@@ -0,0 +1,14 @@
+#include "startup_screen_children.h"
+#include <new>
+
+// Observed member construction in Dialog 0x004a5710 and Frame 0x004c7429.
+// No separate original entry address or original template name is claimed.
+ScreenChildRing::ScreenChildRing()
+    : head(0)
+{
+    void* storage = AllocatePoolBytes(sizeof(ScreenChildNode));
+    ScreenChildNode* sentinel = ::new (storage) ScreenChildNode;
+    sentinel->next = sentinel;
+    sentinel->previous = sentinel;
+    head = sentinel;
+}
