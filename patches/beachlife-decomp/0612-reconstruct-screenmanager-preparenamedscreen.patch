@@ -0,0 +1,20 @@
+#include "startup_screen_manager.h"
+#include "startup_screen_name_search.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x004b12b0
+void ScreenManager::PrepareNamedScreen(const char* name, unsigned char prepare)
+{
+    CircularListIterator found;
+    CircularListNode* selected = FindScreenByName(&found, active.Begin(), active.End(), name)->node;
+    if (selected != active.head)
+    {
+        CircularListValueNode* node = static_cast<CircularListValueNode*>(selected);
+        if (node->entry->state == 1)
+        {
+            if (prepare)
+                renderer->PrepareSurface(node->entry->surface);
+            node->entry->item->MarkPrepared();
+        }
+    }
+}
