+// FUNCTION: BEACHLIFE 0x004d2310
+WindowSoundIterator WindowSoundBank::FindSoundKey(const ScreenTextKey& key)
+{
+    WindowSoundIterator end = EndSound();
+    const char* cursor = key.text;
+    unsigned int hash = 0;
+    while (*cursor != 0)
+    {
+        hash = hash * 5 + static_cast<signed char>(*cursor);
+        ++cursor;
+    }
+
+    int first = static_cast<int>(hash % static_cast<unsigned int>(bucket_count));
+    int index = first;
+    do
+    {
+        if (buckets[index].unavailable == 0
+            && _stricmp(buckets[index].key, key.text) == 0)
+        {
+            WindowSoundIterator found = { buckets + index, this };
+            return found;
+        }
+        ++index;
+        if (index >= bucket_count)
+            index = 0;
+    } while (index != first);
+    return end;
+}
