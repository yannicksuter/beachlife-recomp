+#include "window_sound_bank.h"
+#include "sound_name_hash.h"
+
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004d2140
+void WindowSoundBank::LoadIndex(const char* header_path, const char* bank_path)
+{
+    stream_18 = fopen(bank_path, "rb");
+    FILE* header = fopen(header_path, "rb");
+    int offset;
+    unsigned int bytes;
+    while (fread(&offset, 1, 4, header) == 4)
+    {
+        WindowSoundRecord* record = new WindowSoundRecord;
+        if (record != 0)
+        {
+            record->bytes_20 = 0;
+            record->offset_24 = 0;
+            record->cached_28 = 0;
+            record->references_30 = 0;
+        }
+
+        record->offset_24 = offset;
+        fread(&bytes, 1, 4, header);
+        record->bytes_20 = bytes;
+        fread(record->name, 1, 32, header);
+
+        ScreenTextKey key(record->name);
+        unsigned int hash = SoundNameHash(key.text);
+        int count = bucket_count;
+        int first = static_cast<int>(hash % static_cast<unsigned int>(count));
+        WindowSoundBucket* table = buckets;
+        int index = first;
+        bool available = table[index].unavailable != 0;
+        while (!available)
+        {
+            ++index;
+            if (index >= count)
+                index = 0;
+            if (index == first)
+                break;
+            available = table[index].unavailable != 0;
+        }
+
+        if (available)
+        {
+            table[index].key = key.text;
+            buckets[index].value = record;
+            buckets[index].unavailable = 0;
+            ++word_14;
+        }
+    }
+    fclose(header);
+}
