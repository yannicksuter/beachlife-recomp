+                if (cached != 0)
+                    ::operator delete(cached);
+                ::operator delete(record);
+            }
+
+            do
+            {
+                ++current.bucket;
+                if (current.bucket == current.lookup->EndSound().bucket)
+                    break;
+            } while (current.bucket->unavailable != 0);
+        }
+
+        int count = end_index;
+        WindowSoundBucket* entry = buckets;
+        while (count > 0)
+        {
+            entry->unavailable = 1;
+            ++entry;
+            --count;
+        }
+        FILE* stream = stream_18;
+        word_14 = 0;
+        fclose(stream);
+    }
+    catch (...)
+    {
+        ReleaseIndexStorage();
+        throw;
+    }
