+bool ScreenFrameItem::TestRectangle(int x, int y)
+{
+    bool hit = ScreenItem::TestRectangle(x, y);
+    if (!hit)
+    {
+        ScreenChildNode* node = children.head->next;
+        while (node != children.head && !hit)
+        {
+            hit = node->item->TestRectangle(x, y);
+            node = node->next;
+        }
+    }
+    return hit;
+}
