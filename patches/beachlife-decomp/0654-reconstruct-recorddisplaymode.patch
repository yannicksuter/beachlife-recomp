+#include "startup_renderer_display.h"
+
+// FUNCTION: BEACHLIFE 0x00411ad0
+SurfaceResult SURFACE_STDCALL RecordDisplayMode(SurfaceDescription* description, void* context)
+{
+    switch (description->width)
+    {
+    case 640:
+        if (description->height == 480)
+            static_cast<unsigned char*>(context)[0] = 1;
+        break;
+    case 800:
+        if (description->height == 600)
+            static_cast<unsigned char*>(context)[1] = 1;
+        break;
+    case 1024:
+        if (description->height == 768)
+            static_cast<unsigned char*>(context)[2] = 1;
+        break;
+    case 1280:
+        if (description->height == 960)
+            static_cast<unsigned char*>(context)[3] = 1;
+        break;
+    }
+    return 1;
+}
