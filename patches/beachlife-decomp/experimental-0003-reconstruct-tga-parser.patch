@@ -0,0 +1,42 @@
+#include "tga_image.h"
+
+#include <cstdint>
+#include <string.h>
+
+// Descriptive class name; the original symbol and declaration are unknown.
+// FUNCTION: BEACHLIFE 0x004ea200
+TgaImage::TgaImage(int image_width, int image_height, int image_depth, unsigned char has_palette)
+{
+    pixels = 0;
+    palette = 0;
+    width = image_width;
+    height = image_height;
+    bytes_per_pixel = image_depth / 8;
+    bits_per_pixel = image_depth;
+    converted_palette = 0;
+    pixels = new unsigned char[bytes_per_pixel * width * height];
+    std::uint32_t pixel_bytes = bytes_per_pixel;
+    pixel_bytes *= height;
+    pixel_bytes *= width;
+    memset(pixels, 0, pixel_bytes);
+    if (has_palette)
+    {
+        palette = new unsigned char[768];
+        memset(palette, 0, 768);
+    }
+    switch (image_depth)
+    {
+    case 1:
+        unknown_1c[0] = 2;
+        unknown_1c[1] = 0;
+        unknown_1c[2] = 0;
+        unknown_1c[3] = 0;
+        break;
+    case 8:
+        unknown_1c[0] = 0;
+        unknown_1c[1] = 0;
+        unknown_1c[2] = 0;
+        unknown_1c[3] = 0;
+        break;
+    }
+}
diff --git a/src/tga_buffer_parser.cpp b/src/tga_buffer_parser.cpp
