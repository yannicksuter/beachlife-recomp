index 0000000000000000000000000000000000000000..1a8c52cd8e4abb5e7e6607d498b2bda5773ce566
--- /dev/null
+++ b/src/startup_screen_text_find.cpp
@@ -0,0 +1,36 @@
+#include "startup_screen_text.h"
+#include <string.h>
+#if !defined(_WIN32)
+#include <strings.h>
+// Native CRT spelling only; no replacement comparator.
+#define _stricmp strcasecmp
+#endif
+
+// FUNCTION: BEACHLIFE 0x004d2310
+ScreenTextIterator ScreenTextLookup::FindText(const ScreenTextKey& key)
+{
+    ScreenTextIterator end = EndText();
+    const char* cursor = key.text;
+    unsigned int hash = 0;
+    while (*cursor != 0)
+    {
+        hash = hash * 5 + static_cast<signed char>(*cursor);
+        ++cursor;
+    }
+
+    int first = static_cast<int>(hash % static_cast<unsigned int>(bucket_count));
+    int index = first;
+    do
+    {
+        if (buckets[index].unavailable == 0
+            && _stricmp(buckets[index].key, key.text) == 0)
+        {
+            ScreenTextIterator found = { buckets + index, this };
+            return found;
+        }
+        ++index;
+        if (index >= bucket_count)
+            index = 0;
+    } while (index != first);
+    return end;
+}
