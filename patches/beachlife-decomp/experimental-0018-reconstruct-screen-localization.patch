@@ -0,0 +1,14 @@
+#include "startup_screen_text.h"
+
+// FUNCTION: BEACHLIFE 0x0049f370
+const unsigned short* ScreenTextLookup::LookupText(const char* key)
+{
+    ScreenTextIterator found = { 0, 0 };
+    if (key != 0)
+    {
+        found = FindText(ScreenTextKey(key));
+        if (found.bucket != EndText().bucket)
+            return found.bucket->value->text;
+    }
+    return screen_text_empty;
+}
