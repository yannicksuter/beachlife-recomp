diff --git a/src/startup_input_initialize.cpp b/src/startup_input_initialize.cpp
new file mode 100644
index 0000000..9d61975
--- /dev/null
+++ b/src/startup_input_initialize.cpp
@@ -0,0 +1,23 @@
+#include <windows.h>
+#include "startup_direct_input8.h"
+#include "startup_input_state.h"
+
+// FUNCTION: BEACHLIFE 0x004eaa50
+bool InputState::Initialize(void* instance, void* window)
+{
+    window_handle = window;
+    resource_instance = instance;
+    if (FAILED(DirectInput8Create(static_cast<HINSTANCE>(instance),
+            DIRECTINPUT8_VERSION,
+            IID_IDirectInput8A,
+            reinterpret_cast<void**>(&direct_input),
+            0)))
+    {
+        return false;
+    }
+    if (!CreateKeyboard(window))
+    {
+        return false;
+    }
+    return CreateMouse(window) ? true : false;
+}
