+
+static int BuildingBeerFeature(VariableBuilding* building)
+{
+    for (unsigned int i = 0; i < building->rows_1f4; ++i)
+        if (_stricmp("Beer", variable_catalog->FeatureName(building->features_1fc[i])) == 0)
+            return i;
+    return -1;
+}
+
+// FUNCTION: BEACHLIFE 0x0045e930
+void WorldBuildingEntity::WriteValue(const char* key, const void* value)
+{
+    if (strcmp(key, "BUILDING_REPAIRINTERVAL") == 0)
+    {
+        word_334 = *static_cast<const unsigned int*>(value);
+        if (!word_334)
+            word_334 = 1;
+        word_338 = word_334;
+    }
+    else if (strncmp(key, "COMMOD_PRICE_", 13) == 0)
+        feature_values_1d0[atoi(key + 13)] = *static_cast<const unsigned int*>(value);
+    else if (strcmp(key, "BEER_STRENGTH") == 0)
+    {
+        drink_value_20c = *static_cast<const float*>(value);
+        int feature = BuildingBeerFeature(building_60);
+        VariableCatalogUnlock* drink = variable_catalog->UnlockRecord(drink_type_210);
+        long double base = drink->base_value_c4;
+        feature_prices_1f8[feature] = base;
+        feature_prices_1f8[feature] = static_cast<float>(static_cast<long double>(drink->multiplier_c8) * drink_value_20c + base);
+    }
+    else if (strcmp(key, "BUILDING_BEERPRICE") == 0)
+        feature_values_1d0[BuildingBeerFeature(building_60)] = *static_cast<const unsigned int*>(value);
+    else if (strcmp(key, "BI_BUILDING_OPEN") == 0)
+    {
+        if (*static_cast<const int*>(value))
+        {
+            building_state_19c = 1;
+            building_queue_16c->Clear();
+            ScreenModeCommand command;
+            command.words[0] = id_28;
+            closed_365 = 1;
+            command.words[1] = -1;
+            command.words[2] = 0x2d;
+            command.words[3] = 0;
+            command.words[4] = 0;
+            window_deactivation_state->BroadcastCommand(&command);
+            CloseBuildingContents();
+        }
+        else
+        {
+            building_state_19c = 0;
+            closed_365 = 0;
+            OpenBuildingContents();
+        }
+    }
+    else if (strncmp(key, "EVENT0_PRICE", 12) == 0)
+    {
+        if (!events_170->IsInProgress(0))
+            events_170->SetPrice(0, *static_cast<const float*>(value));
+    }
+    else if (strncmp(key, "EVENT1_PRICE", 12) == 0)
+    {
+        if (!events_170->IsInProgress(1))
+            events_170->SetPrice(1, *static_cast<const float*>(value));
+    }
+    else if (strncmp(key, "EVENT2_PRICE", 12) == 0)
+    {
+        if (!events_170->IsInProgress(2))
+            events_170->SetPrice(2, *static_cast<const float*>(value));
+    }
+    else if (strcmp(key, "STAFF_BEACH_OPEN") == 0)
+        SetBeachOpen(*static_cast<const int*>(value) ? 0 : 1);
+    else
+        StartupFatal("BuildingObject::SetVariable - keyword not recognised - %s", key);
+}
