@@ -0,0 +1,146 @@
+#include <windows.h>
+#include "startup_application.h"
+#include <stdio.h>
+
+// FUNCTION: BEACHLIFE 0x004a07e0
+int WINAPI WinMain(HINSTANCE instance, HINSTANCE previous, LPSTR command, int show)
+{
+    bool first_instance = true;
+    HANDLE mutex = CreateMutexA(0, FALSE, mutex_name);
+    if (mutex)
+    {
+        if (GetLastError() == ERROR_ALREADY_EXISTS)
+        {
+            first_instance = false;
+        }
+    }
+    else
+    {
+        first_instance = false;
+    }
+
+    int capabilities;
+    // The retail entrypoint contains this inline CPUID feature probe.
+    __asm {
+        pushfd
+        pop eax
+        mov ebx, eax
+        xor eax, 200000h
+        push eax
+        popfd
+        pushfd
+        pop eax
+        xor eax, ebx
+        and eax, 200000h
+        jz cpu_done
+        xor eax, eax
+        cpuid
+        test eax, eax
+        jz cpu_done
+        mov eax, 1
+        cpuid
+        and eax, 0f00h
+        and edx, 0fffff0ffh
+        or eax, edx
+    cpu_done:
+        mov capabilities, eax
+    }
+
+    bool mmx;
+    if (capabilities & 0x800000)
+    {
+        mmx = true;
+    }
+    else
+    {
+        mmx = false;
+        StartupFatal("Your processor does not have the MMX capability this application requires");
+    }
+
+    if (first_instance && mmx)
+    {
+        StartupConfig* config = new StartupConfig("data/script/gameparameters.pis");
+        windowed = false;
+
+        WNDCLASSEXA window_class;
+        window_class.cbSize = sizeof(window_class);
+        window_class.lpszClassName = window_name;
+        window_class.lpfnWndProc = GameWindowProc;
+        window_class.style = CS_HREDRAW | CS_VREDRAW;
+        window_class.hInstance = instance;
+        window_class.hIcon = LoadIconA(instance, MAKEINTRESOURCEA(104));
+        window_class.hIconSm = LoadIconA(instance, MAKEINTRESOURCEA(104));
+        window_class.hCursor = 0;
+        window_class.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
+        window_class.lpszMenuName = 0;
+        window_class.cbClsExtra = 0;
+        window_class.cbWndExtra = 0;
+        if (!RegisterClassExA(&window_class))
+        {
+            StartupFatal("WinMain - error registering the window class");
+        }
+
+        int border_x = GetSystemMetrics(SM_CXSIZEFRAME);
+        int border_y = GetSystemMetrics(SM_CYSIZEFRAME);
+        int height = 600 + 2 * border_y + GetSystemMetrics(SM_CYCAPTION);
+        char title[256];
+        sprintf(title, "%s", window_name);
+        HWND window;
+        if (windowed)
+        {
+            window = CreateWindowExA(0,
+                window_name,
+                title,
+                0,
+                CW_USEDEFAULT,
+                CW_USEDEFAULT,
+                800 + 2 * border_x,
+                height,
+                0,
+                0,
+                instance,
+                0);
+        }
+        else
+        {
+            window = CreateWindowExA(
+                WS_EX_TOPMOST, window_name, title, WS_POPUP, 0, 0, 800, 600, 0, 0, instance, 0);
+        }
+        if (!window)
+        {
+            StartupFatal("WinMain - error creating window");
+        }
+        ShowWindow(window, show);
+        UpdateWindow(window);
+        CoInitialize(0);
+
+        ScreenRequestGamePrefix* game = new ScreenRequestGamePrefix(instance, window);
+        MSG message;
+        ZeroMemory(&message, sizeof(message));
+        while (message.message != WM_QUIT)
+        {
+            if (PeekMessageA(&message, 0, 0, 0, PM_REMOVE))
+            {
+                TranslateMessage(&message);
+                DispatchMessageA(&message);
+            }
+            profiler->Reset();
+            profiler->Start();
+            game->Update();
+            profiler->Stop();
+            startup_frame_clock->value_24 = static_cast<int>(profiler->elapsed) / 1000;
+            profiler->Start();
+            game->Render();
+            profiler->Stop();
+            startup_frame_clock->value_20 = static_cast<int>(profiler->elapsed) / 1000;
+        }
+
+        delete game;
+        delete config;
+        CoUninitialize();
+        UnregisterClassA("app", window_class.hInstance);
+        ReleaseMutex(mutex);
+        CloseHandle(mutex);
+    }
+    return 0;
+}
