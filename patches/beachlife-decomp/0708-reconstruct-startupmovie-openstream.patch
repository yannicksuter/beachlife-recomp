new file mode 100644
index 0000000..2f6588a
--- /dev/null
+++ b/src/startup_movie_stream.cpp
@@ -0,0 +1,21 @@
+#include <windows.h>
+#include <ddraw.h>
+#include "startup_movie_stream_abi.h"
+
+#include "startup_direct_draw4.h"
+#include "startup_movie.h"
+
+// FUNCTION: BEACHLIFE 0x004ed390
+void StartupMovie::OpenStream(const char* path)
+{
+    IAMMultiMediaStream* opened;
+    CoCreateInstance(CLSID_AMMultiMediaStream, 0, CLSCTX_INPROC_SERVER, IID_IAMMultiMediaStream, reinterpret_cast<void**>(&opened));
+    WCHAR wide_path[260];
+    MultiByteToWideChar(CP_ACP, 0, path, -1, wide_path, 260);
+    opened->Initialize(STREAMTYPE_READ, AMMSF_NOGRAPHTHREAD, 0);
+    opened->AddMediaStream(direct_draw, &MSPID_PrimaryVideo, 0, 0);
+    opened->AddMediaStream(0, &MSPID_PrimaryAudio, AMMSF_ADDDEFAULTRENDERER, 0);
+    if (opened->OpenFile(wide_path, 0) != S_OK)
+        ready = 0;
+    stream_2c = opened;
+}
diff --git a/src/startup_movie_stream_abi.h b/src/startup_movie_stream_abi.h
new file mode 100644
index 0000000..1b6f8f7
--- /dev/null
+++ b/src/startup_movie_stream_abi.h
@@ -0,0 +1,46 @@
+#ifndef STARTUP_MOVIE_STREAM_ABI_H
+#define STARTUP_MOVIE_STREAM_ABI_H
+#include <windows.h>
+#include <unknwn.h>
+struct IMediaStream;
+struct IGraphBuilder;
+struct IMediaStreamFilter;
+enum STREAM_TYPE
+{
+    STREAMTYPE_READ,
+    STREAMTYPE_WRITE,
+    STREAMTYPE_TRANSFORM
+};
+enum STREAM_STATE
+{
+    STREAMSTATE_STOP,
+    STREAMSTATE_RUN
+};
+// DirectShow multimedia-stream interface prefix through OpenFile, in SDK order.
+struct IAMMultiMediaStream : IUnknown
+{
+    STDMETHOD(GetInformation)(DWORD*, STREAM_TYPE*) PURE;
+    STDMETHOD(GetMediaStream)(const GUID&, IMediaStream**) PURE;
+    STDMETHOD(EnumMediaStreams)(LONG, IMediaStream**) PURE;
+    STDMETHOD(GetState)(STREAM_STATE*) PURE;
+    STDMETHOD(SetState)(STREAM_STATE) PURE;
+    STDMETHOD(GetTime)(__int64*) PURE;
+    STDMETHOD(GetDuration)(__int64*) PURE;
+    STDMETHOD(Seek)(__int64) PURE;
+    STDMETHOD(GetEndOfStreamEventHandle)(HANDLE*) PURE;
+    STDMETHOD(Initialize)(STREAM_TYPE, DWORD, IGraphBuilder*) PURE;
+    STDMETHOD(GetFilterGraph)(IGraphBuilder**) PURE;
+    STDMETHOD(GetFilter)(IMediaStreamFilter**) PURE;
+    STDMETHOD(AddMediaStream)(IUnknown*, const GUID*, DWORD, IMediaStream**) PURE;
+    STDMETHOD(OpenFile)(LPCWSTR, DWORD) PURE;
+};
+enum
+{
+    AMMSF_NOGRAPHTHREAD = 1,
+    AMMSF_ADDDEFAULTRENDERER = 1
+};
+extern "C" const GUID CLSID_AMMultiMediaStream;
+extern "C" const GUID IID_IAMMultiMediaStream;
+extern "C" const GUID MSPID_PrimaryVideo;
+extern "C" const GUID MSPID_PrimaryAudio;
+#endif
