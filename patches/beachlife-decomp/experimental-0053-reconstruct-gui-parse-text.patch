+
+// FUNCTION: BEACHLIFE 0x004abeb0
+void GuiParserState::ParseText()
+{
+    const char* data = buffer;
+    if (data[cursor] != '(')
+    {
+        StartupFatal("GUIManager::process_text - Script Error \r\nNo open bracket found at file offset - %u", cursor);
+        return;
+    }
+    ++cursor;
+    while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+
+    ScreenRectangle rectangle;
+    ReadRectangle(rectangle, current_context);
+    char text[64];
+    ReadText(text);
+    int font;
+    ReadInteger(font, true);
+    int value_50;
+    ReadInteger(value_50, true);
+    int value_54;
+    ReadInteger(value_54, true);
+    ScreenTextItem* item = new ScreenTextItem(rectangle, text, font, value_50, value_54);
+    RegisterItem(item, 0);
+}
