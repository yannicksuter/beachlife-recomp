+        description.width = static_cast<unsigned int>(actual.width);
+        description.height = static_cast<unsigned int>(actual.height);
+        RecordDisplayMode(&description, display_mode_flags_48);
+    }
+
+    device = native_display;
+    device->use_windowed_mode();
+    device->resize_client(static_cast<int>(requested_width), static_cast<int>(requested_height));
+    device->clear_topmost();
+
+    const auto work_area = device->work_area();
+    auto rectangle = device->outer_rectangle();
+    if (rectangle.left < work_area.left)
+        rectangle.left = work_area.left;
+    if (rectangle.top < work_area.top)
