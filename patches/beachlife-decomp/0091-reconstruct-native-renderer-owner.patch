+unsigned char ScreenRequestRenderer::InitializeDisplay(beachlife::platform::Video& window,
+    unsigned char mode, unsigned int requested_width, unsigned int requested_height,
+    unsigned int bits)
+{
+    // No forced software mode and no fabricated COM device. Reject the native
+    // capability boundary before allocation, member publication or SDL mutation.
+    if (mode == 0 || software_mode == 0)
+    {
+        throw std::runtime_error("Native hardware renderer display initialization is unsupported");
+    }
+    const unsigned int maximum = static_cast<unsigned int>(std::numeric_limits<int>::max());
+    if (requested_width == 0 || requested_height == 0 || requested_width > maximum / 2
+        || requested_height > maximum / requested_width || window_34 == 0)
+    {
+        throw std::invalid_argument("Native software renderer dimensions or stored window are invalid");
+    }
