+    ::operator delete(pixels_1c);
+
+    ScreenSurfacePosition** surface_slot = surface_storage.data();
+    ScreenSurfacePosition** surface_end = surface_storage.empty()
+                                            ? surface_slot
+                                            : surface_slot + surface_storage.size();
+    while (surface_slot != surface_end)
+    {
+        ScreenSurfacePosition* entry = *surface_slot;
+        if (entry)
+        {
+            entry->Cleanup();
+            entry->~ScreenSurfacePosition();
+            ::operator delete(entry);
+        }
+        ++surface_slot;
+    }
+    surface_storage.clear();
