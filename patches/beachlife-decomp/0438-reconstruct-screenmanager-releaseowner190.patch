+#ifndef STARTUP_POINTER_LIST_OPERATIONS_H
+#define STARTUP_POINTER_LIST_OPERATIONS_H
+
+#include "pool_return.h"
+
+// Folded holder constructor at 0x00437de0; both allocator proxies and list
+// heads store only their incoming pointer.
+template <class T>
+void InitializePointerHolder(T*& destination, T* value)
+{
+    destination = value;
+}
+
+// Shared typed forms of the retail folded list traversal and erasure bodies.
+template <class Node, class Iterator, class Callback, class Value>
+Callback VisitPointerList(Iterator first, Iterator last, Callback callback, Value Node::* payload)
+{
+    while (first.node != last.node)
+    {
+        callback(static_cast<Node*>(first.node)->*payload);
+        first.node = first.node->next;
+    }
+    return callback;
+}
+
+template <class Node, class Iterator>
+Iterator ErasePointerListNode(Iterator position)
+{
+    Node* node = position.node;
+    Node* previous = node->previous;
+    Node* next = node->next;
+    previous->next = next;
+    next->previous = previous;
+    if (node)
+        ReturnPool(node, sizeof(Node));
+    Iterator result;
+    result.node = next;
+    return result;
+}
+
+template <class Iterator, class Node>
+Iterator PointerListEnd(Node* head)
+{
+    Iterator result;
+    result.node = head;
+    return result;
+}
+
+#endif
