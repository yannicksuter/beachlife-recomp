+#ifndef STARTUP_SCREEN_VARIABLE_FILTER_H
+#define STARTUP_SCREEN_VARIABLE_FILTER_H
+
+#include "startup_screen_item.h"
+
+struct ScreenBar;
+
+// Genuine 0x2c-byte filter object created for a FILTER_ table column. It is not
+// a ScreenItem (no table). Descriptive names only.
+struct ScreenVariableFilter
+{
+    // Owned bar: 0x004c20f0 deletes it (virtual destructor) when the selected
+    // key changes and creates a new 0x80-byte ScreenBar (0x004c1340) for
+    // kind-0 entries of the filter table 0x00581188.
+    ScreenBar* bar_00;
+    ScreenRectangle bounds_04;
+    ScreenRectangle initial_14;
+    int kind_24;             // Kind of the selected entry: 0 bar, 1 text, 2 none.
+    const char* variable_28; // Variable named by a kind-1 entry.
+
+    // Actual 0x004c2090, RET 0x10: stores the bounds twice, clears the bar and
+    // the shared selected key.
+    explicit ScreenVariableFilter(ScreenRectangle bounds);
+    // Actual 0x004c20e0, 13 bytes: deletes the owned bar. The physical body is
+    // shared with ScreenListBoxEntry's destructor (identical code, one copy).
+    ~ScreenVariableFilter();
+
+    // Actual 0x004c20f0, RET4: selects the filter table entry for a new key,
+    // replacing the bar.
+    void SelectKey(int key);
+    // Actual 0x004c2360, RET8: moves the filter; body separate.
+    void ApplyPosition(int dx, int dy);
+    // Actual 0x004c2330, RET8: moves the filter rectangle; body separate.
+    void MoveRectangle(int dx, int dy);
+};
+
+// Observed 0x18-byte filter table entry. Descriptive names.
+struct VariableFilterEntry
+{
+    int key;
+    int kind;             // 0 bar, 1 text, 2 none.
+    const char* variable; // Variable name shown.
+    float minimum;        // Bar range.
+    float maximum;
+    int style; // Bar style.
+};
+
+// The 28 filter entries, 0x00581188 (the selection loop's bound).
+extern VariableFilterEntry variable_filter_entries[28];
+
+// Key last selected by any filter (0x004c20f0 compares and stores it); every
+// filter constructor clears it. Descriptive name.
+extern int variable_filter_key; // 0x005baedc.
+
+#endif
