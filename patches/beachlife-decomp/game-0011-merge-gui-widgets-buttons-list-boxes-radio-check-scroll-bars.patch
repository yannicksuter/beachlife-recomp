diff --git a/src/startup_screen_scroll_bar_timed.cpp b/src/startup_screen_scroll_bar_timed.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..31b9f0fb3ccf44435bafcde977fee217274b1222
--- /dev/null
+++ b/src/startup_screen_scroll_bar_timed.cpp
@@ -0,0 +1,110 @@
+#include "startup_input_motion.h"
+#include "startup_input_state.h"
+#include "startup_screen_button.h"
+#include "startup_screen_frame_item.h"
+#include "startup_screen_scroll_bar.h"
+
+// FUNCTION: BEACHLIFE 0x004b5400
+bool ScreenScrollBarPrefix::HandleTimedCoordinates(int x, int y, int value)
+{
+    state_40 = TestRectangle(x, y);
+    if (value != 2)
+    {
+        state_54 = 0;
+    }
+    bool handled = up_58->HandleTimedCoordinates(x, y, value);
+    if (!handled)
+    {
+        handled = down_5c->HandleTimedCoordinates(x, y, value);
+        if (!handled)
+        {
+            thumb_60->HandleTimedCoordinates(x, y, value);
+            if (thumb_60->ReadState41())
+            {
+                state_54 = 1;
+            }
+            else if (thumb_60->ReadState42())
+            {
+                thumb_60->state_42 = 0;
+                handled = true;
+            }
+        }
+    }
+    if (up_58->ReadState41() || down_5c->ReadState41())
+    {
+        handled = true;
+    }
+    if (up_58->ReadState40() || down_5c->ReadState40())
+    {
+        handled = true;
+    }
+
+    if (!state_54 && !handled && !thumb_60->TestRectangle(x, y))
+    {
+        track_64->HandleTimedCoordinates(x, y, value);
+        if (track_64->ReadState42() || track_64->ReadState41())
+        {
+            track_64->state_42 = 0;
+            handled = true;
+            if (y > thumb_60->GetRectangle().top)
+            {
+                for (unsigned int step = 0; step < visible_50 - 1; ++step)
+                {
+                    if (position_48 < count_4c - visible_50)
+                    {
+                        ++position_48;
+                        int thumb_left = thumb_60->GetRectangle().left;
+                        float offset = position_48 * ((track_length_68 - offset_70) / count_4c);
+                        if (offset < 0.0f)
+                        {
+                            offset = 0.0f;
+                        }
+                        thumb_60->SetRectanglePosition(
+                            thumb_left, static_cast<int>(rectangle.top + arrow_height_6c + offset));
+                    }
+                }
+            }
+            else
+            {
+                for (unsigned int step = 0; step < visible_50 - 1; ++step)
+                {
+                    if (position_48 > 0)
+                    {
+                        --position_48;
+                        int thumb_left = thumb_60->GetRectangle().left;
+                        float offset = position_48 * ((track_length_68 - offset_70) / count_4c);
+                        if (offset < 0.0f)
+                        {
+                            offset = 0.0f;
+                        }
+                        thumb_60->SetRectanglePosition(
+                            thumb_left, static_cast<int>(rectangle.top + arrow_height_6c + offset));
+                    }
+                }
+            }
+        }
+    }
+
+    if (state_54)
+    {
+        int dy = startup_input_state->ReadDeltaY();
+        if (thumb_60->GetRectangle().bottom + dy > down_5c->GetRectangle().top)
+        {
+            dy = down_5c->GetRectangle().top - thumb_60->GetRectangle().bottom;
+        }
+        else if (thumb_60->GetRectangle().top + dy < up_58->GetRectangle().bottom)
+        {
+            dy = up_58->GetRectangle().bottom - thumb_60->GetRectangle().top;
+        }
+        thumb_60->MoveRectangle(0, dy);
+        float pixel = thumb_60->GetRectangle().top - up_58->GetRectangle().bottom;
+        position_48 = static_cast<unsigned int>(
+            pixel / (track_length_68 - thumb_size_74) * (count_4c - visible_50));
+        handled = true;
+    }
+    if (ReadState40() && value == 2)
+    {
+        return true;
+    }
+    return handled;
+}
