+++ b/src/copy_trivial.h
@@ -0,0 +1,19 @@
+#ifndef COPY_TRIVIAL_H
+#define COPY_TRIVIAL_H
+
+#include <string.h>
+
+// Library inline trivial range copy: memmove of the byte span, returning the
+// destination end; equal bounds return the destination unchanged. Expanded
+// inline in some callers; 57 direct calls reach the out-of-line instance.
+// LIBRARY: BEACHLIFE 0x004450b0
+inline void* CopyTrivial(const void* first, const void* last, void* result)
+{
+    return last == first ? result
+                         : static_cast<char*>(memmove(result,
+                               first,
+                               static_cast<const char*>(last) - static_cast<const char*>(first)))
+                               + (static_cast<const char*>(last) - static_cast<const char*>(first));
+}
+
+#endif
