-template <class Node, class Iterator>
-Iterator ErasePointerListNode(Iterator position)
-{
     Iterator result;
-    result.node = ErasePointerListLinks<Node>(position.node);
+    result.node = next;
     return result;
 }
 
@@ -54,4 +47,20 @@ Iterator PointerListEnd(Node* head)
     return result;
 }
 
+// Shared erasure of the retail pointer-list nodes; the payload determines size.
+template <class Node>
+CircularListIterator ErasePointerListNode(CircularListIterator position)
+{
+    CircularListNode* node = position.node;
+    CircularListNode* previous = node->previous;
+    CircularListNode* next = node->next;
+    previous->next = next;
+    next->previous = previous;
+    if (node)
+        ReturnPool(node, sizeof(Node));
+    CircularListIterator result;
+    result.node = next;
+    return result;
+}
+
