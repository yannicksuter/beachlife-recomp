@@ -0,0 +1,35 @@
+#ifndef STARTUP_SCREEN_TERRAIN_ORIGIN_H
+#define STARTUP_SCREEN_TERRAIN_ORIGIN_H
+
+#include <math.h>
+#include "startup_screen_mode_world.h"
+#include "startup_screen_position_inlines.h"
+
+// Inline in retail: the terrain route searches expand both within their /Ob1
+// budget and call the shared out-of-line copies where it refuses a site. Every
+// other caller sees only the declarations; match_004479c0.cpp and
+// match_00446200.cpp emit the copies.
+// FUNCTION: BEACHLIFE 0x004479c0
+inline float ScreenWorldPosition::Length() const
+{
+    return static_cast<float>(sqrt(x * x + y * y + z * z));
+}
+
+// FUNCTION: BEACHLIFE 0x00446200
+inline ScreenWorldPosition ScreenTerrainGrid::TileOrigin(ScreenPoint tile)
+{
+    int size = tile_size_00;
+    int x = tile.x;
+    int y = tile.y;
+    int half = size / 2;
+    ScreenWorldPosition result;
+    result.x = static_cast<float>(half * x);
+    if (x & 1)
+        result.y = static_cast<float>(y * size);
+    else
+        result.y = static_cast<float>(y * size - half);
+    result.z = 0.0f;
+    return result;
+}
+
+#endif
