+++ b/src/startup_main_menu_enter.cpp
@@ -0,0 +1,33 @@
+#include "startup_main_menu.h"
+#include "startup_screen_manager.h"
+#include "window_activation.h"
+
+// GLOBAL: BEACHLIFE 0x004f4e04
+const float main_menu_voice_level = 0.8f;
+
+// FUNCTION: BEACHLIFE 0x004e8e60
+void MainMenuController::Enter()
+{
+    active = 1;
+
+    int voice = window_audio_state->PlaySound("waves_loop", 2, 0.0f);
+    window_audio_state->SetSoundLevel(voice, main_menu_voice_level);
+
+    screen_request_game->SetScreenSize(800, 600);
+    ScreenRequestGamePrefix* game = screen_request_game;
+    const char* path = ScriptPath();
+    game->LoadControllerScreen(path);
+    screen_manager->SetMode(6);
+
+    if (first_entry == 0 && screen_request_game->ReadMenuReturnFlag() == 0)
+    {
+        screen_request_game->LoadScenarioProgress();
+        screen_manager->RequestScreen("ScenarioScreen", 0, 0);
+    }
+    else
+    {
+        screen_manager->RequestScreen("MainMenu", 0, 0);
+        first_entry = 0;
+        screen_request_game->ClearMenuReturnFlag();
+    }
+}
