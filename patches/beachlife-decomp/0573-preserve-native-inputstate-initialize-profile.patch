-        LPCSTR user, void* action_format, void* callback, LPVOID context, DWORD flags) PURE;
-    STDMETHOD(ConfigureDevices)(void* callback, void* parameters, DWORD flags, LPVOID data) PURE;
-};
-
-extern "C" const GUID IID_IDirectInput8A;
