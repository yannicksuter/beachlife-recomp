+// FUNCTION: BEACHLIFE 0x00431520
+void WorldRouteFinder::PropagateRouteCost(ScreenTerrainCell* cell)
+{
+    int cost = cell->cost_3c;
+    for (int i = 0; i < 8; ++i)
+    {
+        ScreenTerrainCell* neighbour = cell->neighbours_10[i];
+        if (!neighbour || neighbour->visited_generation_08 != generation_08)
+            break;
+        int new_cost = static_cast<int>(static_cast<unsigned int>(cost) + 1);
+        if (new_cost < neighbour->cost_3c)
+        {
+            neighbour->cost_3c = new_cost;
+            neighbour->score_34 = static_cast<int>(static_cast<unsigned int>(neighbour->distance_38) + new_cost);
+            neighbour->parent_00 = cell;
+            AllocationNode* node = static_cast<AllocationNode*>(std::calloc(1, sizeof(AllocationNode)));
+            node->data = neighbour;
+            node->next = data_8c->next;
+            data_8c->next = node;
+        }
+    }
+    while (data_8c->next)
+    {
+        AllocationNode* node = data_8c->next;
+        cell = static_cast<ScreenTerrainCell*>(node->data);
+        data_8c->next = node->next;
+        std::free(node);
+        for (int i = 0; i < 8; ++i)
+        {
+            ScreenTerrainCell* neighbour = cell->neighbours_10[i];
+            if (!neighbour || neighbour->visited_generation_08 != generation_08)
+                break;
+            int new_cost = static_cast<int>(static_cast<unsigned int>(cell->cost_3c) + 1);
+            if (new_cost < neighbour->cost_3c)
+            {
+                neighbour->cost_3c = new_cost;
+                neighbour->score_34 = static_cast<int>(static_cast<unsigned int>(neighbour->distance_38) + new_cost);
+                neighbour->parent_00 = cell;
+                AllocationNode* pending = static_cast<AllocationNode*>(std::calloc(1, sizeof(AllocationNode)));
+                pending->data = neighbour;
+                pending->next = data_8c->next;
+                data_8c->next = pending;
+            }
+        }
+    }
+}
