+// FUNCTION: BEACHLIFE 0x004312a0
+void WorldRouteFinder::VisitRouteCell(ScreenTerrainCell* cell, const ScreenPoint* point, const ScreenPoint*, int cost)
+{
+    int new_cost = static_cast<int>(static_cast<unsigned int>(cell->cost_3c) + cost);
+    unsigned int y = static_cast<unsigned int>(point->y) % terrain_00->height_08;
+    unsigned int x = static_cast<unsigned int>(point->x) % terrain_00->width_04;
+    ScreenTerrainCell* neighbour = &terrain_00->cells_0c[y * terrain_00->width_04 + x];
+    if (neighbour->open_31 && neighbour->visited_generation_08 == generation_08)
+    {
+        for (int i = 0; i < 8; ++i)
+        {
+            ScreenTerrainCell* previous = cell->neighbours_10[i];
+            if (!previous || previous->visited_generation_08 != generation_08)
+            {
+                cell->neighbours_10[i] = neighbour;
+                break;
+            }
+        }
+        if (new_cost < neighbour->cost_3c)
+        {
+            neighbour->parent_00 = cell;
+            neighbour->cost_3c = new_cost;
+            neighbour->score_34 = static_cast<int>(static_cast<unsigned int>(neighbour->distance_38) + new_cost);
+        }
+        return;
+    }
+    if (neighbour->closed_30 && neighbour->visited_generation_08 == generation_08)
+    {
+        for (int i = 0; i < 8; ++i)
+        {
+            ScreenTerrainCell* previous = cell->neighbours_10[i];
+            if (!previous || previous->visited_generation_08 != generation_08)
+            {
+                cell->neighbours_10[i] = neighbour;
+                break;
+            }
+        }
+        if (new_cost < neighbour->cost_3c)
+        {
+            neighbour->parent_00 = cell;
+            neighbour->cost_3c = new_cost;
+            neighbour->score_34 = static_cast<int>(static_cast<unsigned int>(neighbour->distance_38) + new_cost);
+            PropagateRouteCost(neighbour);
+        }
+        return;
+    }
+
+    neighbour->parent_00 = cell;
+    neighbour->cost_3c = new_cost;
+    ScreenWorldPosition position = terrain_00->TilePosition(point->x, point->y, 4);
+    int dx = static_cast<int>(static_cast<long double>(position.x) - start_position_1c.x);
+    int dy = static_cast<int>(static_cast<long double>(position.y) - start_position_1c.y);
+    neighbour->distance_38 = static_cast<int>(static_cast<unsigned int>(dx) * dx + static_cast<unsigned int>(dy) * dy);
+    neighbour->score_34 = static_cast<int>(static_cast<unsigned int>(neighbour->distance_38) + new_cost);
+    neighbour->open_31 = 1;
+    neighbour->visited_generation_08 = generation_08;
+    InsertOpenRouteCell(neighbour);
+    for (int i = 0; i < 8; ++i)
+    {
+        ScreenTerrainCell* previous = cell->neighbours_10[i];
+        if (!previous || previous->visited_generation_08 != generation_08)
+        {
+            cell->neighbours_10[i] = neighbour;
+            break;
+        }
+    }
+}
