+// FUNCTION: BEACHLIFE 0x00431470
+void WorldRouteFinder::InsertOpenRouteCell(ScreenTerrainCell* cell)
+{
+    ScreenTerrainCell* next = cell_34.next_04;
+    if (!next || cell_34.linked_generation_0c != generation_08)
+    {
+        cell_34.next_04 = cell;
+        cell_34.linked_generation_0c = generation_08;
+        return;
+    }
+    if (next->visited_generation_08 != generation_08)
+    {
+        cell_34.linked_generation_0c = generation_08;
+        cell_34.next_04 = cell;
+        cell->visited_generation_08 = generation_08;
+        return;
+    }
+
+    ScreenTerrainCell* previous = &cell_34;
+    int score = cell->score_34;
+    while (next && next->visited_generation_08 == generation_08 && next->score_34 < score)
+    {
+        previous = next;
+        next = previous->next_04;
+        if (!next || previous->linked_generation_0c != generation_08)
+            next = 0;
+    }
+    cell->linked_generation_0c = generation_08;
+    cell->next_04 = next;
+    previous->next_04 = cell;
+    previous->linked_generation_0c = generation_08;
+    previous->visited_generation_08 = generation_08;
+}
