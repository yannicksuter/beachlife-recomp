diff --git a/src/startup_surface_create.cpp b/src/startup_surface_create.cpp
new file mode 100644
index 0000000..a8de73c
--- /dev/null
+++ b/src/startup_surface_create.cpp
@@ -0,0 +1,123 @@
+#include "startup_screen_renderer.h"
+#include "pool_chunk_acquire.h"
+#include "pool_lock_acquire.h"
+#include "pool_lock_guard.h"
+#include "pool_refill.h"
+#include "pool_return.h"
+
+#include <new>
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0040def0
+int ScreenRequestRenderer::CreateSurface(int image_width, int image_height, int mode)
+{
+    ScreenSurfacePosition* selected = 0;
+    unsigned int index = 0;
+    ScreenSurfacePosition** scan = surfaces;
+    if (surfaces_end != surfaces)
+    {
+        do
+        {
+            if (scan[index]->active == 0)
+            {
+                selected = scan[index];
+                break;
+            }
+            ++index;
+        } while (index < static_cast<unsigned int>(surfaces_end - surfaces));
+    }
+
+    if (selected != 0)
+    {
+        selected->active = 1;
+    }
+    else
+    {
+        void* storage = ::operator new(sizeof(ScreenSurfacePosition));
+        if (storage != 0)
+        {
+            // Begin the complete trivial entry lifetime without clearing it.
+            selected = ::new (storage) ScreenSurfacePosition;
+            selected->active = 1;
+            selected->position.x = 0;
+            selected->position.y = 0;
+            selected->prepared = 0;
+        }
+
+        // Equal null endpoints represent the observed empty table. Avoid a
+        // null pointer subtraction while retaining its original zero size.
+        index = surfaces_end == surfaces ? 0 : static_cast<unsigned int>(surfaces_end - surfaces);
+        ScreenSurfacePosition** end = surfaces_end;
+        if (end != surfaces_capacity)
+        {
+            if (end != 0)
+                *end = selected;
+            ++surfaces_end;
+        }
+        else
+        {
+            unsigned int count = end == surfaces ? 0 : static_cast<unsigned int>(end - surfaces);
+            unsigned int capacity = count + (count < 1 ? 1 : count);
+            typedef ScreenSurfacePosition* SurfacePointer;
+            SurfacePointer* replacement = 0;
+            if (capacity != 0)
+            {
+                unsigned int bytes = capacity * sizeof(SurfacePointer);
+                void* table_storage;
+                if (bytes > 128)
+                {
+                    table_storage = ::operator new(bytes);
+                }
+                else
+                {
+                    PoolChunkLink* volatile* bucket = pool_chunk_buckets + (bytes - 1) / 8;
+                    AcquirePoolLock(&pool_lock_word);
+                    PoolLockGuard guard;
+                    PoolChunkLink* block = *bucket;
+                    if (block != 0)
+                    {
+                        *bucket = block->next;
+                        table_storage = block;
+                    }
+                    else
+                    {
+                        table_storage = RefillPool(bytes);
+                    }
+                }
+                // Nonallocating default construction provides a live pointer
+                // array without clearing unused capacity or changing allocator.
+                replacement = ::new (table_storage) SurfacePointer[capacity];
+            }
+
+            SurfacePointer* appended;
+            if (end == surfaces)
+            {
+                appended = replacement;
+            }
+            else
+            {
+                unsigned int bytes = static_cast<unsigned int>((end - surfaces) * sizeof(SurfacePointer));
+                void* copied = memmove(replacement, surfaces, bytes);
+                appended = static_cast<SurfacePointer*>(copied) + bytes / sizeof(SurfacePointer);
+            }
+            *appended = selected;
+            ++appended;
+
+            if (surfaces != 0)
+            {
+                unsigned int old_bytes = static_cast<unsigned int>(
+                    (surfaces_capacity - surfaces) * sizeof(SurfacePointer));
+                if (old_bytes > 128)
+                    ::operator delete(surfaces);
+                else
+                    ReturnPool(surfaces, old_bytes);
+            }
+            surfaces = replacement;
+            surfaces_end = appended;
+            surfaces_capacity = replacement + capacity;
+        }
+    }
+
+    InitializeSurface(image_width, image_height, selected, static_cast<unsigned char>(mode));
+    return static_cast<int>(index);
+}
diff --git a/src/startup_surface_initialize.cpp b/src/startup_surface_initialize.cpp
new file mode 100644
index 0000000..05ad58d
--- /dev/null
+++ b/src/startup_surface_initialize.cpp
@@ -0,0 +1,51 @@
+#include "startup_screen_renderer.h"
+
+#include <string.h>
+
+void StartupFatal(const char* format, ...);
+
+// Descriptive names; original class and declaration are unknown.
+// FUNCTION: BEACHLIFE 0x0040e500
+void ScreenRequestRenderer::InitializeSurface(
+    int image_width, int image_height, ScreenSurfacePosition* entry, unsigned char mode)
+{
+    if (!software_mode)
+    {
+        SurfaceDescription description;
+        memset(&description, 0, sizeof(description));
+        description.size = sizeof(description);
+        description.flags = 7;
+        description.caps = 0x4040;
+        if (mode)
+            description.caps = 0x840;
+        description.width = image_width;
+        description.height = image_height;
+        entry->video_memory = 1;
+        SurfaceResult result = draw->vtable->CreateSurface(draw, &description, &entry->surface, 0);
+        if (result == (SurfaceResult)0x8876017c)
+        {
+            entry->video_memory = 0;
+            description.caps = 0x840;
+            if (draw->vtable->CreateSurface(draw, &description, &entry->surface, 0))
+                StartupFatal("Error creating surface");
+        }
+        DirectDrawSurface7Prefix* surface = entry->surface;
+        entry->width = image_width;
+        entry->height = image_height;
+        memset(&description, 0, sizeof(description));
+        description.size = sizeof(description);
+        entry->software = 0;
+        surface->vtable->GetSurfaceDesc(surface, &description);
+        entry->pitch = description.pitch;
+        entry->prepared = 0;
+    }
+    else
+    {
+        entry->software = 1;
+        entry->pixels = new unsigned short[image_width * image_height];
+        entry->width = image_width;
+        entry->height = image_height;
+        entry->pitch = image_width * 2;
+        entry->prepared = 0;
+    }
+}
