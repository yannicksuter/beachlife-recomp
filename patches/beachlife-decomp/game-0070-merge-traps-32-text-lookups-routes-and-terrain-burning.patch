+// FUNCTION: BEACHLIFE 0x004146f0
+void ScreenDialogResource::BurnTerrainClippedTiles(const ScreenRectangle* rectangle,
+    int tile_x, int tile_y, int offset_x, int offset_y, unsigned int depth)
+{
+    const unsigned char* data = SelectedFrame()->SelectData(word_14, word_18);
+    OverlayMapPrefix* map = overlay_map;
+    const unsigned short* palette = record->palettes[0];
+    int size = map->tile_size_dc;
+    int width = SelectedFrame()->width_0e;
+    unsigned int half = render_half_mask >> 1;
+    unsigned int quarter = render_quarter_mask >> 2;
+    int frame_y = SelectedFrame()->word_14;
+    unsigned int row_depth = ((depth & 0xffffu) - static_cast<unsigned int>(frame_y) * 8) << 16;
+    for (int row = 0; row < rectangle->top; ++row)
+    {
+        row_depth += frame_y++ < 0 ? -0x80000u : 0x100000u;
+        int column = 0;
+        while (column < width)
+        {
+            int run = static_cast<signed char>(*data++);
+            if (run > 0)
+            {
+                data += run;
+                column += run;
+            }
+            else
+                column -= run;
+        }
+    }
+    for (int row = rectangle->top; row < rectangle->bottom; ++row)
+    {
+        row_depth += frame_y++ < 0 ? -0x80000u : 0x100000u;
+        int column = 0;
+        while (column < width)
+        {
+            int run = static_cast<signed char>(*data++);
+            if (run > 0)
+            {
+                for (int i = 0; i < run; ++i, ++column, ++data)
+                {
+                    if (column < rectangle->left || column >= rectangle->right)
+                        continue;
+                    int x = column - rectangle->left + offset_x;
+                    int y = row - rectangle->top + offset_y;
+                    unsigned int* view = TerrainTileView(map, tile_x + x / size, tile_y + y / size);
+                    BurnTerrainPixel(view + (y % 128) * 128 + x % 128, data, palette, row_depth, half, quarter);
+                }
+            }
+            else
+                column -= run;
+        }
+    }
+}
