+static void BurnTerrainPixel(unsigned int* pixel, const unsigned char* data, const unsigned short* palette,
+    unsigned int depth, unsigned int half, unsigned int quarter)
+{
+    unsigned int old_depth = *pixel & 0xffff0000u;
+    if (old_depth > depth)
+        return;
+    unsigned int mode = *data & 0xc0u;
+    unsigned int colour = palette[*data - mode];
+    unsigned int old_colour = *pixel & 0xffffu;
+    switch (mode)
+    {
+    case 0:
+        old_depth = depth;
+        break;
+    case 0x40:
+        colour = ((colour >> 1) & half) + ((old_colour >> 2) & quarter) + ((colour >> 2) & quarter);
+        break;
+    case 0x80:
+        colour = ((old_colour >> 1) & half) + ((colour >> 1) & half);
+        break;
+    case 0xc0:
+        colour = ((old_colour >> 1) & half) + ((old_colour >> 2) & quarter) + ((colour >> 2) & quarter);
+        break;
+    }
+    *pixel = old_depth + (colour & 0xffffu);
+}
