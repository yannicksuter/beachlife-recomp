--- /dev/null
+++ b/src/startup_screen_list_box_selection.h
@@ -0,0 +1,42 @@
+#ifndef STARTUP_SCREEN_LIST_BOX_SELECTION_H
+#define STARTUP_SCREEN_LIST_BOX_SELECTION_H
+
+#include "startup_screen_list_box.h"
+
+#include <functional>
+
+// Library inlines of the signed-word selection append and sort observed
+// expanded in SelectRow. The out-of-line helpers are library support (cdecl,
+// RET0, empty comparison object by value); their bodies are not supplied.
+typedef std::less<int> ScreenListBoxLess;
+
+const int& MedianListBoxSelection(const int& first,
+    const int& middle,
+    const int& last,
+    ScreenListBoxLess less); // 0x004c5940
+int* PartitionListBoxSelection(
+    int* first, int* last, int pivot, ScreenListBoxLess less); // 0x004c5980
+void IntrosortListBoxSelection(int* first,
+    int* last,
+    int* type,
+    int depth_limit,
+    ScreenListBoxLess less); // 0x004c57a0
+void PartialSortListBoxSelection(int* first,
+    int* middle,
+    int* last,
+    int* type,
+    ScreenListBoxLess less); // 0x004c5a40
+void LinearInsertListBoxSelection(
+    int* first, int* last, int value, ScreenListBoxLess less); // 0x004c5bb0
+void UnguardedLinearInsertListBoxSelection(
+    int* last, int value, ScreenListBoxLess less);                                 // 0x004c5c90
+void InsertionSortListBoxSelection(int* first, int* last, ScreenListBoxLess less); // 0x004c59d0
+
+void AdjustListBoxSelectionHeap(int* first, int hole, int length, int value, ScreenListBoxLess less);
+void MakeListBoxSelectionHeap(int* first, int* last, ScreenListBoxLess less, int* value_type, int* distance_type);
+void PopListBoxSelectionHeap(int* first, int* last, int* result, int value, ScreenListBoxLess less, int* distance_type);
+void PushBackSelection(ScreenListBoxSelectionRange& range, const int& value);
+int ListBoxSelectionLog2(int count);
+void SortListBoxSelection(int* first, int* last);
+
+#endif
