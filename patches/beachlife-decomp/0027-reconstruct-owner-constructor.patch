+++ b/src/startup_config_owner_constructor.cpp
@@ -0,0 +1,51 @@
+#include "startup_config_owner.h"
+#include "startup_config_tokens.h"
+
+#include <string.h>
+
+void StartupFatal(const char* format, ...);
+
+// FUNCTION: BEACHLIFE 0x004eca40
+StartupConfig::StartupConfig(const char* filename)
+    : StartupConfigOwnerState(this)
+{
+    head = 0;
+    ConfigTokenBuffer buffer(filename);
+    int count = (int)buffer.count;
+    if (count > 0)
+    {
+        ConfigToken* token = buffer.tokens;
+        for (; count > 0; --count, ++token)
+        {
+            switch (token->name[0])
+            {
+            case 'b':
+                if (token->kind != 1)
+                    StartupFatal("GameParameters - wrong type in script for boolean (expecting string) - %s - %s", token->name, filename);
+                if (strcmp(token->text, "true") == 0)
+                    Append(token->name, true, 0, 0.0f, 0);
+                else
+                    Append(token->name, false, 0, 0.0f, 0);
+                break;
+            case 'i':
+                if (token->kind != 2)
+                    StartupFatal("GameParameters - wrong type in script for integer (expecting float) - %s - %s", token->name, filename);
+                Append(token->name, false, (int)*token->number, 0.0f, 0);
+                break;
+            case 'f':
+                if (token->kind != 2)
+                    StartupFatal("GameParameters - wrong type in script for float (expecting float) - %s - %s", token->name, filename);
+                Append(token->name, false, 0, *token->number, 0);
+                break;
+            case 's':
+                if (token->kind != 1)
+                    StartupFatal("GameParameters - wrong type in script for string (expecting string) - %s - %s", token->name, filename);
+                Append(token->name, false, 0, 0.0f, token->text);
+                break;
+            default:
+                StartupFatal("GameParameters - error - none defined type (needs prefix) - %s - %s", token->name, filename);
+                break;
+            }
+        }
+    }
+}
