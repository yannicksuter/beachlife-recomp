+    if ((flags & 0x100) && !(flags & 0x10))
+    {
+        flags |= 0xc0000080u;
+        for (int direction = 0; direction < 8; ++direction)
+        {
+            ScreenPoint neighbour;
+            screen_terrain_grid->Step(point.x, point.y, direction, &neighbour);
+            unsigned int& adjacent = RouteTileFlags(neighbour);
+            if ((adjacent & 0x100) && !(adjacent & 0x10))
+                adjacent |= 0xc0000080u;
+        }
+        return (flags & mask) != 0;
+    }
+    for (int direction = 0; direction < 8; direction += 2)
+    {
+        ScreenPoint neighbour;
+        screen_terrain_grid->Step(point.x, point.y, direction, &neighbour);
+        unsigned int adjacent = RouteTileFlags(neighbour);
+        if ((adjacent & mask) && !(adjacent & 0x8000))
+        {
+            point = neighbour;
+            return true;
+        }
+    }
+    return false;
+}
