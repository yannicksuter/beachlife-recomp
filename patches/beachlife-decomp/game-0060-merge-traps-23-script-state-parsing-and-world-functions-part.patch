+#include "startup_world_vehicle_helpers.h"
+
+static void ChangeVehicleApproach(int x, int y, int direction, unsigned char restore)
+{
+    ScreenTerrainCell* neighbours[8];
+    screen_terrain_grid->Neighbours(x, y, neighbours);
+    static const unsigned char indices[4][4] = {
+        { 7, 6, 5, 4 }, { 0, 1, 7, 6 }, { 0, 1, 2, 3 }, { 2, 3, 4, 5 }
+    };
+    if (direction != 1 && direction != 3 && direction != 5 && direction != 7)
+        return;
+    for (unsigned int i = 0; i < 4; ++i)
+    {
+        unsigned int& flags = neighbours[indices[(direction - 1) / 2][i]]->flags_48;
+        if (restore)
+            flags &= ~0x10u;
+        else
+            flags |= 0x10;
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x00497640
+void ClearVehicleApproach(int x, int y, int direction)
+{
+    ChangeVehicleApproach(x, y, direction, 0);
+}
+
+// FUNCTION: BEACHLIFE 0x00497740
+void RestoreVehicleApproach(int x, int y, int direction)
+{
+    ChangeVehicleApproach(x, y, direction, 1);
+}
+
+// FUNCTION: BEACHLIFE 0x00497840
+void ClearVehicleReturn(int x, int y, int direction)
+{
+    ScreenTerrainCell* neighbours[8];
+    screen_terrain_grid->Neighbours(x, y, neighbours);
+    static const unsigned char indices[4][4] = {
+        { 0, 7, 6, 5 }, { 2, 1, 0, 7 }, { 4, 3, 1, 2 }, { 3, 4, 5, 6 }
+    };
+    if (direction != 1 && direction != 3 && direction != 5 && direction != 7)
+        return;
+    for (unsigned int i = 0; i < 4; ++i)
+        neighbours[indices[(direction - 1) / 2][i]]->flags_48 |= 0x10;
+}
