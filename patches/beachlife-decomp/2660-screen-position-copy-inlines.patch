+#ifndef STARTUP_SCREEN_POSITION_COPY_INLINES_H
+#define STARTUP_SCREEN_POSITION_COPY_INLINES_H
+
+#include "startup_screen_point.h"
+
+// The inline position bodies of units whose retail code expands the world
+// position constructors and the map position assignment but still calls the
+// world position assignment (folded into the copy constructor 0x0041c0b0) and
+// the map position copy constructor (0x00424630) out of line. The bodies equal
+// those of startup_screen_position_inlines.h, which also defines the other
+// two; a unit includes one of the two headers, never both.
+
+// Retail 0x004479a0.
+inline ScreenWorldPosition::ScreenWorldPosition(float first, float second, float third)
+    : x(first)
+    , y(second)
+    , z(third)
+{
+}
+
+// Retail 0x0041c0b0.
+inline ScreenWorldPosition::ScreenWorldPosition(const ScreenWorldPosition& other)
+    : x(other.x)
+    , y(other.y)
+    , z(other.z)
+{
+}
+
+// Folded into retail 0x00424630.
+inline ScreenMapPosition& ScreenMapPosition::operator=(const ScreenMapPosition& other)
+{
+    x = other.x;
+    y = other.y;
+    return *this;
+}
+
+#endif
