index 0000000..bac6e7e
--- /dev/null
+++ b/src/resource_depth_rasters.cpp
@@ -0,0 +1,37 @@
+#include "render_mask_setup.h"
+
+// The render masks belong to the unit of the depth-tested rasters, defined
+// uninitialised in .bss. VC6 reads a 16-bit global it defines with a 32-bit
+// load and `and 0xffff` when the global starts a 4-byte aligned slot of the
+// unit's .bss, which it lays out in symbol hash order, not definition order.
+// Retail reads render_quarter_mask and render_full_mask that way and
+// render_half_mask always as a word; with these names only a unit without
+// render_half_mask gives the same slots, so that one stays outside.
+// GLOBAL: BEACHLIFE 0x005881c8
+unsigned int render_mask_format;
+// GLOBAL: BEACHLIFE 0x005881cc
+unsigned short render_quarter_mask;
+// GLOBAL: BEACHLIFE 0x005881d0
+unsigned short* render_mask_pixels;
+// GLOBAL: BEACHLIFE 0x005881d4
+unsigned short render_full_mask;
+// GLOBAL: BEACHLIFE 0x00588818
+unsigned short render_green_mask;
+// GLOBAL: BEACHLIFE 0x0058881a
+unsigned short render_sum_bias;
+// GLOBAL: BEACHLIFE 0x0058881c
+unsigned short render_quarter_bias;
+// GLOBAL: BEACHLIFE 0x0058881e
+unsigned short render_half_bias;
+// GLOBAL: BEACHLIFE 0x00588820
+unsigned char render_green_levels;
+// GLOBAL: BEACHLIFE 0x00588822
+unsigned short render_green_bits;
+// GLOBAL: BEACHLIFE 0x00588824
+unsigned short render_red_shift;
+// GLOBAL: BEACHLIFE 0x0058882a
+unsigned short render_red_mask;
+// GLOBAL: BEACHLIFE 0x00588830
+unsigned int render_mask_width;
+// GLOBAL: BEACHLIFE 0x00588834
+unsigned short render_blue_mask;
