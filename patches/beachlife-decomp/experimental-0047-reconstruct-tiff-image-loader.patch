+
+struct TgaImage;
+
+// Actual 0x004ebd80, cdecl(filename), image pointer result; no callee stack pop.
+// This TIFF path is distinct from LoadTgaFile at 0x004ea910.
+TgaImage* LoadTiffFile(const char* filename);
diff --git a/src/tiff_read_palette.cpp b/src/tiff_read_palette.cpp
new file mode 100644
index 0000000..b8045e2
--- /dev/null
+++ b/src/tiff_read_palette.cpp
@@ -0,0 +1,18 @@
+#include "tiff_read_context.h"
+#include "tiff_palette_byte.h"
+#include "startup_resource_binary_read.h"
+
+// FUNCTION: BEACHLIFE 0x004ebcf0
+void TiffReadPalette(TiffReadContext* context, unsigned char* palette)
+{
+    fseek(context->file, static_cast<int>(context->palette_offset), SEEK_SET);
+
+    for (int index = 0; index < 256; ++index)
+        palette[index * 3] = TiffPaletteByte(ReadResourceWord(context->file));
+
+    for (int index = 0; index < 256; ++index)
+        palette[index * 3 + 1] = TiffPaletteByte(ReadResourceWord(context->file));
+
+    for (int index = 0; index < 256; ++index)
+        palette[index * 3 + 2] = TiffPaletteByte(ReadResourceWord(context->file));
+}
