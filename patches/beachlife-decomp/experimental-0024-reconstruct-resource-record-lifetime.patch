diff --git a/src/startup_screen_dialog_record_destructor.cpp b/src/startup_screen_dialog_record_destructor.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_screen_dialog_record_destructor.cpp
@@ -0,0 +1,27 @@
+#include "startup_screen_dialog_resource.h"
+
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004171e0
+ScreenDialogResourceRecord::~ScreenDialogResourceRecord()
+{
+    if (name)
+    {
+        ::operator delete(const_cast<char*>(name));
+    }
+    for (int i = 0; i < palette_count; ++i)
+    {
+        ::operator delete(palettes[i]);
+    }
+    ::operator delete(palettes);
+    for (int frame_index = 0; frame_index < frame_count; ++frame_index)
+    {
+        ScreenDialogResourceFrame* frame = frames[frame_index];
+        if (frame)
+        {
+            frame->~ScreenDialogResourceFrame();
+            ::operator delete(frame);
+        }
+    }
+    ::operator delete(frames);
+}
