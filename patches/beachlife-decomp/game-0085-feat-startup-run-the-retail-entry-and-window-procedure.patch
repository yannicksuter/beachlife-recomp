diff --git a/src/window_procedure.cpp b/src/window_procedure.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2edd180756fc1deee9ea187b580c27dd771f7945
--- /dev/null
+++ b/src/window_procedure.cpp
@@ -0,0 +1,40 @@
+#include "startup_application.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x004a0710
+LRESULT CALLBACK WindowProcedure(HWND window, UINT message, WPARAM word, LPARAM parameter)
+{
+    switch (message)
+    {
+    case WM_CLOSE:
+        DestroyWindow(window);
+        PostQuitMessage(0);
+        return 0;
+    case WM_ERASEBKGND:
+        return 0;
+    case WM_ACTIVATEAPP:
+        application_active = word != 0;
+        if (!windowed && screen_request_game)
+        {
+            if (application_active)
+                screen_request_game->Activate();
+            else
+                screen_request_game->Deactivate();
+        }
+        break;
+    case WM_SYSCOMMAND:
+        switch (word)
+        {
+        case SC_SIZE:
+        case SC_MOVE:
+        case SC_MAXIMIZE:
+        case SC_KEYMENU:
+        case SC_MONITORPOWER:
+            if (!screen_request_renderer->software_mode)
+                return 1;
+            break;
+        }
+        break;
+    }
+    return DefWindowProcA(window, message, word, parameter);
+}
