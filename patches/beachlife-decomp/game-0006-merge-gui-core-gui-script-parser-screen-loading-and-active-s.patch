+// FUNCTION: BEACHLIFE 0x004aa550
+void GuiParserState::Parse(const char* script, unsigned int size)
+{
+    current_context = 0;
+    alternate_context_10 = 0;
+    alternate_context_14 = 0;
+    context_head = 0;
+    previous_context = 0;
+    last_registered_item = 0;
+    defined_items = 0;
+    registry_head = 0;
+    items_head = 0;
+    items_tail = 0;
+    registry_tail = 0;
+    word_38 = 0;
+    word_3c = 0;
+    bool stop = false;
+    cursor = 0;
+    buffer = script;
+    char command[32];
+    while (cursor < size && !stop)
+    {
+        const char* data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
+               data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+        if (cursor < size)
+        {
+            char current = data[cursor];
+            if (current == '<')
+            {
+                ++cursor;
+                while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
+                       data[cursor] == '\t')
+                {
