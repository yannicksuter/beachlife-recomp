+#include "startup_gui_parser.h"
+#include "startup_screen_item.h"
+#include "startup_screen_manager.h"
+
+void StartupFatal(const char* format, ...);
+
+// FUNCTION: BEACHLIFE 0x004aa8b0
+bool GuiParserState::DispatchToken(unsigned int token)
+{
+    bool stop = false;
+    switch (token)
+    {
+    case 14:
+        ParseFont();
+        break;
+    case 2:
+        ParseMainItem();
+        break;
+    case 3:
+        ParseMainItem640();
+        break;
+    case 15:
+        ParseTGA();
+        break;
+    case 1:
+        ParseDialogItem();
+        break;
+    case 9:
+        ParseText();
+        break;
+    case 7:
+        ParseButton();
+        break;
+    case 11:
+        ParseComboBox();
+        break;
+    case 6:
+        ParseDefine();
+        break;
+    case 4:
+        ParseTabWindow();
+        break;
+    case 10:
+        ParseVariable();
+        break;
+    case 5:
+        ParseTable();
+        break;
+    case 8:
+        ParseSlider();
+        break;
+    case 12:
+        ParseVariableImage();
+        break;
+    case 13:
+        ParseImage();
+        break;
+    case 16:
+        if (buffer[cursor] == '(')
+        {
+            ++cursor;
+            const char* data = buffer;
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
+                   data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            ScreenRectangle rectangle;
+            ReadRectangle(rectangle, current_context);
+            data = buffer;
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
+                   data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            ++cursor;
+            manager->SetTickerRectangle(rectangle);
+        }
+        else
+        {
+            StartupFatal("GUIManager::process_scrollwindow - Script Error \r\nNo open bracket "
+                         "found at file offset - %u",
+                cursor);
+        }
+        break;
+    case 0:
+        ParseCheckBox();
+        break;
+    case 17:
+        ParseImageList();
+        break;
+    case 18:
+        ParseIcon();
+        break;
+    case 19:
+        ParseBar();
+        break;
+    case 20:
+        ParseNumberAdjust();
+        break;
+    case 21:
+        ParseRadioGroup();
+        break;
+    case 22:
+        ParseRadioButton();
+        break;
+    case 23:
+        ParseListBox();
+        break;
+    case 24:
+        stop = true;
+        break;
+    }
+    return stop;
+}
