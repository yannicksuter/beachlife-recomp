+        ReadText(source);
+        int left;
+        ReadInteger(left, true);
+        int right;
+        ReadInteger(right, true);
+        int value_d;
+        ReadInteger(value_d, true);
+        int value_c;
+        ReadInteger(value_c, false);
+
+        data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
+               data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        // The column takes the open table's top and bottom; left and right are
+        // offsets from the table's left edge.
+        ScreenRectangle bounds;
+        bounds.left = alternate_context_14->GetRectangle().left + left;
+        bounds.right = alternate_context_14->GetRectangle().left + right;
+        bounds.top = alternate_context_14->GetRectangle().top;
+        bounds.bottom = alternate_context_14->GetRectangle().bottom;
+        ScreenTableColumn* column =
+            new ScreenTableColumn(bounds, source, value_a, value_b, value_c, value_d);
+        RegisterItem(column, 0);
+
+        data = buffer;
+        if (data[cursor] == ',')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
+                   data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            ++cursor;
+            char text[64];
+            ReadText(text);
+            column->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+        else
+        {
+            if (data[cursor] == ')')
+            {
+                ++cursor;
+            }
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
+                   data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+        }
+        if (buffer[cursor] == '>')
+        {
+            ++cursor;
+        }
+        else
+        {
+            StartupFatal(
+                "GUIManager::process_col - Script Error \r\nNo close symbol at file offset - %u",
+                cursor);
+        }
+
+        data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' ||
