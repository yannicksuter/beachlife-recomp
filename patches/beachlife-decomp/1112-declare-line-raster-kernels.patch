+// Direct storage uses four-byte slots; packed storage uses two-byte slots.
+// Only declarations are supplied here; each actual implementation is required.
+void RasterLineDirectX(int x, int y, int delta_x, int delta_y, int direction,
+    unsigned int colour, unsigned short* pixels, unsigned int stride); // 0x00411560
+void RasterLineDirectY(int x, int y, int delta_x, int delta_y, int direction,
+    unsigned int colour, unsigned short* pixels, unsigned int stride); // 0x00411640
+void RasterLinePackedX(int x, int y, int delta_x, int delta_y, int direction,
+    unsigned int colour, unsigned short* pixels, unsigned int stride); // 0x00411710
+void RasterLinePackedY(int x, int y, int delta_x, int delta_y, int direction,
+    unsigned int colour, unsigned short* pixels, unsigned int stride); // 0x004117e0
+
+#endif
