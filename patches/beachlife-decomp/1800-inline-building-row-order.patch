diff --git a/src/startup_screen_table_building_order.h b/src/startup_screen_table_building_order.h
new file mode 100644
index 0000000..8e0a264
--- /dev/null
+++ b/src/startup_screen_table_building_order.h
@@ -0,0 +1,56 @@
+#ifndef STARTUP_SCREEN_TABLE_BUILDING_ORDER_H
+#define STARTUP_SCREEN_TABLE_BUILDING_ORDER_H
+
+#include "startup_screen_table_sort.h"
+#include <utility>
+#include "startup_world_entities.h"
+#include "startup_variable_state.h"
+#include <wchar.h>
+
+static inline float BuildingValue(ScreenRequestContext* context, unsigned int index)
+{
+    return context->AsBuilding()->building_values_214[index];
+}
+inline bool ScreenTableBuildingOrder::operator()(ScreenRequestContext* a, ScreenRequestContext* b)
+{
+    unsigned short first_name[256], second_name[256];
+    ScreenRequestContext* left;
+    ScreenRequestContext* right;
+    if (reversed)
+    {
+        left = a;
+        right = b;
+    }
+    else
+    {
+        left = b;
+        right = a;
+    }
+    switch (kind)
+    {
+    case 23:
+        return left->AsBuilding()->building_60->power_cf4 > right->AsBuilding()->building_60->power_cf4;
+    case 18:
+        return left->AsBuilding()->power_state_33c > right->AsBuilding()->power_state_33c;
+    case 28:
+        return left->AsBuilding()->building_value_330 > right->AsBuilding()->building_value_330;
+    case 19:
+        return !(BuildingValue(left, 0) <= BuildingValue(right, 0));
+    case 20:
+        return !(BuildingValue(left, 1) <= BuildingValue(right, 1));
+    case 21:
+        return !(BuildingValue(left, 2) <= BuildingValue(right, 2));
+    case 22:
+        return !(BuildingValue(left, 3) <= BuildingValue(right, 3));
+    case 26:
+        return left->AsBuilding()->word_224 > right->AsBuilding()->word_224;
+    case 27:
+        return left->AsBuilding()->building_value_350 > right->AsBuilding()->building_value_350;
+    default:
+        left->ReadText("BUILDING_NAME", second_name);
+        right->ReadText("BUILDING_NAME", first_name);
+        return wcscmp(second_name, first_name) < 0;
+    }
+}
+
+#endif
