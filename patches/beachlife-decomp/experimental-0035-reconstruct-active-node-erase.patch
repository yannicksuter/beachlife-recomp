+#include "startup_list.h"
+#include "pool_return.h"
+
+// FUNCTION: BEACHLIFE 0x004209d0
+CircularListIterator CircularList::Erase(CircularListIterator position)
+{
+    CircularListNode* node = position.node;
+    CircularListNode* previous = node->previous;
+    CircularListNode* next = node->next;
+    previous->next = next;
+    next->previous = previous;
+    if (node != 0)
+        ReturnPool(node, sizeof(CircularListValueNode));
+
+    CircularListIterator result;
+    result.node = next;
+    return result;
+}
