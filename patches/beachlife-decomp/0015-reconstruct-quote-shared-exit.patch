@@ -0,0 +1,23 @@
+#include "startup_config_scan.h"
+
+// Descriptive name; positive extents require a readable lookahead byte at buffer[size].
+// FUNCTION: BEACHLIFE 0x004ec3c0
+int SeekConfigQuotedName(const char* buffer, int size)
+{
+    int index = 0;
+    while (index < size)
+    {
+        if (buffer[index] == '\'')
+            return index;
+        if (buffer[++index] == '/')
+        {
+            do
+            {
+                if (index >= size)
+                    goto done;
+            } while (buffer[++index] != '\r');
+        }
+    }
+done:
+    return size;
+}
