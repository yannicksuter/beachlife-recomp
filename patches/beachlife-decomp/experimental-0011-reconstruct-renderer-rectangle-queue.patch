diff --git a/src/startup_renderer_rectangle_queue.h b/src/startup_renderer_rectangle_queue.h
new file mode 100644
--- /dev/null
+++ b/src/startup_renderer_rectangle_queue.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include "startup_screen_item.h"
+#include <cstddef>
+#include <deque>
+
+// Native library adaptation of the observed rectangle-value queue. This is not
+// the original block/iterator ABI or an allocation/failure/timing reconstruction.
+// Calls require live storage, valid indices/count, and successful allocation.
+struct RendererRectangleQueue
+{
+    std::deque<ScreenRectangle> values;
+
+    ScreenRectangle& At(int index)
+    {
+        return values[static_cast<std::size_t>(index)];
+    }
+
+    const ScreenRectangle& At(int index) const
+    {
+        return values[static_cast<std::size_t>(index)];
+    }
+
+    void PopBack()
+    {
+        values.pop_back();
+    }
+
+    void PushBack(const ScreenRectangle& bounds)
+    {
+        values.push_back(bounds);
+    }
+};
