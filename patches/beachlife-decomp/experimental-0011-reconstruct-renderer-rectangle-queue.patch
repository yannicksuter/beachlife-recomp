+void ScreenRequestRenderer::AccumulateRectangle(ScreenRectangle bounds)
+{
+    ScreenRectangle overlap;
+    bool overlaps = false;
+    for (int index = 0; index < dirty_rectangle_count; ++index)
+    {
+        if (bounds.left >= dirty_rectangles.At(index).left
+            && bounds.right <= dirty_rectangles.At(index).right
+            && bounds.top >= dirty_rectangles.At(index).top
+            && bounds.bottom <= dirty_rectangles.At(index).bottom)
+        {
+            return;
+        }
+
+        if (dirty_rectangles.At(index).left >= bounds.left
+            && dirty_rectangles.At(index).right <= bounds.right
+            && dirty_rectangles.At(index).top >= bounds.top
+            && dirty_rectangles.At(index).bottom <= bounds.bottom)
+        {
+            dirty_rectangles.At(index) = dirty_rectangles.At(dirty_rectangle_count - 1);
+            dirty_rectangles.PopBack();
+            --dirty_rectangle_count;
+            --index;
+        }
+        else if (((bounds.left > dirty_rectangles.At(index).left
+                      && bounds.left < dirty_rectangles.At(index).right)
+                     || (bounds.right > dirty_rectangles.At(index).left
+                         && bounds.right < dirty_rectangles.At(index).right))
+                 && ((bounds.top > dirty_rectangles.At(index).top
+                         && bounds.top < dirty_rectangles.At(index).bottom)
+                     || (bounds.bottom > dirty_rectangles.At(index).top
+                         && bounds.bottom < dirty_rectangles.At(index).bottom)))
+        {
+            overlap = dirty_rectangles.At(index);
+            overlaps = true;
+            break;
+        }
+    }
+
+    if (!overlaps)
+    {
+        dirty_rectangles.PushBack(bounds);
+        ++dirty_rectangle_count;
+        return;
+    }
+
+    if (bounds.left > overlap.left && bounds.left < overlap.right && bounds.right > overlap.right)
+    {
+        if (bounds.top < overlap.top && bounds.bottom > overlap.bottom)
+        {
+            ScreenRectangle right = { overlap.right, overlap.top, bounds.right, overlap.bottom };
+            ScreenRectangle top = { bounds.left, bounds.top, bounds.right, overlap.top };
+            ScreenRectangle bottom = { bounds.left, overlap.bottom, bounds.right, bounds.bottom };
+            AccumulateRectangle(right);
+            AccumulateRectangle(top);
+            AccumulateRectangle(bottom);
+        }
+        else if (bounds.top > overlap.top && bounds.top < overlap.bottom && bounds.bottom > overlap.bottom)
+        {
+            ScreenRectangle right = { overlap.right, bounds.top, bounds.right, bounds.bottom };
+            ScreenRectangle bottom = { bounds.left, overlap.bottom, overlap.right, bounds.bottom };
+            AccumulateRectangle(right);
+            AccumulateRectangle(bottom);
+        }
+        else if (bounds.bottom > overlap.top && bounds.bottom < overlap.bottom && bounds.top < overlap.top)
+        {
+            ScreenRectangle right = { overlap.right, bounds.top, bounds.right, bounds.bottom };
+            ScreenRectangle top = { bounds.left, bounds.top, overlap.right, overlap.top };
+            AccumulateRectangle(right);
+            AccumulateRectangle(top);
+        }
+        else
+        {
+            ScreenRectangle right = { overlap.right, bounds.top, bounds.right, bounds.bottom };
+            AccumulateRectangle(right);
+        }
+        return;
+    }
+
+    if (bounds.right > overlap.left && bounds.right < overlap.right && bounds.left < overlap.left)
+    {
+        if (bounds.top < overlap.top && bounds.bottom > overlap.bottom)
+        {
+            ScreenRectangle left = { bounds.left, overlap.top, overlap.left, overlap.bottom };
+            ScreenRectangle top = { bounds.left, bounds.top, bounds.right, overlap.top };
+            ScreenRectangle bottom = { bounds.left, overlap.bottom, bounds.right, bounds.bottom };
+            AccumulateRectangle(left);
+            AccumulateRectangle(top);
+            AccumulateRectangle(bottom);
+        }
+        else if (bounds.top >= overlap.top && bounds.top <= overlap.bottom && bounds.bottom > overlap.bottom)
+        {
+            ScreenRectangle left = { bounds.left, bounds.top, overlap.left, bounds.bottom };
+            ScreenRectangle bottom = { overlap.left, overlap.bottom, bounds.right, bounds.bottom };
+            AccumulateRectangle(left);
+            AccumulateRectangle(bottom);
+        }
+        else if (bounds.bottom > overlap.top && bounds.bottom < overlap.bottom && bounds.top < overlap.top)
+        {
+            ScreenRectangle left = { bounds.left, bounds.top, overlap.left, bounds.bottom };
+            ScreenRectangle top = { overlap.left, bounds.top, bounds.right, overlap.top };
+            AccumulateRectangle(left);
+            AccumulateRectangle(top);
+        }
+        else
+        {
+            ScreenRectangle left = { bounds.left, bounds.top, overlap.left, bounds.bottom };
+            AccumulateRectangle(left);
+        }
+        return;
+    }
+
+    if (bounds.top > overlap.top && bounds.top < overlap.bottom && bounds.bottom > overlap.bottom)
+    {
+        if (bounds.left < overlap.left && bounds.right > overlap.right)
+        {
+            ScreenRectangle left = { bounds.left, bounds.top, overlap.left, bounds.bottom };
+            ScreenRectangle right = { overlap.right, bounds.top, bounds.right, bounds.bottom };
+            ScreenRectangle bottom = { overlap.left, overlap.bottom, overlap.right, bounds.bottom };
+            AccumulateRectangle(left);
+            AccumulateRectangle(right);
+            AccumulateRectangle(bottom);
+        }
+        else
+        {
+            ScreenRectangle bottom = { bounds.left, overlap.bottom, bounds.right, bounds.bottom };
+            AccumulateRectangle(bottom);
+        }
+        return;
+    }
+
+    if (bounds.bottom > overlap.top && bounds.bottom < overlap.bottom && bounds.top < overlap.top)
+    {
+        if (bounds.left < overlap.left && bounds.right > overlap.right)
+        {
