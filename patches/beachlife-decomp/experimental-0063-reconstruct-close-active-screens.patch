+++ b/src/startup_screen_close_active.cpp
@@ -0,0 +1,30 @@
+#include "startup_screen_manager.h"
+#include "startup_screen_dialog.h"
+#include "startup_screen_placement.h"
+#include "startup_screen_request_context.h"
+
+// FUNCTION: BEACHLIFE 0x004b1890
+void ScreenManager::CloseActiveScreens()
+{
+    CircularListNode* head = active.head;
+    CircularListNode* node = head->next;
+    if (node == head)
+        return;
+
+    do
+    {
+        ActiveScreenEntry* entry = static_cast<CircularListValueNode*>(node)->entry;
+        ScreenDialog* item = entry->item;
+        entry->state = 2;
+        unsigned int group = item->group_7c;
+        ScreenRectangle rectangle;
+        rectangle = item->GetRectangle();
+        if (mode != 6 && previous_mode != 6)
+            screen_request_game->placement->WritePlacement(rectangle.left, rectangle.top, static_cast<int>(group));
+
+        ScreenRequestContext* context = entry->context;
+        if (context)
+            context->Replaced();
+        node = node->next;
+    } while (node != active.head);
+}
