+{
+    unsigned int count = 0;
+    VariableEntity** scenery = variable_world->ByType(1, &count);
+    for (unsigned int attempt = 0; attempt < count; ++attempt)
+    {
+        unsigned int index = static_cast<unsigned int>(std::rand()) % count;
+        WorldSceneryEntity* entity = static_cast<WorldSceneryEntity*>(scenery[index]);
+        if (!entity->scenery_f4->serviceable_30a || entity->inactive_04)
+            continue;
+        float x = position->x - entity->x_30;
+        float y = position->y - entity->y_34;
+        float z = position->z - entity->z_38;
+        CircularListNode* node = assignments_10.head->next;
