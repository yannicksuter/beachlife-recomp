+#ifndef STARTUP_WORLD_INDEX_DEQUE_H
+#define STARTUP_WORLD_INDEX_DEQUE_H
+
+#include "startup_world_deque.h"
+#include "pool_allocate.h"
+#include <cstring>
+#include <new>
+
+// Shared storage operations for the folded signed and unsigned index deques.
+template <class T>
+void ReserveWorldIndexMap(WorldDequeStorage<T>& deque, unsigned int count, unsigned char front)
+{
+    unsigned int old_nodes = static_cast<unsigned int>(deque.end.node - deque.begin.node) + 1;
+    unsigned int new_nodes = old_nodes + count;
+    T** begin;
+    if (deque.map_count > new_nodes * 2)
+    {
+        begin = deque.map + (deque.map_count - new_nodes) / 2 + (front ? count : 0);
+        std::memmove(begin, deque.begin.node, old_nodes * sizeof(T*));
+    }
+    else
+    {
+        unsigned int size = deque.map_count + (deque.map_count < count ? count : deque.map_count) + 2;
+        T** map = static_cast<T**>(size == 0 ? 0 : size * sizeof(T*) > 128 ? ::operator new(size * sizeof(T*), std::nothrow)
+                                                                           : AllocatePoolBytes(size * sizeof(T*)));
+        begin = map + (size - new_nodes) / 2 + (front ? count : 0);
+        std::memmove(begin, deque.begin.node, old_nodes * sizeof(T*));
+        WorldDequeStorage<T>::FreeSlots(deque.map, deque.map_count * sizeof(T*));
+        deque.map = map;
+        deque.map_count = size;
+    }
+    deque.begin.node = begin;
+    deque.begin.first = *begin;
+    deque.begin.last = deque.begin.first + 32;
+    deque.end.node = begin + old_nodes - 1;
+    deque.end.first = *deque.end.node;
+    deque.end.last = deque.end.first + 32;
+}
+
+template <class T>
+void AppendWorldIndexBlock(WorldDequeStorage<T>& deque, const T& index)
+{
+    T value = index;
+    if (deque.map_count - static_cast<unsigned int>(deque.end.node - deque.map) < 2)
+        ReserveWorldIndexMap(deque, 1, 0);
+    deque.end.node[1] = static_cast<T*>(AllocatePoolBytes(32 * sizeof(T)));
+    if (deque.end.current)
+        *deque.end.current = value;
+    ++deque.end.node;
+    deque.end.first = *deque.end.node;
+    deque.end.last = deque.end.first + 32;
+    deque.end.current = deque.end.first;
+}
+
+#endif
