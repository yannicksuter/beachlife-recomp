+bool WorldStaffEntity::FindInteractionOffset(ScreenWorldPosition* position, int x, int y)
+{
+    for (int i = 0; i < 4; ++i)
+    {
+        ScreenWorldPosition candidate = *position;
+        candidate.x = static_cast<float>(static_cast<double>(candidate.x) + ((i == 0 || i == 3) ? x : -static_cast<double>(x)));
+        candidate.y = static_cast<float>(static_cast<double>(candidate.y) + ((i == 0 || i == 2) ? -static_cast<double>(y) : y));
+        unsigned int flags = CurrentScreenTerrain()->CellAt(candidate)->flags_48;
+        if (((flags & 0x10000080) && !(flags & 0x8000)) || ((flags & 2) && !(flags & 0x8010)))
+        {
+            *position = candidate;
+            return true;
+        }
+    }
