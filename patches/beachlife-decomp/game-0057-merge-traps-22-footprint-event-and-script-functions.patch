+// FUNCTION: BEACHLIFE 0x004235f0
+void VariableBuildingStatus::PrepareConstruction(unsigned int id)
+{
+    WorldBuildingEntity* entity = variable_world->FindObject(id)->AsBuilding();
+    VariableBuilding* building = entity->building_60;
+    ScreenPoint origin = entity->TilePosition();
+    ScreenPoint row_start = origin;
+    ScreenPoint tile = origin;
+    unsigned int width = building->footprint_x_1d4;
+    unsigned int height = building->footprint_y_1d8;
+    if (entity->keyline_state_44->word_18 & 1)
+    {
+        unsigned int temporary = width;
+        width = height;
+        height = temporary;
+    }
+    if (building->footprint_e14)
+        SetFootprint(origin.x, origin.y, 0, 2, id);
+    for (unsigned int row = 0; row < width; ++row)
+    {
+        for (unsigned int column = 0; column < height; ++column)
+        {
+            if (!building->footprint_e14)
+            {
+                BuildingFootprintCell(screen_terrain_grid, tile)->flags_48 |= 0x10;
+                BuildingFootprintCell(screen_terrain_grid, tile)->flags_48 &= 0x7fffffff;
+                if (BuildingFootprintCell(screen_terrain_grid, tile)->flags_48 & 1)
+                    BuildingFootprintCell(screen_terrain_grid, tile)->flags_48 |= 0x80;
+            }
+            screen_terrain_grid->Step(tile.x, tile.y, 0, &tile);
+        }
+        screen_terrain_grid->Step(row_start.x, row_start.y, 6, &row_start);
+        tile = row_start;
+    }
+    ScreenMapPosition offset = { static_cast<float>(building->staff_x_314), static_cast<float>(building->staff_y_316) };
+    unsigned int rotation = entity->keyline_state_44->word_18;
+    ScreenPoint position = entity->TilePosition();
+    ScreenMapPosition staff = CurrentScreenTerrain()->BuildingOffset(position.x, position.y, entity->building_60->footprint_x_1d4, entity->building_60->footprint_y_1d8, offset, rotation);
+    ScreenPoint staff_tile = CurrentScreenTerrain()->WorldToTile({ staff.x, staff.y, 0.0f });
+    BuildingFootprintCell(screen_terrain_grid, staff_tile)->flags_48 |= 0x80000080;
+    if (!building->footprint_e14)
+    {
+        ScreenPoint border;
+        screen_terrain_grid->Step(origin.x, origin.y, 2, &border);
+        screen_terrain_grid->Step(border.x, border.y, 4, &border);
+        const int directions[] = { 6, 0, 2, 4 };
+        for (int side = 0; side < 4; ++side)
+        {
+            unsigned int count = (side & 1) ? height + 1 : width + 1;
+            for (unsigned int i = 0; i < count; ++i)
+            {
+                screen_terrain_grid->Step(border.x, border.y, directions[side], &border);
+                ScreenTerrainCell* cell = BuildingFootprintCell(screen_terrain_grid, border);
+                if (cell->flags_48 & 1)
+                {
+                    cell->flags_48 |= 0x10000080;
+                    world_cursor_names->UpdateTile(border.x, border.y, 0);
+                }
+            }
+        }
+    }
+    tile = entity->TilePosition();
+    for (unsigned char i = 0; i < static_cast<int>(entity->footprint_y_59) - 1; ++i)
+        screen_terrain_grid->Step(tile.x, tile.y, 0, &tile);
+    for (unsigned char i = 0; i < static_cast<int>(entity->footprint_x_58) - 1; ++i)
+        screen_terrain_grid->Step(tile.x, tile.y, 6, &tile);
+    entity->SetMarkerPosition(CurrentScreenTerrain()->TilePosition(tile.x, tile.y, 0));
+}
