+    grid->BuildingBounds(row_start, rows, columns, &column_direction, &row_direction, rotation);
+    ScreenPoint tile = row_start;
+    for (unsigned int row = 0; row < rows; ++row)
+    {
+        for (unsigned int column = 0; column < columns; ++column)
+        {
+            unsigned int index = odd ? column * 25 + row : row * 25 + column;
+            unsigned int footprint = building->footprint_e14[2 + index];
+            ScreenTerrainCell* cell = &screen_terrain_grid->cells_0c[screen_terrain_grid->TileIndex(tile.x, tile.y)];
+            unsigned int flags = cell->flags_48;
