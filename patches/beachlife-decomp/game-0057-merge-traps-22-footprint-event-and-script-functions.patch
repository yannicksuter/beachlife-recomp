+        {
+            if (static_cast<unsigned int>(static_cast<WorldRepairNode<WorldRepairAssignment>*>(node)->entry->id_00) == entity->id_28)
+                break;
+            node = node->next;
+        }
+        if (node != assignments_10.head)
+            continue;
+        int random = range ? 0 : std::rand() % 3;
+        long double distance = std::sqrt(static_cast<long double>(y) * y + static_cast<long double>(z) * z + static_cast<long double>(x) * x);
+        if (range ? static_cast<long double>(range) > distance : distance > (random ? 120.0f : 150.0f))
