--- a/src/startup_pointer_list_operations.h
+++ b/src/startup_pointer_list_operations.h
@@ -2,6 +2,7 @@
 #define STARTUP_POINTER_LIST_OPERATIONS_H
 
 #include "pool_return.h"
+#include "startup_list.h"
 
 // Folded holder constructor at 0x00437de0; both allocator proxies and list
 // heads store only their incoming pointer.
@@ -46,4 +47,20 @@ Iterator PointerListEnd(Node* head)
     return result;
 }
 
+// Shared erasure of the retail pointer-list nodes; the payload determines size.
+template <class Node>
+CircularListIterator ErasePointerListNode(CircularListIterator position)
+{
+    CircularListNode* node = position.node;
+    CircularListNode* previous = node->previous;
+    CircularListNode* next = node->next;
+    previous->next = next;
+    next->previous = previous;
+    if (node)
+        ReturnPool(node, sizeof(Node));
+    CircularListIterator result;
+    result.node = next;
+    return result;
+}
+
 #endif
