+// FUNCTION: BEACHLIFE 0x004d6f70
+void WorldSubsystemScript::AppendExpression(Expression* expression, unsigned int phase)
+{
+    if (word_5918 && !world_object_script_nested)
+    {
+        WorldExpressionSwitchData::Case* last = word_5918->cases_00;
+        if (!last)
+        {
+            StartupFatal("No Case has been defined for this statement");
+            return;
+        }
+        while (last->next_0c)
+            last = last->next_0c;
+        AppendToList(last->expression_08, expression);
+        return;
+    }
+    if (word_5914)
+    {
+        if (!word_5914->parsing_else_1c)
+            AppendToList(word_5914->first_00, expression);
+        else
+            AppendToList(word_5914->second_04, expression);
+        return;
+    }
+    rules_00[count_5910].AddCommand(expression, phase);
+}
