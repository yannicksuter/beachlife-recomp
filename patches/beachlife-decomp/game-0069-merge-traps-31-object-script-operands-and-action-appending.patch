+// FUNCTION: BEACHLIFE 0x004d5320
+void WorldSubsystemScript::Rule::AddCommand(Expression* expression, unsigned int phase)
+{
+    switch (phase)
+    {
+    case 0:
+        AppendToList(first_170, expression);
+        break;
+    case 1:
+        AppendToList(second_174, expression);
+        break;
+    case 2:
+        AppendToList(third_178, expression);
+        break;
+    case 3:
+        AppendToList(commands_04[count_16c].first_04, expression);
+        break;
+    case 4:
+        AppendToList(commands_04[count_16c].second_08, expression);
+        break;
+    default:
+        StartupFatal("State::AddCommand - Invalid Command List has been specified");
+        break;
+    }
+}
