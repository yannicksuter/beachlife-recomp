+    else if (!_stricmp(token, "MissedPurchase"))
+        result.kind = 0x64;
+    else if (!_stricmp(token, "MyOffence"))
+        result.kind = 0x65;
+    else if (!_stricmp(token, "NoOffence"))
+        result.kind = 0x66;
+    else if (!_stricmp(token, "DesiredCommodSeaClosed"))
+        result.kind = 0x67;
+    else if (!_stricmp(token, "IsEntryPointClear"))
+        result.kind = 0x68;
+    else if (!_stricmp(token, "SunburnLevel"))
+        result.kind = 0x69;
+
+    else if (token[0] == '"')
+    {
+        char* text = static_cast<char*>(::operator new(std::strlen(token) - 1, std::nothrow));
+        token[std::strlen(token) - 1] = 0;
+        std::strcpy(text, token + 1);
+        result.kind = 0x36;
+        result.data = reinterpret_cast<std::uintptr_t>(text);
+    }
+    else if (!std::strncmp(token, "RandDWORD", 9))
+    {
+        unsigned int* value = new (std::nothrow) unsigned int;
+        *value = std::atoi(token + 9);
+        result.kind = 0xe3;
+        result.data = reinterpret_cast<std::uintptr_t>(value);
+    }
+    else if (!std::strncmp(token, "Random", 6))
+    {
+        unsigned int* value = new (std::nothrow) unsigned int;
+        *value = std::atoi(token + 6);
+        result.kind = 0xe4;
+        result.data = reinterpret_cast<std::uintptr_t>(value);
+    }
+    else if (!std::strncmp(token, "STATE_", 6))
+    {
+        float* value = new (std::nothrow) float;
+        unsigned int state = 0;
+        unsigned int index;
+        for (index = 0; index < 137; ++index)
+        {
+            if (std::strcmp(token, object_script_states[index].name) == 0)
+            {
+                state = object_script_states[index].state;
+                break;
+            }
+        }
+        if (index == 137)
+            StartupFatal("ObjectScript::DetermineState - State doesnt exist check state decode table");
+        *value = static_cast<float>(state);
+        result.kind = 0xe8;
+        result.data = reinterpret_cast<std::uintptr_t>(value);
+    }
+    else if (result.kind == 0x110)
+    {
+        if ((token[0] < '0' || token[0] > '9') && token[0] != '-')
+            StartupFatal("Data in script has not been defined and is not a number : %s", token);
+        float* value = new (std::nothrow) float;
+        *value = static_cast<float>(std::atof(token));
+        result.kind = 0xe8;
+        result.data = reinterpret_cast<std::uintptr_t>(value);
+    }
+    return result;
+}
