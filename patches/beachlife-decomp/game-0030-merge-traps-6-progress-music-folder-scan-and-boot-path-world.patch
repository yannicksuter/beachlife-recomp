+// FUNCTION: BEACHLIFE 0x004cdb60
+void ScreenLoadPanel13cOwner::SetCurrentEntry(int index)
+{
+    if (index >= entries_end_08 - entries_begin_04)
+        index = static_cast<int>(entries_end_08 - entries_begin_04) - 1;
+    if (index < 0)
+        index = 0;
+    index_10 = index;
+}
+
+// FUNCTION: BEACHLIFE 0x004cdbd0
+void ScreenLoadPanel13cOwner::SetEntryWord10(int index, unsigned int value)
+{
+    entries_begin_04[index]->word_10 = value;
+}
+
+// FUNCTION: BEACHLIFE 0x004cdf40
+void ScreenLoadPanel13cOwner::MoveEntryUp(int index)
+{
+    if (index > 0)
+    {
+        if (index_10 == index)
+            --index_10;
+        else if (index_10 == index - 1)
+            ++index_10;
+        ScreenLoadPanel13cEntry* moved = entries_begin_04[index];
+        ScreenLoadPanel13cEntry* previous = entries_begin_04[index - 1];
+        entries_begin_04[index - 1] = moved;
+        entries_begin_04[index] = previous;
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x004cdf80
+void ScreenLoadPanel13cOwner::MoveEntryDown(int index)
+{
+    if (index < entries_end_08 - entries_begin_04 - 1)
+    {
+        if (index_10 == index)
+            ++index_10;
+        else if (index_10 == index + 1)
+            --index_10;
+        ScreenLoadPanel13cEntry* moved = entries_begin_04[index];
+        ScreenLoadPanel13cEntry* next = entries_begin_04[index + 1];
+        entries_begin_04[index] = next;
+        entries_begin_04[index + 1] = moved;
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x004cdfd0
+bool ScreenLoadPanel13cOwner::Play(unsigned char resume)
+{
+    if (entries_begin_04 == entries_end_08)
+        return false;
+    if (resume && audio_00->IsStreamPaused())
+    {
+        audio_00->ResumeAudioStream();
+        return true;
+    }
+    char path[1024];
+    ScreenLoadPanel13cEntry* entry = entries_begin_04[index_10];
+    std::sprintf(path, "%s%s", entry->directory_04, entry->name_00);
+    bool playing = audio_00->PlayStream(path);
+    state_18 = playing ? 1 : 0;
+    state_20 = playing ? 0 : 1;
+    return playing;
+}
+
+// FUNCTION: BEACHLIFE 0x004ce070
+void ScreenLoadPanel13cOwner::StopPlayback()
+{
+    audio_00->StopStream();
+    state_18 = 0;
+}
+
+// FUNCTION: BEACHLIFE 0x004ce080
+void ScreenLoadPanel13cOwner::TogglePause()
+{
+    if (audio_00->IsStreamPaused())
+        audio_00->ResumeAudioStream();
+    else
