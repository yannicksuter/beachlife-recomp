+#include "startup_game_won.h"
+#include "startup_game_won_credits.h"
+#include "startup_screen_manager.h"
+#include "startup_screen_text_item.h"
+#include "pool_allocate.h"
+
+#include <cstdio>
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004e89a0
+static void DeleteGameWonItem(ScreenItem* item)
+{
+    delete item;
+}
+
+// FUNCTION: BEACHLIFE 0x004e8a80
+GameWonListNode* GameWonList::CreateNode(ScreenItem* const& item)
+{
+    GameWonListNode* node = ::new (AllocatePoolBytes(game_won_node_bytes)) GameWonListNode;
+    node->item = item;
+    return node;
+}
+
+// FUNCTION: BEACHLIFE 0x004e8a50
+CircularListIterator GameWonList::Insert(CircularListIterator position, ScreenItem* const& item)
+{
+    GameWonListNode* node = CreateNode(item);
+    node->next = position.node;
+    node->previous = position.node->previous;
+    node->previous->next = node;
+    position.node->previous = node;
+    CircularListIterator result;
+    result.node = node;
+    return result;
+}
+
+// FUNCTION: BEACHLIFE 0x004e87a0
+void GameWonController::ShowStage()
+{
+    screen_manager->CloseActiveScreens();
+    char name[128];
+    std::sprintf(name, "GameWon%d", stage);
+    screen_manager->RequestScreen(name, 0, 0);
+    for (CircularListNode* node = list_90.head->next; node != list_90.head; node = node->next)
+        DeleteGameWonItem(static_cast<GameWonListNode*>(node)->item);
+    list_90.Clear();
+    GameWonCreditLayout* layouts = game_won_credit_layouts[stage];
+    for (int i = 0; i < 3; ++i)
+    {
+        GameWonCreditLayout& layout = layouts[i];
+        if (layout.group == -1)
+            break;
+        int y = layout.y;
+        int x = layout.x;
+        int right = x + layout.width;
+        for (GameWonCreditEntry* entry = game_won_credit_groups[layout.group]; entry->font != -1; ++entry)
+        {
+            char key[128];
+            std::sprintf(key, "CREDIT_ENTRY_%d", entry->text_id);
+            ScreenRectangle bounds = { x, y, right, y + 15 };
+            ScreenItem* item = new (std::nothrow) ScreenTextItem(bounds, key, entry->font, entry->value, 4);
+            CircularListIterator end;
+            end.node = list_90.head;
+            list_90.Insert(end, item);
+            y += entry->double_spacing ? 30 : 15;
+        }
+    }
+}
