+// FUNCTION: BEACHLIFE 0x0042f380
+bool IsPointerSelectedEntity(VariableEntity* entity, const void*)
+{
+    if (!entity->CanSelectAtPointer() || !overlay_map->ContainsEntity(entity) || !entity->visible_40)
+        return false;
+
+    ScreenDialogResource* resource = entity->keyline_state_44;
+    if (entity->kind_2c == 2)
+    {
+        for (int frame = 0; frame < resource->record->frame_count; ++frame)
+        {
+            if (std::strcmp("pick", resource->record->frames[frame]->name) == 0)
+            {
+                if (resource->word_10 != static_cast<unsigned int>(frame))
+                {
+                    resource->word_10 = frame;
+                    resource->word_14 = 0;
+                }
+                break;
+            }
+        }
+    }
+
+    ScreenWorldPosition position = { entity->x_30, entity->y_34, entity->z_38 };
+    ScreenPoint point = overlay_map->WorldToScreen(position);
+    point.x += resource->CurrentFrameValue();
+    point.y += resource->record->frames[resource->word_10]->word_14;
+    float scale;
+    std::memcpy(&scale, &screen_request_renderer->word_58, sizeof(scale));
+    int x = static_cast<int>(static_cast<long double>(startup_input_motion_state->value_134) / scale) - point.x;
+    int y = static_cast<int>(static_cast<long double>(startup_input_motion_state->value_138) / scale) - point.y;
+    ScreenDialogResourceFrame* frame = resource->record->frames[resource->word_10];
+    if (x < 0 || x >= frame->width_0e || y < 0 || y >= frame->height_10)
+        return false;
+    return resource->TestPixel(x, y);
+}
+
+// FUNCTION: BEACHLIFE 0x0042f890
+VariableEntity** VariableWorldPrefix::FindMatches(unsigned int* count, const void* key,
+    bool (*predicate)(VariableEntity*, const void*))
+{
+    unsigned int found = 0;
+    for (unsigned int i = 0; i < buildings_04; ++i)
+        if (predicate(buildings_12120[i], key))
+            matches_24234[found++] = buildings_12120[i];
+    for (unsigned int i = 0; i < guests_08; ++i)
+        if (predicate(guests_128f0[i], key))
+            matches_24234[found++] = guests_128f0[i];
+    for (unsigned int i = 0; i < entities_0c; ++i)
+        if (predicate(entities_14060[i], key))
+            matches_24234[found++] = entities_14060[i];
+    *count = found;
+    return matches_24234;
+}
