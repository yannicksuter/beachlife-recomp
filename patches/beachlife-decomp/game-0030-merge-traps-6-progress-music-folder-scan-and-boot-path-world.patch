+
+// FUNCTION: BEACHLIFE 0x004cfe20
+bool WindowAudioState::PlayStream(const char* path)
+{
+    if (!enabled)
+        return false;
+    if (stream)
+    {
+        AIL_close_stream(stream);
+        stream = 0;
+    }
+    stream = AIL_open_stream(digital_driver, path, 0);
+    if (!stream)
+        return false;
+    long double level = stream_volume_10;
+    if (!(level >= 0.0L))
+        level = 0.0L;
+    else if (level > 1.0L)
+        level = 1.0L;
+    int volume = static_cast<int>(level * 127.0L);
+    if (volume < 3)
+        volume = 0;
+    AIL_set_stream_loop_count(stream, 1);
+    AIL_set_stream_volume(stream, volume);
+    AIL_start_stream(stream);
+    return true;
+}
+
+// FUNCTION: BEACHLIFE 0x004cff80
+void WindowAudioState::StopStream()
+{
+    if (enabled && stream)
+    {
+        AIL_close_stream(stream);
+        stream = 0;
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x004cff10
+bool WindowAudioState::IsStreamPaused()
+{
+    return enabled && stream && AIL_stream_status(stream) == 8;
+}
