+    int step_x = map_width_cc / height_map->width;
+    int step_y = map_height_d0 / height_map->height;
+    int column = x / step_x;
+    int row = y / step_y;
+    long double fraction_x = static_cast<long double>(x % step_x) / step_x;
+    long double fraction_y = static_cast<long double>(y % step_y) / step_y;
+    if (column > height_map->width - 2)
+        column = height_map->width - 2;
+    if (row > height_map->height - 2)
+        row = height_map->height - 2;
+    const unsigned char* top = height_map->pixels + height_map->width * row + column;
+    const unsigned char* bottom = height_map->pixels + height_map->width * (row + 1) + column;
+    long double first = (static_cast<int>(top[1]) - top[0]) * fraction_x + top[0];
+    long double second = (static_cast<int>(bottom[1]) - bottom[0]) * fraction_x + bottom[0];
+    return static_cast<float>(((second - first) * fraction_y + first) * screen_terrain_grid->height_scale_14);
+}
