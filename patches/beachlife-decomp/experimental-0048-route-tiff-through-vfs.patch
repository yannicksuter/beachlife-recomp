--- /dev/null
+++ b/src/tiff_vfs_read_word.cpp
@@ -0,0 +1,12 @@
+#include "tiff_vfs_read_word.h"
+
+namespace files = beachlife::runtime::retail_files;
+
+// Native stream adaptation; this is the same original method, counted once.
+// FUNCTION: BEACHLIFE 0x004eb440
+unsigned short ReadResourceWord(files::File* stream)
+{
+    unsigned short value;
+    files::read(&value, sizeof(value), 1, stream);
+    return value;
+}
