@@ -0,0 +1,108 @@
+#ifndef STARTUP_WORLD_DEQUE_OPERATIONS_H
+#define STARTUP_WORLD_DEQUE_OPERATIONS_H
+
+#include "startup_world_deque.h"
+#include <cstring>
+
+// Shared implementation of the retail library's 32-element deque operations.
+template <class Iterator>
+static int WorldDequeDistance(Iterator last, Iterator first)
+{
+    return 32 * (last.node - first.node - 1) + (last.current - last.first)
+         + (first.last - first.current);
+}
+
+template <class Iterator>
+static Iterator WorldDequeAdvance(Iterator position, int count)
+{
+    int offset = static_cast<int>(position.current - position.first) + count;
+    if (offset >= 0 && offset < 32)
+        position.current += count;
+    else
+    {
+        int block = offset > 0 ? offset / 32 : (offset + 1) / 32 - 1;
+        position.node += block;
+        position.first = *position.node;
+        position.last = position.first + 32;
+        position.current = position.first + offset - block * 32;
+    }
+    return position;
+}
+
+template <class T, class Iterator>
+static void WorldDequeReserveMap(WorldDequeStorage<T, Iterator>& deque, unsigned int count, bool front)
+{
+    unsigned int old_nodes = static_cast<unsigned int>(deque.end.node - deque.begin.node) + 1;
+    unsigned int new_nodes = old_nodes + count;
+    T** begin;
+    if (deque.map_count > new_nodes * 2)
+    {
+        begin = deque.map + (deque.map_count - new_nodes) / 2 + (front ? count : 0);
+        std::memmove(begin, deque.begin.node, old_nodes * sizeof(T*));
+    }
+    else
+    {
+        unsigned int size = deque.map_count + (deque.map_count < count ? count : deque.map_count) + 2;
+        T** map = static_cast<T**>(AllocateNodeStorage(size * sizeof(T*)));
+        begin = map + (size - new_nodes) / 2 + (front ? count : 0);
+        std::memmove(begin, deque.begin.node, old_nodes * sizeof(T*));
+        WorldDequeStorage<T, Iterator>::FreeSlots(deque.map, deque.map_count * sizeof(T*));
+        deque.map = map;
+        deque.map_count = size;
+    }
+    deque.begin.node = begin;
+    deque.begin.first = *begin;
