+void ResourceLightRasterHalf(unsigned char* light, const unsigned char* source,
+    unsigned short*, unsigned int pitch, int x, int y, int width, int height,
+    int left, int top, int right, int bottom)
+{
+    unsigned char* start = light + pitch * (y / 2) + x / 2;
+    bool unclipped = left <= 0 && top <= 0 && right >= width && bottom >= height;
+    if (!unclipped)
+        SkipResourceLightRows(source, width, top);
+    int rows = unclipped ? height : bottom - top;
+    for (int row = 0; row < rows; ++row)
+    {
+        unsigned char* destination = start + (row / 2) * pitch;
+        int remaining_left = left;
+        int column = 0;
+        while (column < width)
+        {
+            int run = static_cast<signed char>(*source++);
+            if (run >= 0)
+            {
+                while (run--)
+                {
+                    if (left > 0 && remaining_left)
+                        --remaining_left;
+                    else if ((unclipped || column < right) && !((x + column) & 1) && !((y + row) & 1))
+                        RaiseResourceLight(destination++, *source);
+                    ++source;
+                    ++column;
+                }
+            }
+            else
+            {
+                unsigned char skip = static_cast<unsigned char>(-run);
+                if (left > 0)
+                {
+                    while (remaining_left && skip)
+                    {
+                        --remaining_left;
+                        ++column;
+                        --skip;
+                    }
+                }
+                int count = static_cast<signed char>(skip);
+                for (int index = 0; index < count; ++index, ++column)
+                    if (!((x + column) & 1) && !((y + row) & 1))
+                        ++destination;
+            }
+        }
+    }
+}
