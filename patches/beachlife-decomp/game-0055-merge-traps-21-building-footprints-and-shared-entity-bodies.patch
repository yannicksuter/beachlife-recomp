+static void RaiseResourceLight(unsigned char* destination, unsigned char source)
+{
+    int level = static_cast<int>(source) - 24;
+    if (level > *destination)
+        *destination = static_cast<unsigned char>(level);
+}
+
+static void SkipResourceLightRows(const unsigned char*& source, int width, int rows)
+{
+    for (int row = 0; row < rows; ++row)
+    {
+        int column = 0;
+        while (column < width)
+        {
+            int run = static_cast<signed char>(*source++);
+            if (run >= 0)
+            {
+                column += run;
+                source += run;
+            }
+            else
+                column -= run;
+        }
+    }
+}
