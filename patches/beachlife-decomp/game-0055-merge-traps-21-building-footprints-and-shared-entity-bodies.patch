+// FUNCTION: BEACHLIFE 0x00407110
+void ResourceLightRaster(unsigned char* light, const unsigned char* source,
+    unsigned short*, unsigned int pitch, int x, int y, int width, int height,
+    int left, int top, int right, int bottom)
+{
+    unsigned char* row_start = light + pitch * y + x;
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int row = 0; row < height; ++row, row_start += pitch)
+        {
+            unsigned char* destination = row_start;
+            int column = 0;
+            while (column < width)
+            {
+                int run = static_cast<signed char>(*source++);
+                if (run > 0)
+                {
+                    column += run;
+                    while (run--)
+                        RaiseResourceLight(destination++, *source++);
+                }
+                else
+                {
+                    column -= run;
+                    destination -= run;
+                }
+            }
+        }
+        return;
+    }
+    SkipResourceLightRows(source, width, top);
+    for (int row = 0; row < bottom - top; ++row, row_start += pitch)
+    {
+        unsigned char* destination = row_start;
+        int column = 0;
+        int remaining_left = left;
+        while (column < width)
+        {
+            int run = static_cast<signed char>(*source++);
+            if (run >= 0)
+            {
+                while (run--)
+                {
+                    if (left > 0 && remaining_left)
+                        --remaining_left;
+                    else if (column < right)
+                        RaiseResourceLight(destination++, *source);
+                    ++source;
+                    ++column;
+                }
+            }
+            else if (left > 0)
+            {
+                unsigned char skip = static_cast<unsigned char>(-run);
+                while (remaining_left && skip)
+                {
+                    --remaining_left;
+                    ++column;
+                    --skip;
+                }
+                int count = static_cast<signed char>(skip);
+                column += count;
+                destination += count;
+            }
+            else
+            {
+                if (column < right)
+                    destination -= run;
+                column -= run;
+            }
+        }
+    }
+}
