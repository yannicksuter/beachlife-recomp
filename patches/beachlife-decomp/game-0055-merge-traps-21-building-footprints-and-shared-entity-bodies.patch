+// FUNCTION: BEACHLIFE 0x0043aac0
+template <>
+WorldDequeIterator<WorldWeatherEvent*> WorldDequeStorage<WorldWeatherEvent*>::Insert(
+    WorldDequeIterator<WorldWeatherEvent*> position, WorldWeatherEvent* const& source)
+{
+    if (position.current == begin.current)
+    {
+        WorldDequePushFront(*this, source);
+        return begin;
+    }
+    if (position.current == end.current)
+    {
+        WorldDequePushBack(*this, source);
+        return WorldDequeAdvance(end, -1);
+    }
+    WorldWeatherEvent* value = source;
+    int index = WorldDequeDistance(position, begin);
+    unsigned int size = WorldDequeDistance(end, begin);
+    if (index < static_cast<int>(size / 2))
+    {
+        WorldDequePushFront(*this, *begin.current);
+        for (int i = 1; i < index; ++i)
+            At(i) = At(i + 1);
+    }
+    else
+    {
+        WorldDequePushBack(*this, *WorldDequeAdvance(end, -1).current);
+        for (int i = size - 1; i > index; --i)
+            At(i) = At(i - 1);
+    }
+    position = WorldDequeAdvance(begin, index);
+    *position.current = value;
+    return position;
+}
