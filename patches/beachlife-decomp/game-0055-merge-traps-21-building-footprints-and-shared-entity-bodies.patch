+// FUNCTION: BEACHLIFE 0x004092c0
+void ExpandOverlayArchive(const unsigned char* source, void* destination)
+{
+    if (!source)
+        return;
+    unsigned int flags = (static_cast<unsigned int>(source[0]) << 8) + source[1];
+    source += 2;
+    if (flags & 0x100)
+        source += 3;
+    source += 3;
+    unsigned char* output = static_cast<unsigned char*>(destination);
+    for (;;)
+    {
+        unsigned int control = *source++;
+        unsigned int literals;
+        unsigned int distance;
+        unsigned int count;
+        if (!(control & 0x80))
+        {
+            unsigned int second = *source++;
+            literals = control & 3;
+            distance = ((control & 0x60) << 3) + second + 1;
+            count = ((control >> 2) & 7) + 3;
+        }
+        else if (!(control & 0x40))
+        {
+            unsigned int second = *source++;
+            unsigned int third = *source++;
+            literals = second >> 6;
+            distance = ((second & 0x3f) << 8) + third + 1;
+            count = (control & 0x3f) + 4;
+        }
+        else if (!(control & 0x20))
+        {
+            unsigned int second = *source++;
+            unsigned int third = *source++;
+            unsigned int fourth = *source++;
+            literals = control & 3;
+            distance = ((control & 0x10) << 12) + (second << 8) + third + 1;
+            count = ((control & 0x0c) << 6) + fourth + 5;
+        }
+        else
+        {
+            count = control < 0xfc ? ((control & 0x1f) + 1) * 4 : control & 3;
+            while (count--)
+                *output++ = *source++;
+            if (control >= 0xfc)
+                return;
+            continue;
+        }
+        while (literals--)
+            *output++ = *source++;
+        unsigned char* previous = output - distance;
+        while (count--)
+            *output++ = *previous++;
+    }
+}
