+int SkipCursorFrameComments(const char* text)
+{
+    if (*text != '/')
+        return 0;
+    int count = 1;
+    while (text[count] != '\n')
+        ++count;
+    count += CursorFrameWhitespace(text + count);
+    count += SkipCursorFrameComments(text + count);
+    count += CursorFrameWhitespace(text + count);
+    return count;
