--- /dev/null
+++ a/src/startup_list_insert.cpp
@@ -0,0 +1,16 @@
+#include "startup_list.h"
+
+// LIBRARY: BEACHLIFE 0x004b2fb0
+// ?Insert@CircularList@@QAE?AUCircularListIterator@@U2@ABQAUActiveScreenEntry@@@Z
+CircularListIterator CircularList::Insert(CircularListIterator position, ActiveScreenEntry* const& entry)
+{
+    CircularListValueNode* node = CreateNode(entry);
+    CircularListNode* previous = position.node->previous;
+    node->next = position.node;
+    node->previous = previous;
+    previous->next = node;
+    position.node->previous = node;
+    CircularListIterator result;
+    result.node = node;
+    return result;
+}
