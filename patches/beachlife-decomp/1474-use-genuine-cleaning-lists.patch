diff --git a/src/startup_world_cleaning_lists.h b/src/startup_world_cleaning_lists.h
new file mode 100644
index 0000000..3becec7
--- /dev/null
+++ b/src/startup_world_cleaning_lists.h
@@ -0,0 +1,57 @@
+#ifndef STARTUP_WORLD_CLEANING_LISTS_H
+#define STARTUP_WORLD_CLEANING_LISTS_H
+
+#include "startup_world_subsystems.h"
+
+#include <algorithm>
+
+// Matching retention of the cleaning lists' out-of-line vendor members: insert
+// 0x00420b40/0x00420bb0 and their node constructors 0x00420be0/0x00420ca0.
+struct WorldCleaningRequestListRetention : WorldCleaningRequestList
+{
+    static void Insert(WorldCleaningRequestListRetention* self, WorldCleaningRequest* const& request);
+    static void CreateNode(WorldCleaningRequestListRetention* self, WorldCleaningRequest* const& request);
+};
+
+struct WorldCleaningAssignmentListRetention : WorldCleaningAssignmentList
+{
+    static void Insert(WorldCleaningAssignmentListRetention* self, WorldCleaningAssignment* const& assignment);
+    static void CreateNode(WorldCleaningAssignmentListRetention* self, WorldCleaningAssignment* const& assignment);
+};
+
+typedef WorldList<WorldCleaningRequest*>::Node WorldCleaningRequestNode;
+typedef WorldList<WorldCleaningAssignment*>::Node WorldCleaningAssignmentNode;
+
+// The record searches as retail's /Ob1 methods make them: begin(), end() and
+// the search stay out of line and the found node is read from the result.
+inline std::_List_node_base* FindCleaningNode(WorldCleaningRequestList& list, unsigned int id)
+{
+    return FindListRecord(list.begin(), list.end(), ListRecordIdEquals<WorldCleaningRequest>(id))._M_node;
+}
+inline std::_List_node_base* FindCleaningNode(WorldCleaningAssignmentList& list, unsigned int id)
+{
+    return FindListRecord(list.begin(), list.end(), ListRecordIdEquals<WorldCleaningAssignment>(id))._M_node;
+}
+
+// The image folds both instances with the other pointer-delete callbacks
+// (0x004209c0).
+template <class Record>
+void DeleteCleaningRecord(Record* record)
+{
+    ::operator delete(record);
+}
+// VC6 does not instantiate a function template whose address is only passed.
+template void DeleteCleaningRecord<WorldCleaningRequest>(WorldCleaningRequest*);
+template void DeleteCleaningRecord<WorldCleaningAssignment>(WorldCleaningAssignment*);
+
+// Retail's release of both lists (destructor and LoadState).
+inline void ClearCleaningLists(WorldCleaningManager* manager)
+{
+    std::for_each(manager->requests_00.begin(), manager->requests_00.end(), DeleteCleaningRecord<WorldCleaningRequest>);
+    manager->requests_00.clear();
+    std::for_each(
+        manager->assignments_08.begin(), manager->assignments_08.end(), DeleteCleaningRecord<WorldCleaningAssignment>);
+    manager->assignments_08.clear();
+}
+
+#endif
