+    FILE* file = fopen(filename, "rb");
+    if (!file)
+        return;
+    fclose(file);
+    int size = GetUncheckedConfigFileSize(filename) + 1;
+    char* buffer = new char[size];
+    ReadConfigFileBuffer(filename, buffer, size);
+    buffer[size - 1] = 0;
+    if (AllocateTokens(CountConfigTokens(buffer, size)))
+        ParseTokens(buffer, size);
+    delete[] buffer;
+}
