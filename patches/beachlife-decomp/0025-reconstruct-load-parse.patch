+static inline int GetUncheckedConfigFileSize(const char* filename)
+{
+    FILE* file = fopen(filename, "rb");
+    if (!file)
+        return 0;
+    fpos_t position;
+    fseek(file, 0, SEEK_END);
+    fgetpos(file, &position);
+    fclose(file);
+    return (int)position;
+}
