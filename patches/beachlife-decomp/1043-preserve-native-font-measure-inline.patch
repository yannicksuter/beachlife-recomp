+++ a/src/startup_font_measure_text.cpp
@@ -1 +1,24 @@
-#include "startup_screen_font_inlines.h"
+#include "startup_screen_text.h"
+#include "startup_screen_font_data.h"
+
+// FUNCTION: BEACHLIFE 0x0049fa30
+unsigned int ScreenFontRenderer::MeasureText(const unsigned short* text)
+{
+    ScreenFontData* data = data_1c;
+    unsigned int width = 0;
+    while (*text != 0)
+    {
+        unsigned int current = *text;
+        unsigned short advance = static_cast<unsigned short>(
+            data->glyphs[current][2] - data->glyphs[current][0]);
+        unsigned int next = text[1];
+        if (next != 0)
+        {
+            advance = static_cast<unsigned short>(
+                advance + data->kerning[current * 255 + next]);
+        }
+        width += advance;
+        ++text;
+    }
+    return width;
+}
