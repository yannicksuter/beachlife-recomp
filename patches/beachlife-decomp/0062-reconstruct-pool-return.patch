+#ifndef POOL_LOCK_ACQUIRE_INLINE_H
+#define POOL_LOCK_ACQUIRE_INLINE_H
+
+#include "pool_lock_acquire.h"
+
+// Shared source for the observed standalone and inlined acquisition bodies.
+// This factoring does not identify the original template or class declaration.
+inline void AcquirePoolLockBody(volatile LONG* lock)
+{
+    if (InterlockedExchange(const_cast<LONG*>(lock), 1) == 0)
+        return;
+    const unsigned int spin_limit = pool_spin_limit;
+    const unsigned int last_spin = pool_last_spin;
+    // The observed four repeated squares each read this word twice and write
+    // it back. Unsigned arithmetic preserves the evidenced low32-bit wrap.
+    volatile unsigned int delay = 17;
+    for (unsigned int spin = 0; spin < spin_limit; ++spin)
+    {
+        if (spin >= last_spin / 2 && *lock == 0)
+        {
+            if (InterlockedExchange(const_cast<LONG*>(lock), 1) == 0)
+            {
+                pool_last_spin = spin;
+                pool_spin_limit = 1000;
+                return;
+            }
+        }
+        else
+        {
+            delay = delay * delay;
+            delay = delay * delay;
+            delay = delay * delay;
+            delay = delay * delay;
+        }
+    }
+    pool_spin_limit = 30;
+    for (int attempt = 6;; ++attempt)
+    {
+        int capped = attempt;
+        if (capped > 27)
+            capped = 27;
+        if (InterlockedExchange(const_cast<LONG*>(lock), 1) == 0)
+            return;
+        if (capped <= 20)
+            Sleep(0);
+        else
+            Sleep(1u << (capped - 20));
+    }
+}
+
+#endif
