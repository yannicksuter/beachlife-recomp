+#include "startup_screen_mode_world.h"
+
+// Matching retention of the command lists' out-of-line vendor members:
+// insert 0x0042e5b0 with its node constructor 0x0042e5e0, erase 0x0042e4e0,
+// clear 0x0042e6f0 and the node deallocation 0x0042e6a0.
+struct ScreenModeCommandListRetention : ScreenModeCommandList
+{
+    typedef ScreenModeCommandList::iterator (ScreenModeCommandList::*InsertMember)(
+        ScreenModeCommandList::iterator, const ScreenModeCommand&);
+    typedef ScreenModeCommandList::_Node* (ScreenModeCommandList::*CreateNodeMember)(const ScreenModeCommand&);
+    typedef ScreenModeCommandList::iterator (ScreenModeCommandList::*EraseMember)(ScreenModeCommandList::iterator);
+    typedef void (std::_List_base<ScreenModeCommand, std::allocator<ScreenModeCommand> >::*ClearMember)();
+    typedef std::allocator<ScreenModeCommandList::_Node> NodeAllocator;
+    typedef void (NodeAllocator::*DeallocateMember)(ScreenModeCommandList::_Node*, size_t) const;
+
+    // The node constructor is protected in the vendor list.
+    static CreateNodeMember CreateNode()
+    {
+        return &ScreenModeCommandListRetention::_M_create_node;
+    }
+};
+
+#endif
