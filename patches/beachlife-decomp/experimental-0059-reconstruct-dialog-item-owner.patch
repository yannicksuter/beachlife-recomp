+++ b/src/startup_surface_prepare.cpp
@@ -0,0 +1,56 @@
+#include "startup_screen_renderer.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0040e0d0
+void ScreenRequestRenderer::PrepareSurface(int surface)
+{
+    ScreenSurfacePosition* selected = surfaces[surface];
+    if (selected->prepared == 0)
+    {
+        unsigned int x;
+        unsigned int y;
+        if (software_mode == 0)
+        {
+            unsigned short color = fill_color;
+            SurfaceColorKey key;
+            key.low = color;
+            key.high = color;
+            selected->surface->vtable->SetColorKey(selected->surface, 8, &key);
+
+            SurfaceDescription description;
+            memset(&description, 0, sizeof(description));
+            description.size = sizeof(description);
+            if (surfaces[surface]->surface->vtable->Lock(
+                    surfaces[surface]->surface, 0, &description, 0, 0)
+                >= 0)
+            {
+                unsigned short* row = static_cast<unsigned short*>(description.pixels);
+                for (y = 0; y < description.height; ++y)
+                {
+                    unsigned short* pixel = row;
+                    for (x = 0; x < description.width; ++x)
+                    {
+                        *pixel++ = color;
+                    }
+                    row += description.pitch / 2;
+                }
+                surfaces[surface]->surface->vtable->Unlock(surfaces[surface]->surface, 0);
+            }
+        }
+        else
+        {
+            unsigned int width = selected->pitch / 2;
+            unsigned short* row = selected->pixels;
+            for (y = 0; y < selected->height; ++y)
+            {
+                unsigned short* pixel = row;
+                for (x = 0; x < width; ++x)
+                {
+                    *pixel++ = fill_color;
+                }
+                row += width;
+            }
+        }
+        surfaces[surface]->prepared = 1;
+    }
+}
