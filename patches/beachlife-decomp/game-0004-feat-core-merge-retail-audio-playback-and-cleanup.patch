diff --git a/src/window_audio_set_sound_level.cpp b/src/window_audio_set_sound_level.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..26ed1be1d83aca1c4f83c4653cb8ec5fa0e42778
--- /dev/null
+++ b/src/window_audio_set_sound_level.cpp
@@ -0,0 +1,45 @@
+#include "miles_imports.h"
+#include "window_audio.h"
+#include "window_sound_voice.h"
+
+// FUNCTION: BEACHLIFE 0x004cfb00
+void WindowAudioState::SetSoundLevel(int voice, float level)
+{
+    if (voice < 0)
+    {
+        return;
+    }
+
+    // The original keeps this product on the x87 stack through both clamps.
+    long double adjusted = static_cast<long double>(level) * static_cast<long double>(scale_d8);
+    if (!(adjusted >= 0.0L))
+    {
+        adjusted = 0.0L;
+    }
+    else if (adjusted > 1.0L)
+    {
+        adjusted = 1.0L;
+    }
+
+    int volume = static_cast<int>(adjusted * 127.0L);
+    if (volume < 3)
+    {
+        volume = 0;
+    }
+
+    WindowSoundVoice* current = voice < 16 ? voices_74[voice] : voices_b4[voice - 16];
+    if (!current)
+    {
+        return;
+    }
+
+    if (voice >= 16)
+    {
+        AIL_set_3D_sample_volume(samples_54[voice - 16], volume);
+        return;
+    }
+
+    AIL_set_sample_volume(samples_14[voice], volume);
+    // Reload after the SDK call; copy the original argument, not the clamp.
+    voices_74[voice]->scale_14 = level;
+}
