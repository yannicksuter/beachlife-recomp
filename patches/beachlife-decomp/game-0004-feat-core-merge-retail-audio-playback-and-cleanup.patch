@@ -0,0 +1,59 @@
+#include "miles_imports.h"
+#include "window_audio.h"
+#include "window_sound_bank.h"
+#include "window_sound_voice.h"
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004cf440
+void WindowAudioState::Update(float delta)
+{
+    if (!enabled)
+    {
+        return;
+    }
+
+    UpdateVoiceFades(delta);
+
+    for (int index = 0; index < 16; ++index)
+    {
+        if (AIL_sample_status(samples_14[index]) == 2 && voices_74[index])
+        {
+            const char* name = voices_74[index]->name;
+            bank_f4->ReleaseSample(name);
+            WindowSoundVoice* voice = voices_74[index];
+            if (voice)
+            {
+                if (voice->name)
+                {
+                    ::operator delete(voice->name);
+                }
+                ::operator delete(voice);
+            }
+            voices_74[index] = 0;
+        }
+    }
+
+    if (enabled_3d)
+    {
+        for (int index = 0; index < 8; ++index)
+        {
+            if (AIL_3D_sample_status(samples_54[index]) == 2 && voices_b4[index])
+            {
+                const char* name = voices_b4[index]->name;
+                bank_f4->ReleaseSample(name);
+                WindowSoundVoice* voice = voices_b4[index];
+                if (voice)
+                {
+                    if (voice->name)
+                    {
+                        ::operator delete(voice->name);
+                    }
+                    ::operator delete(voice);
+                }
+                voices_b4[index] = 0;
+            }
+        }
+    }
+
+    bank_f4->UpdateCache(delta);
+}
diff --git a/src/window_audio_voice_fades.cpp b/src/window_audio_voice_fades.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..14011bde209d364a25f72aa594c1d76594ac1c1a
--- /dev/null
+++ b/src/window_audio_voice_fades.cpp
@@ -0,0 +1,74 @@
+#include "miles_imports.h"
+#include "window_audio.h"
+#include "window_sound_voice.h"
+
+// FUNCTION: BEACHLIFE 0x004d0440
+void WindowAudioState::UpdateVoiceFades(float delta)
+{
+    for (int index = 0; index < 24; ++index)
+    {
+        WindowSoundVoice*& current = index < 16 ? voices_74[index] : voices_b4[index - 16];
+        void*& sample = index < 16 ? samples_14[index] : samples_54[index - 16];
+        WindowSoundVoice* voice = current;
+        if (!voice || !voice->word_10)
+        {
+            continue;
+        }
+
+        // FST stores binary32 without popping the value used by FCOMP.
+        long double remaining =
+            static_cast<long double>(voice->fade_28) - static_cast<long double>(delta);
+        voice->fade_28 = static_cast<float>(remaining);
+        bool finished = !(remaining >= 0.0L);
+        long double volume = static_cast<long double>(voice->volume_18);
+        if (finished)
+        {
+            int converted_volume = static_cast<int>(volume);
+            if (current)
+            {
+                if (index < 16)
+                {
+                    AIL_set_sample_volume(sample, converted_volume);
+                }
+                else
+                {
+                    AIL_set_3D_sample_volume(sample, converted_volume);
+                }
+            }
+
+            if (voice->word_10 == 2 && index >= 0 && current)
+            {
+                if (index < 16)
+                {
+                    AIL_end_sample(sample);
+                }
+                else if (enabled_3d)
+                {
+                    AIL_end_3D_sample(sample);
+                }
+            }
+            voice->word_10 = 0;
+        }
+        else
+        {
+            volume -= static_cast<long double>(voice->word_1c);
+            volume /= static_cast<long double>(voice->fade_24);
+            volume *= static_cast<long double>(delta);
+            volume += static_cast<long double>(voice->word_20);
+            // The following _ftol consumes the retained value, not this store.
+            voice->word_20 = static_cast<float>(volume);
+            int converted_volume = static_cast<int>(volume);
+            if (current)
+            {
+                if (index < 16)
+                {
+                    AIL_set_sample_volume(sample, converted_volume);
+                }
+                else
+                {
+                    AIL_set_3D_sample_volume(sample, converted_volume);
+                }
+            }
+        }
+    }
+}
