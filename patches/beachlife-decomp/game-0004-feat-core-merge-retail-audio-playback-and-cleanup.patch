diff --git a/src/window_audio_destructor.cpp b/src/window_audio_destructor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f2929c86fd019cbd54fee20c832de850699c2063
--- /dev/null
+++ b/src/window_audio_destructor.cpp
@@ -0,0 +1,82 @@
+#include "miles_imports.h"
+#include "window_audio.h"
+#include "window_audio_initialization.h"
+#include "window_sound_bank.h"
+#include "window_sound_voice.h"
+
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004cf330
+WindowAudioState::~WindowAudioState() noexcept(false)
+{
+    try
+    {
+        if (enabled)
+        {
+            void(__stdcall * end_3d_sample)(void*) = AIL_end_3D_sample;
+            for (int index = 0; index < 24; ++index)
+            {
+                if (index >= 0)
+                {
+                    WindowSoundVoice* voice = index < 16 ? voices_74[index] : voices_b4[index - 16];
+                    if (voice)
+                    {
+                        if (index >= 16)
+                        {
+                            if (enabled_3d)
+                            {
+                                end_3d_sample(samples_54[index - 16]);
+                            }
+                        }
+                        else
+                        {
+                            AIL_end_sample(samples_14[index]);
+                        }
+                    }
+                }
+            }
+
+            Update(0.0f);
+            void* current_stream = stream;
+            if (current_stream)
+            {
+                AIL_close_stream(current_stream);
+            }
+            if (enabled_3d)
+            {
+                AIL_close_3D_provider(provider_08);
+            }
+            AIL_close_digital_driver(digital_driver);
+            AIL_shutdown();
+        }
+
+        for (int index = 0; index < 24; ++index)
+        {
+            WindowSoundVoice*& slot = index < 16 ? voices_74[index] : voices_b4[index - 16];
+            WindowSoundVoice* voice = slot;
+            if (voice)
+            {
+                char* name = voice->name;
+                if (name)
+                {
+                    ::operator delete(name);
+                }
+                ::operator delete(voice);
+                slot = 0;
+            }
+        }
+
+        WindowSoundBank* bank = bank_f4;
+        if (bank)
+        {
+            bank->~WindowSoundBank();
+            ::operator delete(bank);
+        }
+    }
+    catch (...)
+    {
+        ClearRegistration();
+        throw;
+    }
+    window_audio_state = 0;
+}
diff --git a/src/window_audio_initialize_3d_provider.cpp b/src/window_audio_initialize_3d_provider.cpp
