index 0000000000000000000000000000000000000000..970a99a1d23ae37b4238067984db711a0ce02b57
--- /dev/null
+++ b/src/window_audio_initialize_3d_provider.cpp
@@ -0,0 +1,42 @@
+#include "miles_imports.h"
+#include "window_audio.h"
+
+#include <string.h>
+
+extern "C" int _stricmp(const char*, const char*);
+
+// FUNCTION: BEACHLIFE 0x004d0370
+void WindowAudioState::Initialize3DProvider(const char* provider_name)
+{
+    unsigned int cursor = 0;
+    const char* names[64];
+    void* providers[64];
+    void* selected = 0;
+    unsigned int index = 0;
+
+    if (!AIL_enumerate_3D_providers(&cursor, &providers[index], &names[index]))
+    {
+        return;
+    }
+
+    do
+    {
+        if (_stricmp(names[index], provider_name) == 0)
+        {
+            selected = providers[index];
+        }
+        ++index;
+    } while (AIL_enumerate_3D_providers(&cursor, &providers[index], &names[index]));
+
+    if (selected != 0 && AIL_open_3D_provider(selected) == 0)
+    {
+        enabled_3d = 1;
+        provider_08 = selected;
+        void* listener = AIL_open_3D_listener(selected);
+        listener_dc = listener;
+        position_x_e0 = 0.0f;
+        position_y_e4 = 0.0f;
+        position_z_e8 = 0.0f;
+        AIL_set_3D_position(listener, 0.0f, 0.0f, 0.0f);
+    }
+}
