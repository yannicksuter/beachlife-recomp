diff --git a/src/window_audio_playback.cpp b/src/window_audio_playback.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b0565d4640a31fece3e26243e9bf3d871d2aa5c5
--- /dev/null
+++ b/src/window_audio_playback.cpp
@@ -0,0 +1,95 @@
+#include "miles_imports.h"
+#include "window_audio.h"
+#include "window_sound_bank.h"
+#include "window_sound_voice.h"
+#include <new>
+#include <stdio.h>
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004d0040
+int WindowAudioState::PlaySoundWithParameters(
+    const char* name, int volume, unsigned int flags, float fade, float scale)
+{
+    int result = -1;
+    if (enabled)
+    {
+        int index;
+        for (index = 0; index < 16; ++index)
+        {
+            if (voices_74[index] == 0)
+            {
+                break;
+            }
+        }
+        if (index == 16)
+        {
+            return result;
+        }
+
+        void* sample = samples_14[index];
+        AIL_init_sample(sample);
+        result = index;
+        if (sample)
+        {
+            char filename[64];
+            sprintf(filename, "%s%s", name, window_sound_wave_extension);
+            unsigned int bytes;
+            void* data = bank_f4->FindSample(filename, &bytes);
+            if (data)
+            {
+                WindowSoundVoice* voice = new WindowSoundVoice;
+                if (voice)
+                {
+                    voice->name = 0;
+                    voice->data_04 = 0;
+                    voice->word_08 = 0;
+                    voice->bytes_0c = 0;
+                    voice->word_10 = 0;
+                    voice->byte_2c = 0;
+                    voice->word_30 = -1;
+                }
+                voices_74[index] = voice;
+                voice->data_04 = data;
+                voice->bytes_0c = bytes;
+                voice->name = static_cast<char*>(::operator new(strlen(filename) + 1));
+                strcpy(voice->name, filename);
+
+                unsigned int format = voice->word_08;
+                unsigned int sample_bytes = voice->bytes_0c;
+                void* sample_data = voice->data_04;
+                const char* extension = window_sound_wave_extension;
+                if (format)
+                {
+                    extension = window_sound_mp3_extension;
+                }
+                AIL_set_named_sample_file(sample, extension, sample_data, sample_bytes, 0);
+
+                float target_volume = static_cast<float>(volume);
+                voice->scale_14 = scale;
+                voice->volume_18 = target_volume;
+                int initial_volume;
+                if (fade > 0.0f)
+                {
+                    voice->word_10 = 1;
+                    voice->fade_28 = fade;
+                    voice->fade_24 = fade;
+                    voice->word_1c = 0;
+                    voice->word_20 = 0;
+                    initial_volume = 0;
+                }
+                else
+                {
+                    initial_volume = volume;
+                }
+
+                if (flags & 2)
+                {
+                    AIL_set_sample_loop_count(sample, 0);
+                }
+                AIL_start_sample(sample);
+                AIL_set_sample_volume(sample, initial_volume);
+            }
+        }
+    }
+    return result;
+}
