+// FUNCTION: BEACHLIFE 0x0048feb0
+void WorldStaffEntity::WriteValue(const char* key, const void* value)
+{
+    if (strncmp(key, "STAFF_WAGES", 11) == 0)
+    {
+        const unsigned int* wages = static_cast<const unsigned int*>(value);
+        if (*wages > wages_108)
+            AddThought(0x4000000);
+        else
+            AddThought(0x8000000);
+        wages_108 = *wages;
+        if (wages_108 < 5)
+            wages_108 = 5;
+        UpdateWageMorale();
+    }
+    else
+        StartupFatal("StaffObject::SetVariable - data keyword not recognised - %s", key);
+}
