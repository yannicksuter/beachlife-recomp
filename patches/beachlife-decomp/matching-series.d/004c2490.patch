+
+// FUNCTION: BEACHLIFE 0x004c2490
+void ScreenLoadPanel13c::Update()
+{
+    if (state_1c)
+    {
+        // A requested music rescan: rebuild the playlist under a forced pause
+        // and close the "MP3Refreshing" notice.
+        screen_manager->SavePauseState();
+        owner_00->StopPlayback();
+        owner_00->SetCurrentEntry(0);
+        owner_00->ClearEntries();
+        ReloadFromStore();
+        screen_request_game->placement->ResetMusicDefaults();
+        InitializeContents(1);
+        RefreshList(1);
+        list_04->SelectRow(0, 1);
+        EnableControls();
+        state_1c = 0;
+        screen_manager->CloseScreen("MP3Refreshing");
+        screen_manager->RestorePauseState();
+    }
+
+    bool advanced = owner_00->UpdatePlayback();
+    if (!state_0c)
+        return;
+
+    // Moving and repeating only work for a single selected track.
+    ScreenListBoxSelectionRange& selection = list_04->selection;
+    int selected = static_cast<int>(selection.end - selection.begin);
+    if (selected != word_08)
+    {
+        if (selected > 1)
+        {
+            if (word_08 <= 1)
+            {
+                screen_manager->DisableNamedItems(mp3_button_move_up);
+                screen_manager->DisableNamedItems(mp3_button_move_down);
+                screen_manager->DisableNamedItems(mp3_button_repeat);
+            }
+        }
+        else if (word_08 > 1)
+        {
+            screen_manager->EnableNamedItems(mp3_button_move_up);
+            screen_manager->EnableNamedItems(mp3_button_move_down);
+            screen_manager->EnableNamedItems(mp3_button_repeat);
+        }
+        word_08 = selected;
+    }
+
+    if (owner_00->EntryCount() == 0)
+    {
+        screen_manager->DisableNamedItems(mp3_button_move_up);
+        screen_manager->DisableNamedItems(mp3_button_move_down);
+        screen_manager->DisableNamedItems(mp3_button_repeat);
+        screen_manager->DisableNamedItems(mp3_button_sun);
+        screen_manager->DisableNamedItems(mp3_button_moon);
+        screen_manager->DisableNamedItems(mp3_button_delete);
+        screen_manager->DisableNamedItems(mp3_button_shuffle);
+        screen_manager->DisableNamedItems(mp3_button_play);
+    }
+
+    if (list_04->state_95)
+        HandleAction(7);
+
+    if (advanced && state_0c)
+    {
+        ScreenListBoxPrefix* list = list_04;
+        int top = list->word_64;
+        list->word_84 = 0;
+        int row = list->selection.begin[0];
+        RefreshList(0);
+        list_04->SetFirstVisibleRow(top);
+        list_04->EnsureRowVisible(row);
+    }
+}
