+// FUNCTION: BEACHLIFE 0x0044e410
+void VariableCatalog::ParseObject(unsigned int id, const char* key, const char* value)
+{
+    VariableCatalogObjectDefinition* object = &objects_4f1a4[id];
+    if (strcmp(key, "NAME") == 0)
+        strcpy(reinterpret_cast<char*>(object->unknown_44), value);
+    else if (strcmp(key, "TABLE_SPRITE") == 0)
+        strcpy(object->resource_c4, value);
+    else if (strcmp(key, "CHAIR_SPRITE") == 0)
+        strcpy(object->resource_1c4, value);
+    else if (strcmp(key, "GRIDWIDTH") == 0)
+        *reinterpret_cast<int*>(object->unknown_348 + 0x80) = atoi(value);
+    else if (strcmp(key, "GRIDHEIGHT") == 0)
+        *reinterpret_cast<int*>(object->unknown_348 + 0x84) = atoi(value);
+    else if (strcmp(key, "CAPACITY") == 0)
+    {
+        object->frame_count_3d0 = atoi(value);
+        object->data_3f0 = ::operator new(object->frame_count_3d0 * sizeof(unsigned int));
+        object->frames_3f4 = static_cast<void**>(::operator new(object->frame_count_3d0 * sizeof(void*)));
+    }
+    else if (strcmp(key, "NUM_WALK_PTS") == 0)
+        object->data_3e0 = new ScreenMapPosition[atoi(value)];
+    else if (strcmp(key, "WALK_PNT_X") == 0)
+        static_cast<ScreenMapPosition*>(object->data_3e0)[*reinterpret_cast<unsigned int*>(object->unknown_3d8 + 4)].x = static_cast<float>(atof(value));
+    else if (strcmp(key, "WALK_PNT_Y") == 0)
+    {
+        unsigned int& count = *reinterpret_cast<unsigned int*>(object->unknown_3d8 + 4);
+        static_cast<ScreenMapPosition*>(object->data_3e0)[count].y = static_cast<float>(atof(value));
+        ++count;
+    }
+    else if (strcmp(key, "NUM_CHAIRPOS_PTS") == 0)
+        object->data_3e8 = new ScreenMapPosition[atoi(value)];
+    else if (strcmp(key, "CHAIRPOS_X") == 0)
+        static_cast<ScreenMapPosition*>(object->data_3e8)[*reinterpret_cast<unsigned int*>(object->unknown_3e4 + 0)].x = static_cast<float>(atof(value));
+    else if (strcmp(key, "CHAIRPOS_Y") == 0)
+    {
+        unsigned int& count = *reinterpret_cast<unsigned int*>(object->unknown_3e4 + 0);
+        static_cast<ScreenMapPosition*>(object->data_3e8)[count].y = static_cast<float>(atof(value));
+        ++count;
+    }
+    else if (strcmp(key, "CHAIR_DIRECTION") == 0)
+    {
+        unsigned int& count = *reinterpret_cast<unsigned int*>(object->unknown_3ec);
+        if (strcmp(value, "N") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 0;
+        else if (strcmp(value, "NE") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 1;
+        else if (strcmp(value, "E") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 2;
+        else if (strcmp(value, "SE") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 3;
+        else if (strcmp(value, "S") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 4;
+        else if (strcmp(value, "SW") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 5;
+        else if (strcmp(value, "W") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 6;
+        else if (strcmp(value, "NW") == 0)
+            static_cast<unsigned int*>(object->data_3f0)[count] = 7;
+        else
+            StartupFatal("Invalid direction in table - %s", value);
+        ++count;
+    }
+    else if (strcmp(key, "CHAIR_NUM_WALKPNT") == 0)
+    {
+        object->frames_3f4[*reinterpret_cast<unsigned int*>(object->unknown_414 + 4)] = new int[atoi(value) + 1];
+        *static_cast<int*>(object->frames_3f4[*reinterpret_cast<unsigned int*>(object->unknown_414 + 4)]) = atoi(value);
+        ++*reinterpret_cast<unsigned int*>(object->unknown_414 + 4);
+        *reinterpret_cast<unsigned int*>(object->unknown_414 + 0) = 1;
+    }
+    else if (strcmp(key, "CHAIR_WALKPNT") == 0)
+    {
+        int point = atoi(value);
+        unsigned int count = *reinterpret_cast<unsigned int*>(object->unknown_414 + 4);
+        unsigned int& index = *reinterpret_cast<unsigned int*>(object->unknown_414 + 0);
+        static_cast<int*>(object->frames_3f4[count - 1])[index] = point;
+        ++index;
+    }
+    else if (strcmp(key, "SIT_DOWN_ANIM") == 0)
+        strcpy(reinterpret_cast<char*>(object->unknown_2c4), value);
+    else if (strcmp(key, "NUM_SAT_DOWN_ANIM") == 0)
+    {
+        int count = atoi(value);
+        object->names_344 = new void*[count];
+    }
+    else if (strcmp(key, "SAT_DOWN_ANIM") == 0)
+    {
+        object->names_344[object->name_count_3d4] = ::operator new(strlen(value) + 1);
+        strcpy(static_cast<char*>(object->names_344[object->name_count_3d4]), value);
+        ++object->name_count_3d4;
+    }
+    else if (strcmp(key, "GET_UP_ANIM") == 0)
+        strcpy(reinterpret_cast<char*>(object->unknown_348), value);
+    else if (strcmp(key, "SERVE_TABLE") == 0)
+    {
+        if (atoi(value) != 0)
+            object->flag_424 = 1;
+        else
+            object->flag_424 = 0;
+    }
+    else if (strcmp(key, "XOFFSET_TABLE") == 0)
+        object->draw_offset_x_41c = atoi(value);
+    else if (strcmp(key, "YOFFSET_TABLE") == 0)
+        object->draw_offset_y_420 = atoi(value);
+    else if (strcmp(key, "HAS_WAITER") == 0)
+    {
+        if (atoi(value) != 0)
+            object->flag_3f8 = 1;
+        else
+            object->flag_3f8 = 0;
+    }
+    else if (strcmp(key, "WAITER_SPRITE") == 0)
+    {
+        object->data_40c = new char[strlen(value) + 1];
+        strcpy(static_cast<char*>(object->data_40c), value);
+    }
+    else if (strcmp(key, "WAITER_WALK_ANIM") == 0)
+    {
+        object->data_404 = new char[strlen(value) + 1];
+        strcpy(static_cast<char*>(object->data_404), value);
+    }
+    else if (strcmp(key, "WAITER_SERVE_ANIM") == 0)
+    {
+        object->data_408 = new char[strlen(value) + 1];
+        strcpy(static_cast<char*>(object->data_408), value);
+    }
+    else if (strcmp(key, "CALL_WAITER_ANIM") == 0)
+    {
+        object->data_3fc = new char[strlen(value) + 1];
+        strcpy(static_cast<char*>(object->data_3fc), value);
+    }
+    else if (strcmp(key, "WAIT_WAITER_ANIM") == 0)
+    {
+        object->data_400 = new char[strlen(value) + 1];
+        strcpy(static_cast<char*>(object->data_400), value);
+    }
+    else if (strcmp(key, "WAITER_SERVE_POINT_X") == 0)
+    {
+        if (*reinterpret_cast<unsigned int*>(object->unknown_3d8 + 0) == 0)
+            object->data_410 = new ScreenMapPosition[object->frame_count_3d0];
+        static_cast<ScreenMapPosition*>(object->data_410)[*reinterpret_cast<unsigned int*>(object->unknown_3d8 + 0)].x = static_cast<float>(atof(value));
+    }
+    else if (strcmp(key, "WAITER_SERVE_POINT_Y") == 0)
+    {
+        unsigned int& count = *reinterpret_cast<unsigned int*>(object->unknown_3d8 + 0);
+        static_cast<ScreenMapPosition*>(object->data_410)[count].y = static_cast<float>(atof(value));
+        ++count;
+    }
+    else
+        StartupFatal("WorldParams::AddTableData - unrecognised Table keyword - %s", key);
+}
