+#include "window_audio.h"
+#include <math.h>
+
+static inline float ClampLevel(float level)
+{
+    if (level < 0.0f)
+        level = 0.0f;
+    else if (level > 1.0f)
+        level = 1.0f;
+    return level;
+}
+
+static inline int SoundVolume(float level)
+{
+    level = ClampLevel(level);
+    int volume = static_cast<int>(level * 127.0f);
+    if (volume < 3)
+        volume = 0;
+    return volume;
+}
+
+// FUNCTION: BEACHLIFE 0x004cf8f0
+int WindowAudioState::PlaySoundAtPosition(const char* name,
+    float level,
+    const WindowAudioVector* position,
+    unsigned int flags,
+    int voice)
+{
+    float adjusted = level * scale_d8;
+    int volume = SoundVolume(adjusted);
+    int result = -1;
+    if (!enabled_3d)
+    {
+        float far_distance = value_f0;
+        float near_distance = value_ec;
+        float dx = position_e0.x - position->x;
+        float dy = position_e0.y - position->y;
+        double distance = sqrt(dx * dx + dy * dy);
+        float stored = static_cast<float>(distance);
+        float attenuation;
+        bool audible = true;
+        // The far test rounds the distance in place; the later tests reload the stored float.
+        if (static_cast<float>(distance) > far_distance)
+        {
+            attenuation = 0.0f;
+            audible = false;
+        }
+        else if (stored < near_distance)
+            attenuation = 1.0f;
+        else
+            attenuation = 1.0f - (stored - near_distance) / (far_distance - near_distance);
+        float attenuated = attenuation * adjusted;
+        if (audible)
+        {
+            volume = SoundVolume(attenuated);
+            result = PlaySoundWithParameters(name, volume, flags, 0.0f, attenuated);
+        }
+    }
+    else
+    {
+        result = Play3DSoundWithParameters(name, volume, position, flags, voice);
+    }
+    return result;
+}
