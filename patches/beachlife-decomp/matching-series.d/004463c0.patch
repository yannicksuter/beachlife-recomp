+static inline unsigned int HalfTile(const ScreenTerrainGrid* grid)
+{
+    return static_cast<unsigned int>(grid->tile_size_00) >> 1;
+}
+
+// FUNCTION: BEACHLIFE 0x004463c0
+ScreenMapPosition ScreenTerrainGrid::TileWorldPosition(ScreenPoint tile)
+{
+    int x = tile.x;
+    unsigned int column = HalfTile(this) * x;
+    unsigned int row = tile_size_00 * tile.y + (x & 1) * HalfTile(this);
+    ScreenMapPosition position(static_cast<float>(column),
+        static_cast<float>(HalfTile(this)) + (static_cast<float>(row) - static_cast<float>(HalfTile(this))));
+    return position;
+}
