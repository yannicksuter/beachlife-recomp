+#include "startup_screen_modes.h"
+#include "startup_screen_renderer.h"
+
+#include <io.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// GLOBAL: BEACHLIFE 0x0057ebdc
+const char* screen_capture_directory = "photos\\";
+
+// FUNCTION: BEACHLIFE 0x004a6c20
+void ScreenMode2Controller::SaveCapture(int surface)
+{
+    char search[0x80];
+    char path[0x50];
+    _finddata_t information;
+    long handle;
+    int highest = -1;
+    sprintf(search, "%sBeachLife_Snapshot_????.jpg", screen_capture_directory);
+    handle = _findfirst(search, &information);
+    if (handle != -1)
+    {
+        if (strcmp(information.name, ".") != 0 && strcmp(information.name, "..") != 0)
+        {
+            int number = atoi(information.name + strlen(information.name) - 8);
+            if (number > highest)
+                highest = number;
+        }
+        while (_findnext(handle, &information) != -1)
+        {
+            int number = atoi(information.name + strlen(information.name) - 8);
+            if (number > highest)
+                highest = number;
+        }
+    }
+    _findclose(handle);
+    sprintf(path, "%sBeachLife_Snapshot_%04d.jpg", screen_capture_directory, highest + 1);
+    screen_request_renderer->SaveSurfaceAsJpeg(surface, path);
+}
