+// FUNCTION: BEACHLIFE 0x0040a300
+void BlendPaletteRange(int first, int last, const unsigned short* start,
+    const unsigned short* end, unsigned short* output, float factor)
+{
+    if (first <= last)
+    {
+        float inverse = 1.0f - factor;
+        for (int i = first; i <= last; ++i)
+            output[i] = screen_request_renderer->BlendColour(start[i], end[i], inverse);
+    }
+}
