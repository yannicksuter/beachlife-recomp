+#include "startup_directdraw_surface.h"
+#include "startup_screen_item.h"
+#include "startup_screen_renderer.h"
+#include "surface_error_sink.h"
+
+// FUNCTION: BEACHLIFE 0x0040e650
+void ScreenRequestRenderer::BlitSurface(int x, int y, int surface)
+{
+    if (software_mode)
+    {
+        unsigned int key = fill_color;
+        if (x < 0 || y < 0)
+        {
+            return;
+        }
+
+        ScreenSurfacePosition* source = surfaces[surface];
+        unsigned int columns = source->pitch >> 1;
+        unsigned short* from = source->pixels;
+        unsigned int rows = source->height;
+        current_surface = 0;
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+        {
+            return;
+        }
+
+        unsigned int pitch = surfaces[current_surface]->pitch >> 1;
+        unsigned short* row = pixels + pitch * y + x;
+        for (unsigned int line = 0; line < rows; ++line)
+        {
+            unsigned short* to = row;
+            for (unsigned int column = 0; column < columns; ++column)
+            {
+                unsigned short value = *from++;
+                if (value != key)
+                {
+                    *to = value;
+                }
+                ++to;
+            }
+            row += pitch;
+        }
+
+        if (!software_mode)
+        {
+            DirectDrawSurface7Prefix* locked = surfaces[current_surface]->surface;
+            locked->vtable->Unlock(locked, 0);
+        }
+        pixels_locked = 0;
+        return;
+    }
+
+    ScreenSurfacePosition* source = surfaces[surface];
+    if (source->video_memory)
+    {
+        int result = back_surface->vtable->BltFast(
+            back_surface, x, y, source->surface, 0, 0x11);
+        if (result < 0)
+        {
+            IgnoreSurfaceError(result);
+        }
+    }
+    else
+    {
+        ScreenRectangle rectangle;
+        rectangle.left = x;
+        rectangle.top = y;
+        rectangle.bottom = y + source->height;
+        rectangle.right = x + source->width;
+        int result = back_surface->vtable->Blt(
+            back_surface, reinterpret_cast<SurfaceApiRectangle*>(&rectangle), source->surface, 0, 0x01008000, 0);
+        if (result < 0)
+        {
+            IgnoreSurfaceError(result);
+        }
+    }
+}
