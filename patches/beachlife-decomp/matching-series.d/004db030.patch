+static inline void AppendToList(WorldSubsystem20::Action*& list, WorldSubsystem20::Action* action)
+{
+    if (list)
+    {
+        if (list->next)
+        {
+            WorldSubsystem20::Action* last = list->next;
+            while (last->next)
+                last = last->next;
+            last->next = action;
+        }
+        else
+            list->next = action;
+    }
+    else
+        list = action;
+}
+
+// FUNCTION: BEACHLIFE 0x004db030
+void WorldSubsystem20::Group::AddCommand(Action* action, unsigned int list)
+{
+    switch (list)
+    {
+    case 0:
+        AppendToList(start_44, action);
+        break;
+    case 1:
+        AppendToList(reset_48, action);
+        break;
+    case 2:
+        AppendToList(actions_4c, action);
+        break;
+    case 3:
+        AppendToList(commands_04[count_40].actions_04, action);
+        break;
+    case 4:
+        AppendToList(commands_04[count_40].actions_08, action);
+        break;
+    default:
+        StartupFatal("State::AddCommand - Invalid Command List has been specified");
+        break;
+    }
