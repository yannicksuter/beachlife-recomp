+#include "startup_variable_state.h"
+#include "startup_screen_manager.h"
+#include "startup_world_subsystems.h"
+#include "window_activation.h"
+#include <stdlib.h>
+
+static inline float TickerTime()
+{
+    return window_deactivation_state->render_value_160;
+}
+
+// The queued message releases its strings as its inline destructor did.
+static inline void DeleteMessage(TickerQueuedMessage* message)
+{
+    if (message)
+    {
+        if (message->text_04)
+            delete message->text_04;
+        if (message->key_08)
+            delete message->key_08;
+        delete message;
+    }
+}
+
+// Inline accessor of the message counter; with it the pop_front keeps its
+// node deallocation (0x004b4eb0) out of line as in the original.
+static inline WorldSubsystem4c* Subsystem4c()
+{
+    return world_subsystem_4c;
+}
+
+// FUNCTION: BEACHLIFE 0x00429c40
+void VariableTicker::Update()
+{
+    if (screen_manager->CanShowTickerMessage() && !pending_00.empty())
+    {
+        int mode = 2;
+        if (static_cast<int>(pending_00.size()) > 5)
+            mode = 1;
+        TickerQueuedMessage* message = *pending_00.begin();
+        if (message->key_08)
+        {
+            screen_manager->ShowTickerMessage(message->key_08, mode);
+            AddHistory(message->key_08, message->id_00);
+        }
+        else
+        {
+            screen_manager->ShowTickerMessage(message->text_04, mode);
+            AddHistory(message->text_04, message->id_00);
+        }
+        pending_00.pop_front();
+        DeleteMessage(message);
+    }
+    float now = TickerTime();
+    if (now - value_214 > 0.5f || (value_214 > now && now + 24.0f - value_214 > 0.5f))
+    {
+        unsigned int* slots = Subsystem4c()->MessageCounts();
+        int count = 0;
+        int i;
+        for (i = 0; i < 26; i++)
+        {
+            if (slots[i] > 5 && i != 12 && i != 13)
+                count++;
+        }
+        if (count)
+        {
+            int pick = rand() % count;
+            for (i = 0; i < 26; slots++, i++)
+            {
+                if (*slots > 5)
+                {
+                    if (i != 12 && i != 13)
+                    {
+                        if (pick == 0)
+                            AddMessage(FeatureMessage(i), static_cast<unsigned int>(-2), 5);
+                        pick--;
+                    }
+                    *slots = 0;
+                }
+            }
+        }
+        value_214 = TickerTime();
+    }
+}
