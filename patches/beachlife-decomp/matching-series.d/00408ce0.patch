+#include "startup_resource_rasters.h"
+#include "startup_screen_item.h"
+#include <stdlib.h>
+#include <string.h>
+
+// Clears the light buffer under an RLE packet sprite: positive packets cover
+// that many pixels with zero, any other packet skips -n. The sprite is clipped
+// against rectangle (in sprite coordinates); rows above its top are decoded
+// and discarded, as are the covered columns left of its left edge.
+// FUNCTION: BEACHLIFE 0x00408ce0
+void ResourceLightMask(unsigned char* light, const unsigned char* source, unsigned int stride, int x, int y, int width,
+    int height, const ScreenRectangle* rectangle)
+{
+    unsigned char* row = light + stride * y + x;
+    int j;
+
+    // Nothing is clipped.
+    if (rectangle->left <= 0 && rectangle->top <= 0 && rectangle->right >= width && rectangle->bottom >= height)
+    {
+        for (j = 0; j < height; j++)
+        {
+            unsigned char* output = row + j * stride;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    memset(output, 0, count);
+                    column += count;
+                    output += count;
+                    packet -= count;
+                }
+                output -= packet;
+                column -= packet;
+            }
+        }
+        return;
+    }
+
+    // Left edge clipped.
+    if (rectangle->left > 0)
+    {
+        for (int skip = rectangle->top; skip > 0; skip--)
+        {
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                column += abs(packet);
+            }
+        }
+
+        for (j = 0; j < rectangle->bottom - rectangle->top; j++)
+        {
+            int remaining_left = rectangle->left;
+            unsigned char* output = row + j * stride;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    packet -= count;
+                    do
+                    {
+                        if (remaining_left != 0)
+                            remaining_left--;
+                        else if (column < rectangle->right)
+                            *output++ = 0;
+                        column++;
+                    } while (--count != 0);
+                }
+                packet = -packet;
+                while (remaining_left != 0 && packet != 0)
+                {
+                    remaining_left--;
+                    column++;
+                    packet--;
+                }
+                column += packet;
+                output += packet;
+            }
+        }
+        return;
+    }
+
+    // Top, right or bottom edge clipped.
+    for (int skip = rectangle->top; skip > 0; skip--)
+    {
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            column += abs(packet);
+        }
+    }
+
+    for (j = 0; j < rectangle->bottom - rectangle->top; j++)
+    {
+        unsigned char* output = row + j * stride;
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet > 0)
+            {
+                int count = packet;
+                packet -= count;
+                do
+                {
+                    if (column < rectangle->right)
+                        *output++ = 0;
+                    column++;
+                } while (--count != 0);
+            }
+            if (column < rectangle->right)
+                output -= packet;
+            column -= packet;
+        }
+    }
+}
