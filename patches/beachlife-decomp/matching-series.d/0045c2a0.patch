+
+// FUNCTION: BEACHLIFE 0x0045c2a0
+void WorldBuildingEntity::InitializeVehicles()
+{
+    unsigned int i;
+    int j;
+    ScreenModeCommand command;
+    ScreenStaffPlacement placement;
+    for (i = 0; i < building_60->vehicle_count_2b8; i++)
+    {
+        VariableVehicleDefinition* vehicle = variable_catalog->Vehicle(building_60->vehicle_ids_2bc[i]);
+        command.words[0] = -2;
+        command.words[1] = -2;
+        command.words[2] = 0;
+        command.words[3] = 0;
+        command.words[4] = 4;
+        strcpy(placement.name, vehicle->name_04);
+        ScreenPoint tile = TilePosition();
+        switch (keyline_state_44->word_18)
+        {
+        case 0:
+            for (j = 0; j < building_60->vehicle_offsets_2d4[i].x; j++)
+                screen_terrain_grid->Step(tile, 6, &tile);
+            for (j = 0; j < building_60->vehicle_offsets_2d4[i].y; j++)
+                screen_terrain_grid->Step(tile, 0, &tile);
+            break;
+        case 1:
+            for (j = 0; j < static_cast<int>(building_60->footprint_x_1d4) - building_60->vehicle_offsets_2d4[i].x - 1; j++)
+                screen_terrain_grid->Step(tile, 0, &tile);
+            for (j = 0; j < building_60->vehicle_offsets_2d4[i].y; j++)
+                screen_terrain_grid->Step(tile, 6, &tile);
+            break;
+        case 2:
+            for (j = 0; j < static_cast<int>(building_60->footprint_x_1d4) - building_60->vehicle_offsets_2d4[i].x - 1; j++)
+                screen_terrain_grid->Step(tile, 6, &tile);
+            for (j = 0; j < static_cast<int>(building_60->footprint_y_1d8) - building_60->vehicle_offsets_2d4[i].y - 1; j++)
+                screen_terrain_grid->Step(tile, 0, &tile);
+            break;
+        case 3:
+            for (j = 0; j < building_60->vehicle_offsets_2d4[i].x; j++)
+                screen_terrain_grid->Step(tile, 0, &tile);
+            for (j = 0; j < static_cast<int>(building_60->footprint_y_1d8) - building_60->vehicle_offsets_2d4[i].y - 1; j++)
+                screen_terrain_grid->Step(tile, 6, &tile);
+            break;
+        }
+        ScreenWorldPosition center = screen_terrain_grid->TileCenter(tile);
+        placement.index = (building_60->vehicle_directions_2fc[i] + 2 * (4 - static_cast<int>(keyline_state_44->word_18))) % 8;
+        placement.position.x = center.x;
+        placement.position.y = center.y;
+        placement.building_id = id_28;
+        screen_mode_commands->QueuePlacement(&command, &placement);
+    }
+}
