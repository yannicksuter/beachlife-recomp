+#include "startup_screen_overlay_layout.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x004b2ae0
+void ScreenManager::DrawPlacementTile(ScreenPoint tile, unsigned short colour)
+{
+    OverlayMapPrefix* map = overlay_map;
+    int scroll_x = map->scroll_x_c4;
+    int scroll_y = map->scroll_y_c8;
+    ScreenPoint first;
+    ScreenPoint second;
+    ScreenPoint opposite;
+    screen_terrain_grid->Step(tile, 4, &first);
+    screen_terrain_grid->Step(tile, 2, &second);
+    screen_terrain_grid->Step(tile, 3, &opposite);
+    if (opposite.y < tile.y || first.x > tile.x)
+        return;
+    ScreenPoint origin = map->TileToScreen(tile);
+    ScreenPoint a = map->TileToScreen(first);
+    ScreenPoint b = map->TileToScreen(second);
+    ScreenPoint c = map->TileToScreen(opposite);
+    renderer->SetUnscaledClip(0);
+    int mode = renderer->clip_mode_54;
+    if (mode == 1 || mode == 0)
+    {
+        renderer->DrawLine(origin.x - scroll_x, origin.y - scroll_y, a.x - scroll_x, a.y - scroll_y, colour);
+        renderer->DrawLine(origin.x - scroll_x, origin.y - scroll_y, b.x - scroll_x, b.y - scroll_y, colour);
+        renderer->DrawLine(c.x - scroll_x, c.y - scroll_y, a.x - scroll_x, a.y - scroll_y, colour);
+        renderer->DrawLine(c.x - scroll_x, c.y - scroll_y, b.x - scroll_x, b.y - scroll_y, colour);
+    }
+    else if (mode == 2)
+    {
+        renderer->DrawLine((origin.x - scroll_x) / 2, (origin.y - scroll_y) / 2, (a.x - scroll_x) / 2, (a.y - scroll_y) / 2, colour);
+        renderer->DrawLine((origin.x - scroll_x) / 2, (origin.y - scroll_y) / 2, (b.x - scroll_x) / 2, (b.y - scroll_y) / 2, colour);
+        renderer->DrawLine((c.x - scroll_x) / 2, (c.y - scroll_y) / 2, (a.x - scroll_x) / 2, (a.y - scroll_y) / 2, colour);
+        renderer->DrawLine((c.x - scroll_x) / 2, (c.y - scroll_y) / 2, (b.x - scroll_x) / 2, (b.y - scroll_y) / 2, colour);
+    }
+    renderer->SetUnscaledClip(1);
+}
