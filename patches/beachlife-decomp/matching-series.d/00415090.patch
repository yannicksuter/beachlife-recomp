+#include "startup_screen_dialog_resource.h"
+#include "startup_screen_overlay_layout.h"
+#include "startup_screen_dialog_resource_inlines.h"
+
+// FUNCTION: BEACHLIFE 0x00415090
+void ScreenDialogResource::BurnTerrain(const ScreenWorldPosition* position)
+{
+    ScreenPoint screen = overlay_map->WorldToScreen(*position);
+    screen.x += CurrentFrameValue();
+    screen.y += SelectedFrame()->word_14;
+    screen.x += overlay_map->scroll_x_c4;
+    screen.y += overlay_map->scroll_y_c8;
+    ScreenRectangle rectangle;
+    rectangle.top = 0;
+    rectangle.right = SelectedFrame()->width_0e;
+    rectangle.left = 0;
+    rectangle.bottom = SelectedFrame()->height_10;
+    bool clipped = false;
+    if (screen.x < 0)
+    {
+        rectangle.left = -screen.x;
+        screen.x = 0;
+        clipped = true;
+    }
+    if (screen.x + rectangle.right > 4096)
+    {
+        rectangle.right = 4096 - screen.x;
+        clipped = true;
+    }
+    if (screen.y + rectangle.bottom > 4096)
+    {
+        rectangle.bottom = 4096 - screen.y;
+        clipped = true;
+    }
+    if (screen.y < 0)
+    {
+        rectangle.top = -screen.y;
+        screen.y = 0;
+        clipped = true;
+    }
+    unsigned short depth = overlay_map->DepthAt(position);
+    if (!(depth & 1))
+        ++depth;
+    int size = overlay_map->tile_size_dc;
+    int column = screen.x / size;
+    int row = screen.y / size;
+    int x_offset = screen.x % size;
+    int y_offset = screen.y % size;
+    if (clipped)
+        BurnTerrainClippedTiles(&rectangle, column, row, x_offset, y_offset, depth);
+    else
+        BurnTerrainTiles(column, row, x_offset, y_offset, depth);
+}
