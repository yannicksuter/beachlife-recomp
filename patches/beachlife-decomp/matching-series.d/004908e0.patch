+    if (flags & 0x400000)
+        result = "FEEDBACK_STAFF_CANT_DO_JOB";
+    else if (flags & 0x200000)
+        result = "FEEDBACK_STAFF_NEXT_JOB_I_DO";
+    else if (flags & 0x800000)
+        result = "FEEDBACK_STAFFTHOUGHT_UNHAPPY";
+    else if (flags & 0x1000000)
+        result = "FEEDBACK_STAFFTHOUGHT_STARTWORK";
+    else if (flags & 0x2000000)
+        result = "FEEDBACK_STAFFTHOUGHT_ENDWORK";
+    else if (flags & 0x4000000)
+        result = "FEEDBACK_STAFFTHOUGHT_PAYRISE";
+    else if (flags & 0x8000000)
+        result = "FEEDBACK_STAFFTHOUGHT_PAYCUT";
+    else if (flags & 0x10000000)
+        result = "FEEDBACK_STAFF_SACKED";
+    else if (flags & 0x40000000)
+    {
+        switch (rand() % 3)
+        {
+        case 0:
+            result = "FEEDBACK_STAFF_DIRECTED_01";
+            break;
+        case 1:
+            result = "FEEDBACK_STAFF_DIRECTED_02";
+            break;
+        case 2:
+            result = "FEEDBACK_STAFF_DIRECTED_03";
+            break;
+        }
+    }
+    else if (flags & 0x80000000)
+    {
+        switch (rand() % 3)
+        {
+        case 0:
+            result = "FEEDBACK_STAFF_OVERWORKED_00";
+            break;
+        case 1:
+            result = "FEEDBACK_STAFF_OVERWORKED_01";
+            break;
+        case 2:
+            result = "FEEDBACK_STAFF_OVERWORKED_02";
+            break;
+        }
+    }
+    return result;
+}
