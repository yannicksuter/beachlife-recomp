+        int top = static_cast<int>(position_y);
+        float fraction_y = position_y - top;
+        for (int x = 0; x < width; ++x)
+        {
+            float position_x = x * scale_x;
+            int left = static_cast<int>(position_x);
+            float fraction_x = position_x - left;
+            unsigned char red_00 = (input[top * source_width + left] >> 10) & 0x1f;
+            unsigned char green_00 = (input[top * source_width + left] >> 5) & 0x1f;
+            unsigned char blue_00 = input[top * source_width + left] & 0x1f;
+            unsigned char red_01 = (input[top * source_width + left + 1] >> 10) & 0x1f;
+            unsigned char green_01 = (input[top * source_width + left + 1] >> 5) & 0x1f;
+            unsigned char blue_01 = input[top * source_width + left + 1] & 0x1f;
+            unsigned char red_10 = (input[(top + 1) * source_width + left] >> 10) & 0x1f;
+            unsigned char green_10 = (input[(top + 1) * source_width + left] >> 5) & 0x1f;
+            unsigned char blue_10 = input[(top + 1) * source_width + left] & 0x1f;
+            unsigned char red_11 = (input[(top + 1) * source_width + left + 1] >> 10) & 0x1f;
+            unsigned char green_11 = (input[(top + 1) * source_width + left + 1] >> 5) & 0x1f;
+            unsigned char blue_11 = input[(top + 1) * source_width + left + 1] & 0x1f;
+            int blue_2;
+            int green_2;
+            int red_2;
+            int blue_1;
+            int green_1;
+            int red_1;
+            RoundToInt(red_00 * (1.0f - fraction_y) + red_10 * fraction_y, &red_1);
+            RoundToInt(green_00 * (1.0f - fraction_y) + green_10 * fraction_y, &green_1);
+            RoundToInt(blue_00 * (1.0f - fraction_y) + blue_10 * fraction_y, &blue_1);
+            RoundToInt(red_01 * (1.0f - fraction_y) + red_11 * fraction_y, &red_2);
+            RoundToInt(green_01 * (1.0f - fraction_y) + green_11 * fraction_y, &green_2);
+            RoundToInt(blue_01 * (1.0f - fraction_y) + blue_11 * fraction_y, &blue_2);
+            float inverse_x = 1.0f - fraction_x;
+            int red;
+            int green;
+            int blue;
+            RoundToInt(red_1 * inverse_x + red_2 * fraction_x, &red);
+            RoundToInt(green_1 * inverse_x + green_2 * fraction_x, &green);
+            RoundToInt(blue_1 * inverse_x + blue_2 * fraction_x, &blue);
+            if (red > 31)
+                red = 31;
+            if (green > 31)
+                green = 31;
+            if (blue > 31)
+                blue = 31;
+            output[y * width + x] = (((red << 5) + green) << 5) + blue;
+        }
+    }
+}
