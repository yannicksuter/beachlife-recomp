+// Rounds with the current FPU mode, as the retail fistp does.
+static inline void RoundToInt(float value, int* result)
+{
+    float rounded = value;
+    __asm {
+        mov eax, result
+        fld rounded
+        fistp DWORD PTR [eax]
+    }
+}
