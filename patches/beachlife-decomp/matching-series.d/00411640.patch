+static inline void PlotPixel(int* pixel, unsigned short colour)
+{
+    *pixel = (*pixel & 0xffff0000) + colour;
+}
+
+// FUNCTION: BEACHLIFE 0x00411640
+void RasterLineDirectY(int x, int y, int delta_x, int delta_y, int direction,
+    unsigned short colour, unsigned short* pixels, unsigned int stride)
+{
+    int* destination = reinterpret_cast<int*>(pixels);
+    int twice_x = delta_x * 2;
+    int diagonal = twice_x - delta_y * 2;
+    int error = twice_x - delta_y;
+    if (static_cast<unsigned int>(x) < screen_request_renderer->width && static_cast<unsigned int>(y) < screen_request_renderer->height)
+        PlotPixel(&destination[y * stride + x], colour);
+    while (delta_y--)
+    {
+        if (error >= 0)
+        {
+            x += direction;
+            error += diagonal;
+        }
+        else
+        {
+            error += twice_x;
+        }
+        y++;
+        if (static_cast<unsigned int>(x) < screen_request_renderer->width && static_cast<unsigned int>(y) < screen_request_renderer->height)
+            PlotPixel(&destination[y * stride + x], colour);
+    }
+}
