+#include "startup_variable_state.h"
+#include "startup_variable_catalog_fields.h"
+#include "startup_game_file.h"
+#include <stdlib.h>
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0044bd80
+void VariableCatalog::ParseStaff(const char* key, const char* name, const char* gender, const char* wage, const char* resource, const char* role, const char* script, const char* base_wage, const char* value210, const char* value214, const char* morale, const char* shift_start, const char* shift_end)
+{
+    unsigned int id = CatalogField<unsigned int>(this, 0x14);
+    unsigned char* record = CatalogRecordAddress(this, 0x384c0, 0x224, id);
+    CatalogField<unsigned int>(record, 0) = id;
+    strcpy(reinterpret_cast<char*>(record + 4), key);
+    strcpy(reinterpret_cast<char*>(record + 0x44), name);
+    switch (*gender)
+    {
+    case 'M':
+        CatalogField<unsigned int>(record, 0xc4) = 0;
+        break;
+    case 'F':
+        CatalogField<unsigned int>(record, 0xc4) = 1;
+        break;
+    default:
+        StartupFatal("WorldParams::AddStaff - sex isn't M or F - %s", key);
+        break;
+    }
+    CatalogField<unsigned int>(record, 0xc8) = atoi(wage);
+    strcpy(reinterpret_cast<char*>(record + 0xcc), resource);
+    strcpy(reinterpret_cast<char*>(record + 0x1cc), role);
+    strcpy(reinterpret_cast<char*>(record + 0x1ec), script);
+    CatalogField<unsigned int>(record, 0x20c) = atoi(base_wage);
+    CatalogField<float>(record, 0x210) = static_cast<float>(atof(value210));
+    CatalogField<float>(record, 0x214) = static_cast<float>(atof(value214));
+    CatalogField<float>(record, 0x218) = static_cast<float>(atof(morale));
+    CatalogField<unsigned int>(record, 0x21c) = atoi(shift_start);
+    CatalogField<unsigned int>(record, 0x220) = atoi(shift_end);
+    ++CatalogField<unsigned int>(this, 0x14);
+}
