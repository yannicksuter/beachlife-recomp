+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_table_column.h"
+#include "startup_screen_text.h"
+
+// FUNCTION: BEACHLIFE 0x004ab330
+void GuiParserState::ParseColumnContext()
+{
+    const char* data = buffer;
+    while (
+        data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        int value_a;
+        ReadInteger(value_a, true);
+        int value_b;
+        ReadInteger(value_b, true);
+        char source[64];
+        ReadText(source);
+        int left;
+        ReadInteger(left, true);
+        int right;
+        ReadInteger(right, true);
+        int value_d;
+        ReadInteger(value_d, true);
+        int value_c;
+        ReadInteger(value_c, false);
+
+        data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        // The column takes the open table's top and bottom; left and right are
+        // offsets from the table's left edge. Top and bottom are read in one
+        // expression, so the second rectangle temporary gets its own slot.
+        int absolute_left = alternate_context_14->GetRectangle().left + left;
+        int absolute_right = alternate_context_14->GetRectangle().left + right;
+        ScreenRectangle bounds;
+        bounds.left = absolute_left;
+        bounds.right = absolute_right;
+        bounds.top = alternate_context_14->GetRectangle().top, bounds.bottom = alternate_context_14->GetRectangle().bottom;
+        ScreenTableColumn* column = new ScreenTableColumn(bounds, source, value_a, value_b, value_c, value_d);
+        RegisterItem(column, 0);
+
+        data = buffer;
+        if (data[cursor] == ',')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            ++cursor;
+            char text[64];
+            ReadText(text);
+            column->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+        else
+        {
+            if (data[cursor] == ')')
+            {
+                ++cursor;
+            }
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+        }
+        if (buffer[cursor] == '>')
+        {
+            ++cursor;
+        }
+        else
+        {
+            StartupFatal(
+                "GUIManager::process_col - Script Error \r\nNo close symbol at file offset - %u",
+                cursor);
+        }
+
+        data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+    }
+    else
+    {
+        StartupFatal(
+            "GUIManager::process_col - Script Error \r\nNo open bracket found at file offset - %u",
+            cursor);
+    }
+}
