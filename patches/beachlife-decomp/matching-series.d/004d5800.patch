+
+// The retail unit expands one level of the comment skipper at both call sites.
+static inline int SkipLoadComments(WorldSubsystemScript* script)
+{
+    int count = 0;
+    if (*script->cursor_591c == '/')
+    {
+        script->cursor_591c++;
+        count = 1;
+        if (*script->cursor_591c != '\n')
+        {
+            do
+            {
+                count++;
+                script->cursor_591c++;
+            } while (*script->cursor_591c != '\n');
+        }
+        int leading = 0;
+        while (*script->cursor_591c == ' ' || *script->cursor_591c == '\r' || *script->cursor_591c == '\n'
+               || *script->cursor_591c == '\t')
+        {
+            leading++;
+            script->cursor_591c++;
+        }
+        count += script->SkipComments() + leading;
+        int trailing = 0;
+        while (*script->cursor_591c == ' ' || *script->cursor_591c == '\r' || *script->cursor_591c == '\n'
+               || *script->cursor_591c == '\t')
+        {
+            trailing++;
+            script->cursor_591c++;
+        }
+        count += trailing;
+    }
+    return count;
+}
+
+// Loads the compiled .ble image beside the given script name and parses its State blocks.
+// FUNCTION: BEACHLIFE 0x004d5800
+void WorldSubsystemScript::LoadScript(const char* text)
+{
+    char token[52];
+    int position = 0;
+    int length = strlen(text);
+    char* name = new char[length + 1];
+    strcpy(name, text);
+    name[length - 4] = '.';
+    name[length - 3] = 'b';
+    name[length - 2] = 'l';
+    name[length - 1] = 'e';
+    int size = GetFileSize(name);
+    cursor_591c = LoadBleFile(name);
+    delete name;
+    char* image = cursor_591c;
+    while (size > position)
+    {
+        int count = 0;
+        while (*cursor_591c == ' ' || *cursor_591c == '\r' || *cursor_591c == '\n' || *cursor_591c == '\t')
+        {
+            count++;
+            cursor_591c++;
+        }
+        position += count;
+        position += SkipLoadComments(this);
+        if (size <= position)
+            break;
+        position += ReadToken(token);
+        if (strcmp(token, "State") == 0)
+        {
+            position += ParseState();
+        }
+        else if (token[0] == '/')
+        {
+            position += SkipLoadComments(this);
+        }
+        else
+        {
+            StartupFatal("Invalid Command Recieved in ObjectScript %s", token);
+        }
+    }
+    delete image;
+}
