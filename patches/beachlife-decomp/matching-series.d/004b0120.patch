+// FUNCTION: BEACHLIFE 0x004b0120
+void ScreenManager::LayoutOverlayDetail()
+{
+    // Scale the visible screen area into the overlay item's map rectangle.
+    detail_rectangle_108.left = word_fc->GetRectangle().left;
+    detail_rectangle_108.top = word_fc->GetRectangle().top;
+    float width = word_fc->GetRectangle().right - word_fc->GetRectangle().left;
+    float height = word_fc->GetRectangle().bottom - word_fc->GetRectangle().top;
+    float view_width = renderer->width;
+    float view_height = renderer->height;
+    float map_width = overlay_map->map_width_cc - 2 * overlay_margin_x;
+    float map_height = overlay_map->map_height_d0 - 2 * overlay_margin_y;
+    if (view_width >= overlay_wide_threshold)
+    {
+        view_height -= overlay_panel_wide;
+    }
+    else
+    {
+        view_height -= overlay_panel_narrow;
+    }
+    detail_rectangle_108.right = static_cast<int>(view_width / map_width * width + detail_rectangle_108.left);
+    detail_rectangle_108.bottom = static_cast<int>(view_height / map_height * height + detail_rectangle_108.top);
+}
