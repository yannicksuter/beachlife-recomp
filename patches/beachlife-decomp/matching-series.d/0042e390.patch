+// The reading helpers spend the inline budget as the original did: with
+// them the clear keeps _M_deallocate (0x004123f0) out of line.
+static inline void ReadCommand(GameFileReader* file, unsigned int* words)
+{
+    file->ReadInt(reinterpret_cast<int*>(&words[0]));
+    file->ReadInt(reinterpret_cast<int*>(&words[1]));
+    file->ReadInt(reinterpret_cast<int*>(&words[2]));
+    file->ReadInt(reinterpret_cast<int*>(&words[3]));
+    file->ReadInt(reinterpret_cast<int*>(&words[4]));
+    file->ReadFloat(reinterpret_cast<float*>(&words[6]));
+    file->ReadFloat(reinterpret_cast<float*>(&words[7]));
+    file->ReadInt(reinterpret_cast<int*>(&words[5]));
+}
+
+static inline const ScreenModeCommand& AsCommand(const unsigned int* words)
+{
+    return *reinterpret_cast<const ScreenModeCommand*>(words);
+}
+
+static inline void ReadCount(GameFileReader* file, int* count)
+{
+    file->Unknown68(reinterpret_cast<unsigned int*>(count));
+}
+
+// FUNCTION: BEACHLIFE 0x0042e390
+void ScreenModeCommandQueue::LoadState(GameFileReader* file)
+{
+    // Retail reads into a plain eight-word record: words 0-4, the numbers in
+    // words 6 and 7, then word 5.
+    unsigned int words[8];
+    words[0] = 0;
+    words[1] = 0;
+    words[2] = 0;
+    words[3] = 0;
+    words[4] = 0;
+    file->Unknown40();
+    char name[0x80];
+    file->ReadString(name, 0x80);
+    unsigned int version;
+    file->Unknown68(&version);
+    commands_00.clear();
+    int count;
+    ReadCount(file, &count);
+    for (int i = 0; i < count; i++)
+    {
+        ReadCommand(file, words);
+        commands_00.insert(commands_00.end(), AsCommand(words));
+    }
+}
