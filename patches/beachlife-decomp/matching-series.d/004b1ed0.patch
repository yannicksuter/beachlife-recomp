+#include "window_activation.h"
+
+// FUNCTION: BEACHLIFE 0x004b1ed0
+void ScreenManager::SetFeatureAvailability(unsigned char key, bool enabled)
+{
+    const char* icon;
+    const char* browser;
+    const char* building;
+    switch (key)
+    {
+    case 11:
+        icon = "CleanerIcon";
+        browser = "CleanerBrowser";
+        building = "CLEANERSHACK";
+        break;
+    case 9:
+        icon = "RepIcon";
+        browser = "RepBrowser";
+        building = "REP";
+        break;
+    case 7:
+        icon = "LifeguardIcon";
+        browser = "LifeguardBrowser";
+        building = "BAYWATCH";
+        break;
+    case 10:
+        icon = "BuilderIcon";
+        browser = "BuilderBrowser";
+        building = "BUILDERYARD";
+        break;
+    case 12:
+        icon = "SecurityIcon";
+        browser = "SecurityBrowser";
+        building = "SECURITY_POST";
+        break;
+    case 8:
+        icon = "MechanicIcon";
+        browser = "MechanicBrowser";
+        building = "HANDYMAN";
+        break;
+    default:
+        // The original copies the raw four-byte enabled argument into all three pointers.
+        icon = *(const char* volatile*)&enabled;
+        browser = *(const char* volatile*)&enabled;
+        building = *(const char* volatile*)&enabled;
+        break;
+    }
+
+    if (enabled)
+    {
+        {
+            for (ScreenChildLink* link = items_head; link; link = link->next)
+            {
+                if (link->item->kind_28 == 0)
+                    static_cast<ScreenButtonPrefix*>(link->item)->SetNamedActive(icon, 1);
+            }
+        }
+        {
+            for (ScreenChildLink* link = items_head; link; link = link->next)
+            {
+                if (link->item->kind_28 == 0)
+                    static_cast<ScreenButtonPrefix*>(link->item)->SetNamedActive(browser, 0);
+            }
+        }
+    }
+    else
+    {
+        {
+            for (ScreenChildLink* link = items_head; link; link = link->next)
+            {
+                if (link->item->kind_28 == 0)
+                    static_cast<ScreenButtonPrefix*>(link->item)->SetNamedActive(browser, 1);
+            }
+        }
+        {
+            for (ScreenChildLink* link = items_head; link; link = link->next)
+            {
+                if (link->item->kind_28 == 0)
+                    static_cast<ScreenButtonPrefix*>(link->item)->SetNamedActive(icon, 0);
+            }
+        }
+    }
+
+    unsigned int index = variable_catalog->FindBuilding(building);
+    if (!window_deactivation_state->IsBuildingListed(index))
+    {
+        {
+            for (ScreenChildLink* link = items_head; link; link = link->next)
+            {
+                if (link->item->kind_28 == 0)
+                    static_cast<ScreenButtonPrefix*>(link->item)->DisableNamed(icon);
+            }
+        }
+        {
+            for (ScreenChildLink* link = items_head; link; link = link->next)
+            {
+                if (link->item->kind_28 == 0)
+                    static_cast<ScreenButtonPrefix*>(link->item)->DisableNamed(browser);
+            }
+        }
+    }
+}
