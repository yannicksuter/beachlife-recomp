+
+static inline int SkipStateWhitespace(char*& cursor)
+{
+    int count = 0;
+    while (*cursor == ' ' || *cursor == '\r' || *cursor == '\n' || *cursor == '\t')
+    {
+        ++count;
+        ++cursor;
+    }
+    return count;
+}
+
+// The retail unit expands one level of the comment skipper here.
+static inline int SkipStateComments(WorldSubsystem20* script)
+{
+    char*& cursor = script->cursor_00;
+    int count = 0;
+    if (*cursor == '/')
+    {
+        ++cursor;
+        count = 1;
+        while (*cursor != '\n')
+        {
+            ++count;
+            ++cursor;
+        }
+        count += SkipStateWhitespace(cursor);
+        count += script->SkipComments();
+        count += SkipStateWhitespace(cursor);
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x004dd140
+int WorldSubsystem20::ParseState()
+{
+    int count = SkipStateWhitespace(cursor_00);
+    count += ParseStateName();
+    count += SkipStateWhitespace(cursor_00);
+    count += SkipStateComments(this);
+    char token[52];
+    count += ReadToken(token);
+    while (strcmp(token, "End") != 0)
+    {
+        if (strcmp(token, "OnEntry") == 0)
+            count += ParseStateActions(0);
+        else if (strcmp(token, "OnExit") == 0)
+            count += ParseStateActions(1);
+        else if (strcmp(token, "OnUpdate") == 0)
+            count += ParseStateActions(2);
+        else if (strcmp(token, "Message") == 0)
+            count += ParseStateMessage();
+        else
+        {
+            char message[256];
+            sprintf(message, "WorldScript::ProcessStateCommand - Unknown Command Found : %s", token);
+            StartupFatal(message);
+        }
+        count += ReadToken(token);
+    }
+    ++count_32c;
+    return count;
+}
