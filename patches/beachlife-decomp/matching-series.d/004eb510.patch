+#include "tga_image.h"
+#include "tiff_read_context.h"
+#include <stdio.h>
+
+// Reads the uncompressed tiles row by row into their places in the image pixels.
+// FUNCTION: BEACHLIFE 0x004eb510
+void TiffDecodeTiles(TgaImage* image, TiffReadContext* context)
+{
+    unsigned char* base = image->pixels;
+    int tile_rows = context->height / context->tile_height;
+    int tiles_per_row = context->width / context->tile_width;
+    unsigned int factor = (static_cast<unsigned int>(context->bits_per_sample) >> 3) * context->samples_per_pixel;
+    int line_bytes = context->width * factor;
+    int chunk = context->tile_width * factor;
+    int index = 0;
+
+    for (int y = 0; y < tile_rows; y++)
+    {
+        for (int x = 0; x < tiles_per_row; x++)
+        {
+            fseek(context->file, context->tile_offsets[index], SEEK_SET);
+            for (int k = 0; k < static_cast<int>(context->tile_height); k++)
+                fread(base + x * chunk + (static_cast<int>(context->tile_height) * y + k) * line_bytes, chunk, 1, context->file);
+            index++;
+        }
+    }
+}
