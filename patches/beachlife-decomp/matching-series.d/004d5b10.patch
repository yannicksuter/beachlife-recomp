+static inline int SkipWhitespace(char*& cursor)
+{
+    int count = 0;
+    while (*cursor == ' ' || *cursor == '\r' || *cursor == '\n' || *cursor == '\t')
+    {
+        ++count;
+        ++cursor;
+    }
+    return count;
+}
+
+// The retail unit expands one level of the comment skipper here.
+static inline int SkipScriptComments(WorldSubsystemScript* script)
+{
+    char*& cursor = script->cursor_591c;
+    int count = 0;
+    if (*cursor == '/')
+    {
+        ++cursor;
+        count = 1;
+        while (*cursor != '\n')
+        {
+            ++count;
+            ++cursor;
+        }
+        count += SkipWhitespace(cursor);
+        count += script->SkipComments();
+        count += SkipWhitespace(cursor);
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x004d5b10
+int WorldSubsystemScript::ParseState()
+{
+    int count = SkipWhitespace(cursor_591c);
+    char state[52];
+    int length = ReadToken(state);
+    for (unsigned int index = 0; index < 137; ++index)
+    {
+        if (strcmp(state, object_script_states[index].name) == 0)
+        {
+            rules_00[count_5910].word_00 = object_script_states[index].state;
+            goto found;
+        }
+    }
+    StartupFatal("ObjectScript::DetermineState - State doesnt exist check state decode table");
+    length = 0;
+found:
+    count += length;
+    count += SkipWhitespace(cursor_591c);
+    count += SkipScriptComments(this);
+    char token[52];
+    count += ReadToken(token);
+    while (strcmp(token, "End") != 0)
+    {
+        if (strcmp(token, "OnEntry") == 0)
+            count += ParseStateActions(0);
+        else if (strcmp(token, "OnExit") == 0)
+            count += ParseStateActions(1);
+        else if (strcmp(token, "OnUpdate") == 0)
+            count += ParseStateActions(2);
+        else if (strcmp(token, "Message") == 0)
+            count += ParseMessage();
+        else
+        {
+            char message[256];
+            sprintf(message, "ObjectScript::ProcessStateCommand - Unknown Command Found : %s", token);
+            StartupFatal(message);
+        }
+        count += ReadToken(token);
+    }
+    ++count_5910;
+    return count;
+}
