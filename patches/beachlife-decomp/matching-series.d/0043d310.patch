+// One removal pass over an entity array, last entry first. Retail prefetches the next entry before testing the count,
+// so it reads the slot before the array start once (harmless over-read, kept for matching).
+static inline void RemoveInactive(
+    WindowDeactivationState* state, VariableEntity** entities, unsigned int count, bool& removed)
+{
+    VariableEntity** last = &entities[count - 1];
+    VariableEntity* entity = *last;
+    if (count != 0)
+    {
+        VariableEntity** slot = last;
+        unsigned int remaining = count;
+        do
+        {
+            if (entity->inactive_04)
+            {
+                removed = true;
+                state->PrepareEntityRemoval(entity);
+                entity->Unknown10();
+                state->world_10->RemoveEntity(entity->id_28);
+            }
+            entity = *--slot;
+        } while (--remaining != 0);
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x0043d310
+void WindowDeactivationState::UpdateAt0043d310()
+{
+    bool removed = false;
