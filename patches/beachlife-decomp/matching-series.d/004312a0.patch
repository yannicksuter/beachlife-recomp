+// FUNCTION: BEACHLIFE 0x004312a0
+void WorldRouteFinder::VisitRouteCell(ScreenTerrainCell* cell, const ScreenPoint* point, const ScreenPoint*, int cost)
+{
+    int new_cost = cell->cost_3c + cost;
+    ScreenTerrainCell* neighbour = RouteCell(terrain_00, point);
+    if (neighbour->open_31 && neighbour->visited_generation_08 == generation_08)
+    {
+        for (int i = 0; i < 8; ++i)
+        {
+            if (!cell->neighbours_10[i] || cell->neighbours_10[i]->visited_generation_08 != generation_08)
+            {
+                cell->neighbours_10[i] = neighbour;
+                break;
+            }
+        }
+        if (new_cost < neighbour->cost_3c)
+        {
+            neighbour->parent_00 = cell;
+            neighbour->cost_3c = new_cost;
+            neighbour->score_34 = neighbour->distance_38 + new_cost;
+        }
+        return;
+    }
+    if (neighbour->closed_30 && neighbour->visited_generation_08 == generation_08)
+    {
+        for (int i = 0; i < 8; ++i)
+        {
+            if (!cell->neighbours_10[i] || cell->neighbours_10[i]->visited_generation_08 != generation_08)
+            {
+                cell->neighbours_10[i] = neighbour;
+                break;
+            }
+        }
+        if (new_cost < neighbour->cost_3c)
+        {
+            neighbour->parent_00 = cell;
+            neighbour->cost_3c = new_cost;
+            neighbour->score_34 = neighbour->distance_38 + new_cost;
+            PropagateRouteCost(neighbour);
+        }
+        return;
+    }
+    neighbour = RouteCell(terrain_00, point);
+    neighbour->parent_00 = cell;
+    neighbour->cost_3c = new_cost;
+    ScreenWorldPosition position = terrain_00->TilePosition(point->x, point->y, 4);
+    int dx = static_cast<int>(position.x - start_position_1c.x);
+    int dy = static_cast<int>(position.y - start_position_1c.y);
+    neighbour->distance_38 = dx * dx + dy * dy;
+    neighbour->score_34 = neighbour->distance_38 + new_cost;
+    neighbour->open_31 = 1;
+    neighbour->visited_generation_08 = generation_08;
+    InsertOpenRouteCell(neighbour);
+    for (int i = 0; i < 8; ++i)
