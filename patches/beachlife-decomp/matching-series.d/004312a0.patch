+static inline ScreenTerrainCell* RouteCell(ScreenTerrainGrid* terrain, const ScreenPoint* point)
+{
+    unsigned int y = static_cast<unsigned int>(point->y) % terrain->height_08;
+    unsigned int x = static_cast<unsigned int>(point->x) % terrain->width_04;
+    return &terrain->cells_0c[y * terrain->width_04 + x];
+}
