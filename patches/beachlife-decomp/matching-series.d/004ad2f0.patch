+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_number_adjust.h"
+#include "startup_screen_text.h"
+
+// FUNCTION: BEACHLIFE 0x004ad2f0
+void GuiParserState::ParseNumberAdjust()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        int value_a;
+        ReadInteger(value_a, true);
+        int value_b;
+        ReadInteger(value_b, true);
+        char name[64];
+        ReadText(name);
+        int value_flag;
+        ReadInteger(value_flag, false);
+        bool flag = value_flag != 0;
+        ScreenNumberAdjust* adjust = new ScreenNumberAdjust(rectangle, value_a, value_b, name, flag, true);
+        RegisterItem(adjust, 0);
+
+        data = buffer;
+        if (data[cursor] == ',')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            ++cursor;
+            char text[64];
+            ReadText(text);
+            adjust->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+        else
+        {
+            if (data[cursor] == ')')
+            {
+                ++cursor;
+            }
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::ProcessNumberWidget - Script Error \r\nNo open bracket found at "
+                     "file offset - %u",
+            cursor);
+    }
+}
