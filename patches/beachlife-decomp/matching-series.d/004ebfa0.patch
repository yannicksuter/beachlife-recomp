+#include "startup_screen_item.h"
+
+// Intel JPEG Library 1.5 JPEG_CORE_PROPERTIES, declared through the fields
+// the game writes; IJL's JPEG_PROPERTIES tail is not declared.
+struct JpegExportState
+{
+    unsigned int use_jpeg_properties;
+    unsigned char* dib_bytes;
+    int dib_width;
+    int dib_height;
+    int dib_pad_bytes;
+    int dib_channels;
+    int dib_color;
+    int dib_subsampling;
+    const char* jpg_file;
+    unsigned char* jpg_bytes;
+    unsigned int jpg_size_bytes;
+    int jpg_width;
+    int jpg_height;
+    int jpg_channels;
+    int jpg_color;
+    int jpg_subsampling;
+    int jpg_thumb_width;
+    int jpg_thumb_height;
+    int colour_conversion_required;
+    int upsampling_required;
+    int quality;
+};
+
+// ijl15.dll, imported by ordinal through the import library's thunks.
+extern "C" int __stdcall ijlInit(JpegExportState* properties);            // Ordinal 2.
+extern "C" int __stdcall ijlWrite(JpegExportState* properties, int mode); // Ordinal 5.
+extern "C" int __stdcall ijlFree(JpegExportState* properties);            // Ordinal 3.
+
+// GLOBAL: BEACHLIFE 0x005bb0b0
+JpegExportState jpeg_export_properties;
+// GLOBAL: BEACHLIFE 0x005bb0a8
+int jpeg_export_result;
+
+// FUNCTION: BEACHLIFE 0x004ebfa0
+void ExportJpegImage(const ScreenRectangle* area, unsigned char* pixels, const char* path, int quality)
+{
+    ijlInit(&jpeg_export_properties);
+    jpeg_export_properties.dib_width = area->right - area->left;
+    jpeg_export_properties.dib_height = area->bottom - area->top;
+    jpeg_export_properties.dib_bytes = pixels;
+    jpeg_export_properties.dib_pad_bytes = 0;
+    jpeg_export_properties.dib_channels = 3;
+    jpeg_export_properties.dib_color = 1;
+    jpeg_export_properties.jpg_file = path;
+    jpeg_export_properties.jpg_width = area->right - area->left;
+    jpeg_export_properties.jpg_height = area->bottom - area->top;
+    jpeg_export_properties.jpg_channels = 3;
+    jpeg_export_properties.jpg_color = 3;
+    jpeg_export_properties.jpg_subsampling = 1;
+    jpeg_export_properties.quality = quality;
+    // IJL_JFILE_WRITEWHOLEIMAGE.
+    jpeg_export_result = ijlWrite(&jpeg_export_properties, 8);
+    ijlFree(&jpeg_export_properties);
+}
