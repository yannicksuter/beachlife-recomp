+
+// FUNCTION: BEACHLIFE 0x00430890
+int MotionDirection(ScreenMapPosition direction, unsigned int count)
+{
+    float vertical = direction.y * -1.0f;
+    if (vertical > 1.0)
+    {
+        vertical = 1.0f;
+    }
+    else if (vertical < -1.0f)
+    {
+        vertical = -1.0f;
+    }
+    double angle = acos(vertical);
+    if (direction.x < 0.0f)
+    {
+        angle = motion_full_turn - angle;
+    }
+    int sectors = count * 2;
+    float width = motion_full_turn / sectors;
