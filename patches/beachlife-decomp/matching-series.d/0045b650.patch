+#include "startup_world_entities.h"
+#include "startup_screen_mode_world.h"
+#include "startup_screen_command_inlines.h"
+#include "startup_variable_state.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0045b650
+bool VariableEntity::HireStaff()
+{
+    if (AsBuilding()->staff_count_8c + AsBuilding()->pending_staff_90 == AsBuilding()->building_60->capacity_288)
+        return false;
+    VariableStaffState* staff = variable_catalog->Staff(AsBuilding()->building_60->staff_ids_290[0]);
+    unsigned int slot = AsBuilding()->staff_count_8c + AsBuilding()->pending_staff_90;
+    ScreenModeCommand message(0, 0, 0, 0, 0);
+    const char* name = staff->role_1cc;
+    ScreenStaffPlacement placement;
+    if (strcmp(name, "LIFEGUARD") == 0)
+        message = ScreenModeCommand(-2, -2, 0, 0, 7);
+    else if (strcmp(name, "MECHANIC") == 0)
+        message = ScreenModeCommand(-2, -2, 0, 0, 8);
+    else if (strcmp(name, "REP") == 0)
+        message = ScreenModeCommand(-2, -2, 0, 0, 9);
+    else if (strcmp(name, "CLEANER") == 0)
+        message = ScreenModeCommand(-2, -2, 0, 0, 0xb);
+    else if (strcmp(name, "SECURITYGUARD") == 0)
+        message = ScreenModeCommand(-2, -2, 0, 0, 0xc);
+    else if (strcmp(name, "BUILDER") == 0)
+    {
+        message = ScreenModeCommand(-2, -2, 0, 0, 0xa);
+        unsigned char used[50] = { 0 };
+        for (unsigned int i = 0; i < AsBuilding()->staff_count_8c + AsBuilding()->pending_staff_90; i++)
+            used[variable_world->FindObject(AsBuilding()->staff_ids_64[i])->AsBuilder()->builder_index_7f0] = 1;
+        for (unsigned int j = 0; j < AsBuilding()->staff_count_8c + AsBuilding()->pending_staff_90; j++)
+            if (!used[j])
+            {
+                slot = j;
+                break;
+            }
+        placement.position.x = AsBuilding()->staff_position_d8.x;
+        placement.position.y = AsBuilding()->staff_position_d8.y;
+        placement.position.z = AsBuilding()->staff_position_d8.z;
+        OffsetStaffPlacement(slot, &placement);
+    }
+    else
+        return false;
+
+    strcpy(placement.name,
+        AsBuilding()->staff_count_8c > AsBuilding()->pending_staff_90 ? AsBuilding()->building_60->staff_model_d04
+                                                                      : AsBuilding()->building_60->staff_model_d44);
+    if (strcmp(name, "BUILDER") != 0)
+    {
+        placement.position.x = AsBuilding()->staff_position_d8.x;
+        placement.position.y = AsBuilding()->staff_position_d8.y;
+        placement.position.z = AsBuilding()->staff_position_d8.z;
+    }
+    placement.index = slot;
+    placement.building_id = id_28;
+    screen_mode_commands->QueuePlacement(&message, &placement);
+    return true;
+}
