+#include <new>
+
+// FUNCTION: BEACHLIFE 0x00420360
+unsigned int WorldCleaningManager::ClaimRequest(unsigned int id, unsigned int cleaner)
+{
+    VariableEntity* object = variable_world->FindObject(id);
+    if (object)
+    {
+        WorldStaticEntity* entity = static_cast<WorldStaticEntity*>(object);
+        bool available = false;
+        if (object->kind_2c == 2)
+        {
+            if (!entity->NeedsCleaning() && !entity->NeedsRepair())
+                available = true;
+        }
+        else if (object->kind_2c == 1)
+        {
+            if (!entity->NeedsCleaning() && !entity->NeedsRepair())
+                available = true;
+        }
+        if (available)
+        {
+            std::_List_node_base* node = FindCleaningNode(requests_00, id);
+            if (node != requests_00.end()._M_node)
+            {
+                AddAssignment(id, 1);
+                delete static_cast<WorldCleaningRequestNode*>(node)->_M_data;
+                requests_00.erase(WorldCleaningRequestList::iterator(static_cast<WorldCleaningRequestNode*>(node)));
+            }
+            else
+                AddAssignment(id, 1);
+            entity->SetCleaningRequested(1);
+            entity->SetFlag5a(1);
+            if (strcmp(entity->name_06, "Litter") == 0)
+                return 0;
+            if (strcmp(entity->name_06, "Bin") == 0)
+                return 1;
+            if (strcmp(entity->name_06, "LOO") == 0)
+                return 2;
+        }
+    }
+    return ~0u;
+}
