+#include <stdlib.h>
+#include <string.h>
+
+template <class T>
+static T& CatalogField(void* record, unsigned int offset)
+{
+    return *reinterpret_cast<T*>(static_cast<unsigned char*>(record) + offset);
+}
+// FUNCTION: BEACHLIFE 0x0044f9d0
+void VariableCatalog::ParseEvent(unsigned int id, const char* key, const char* value)
+{
+    unsigned char* record = CatalogRecordAddress(this, 0x4e5e8, 0x58, id);
+    if (strcmp(key, "COST") == 0)
+        CatalogField<float>(record, 0x4c) = static_cast<float>(atof(value));
+    else if (strcmp(key, "DEF_PRICE") == 0)
+        CatalogField<float>(record, 0x48) = static_cast<float>(atof(value));
+    else if (strcmp(key, "MALE_INTENSITY") == 0)
+        CatalogField<float>(record, 0x50) = static_cast<float>(atof(value));
+    else if (strcmp(key, "FEMALE_INTENSITY") == 0)
+        CatalogField<float>(record, 0x54) = static_cast<float>(atof(value));
+    else
+        StartupFatal("WorldParams::AddEventData - unrecognised event keyword - %s", key);
+}
