+// Inline copy of DeleteComboBoxEntry (0x004a4f40), as in ~ScreenComboBox.
+inline void DeleteComboEntry(ScreenComboBoxEntry* entry)
+{
+    if (entry)
+    {
+        if (entry->text)
+            ::operator delete(entry->text);
+        ::operator delete(entry);
+    }
+}
+
+static inline void ClearComboEntries(ScreenComboBox* box)
+{
+    std::for_each(box->range_78.begin(), box->range_78.end(), DeleteComboEntry);
+    box->range_78.clear();
+}
+
+// Inline accessor of the hire choices; with it the clear keeps __copy_trivial
+// (0x004450b0) out of line as in the original.
+static inline const ComboBoxChoice& StaffChoice(unsigned int index)
+{
+    return staff_choices[index];
+}
+
+// FUNCTION: BEACHLIFE 0x004a4dc0
+void ScreenComboBox::PopulateStaffHire()
+{
+    MarkPrepared();
+    ClearComboEntries(this);
+    for (unsigned int index = 0; index < 6; ++index)
+    {
+        AddKey(StaffChoice(index).key, StaffChoice(index).value);
+        if (StaffChoice(index).value == screen_manager->word_80)
+            word_58 = index;
+    }
+}
