+
+// FUNCTION: BEACHLIFE 0x004e6fe0
+void ScreenPlacementStore::LoadSavedPlacementPreferences()
+{
+    char buffer[128];
+    char key[128];
+    GetPrivateProfileStringA(screen_placement_profile_dialog_section,
+        screen_placement_profile_dialog_count_key,
+        screen_placement_profile_default,
+        buffer,
+        sizeof(buffer),
+        preferences_path_04);
+    if (strcmp(buffer, screen_placement_profile_default) == 0)
+        return;
+    unsigned int count = atoi(buffer);
+    unsigned int loaded = 0;
+    unsigned int group = 0;
+    while (loaded != count)
+    {
+        sprintf(key, "%s%d", screen_placement_profile_dialog_x_key, static_cast<int>(group));
+        GetPrivateProfileStringA(screen_placement_profile_dialog_section, key, screen_placement_profile_default, buffer, sizeof(buffer), preferences_path_04);
+        if (strcmp(buffer, screen_placement_profile_default) != 0)
+        {
+            SavedScreenPlacement* placement = new SavedScreenPlacement;
+            placement->group = group;
+            placement->x = atoi(buffer);
+            sprintf(key, "%s%d", screen_placement_profile_dialog_y_key, static_cast<int>(group));
+            GetPrivateProfileStringA(screen_placement_profile_dialog_section, key, screen_placement_profile_default, buffer, sizeof(buffer), preferences_path_04);
+            placement->y = atoi(buffer);
+            saved.Insert(saved.End(), placement);
+            ++loaded;
+        }
+        ++group;
+    }
+}
