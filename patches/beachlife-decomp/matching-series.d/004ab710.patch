+void GuiParserState::PopContext()
+{
+    if (current_context)
+    {
+        if (context_head)
+        {
+            ScreenChildLink* last = context_head;
+            ScreenChildLink* previous = 0;
+            while (last->next)
+            {
+                previous = last;
+                last = last->next;
+            }
+            current_context = last->item;
+            if (previous)
+            {
+                previous->next = 0;
+                previous_context = previous->item;
+            }
+            else
+            {
+                previous_context = 0;
+                context_head = 0;
+            }
+            last->item = 0;
+            delete last;
+        }
+        else
+        {
+            current_context = 0;
+            previous_context = 0;
+        }
+    }
