+#include "startup_game_save_record.h"
+#include "startup_screen_manager.h"
+#include "startup_screen_list_box.h"
+#include "startup_screen_text.h"
+#include <math.h>
+#include <stdio.h>
+#include <time.h>
+#include <wchar.h>
+
+static inline unsigned int SelectionSize(const ScreenListBoxSelectionRange& range)
+{
+    return range.end() - range.begin();
+}
+
+// FUNCTION: BEACHLIFE 0x004e5100
+void ScreenRequestGamePrefix::UpdateBeforeInput()
+{
+    selected_save = 0;
+    if (!save_info_enabled)
+        return;
+    ScreenListBoxPrefix* info = screens->FindListBox(game_load_info_box_name);
+    ScreenListBoxPrefix* list = screens->FindListBox(game_load_list_box_name);
+    info->state_59 = 0;
+    info->ClearEntries();
+    if (SelectionSize(list->selection) == 0)
+        return;
+    list->word_84 = 0;
+    GameSaveRecord* record = saves[list->selection[0]];
+    selected_save = record;
+    info->AddEntry(0, 0, 350, 15, 2, 0, 0, screen_text_lookup->LookupText(record->name_1c), 1);
+
+    float time = record->time_10;
+    float fraction = (time - static_cast<unsigned int>(floor(time))) * 60.0f;
+    int minutes = 0;
+    if (fraction >= 15.0f)
+        minutes = 15;
+    if (fraction >= 30.0f)
+        minutes = 30;
+    if (fraction >= 45.0f)
+        minutes = 45;
+    int hours = static_cast<int>(floor(record->time_10));
+    unsigned short buffer[128];
+    swprintf(buffer, screen_text_lookup->LookupText("LOADSAVE_DAYTIME_CONTENTS"), record->day_0c + 1, hours, minutes);
+    info->AddEntry(1, 0, 350, 15, 2, 0, 0, buffer, 1);
+
+    swprintf(buffer, screen_text_lookup->LookupText("LOADSAVE_CASH_CONTENTS"), static_cast<double>(record->cash_14));
+    info->AddEntry(2, 0, 350, 15, 2, 0, 0, buffer, 1);
+
+    time_t timestamp = record->time_04;
+    struct tm* date = localtime(&timestamp);
+    swprintf(buffer, screen_text_lookup->LookupText("LOADSAVE_INFO_TIME_CONTENTS"), date->tm_hour, date->tm_min, date->tm_mday, date->tm_mon + 1, date->tm_year + 1900);
+    info->AddEntry(3, 0, 350, 15, 2, 0, 0, buffer, 1);
+
+    swprintf(buffer, screen_text_lookup->LookupText("LOADSAVE_GUESTS_CONTENTS"), record->guests_18);
+    info->AddEntry(4, 0, 350, 15, 2, 0, 0, buffer, 1);
+}
