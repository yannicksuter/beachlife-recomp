+#include "startup_screen_radio_item.h"
+#include "startup_screen_text.h"
+
+// FUNCTION: BEACHLIFE 0x004ad610
+void GuiParserState::ParseRadioButton()
+{
+    if (buffer[cursor] == '(')
+    {
+        ++cursor;
+        while (
+            buffer[cursor] == ' ' || buffer[cursor] == '\r' || buffer[cursor] == '\n' || buffer[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        char resource_name[64];
+        ReadText(resource_name);
+        int word54;
+        ReadInteger(word54, true);
+        int value;
+        ReadInteger(value, true);
+        char name[64];
+        ReadText(name);
+        ScreenRadioItem* item = new ScreenRadioItem(
+            rectangle, resource_name, name, static_cast<unsigned int>(word54), value);
+
+        if (items_tail == 0)
+        {
+            items_tail = new ScreenChildLink(item);
+            items_head = items_tail;
+        }
+        else
+        {
+            ScreenChildLink* link = new ScreenChildLink(item);
+            items_tail->next = link;
+            items_tail = items_tail->next;
+        }
+        current_context->Unresolved10(item);
+
+        if (buffer[cursor - 1] == ',')
+        {
+            while (buffer[cursor] == ' ' || buffer[cursor] == '\r' || buffer[cursor] == '\n' || buffer[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            char text[64];
+            ReadText(text);
+            item->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::ProcessRadioButton - Script Error \r\nNo open bracket found at "
+                     "file offset - %u",
+            cursor);
+    }
+}
