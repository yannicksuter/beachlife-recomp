+#include "startup_ble_file.h"
+#include "startup_world_subsystems.h"
+#include "startup_world_script_command_init.h"
+#include "startup_game_file.h"
+#include <string.h>
+#include <new>
+
+static inline int SkipWorldScriptWhitespace(char*& cursor)
+{
+    int count = 0;
+    while (*cursor == ' ' || *cursor == '\r' || *cursor == '\n' || *cursor == '\t')
+    {
+        ++count;
+        ++cursor;
+    }
+    return count;
+}
+static inline int SkipLoadComments(WorldSubsystem20* script)
+{
+    char*& cursor = script->cursor_00;
+    int count = 0;
+    if (*cursor == '/')
+    {
+        ++cursor;
+        count = 1;
+        while (*cursor != '\n')
+        {
+            ++count;
+            ++cursor;
+        }
+        count += SkipWorldScriptWhitespace(cursor);
+        count += script->SkipComments();
+        count += SkipWorldScriptWhitespace(cursor);
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x004dce70
+int WorldSubsystem20::LoadScript(const char* path)
+{
+    int consumed = 0;
+    unsigned int length = strlen(path);
+    char* filename = static_cast<char*>(::operator new(length + 1));
+    strcpy(filename, path);
+    filename[length - 4] = '.';
+    filename[length - 3] = 'b';
+    filename[length - 2] = 'l';
+    filename[length - 1] = 'e';
+    int size = GetFileSize(filename);
+    cursor_00 = LoadBleFile(filename);
+    ::operator delete(filename);
+    char* buffer = cursor_00;
+    while (size > consumed)
+    {
+        consumed += SkipWorldScriptWhitespace(cursor_00);
+        if (size <= consumed)
+            break;
+        consumed += SkipLoadComments(this);
+        if (size <= consumed)
+            break;
+        char token[64];
+        consumed += ReadToken(token);
+        if (strcmp(token, "State") == 0)
+            consumed += ParseState();
+        else if (token[0] == '/')
+            consumed += SkipLoadComments(this);
+        else
+            StartupFatal("Invalid Command Recieved in WorldScript");
+    }
+    ::operator delete(buffer);
+    return size;
+}
