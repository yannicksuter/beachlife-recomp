+#include "startup_screen_frame_draw.h"
+#include "startup_screen_dialog_resource.h"
+#include "startup_screen_frame_resources.h"
+#include "startup_screen_item.h"
+#include "startup_screen_renderer.h"
+
+static inline int FrameHeight(ScreenDialogResource* resource)
+{
+    return resource->record->frames[resource->word_10]->height_10;
+}
+
+// FUNCTION: BEACHLIFE 0x004c7b50
+void DrawFrameStyle5(const ScreenRectangle& rectangle)
+{
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    ScreenDialogResource* resource = screen_dialog_resources->Lookup(screen_frame_style5_name);
+    resource->word_08 = 3;
+    int height = rectangle.bottom - 2 * FrameHeight(resource) - rectangle.top;
+    int y = rectangle.top;
+    if (height < 0)
+        height = 0;
+    resource->word_14 = 0;
+    resource->Draw(rectangle.left, y, 0, 999999.0f);
+    y += FrameHeight(resource);
+    if (height != 0)
+    {
+        int bottom = y + height;
+        int x = rectangle.left;
+        unsigned short colour;
+        colour = renderer->ConvertColour(0x68, 0xa5, 0x7a);
+        renderer->DrawLine(x, y, x, bottom, colour);
+        ++x;
+        colour = renderer->ConvertColour(0x42, 0x9f, 0x5a);
+        renderer->DrawLine(x, y, x, bottom, colour);
+        ++x;
+        colour = renderer->ConvertColour(0x39, 0xb6, 0x64);
+        renderer->DrawLine(x, y, x, bottom, colour);
+        ++x;
+        colour = renderer->ConvertColour(0x43, 0xc5, 0x73);
+        ScreenRectangle fill;
+        fill.left = x;
+        fill.top = y;
+        fill.bottom = bottom;
+        fill.right = x + 6;
+        renderer->FillRectangle(fill, colour);
+        x += 6;
+        colour = renderer->ConvertColour(0x7a, 0xd8, 0x9e);
+        renderer->DrawLine(x, y, x, bottom, colour);
+        ++x;
+        colour = renderer->ConvertColour(0xb3, 0xeb, 0xcb);
+        renderer->DrawLine(x, y, x, bottom, colour);
+        ++x;
+        colour = renderer->ConvertColour(0x68, 0xa5, 0x7a);
+        renderer->DrawLine(x, y, x, bottom, colour);
+    }
+    resource->word_14 = 1;
+    resource->Draw(rectangle.left, y + height, 0, 999999.0f);
+    screen_dialog_resources->Release(resource);
+}
