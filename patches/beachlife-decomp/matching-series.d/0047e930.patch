+#include "startup_screen_position_inlines.h"
+#include "startup_screen_mode_world.h"
+#include "startup_world_entities.h"
+#include <math.h>
+
+static inline ScreenWorldPosition operator-(const ScreenWorldPosition& first, const ScreenWorldPosition& second)
+{
+    return ScreenWorldPosition(first.x - second.x, first.y - second.y, first.z - second.z);
+}
+
+static inline float Length(const ScreenWorldPosition& point)
+{
+    return sqrt(point.z * point.z + point.y * point.y + point.x * point.x);
+}
+
+// FUNCTION: BEACHLIFE 0x0047e930
+void WorldLifeguardEntity::FindBeachArea()
+{
+    unsigned int area = 0;
+    unsigned int nearest_area = 0;
+    float distance = 0.0f;
+    ScreenWorldPosition position = position_30;
+    ScreenTerrainRouteNode* nearest = screen_terrain_grid->routes_1c;
+    unsigned int count;
+    ScreenPoint* points = nearest->Points(&count);
+    ScreenPoint closest = points[0];
+    for (unsigned int i = 1; i < count; ++i)
+    {
+        ScreenWorldPosition candidate = screen_terrain_grid->TileOrigin(points[i]) - position;
+        ScreenWorldPosition close = screen_terrain_grid->TileOrigin(closest) - position;
+        if (Length(candidate) < Length(close))
+            closest = points[i];
+    }
+    for (ScreenTerrainRouteNode* route = nearest; route; route = route->Next(), ++area)
+    {
+        points = route->Points(&count);
+        for (unsigned int i = 0; i < count; ++i)
+        {
+            ScreenWorldPosition candidate = screen_terrain_grid->TileOrigin(points[i]) - position;
+            // A zero distance doubles as "no area yet", so a later point replaces an exact hit.
+            if (Length(candidate) < distance || distance == 0.0f)
+            {
+                nearest_area = area;
+                nearest = route;
+                ScreenWorldPosition chosen = screen_terrain_grid->TileOrigin(points[i]) - position;
+                distance = Length(chosen);
+            }
+        }
+    }
+    beach_route_780 = nearest;
+    beach_area_784 = nearest_area;
+}
