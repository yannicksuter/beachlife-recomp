+        {
+            script->rules_00[script->count_5910].commands_04[script->rules_00[script->count_5910].count_16c].id_00 = world_script_message_names[index].id;
+            return count;
+        }
+    }
+    StartupFatal("ObjectScript::DetermineMessage - Message doesn't exist check message decode table %s", name);
+    return 0;
+}
