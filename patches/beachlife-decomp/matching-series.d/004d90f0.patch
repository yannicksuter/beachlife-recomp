+// Reads the message name and stores its id in the current rule's next command slot.
+static inline int DetermineMessage(WorldSubsystemScript* script)
+{
+    char name[52];
+    int count = script->ReadToken(name);
+    for (unsigned int index = 0; index < 108; ++index)
+    {
