+// FUNCTION: BEACHLIFE 0x004d90f0
+int WorldSubsystemScript::ParseMessage()
+{
+    int count = DetermineMessage(this) + SkipMessageWhitespace(this);
+    int comments = SkipMessageComments(this);
+    char token[52];
+    count += ReadToken(token) + comments;
