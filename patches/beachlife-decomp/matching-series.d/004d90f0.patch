+// The retail unit expands one level of the comment skipper here.
+static inline int SkipMessageComments(WorldSubsystemScript* script)
+{
+    int count = 0;
+    if (*script->cursor_591c == '/')
+    {
+        script->cursor_591c++;
+        count = 1;
+        if (*script->cursor_591c != '\n')
+        {
+            do
