+                count++;
+                script->cursor_591c++;
+            } while (*script->cursor_591c != '\n');
+        }
+        int leading = 0;
+        while (*script->cursor_591c == ' ' || *script->cursor_591c == '\r' || *script->cursor_591c == '\n'
+               || *script->cursor_591c == '\t')
+        {
+            leading++;
+            script->cursor_591c++;
+        }
+        count += script->SkipComments() + leading;
+        int trailing = 0;
+        while (*script->cursor_591c == ' ' || *script->cursor_591c == '\r' || *script->cursor_591c == '\n'
+               || *script->cursor_591c == '\t')
+        {
+            trailing++;
+            script->cursor_591c++;
+        }
+        count += trailing;
+    }
+    return count;
+}
