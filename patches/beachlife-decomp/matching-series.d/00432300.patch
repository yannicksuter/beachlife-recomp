+#include "startup_world_cursor_names.h"
+
+static inline int CursorFrameWhitespace(const char* text)
+{
+    int count = 0;
+    for (;;)
+    {
+        char c = text[count];
+        if (c != ' ' && c != '\r' && c != '\n' && c != '\t')
+            break;
+        ++count;
+    }
+    return count;
+}
+
+// One inline level of SkipCursorFrameComments 0x00432290; the nested call stays out of line.
+static inline int SkipCursorFrameCommentsInline(const char* text)
+{
+    int count = 0;
+    if (*text == '/')
+    {
+        count = 1;
+        while (*++text != '\n')
+            ++count;
+        int skipped = CursorFrameWhitespace(text);
+        text += skipped;
+        count += skipped;
+        skipped = SkipCursorFrameComments(text);
+        count += skipped;
+        count += CursorFrameWhitespace(text + skipped);
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x00432300
+int ReadCursorFrameToken(char* token, const char* text)
+{
+    int count = CursorFrameWhitespace(text);
+    text += count;
+    int skipped = SkipCursorFrameCommentsInline(text);
+    count += skipped;
+    text += skipped;
+    if (*text == ';')
+    {
+        token[0] = ';';
+        ++count;
+        token[1] = 0;
+    }
+    else
+    {
+        while (*text != ';' && *text != ' ' && *text != '\n' && *text != '\t' && *text != '\r')
+        {
+            ++count;
+            *token++ = *text++;
+        }
+        *token = 0;
+    }
+    return count;
+}
