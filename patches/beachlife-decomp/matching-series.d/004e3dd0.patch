+{
+    game->scenario_names.push_back(name);
+}
+
+// FUNCTION: BEACHLIFE 0x004e3dd0
+void ScreenRequestGamePrefix::LoadScenarioNames()
+{
+    scenario_names.clear();
+
+    char pattern[128];
+    _finddata_t found;
+    sprintf(pattern, "%s*.*", scenario_directory);
+    long handle = _findfirst(pattern, &found);
+    if (handle != -1)
+    {
+        do
+        {
+            if ((found.attrib & _A_SUBDIR) && strcmp(".", found.name) != 0 && strcmp("..", found.name) != 0)
+            {
+                unsigned short* name = static_cast<unsigned short*>(::operator new(128 * sizeof(unsigned short)));
+                MultiByteToWideChar(CP_ACP,
+                    MB_PRECOMPOSED,
+                    found.name,
+                    -1,
+                    name,
+                    static_cast<int>(strlen(found.name) + 1));
+
+                AppendScenarioName(this, name);
+            }
+        } while (_findnext(handle, &found) != -1);
+    }
+    _findclose(handle);
+}
