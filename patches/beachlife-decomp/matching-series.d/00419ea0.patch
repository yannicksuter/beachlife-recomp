+// Copies the overlay archive's colour and depth words of every pixel in the rectangle into the mapped tile cache,
+// mapping each 128-pixel tile view on first use.
+// FUNCTION: BEACHLIFE 0x00419ea0
+void OverlayMapPrefix::InvalidateRectangle(const ScreenRectangle* rectangle)
+{
+    int base_x = rectangle->left / 128;
+    int base_y = rectangle->top / 128;
+    int start_x = rectangle->left % 128;
+    int start_y = rectangle->top % 128;
+    int limit_x = rectangle->right - base_x * 128;
+    int limit_y = rectangle->bottom - base_y * 128;
+    // A dead alias of this: VC6 coalesces it into the same register and keeps retail's imul operand order.
+    OverlayMapPrefix* self = this;
+    int previous_x = -1;
+    int previous_y = -1;
+    unsigned short* view;
+    unsigned short* colours;
+    unsigned short* depths;
+    for (int y = start_y; y < limit_y; y++)
+    {
+        for (int x = start_x; x < limit_x; x++)
+        {
+            int tile_y = y / 128 + base_y;
+            int row_offset = (y % 128) * 128;
+            int tile_x = x / 128 + base_x;
+            if (tile_x != previous_x || tile_y != previous_y)
+            {
+                if (!cached_tiles_e0[tile_y * cache_height_d8 + tile_x].ready)
+                {
+                    cached_tiles_e0[self->cache_width_d4 * tile_y + tile_x].ready = 1;
+                    unsigned int pixels = static_cast<unsigned int>(tile_size_dc) * tile_size_dc;
+                    unsigned int offset = (self->cache_width_d4 * tile_y + tile_x) * pixels * 4;
+                    void* mapped = mapped_file_f4->MapView(offset, pixels * 4);
+                    cached_tiles_e0[self->cache_width_d4 * tile_y + tile_x].view = mapped;
+                }
+                if (!cached_tiles_e0[self->cache_width_d4 * tile_y + tile_x].ready)
+                {
+                    cached_tiles_e0[self->cache_width_d4 * tile_y + tile_x].ready = 1;
+                    unsigned int pixels = static_cast<unsigned int>(tile_size_dc) * tile_size_dc;
+                    unsigned int offset = (self->cache_width_d4 * tile_y + tile_x) * pixels * 4;
+                    void* mapped = mapped_file_f4->MapView(offset, pixels * 4);
+                    cached_tiles_e0[self->cache_width_d4 * tile_y + tile_x].view = mapped;
+                }
+                view = static_cast<unsigned short*>(cached_tiles_e0[self->cache_width_d4 * tile_y + tile_x].view);
+                depths = archive_154->Depths(tile_x, tile_y);
+                colours = archive_154->Colours(tile_x, tile_y);
+            }
+            int pixel = row_offset + x % 128;
+            view[pixel * 2] = colours[pixel];
+            view[pixel * 2 + 1] = depths[pixel];
+            previous_x = tile_x;
+            previous_y = tile_y;
+        }
+    }
+}
