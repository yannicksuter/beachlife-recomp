+// The tile's screen origin moved half a tile towards the given edge (1 down, 2 left, 3 right, 4 half down).
+// FUNCTION: BEACHLIFE 0x00446260
+ScreenWorldPosition ScreenTerrainGrid::TilePosition(ScreenPoint tile, int direction)
+{
+    int size = tile_size_00;
+    int x = tile.x;
+    int y = tile.y;
+    int half = size / 2;
+    ScreenWorldPosition origin;
+    origin.x = (float)(half * x);
+    if (x & 1)
+        origin.y = (float)(y * size);
+    else
+        origin.y = (float)(y * size - half);
+    ScreenWorldPosition result;
+    result.x = origin.x;
+    result.y = origin.y;
+    switch (direction)
+    {
+    case 1:
+        result.y = (float)(unsigned int)(size - 1) + origin.y;
+        break;
+    case 2:
+    {
+        float offset = (float)((unsigned int)size / 2);
+        result.x = origin.x - offset;
+        result.y = offset + origin.y;
+    }
+    break;
+    case 3:
+    {
+        float offset = (float)((unsigned int)size / 2);
+        result.x = origin.x + offset;
+        result.y = offset + origin.y;
+    }
+    break;
+    case 4:
+        result.y = (float)((unsigned int)size / 2) + origin.y;
+        break;
+    }
+    result.z = 0.0f;
+    return result;
+}
