+#include "startup_world_entities.h"
+#include "startup_screen_text.h"
+#include <string.h>
+#include <wchar.h>
+
+// FUNCTION: BEACHLIFE 0x00455830
+void WorldBuilderEntity::ReadText(const char* key, unsigned short* output)
+{
+    if (strcmp(key, "STAFF_ACTIVITY") == 0)
+    {
+        switch (state_3c)
+        {
+        case 95:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_RESTING"));
+            break;
+        case 96:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_HEADING_HOME"));
+            break;
+        case 97:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_GOING_TO_BUILD"));
+            break;
+        case 98:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_GOING_TO_DEMOLISH"));
+            break;
+        case 99:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_BUILDING"));
+            break;
+        case 100:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_DEMOLISHING"));
+            break;
+        case 101:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_RESTING"));
+            break;
+        case 102:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_RESTING"));
+            break;
+        case 103:
+            wcscpy(output, screen_text_lookup->LookupText("BUILDER_IDLE"));
+            break;
+        default:
+            WorldStaffEntity::ReadText(key, output);
+            break;
+        }
+    }
+    else if (strcmp(key, "BUILDER_CURRENT_BUILD") == 0)
+        variable_world->FindObject(word_98)->ReadText("BUILDING_NAME", output);
+    else if (strcmp(key, "STAFF_NAME") == 0)
+        swprintf(output, personal_name_f8);
+    else if (strcmp(key, "STAFF_JOB_TITLE") == 0)
+        swprintf(output, screen_text_lookup->LookupText("STAFFB_TITLE_BUILDER"));
+    else
+        WorldStaffEntity::ReadText(key, output);
+}
