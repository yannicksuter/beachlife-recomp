+#include "startup_game_file.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004d7080
+int WorldSubsystemScript::ParsePlayAnimationAction(unsigned int phase)
+{
+    char token[52];
+    int count = ReadToken(token);
+    WorldExpressionAnimationData* raw = static_cast<WorldExpressionAnimationData*>(::operator new(sizeof(WorldExpressionAnimationData)));
+    WorldExpressionAnimationData* data = raw ? (raw->name_00 = 0, raw->next_state_0c = 0, raw->word_10 = 0, raw->next_animation_04 = 0, raw->command_08 = 0x6c, raw->once_14 = 0, raw) : 0;
+    data->release_15 = 0;
+    char* name = new char[strlen(token) + 1];
+    data->name_00 = name;
+    strcpy(name, token);
+    count += ReadToken(token);
+    while (strcmp(token, ";") != 0)
+    {
+        if (strcmp(token, "Finish") == 0)
+        {
+            count += ReadToken(token);
+            char* next = new char[strlen(token) + 1];
+            data->next_animation_04 = next;
+            strcpy(next, token);
+        }
+        else if (strcmp(token, "NotLooped") == 0)
+            data->release_15 = 1;
+        else if (strcmp(token, "ExitState") == 0)
+        {
+            count += ReadToken(token);
+            for (unsigned int i = 0; i < 137; ++i)
+            {
+                if (strcmp(token, object_script_states[i].name) == 0)
+                {
+                    data->next_state_0c = object_script_states[i].state;
+                    i = 137;
+                }
+            }
+        }
+        else if (strcmp(token, "MaxTime") == 0)
+        {
+            count += ReadToken(token);
+            *reinterpret_cast<float*>(&data->word_10) = static_cast<float>(atof(token));
+        }
+        else if (strcmp(token, "EndMessage") == 0)
+        {
+            count += ReadToken(token);
+            for (unsigned int i = 0; i < 108; ++i)
+            {
+                if (strcmp(token, world_script_message_names[i].name) == 0)
+                {
+                    data->command_08 = world_script_message_names[i].id;
+                    i = 108;
+                }
+            }
+        }
+        else if (strcmp(token, "Reverse") == 0)
+            data->once_14 = 1;
+        else
+            StartupFatal("ObjectScript::AnimationCommand - Invalid Animation command %s", token);
+        count += ReadToken(token);
+    }
+    Expression* expression = static_cast<Expression*>(::operator new(sizeof(Expression)));
+    AppendExpression(expression ? (expression->data_08 = data, expression->kind_04 = 3, expression->next_00 = 0, expression) : 0, phase);
+    return count;
+}
