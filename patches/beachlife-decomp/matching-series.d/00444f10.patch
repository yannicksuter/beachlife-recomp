+VariableEntity** UpperBoundPointer(VariableEntity** first, VariableEntity** last, VariableEntity* const& value, BuildingNameOrder order)
+{
+    int count = static_cast<int>(last - first);
+    while (count > 0)
+    {
+        int half = count >> 1;
+        VariableEntity** middle = first + half;
+        bool before = strcmp((value)->AsBuilding()->building_60->name_04 + 0x40, (*middle)->AsBuilding()->building_60->name_04 + 0x40) < 0;
+        if (before)
+            count = half;
+        else
+        {
+            first = middle + 1;
+            count -= half + 1;
+        }
+    }
+    return first;
+}
