+#include <math.h>
+#include <string.h>
+
+// Retail inlines ConvertWorldScriptInteger (0x004dab20) here.
+static inline int ScriptInteger(WorldScriptValue value)
+{
+    int result = 0;
+    switch (value.kind)
+    {
+    case 0:
+        result = value.data & 255;
+        break;
+    case 2:
+        result = static_cast<int>(value.data);
+        break;
+    case 3:
+        result = static_cast<int>(*reinterpret_cast<float*>(&value.data));
+        break;
+    }
+    return result;
+}
+
+// Retail inlines ConvertWorldScriptNumber (0x004dab50) here.
+static inline float ScriptNumber(WorldScriptValue value)
+{
+    float result = 0.0f;
+    switch (value.kind)
+    {
+    case 0:
+        result = static_cast<float>(static_cast<int>(value.data & 255));
+        break;
+    case 2:
+        result = static_cast<float>(value.data);
+        break;
+    case 3:
+        result = *reinterpret_cast<float*>(&value.data);
+        break;
+    }
+    return result;
+}
+
+// FUNCTION: BEACHLIFE 0x004d4f60
+bool WorldSubsystemScript::Expression::EqualOperands(VariableEntity* entity, WorldScriptValue left, WorldScriptValue right)
+{
+    WorldScriptValue first = entity->Unknown2c(left);
+    WorldScriptValue second = entity->Unknown2c(right);
+    if (first.kind == 1)
+    {
+        bool result = strcmp(reinterpret_cast<const char*>(first.data), reinterpret_cast<const char*>(second.data)) == 0;
+        return result;
+    }
+    if (first.kind == 2)
+    {
+        bool result = first.data == static_cast<unsigned int>(ScriptInteger(second));
+        return result;
+    }
+    if (fabs(ScriptNumber(first) - ScriptNumber(second)) <= 0.00001f)
+        return true;
+    return false;
+}
