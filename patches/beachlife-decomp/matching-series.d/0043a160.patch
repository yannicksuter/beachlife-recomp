+static inline void DarkenWeatherPixel(unsigned int* pixel)
+{
+    unsigned int value = *pixel;
+    unsigned int low = value & 0xffff;
+    if (screen_request_renderer->format_44 == 1)
+        low = ((low >> 1) & 0x3def) + 0x3def;
+    else
+        low = ((low >> 1) & 0x7bef) + 0x7bef;
+    *pixel = (value & 0xffff0000u) + low;
+}
+
+// FUNCTION: BEACHLIFE 0x0043a160
+void VariableWeather::Render()
+{
+    if (lighting_2c38 != 3 && lighting_2c38 != 4 && lighting_2c38 != 5)
+        return;
+    ScreenRectangle area = overlay_map->view_ac;
+    ScreenRectangle view = overlay_map->view_ac;
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    unsigned int* pixels = reinterpret_cast<unsigned int*>(renderer->pixels_1c);
+    int count = 4000;
+    if (lighting_2c38 == 3)
+        count = 2000;
+    if (view.bottom > 600)
+        count += count;
+    for (int i = 0; i < count; ++i)
+    {
+        unsigned int* width = &renderer->width;
+        if (!window_deactivation_state->deactivation_requested)
+        {
+            if (lighting_2c38 == 3)
+            {
+                weather_particles[i].x = (weather_particles[i].x + 1) % area.right;
+                weather_particles[i].y = (weather_particles[i].y + 8) % (view.bottom - 2);
+            }
+            else
+            {
+                weather_particles[i].x = (weather_particles[i].x + 2) % area.right;
+                weather_particles[i].y = (weather_particles[i].y + 14) % (view.bottom - 2);
+            }
+        }
+        ScreenPoint* particle = &weather_particles[i];
+        unsigned int* pixel = pixels + particle->y * *width + particle->x;
+        DarkenWeatherPixel(pixel);
+        pixel += *width;
+        DarkenWeatherPixel(pixel);
+        if (lighting_2c38 != 3)
+        {
+            pixel += *width;
+            DarkenWeatherPixel(pixel);
+        }
+    }
+}
