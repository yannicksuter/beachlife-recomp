+#include "startup_game_file.h"
+#include <stdlib.h>
+
+static inline float RandomBetween(float low, float high)
+{
+    return (rand() * (1.0f / 32767)) * (high - low) + low;
+}
+
+// FUNCTION: BEACHLIFE 0x00475090
+void WorldGuestEntity::PerformAction78()
+{
+    unsigned int count;
+    VariableEntity** stops = variable_world->FindNamed("WHARF", &count);
+    if (count == 0)
+        stops = variable_world->FindNamed("BUSSTOP", &count);
+    if (count)
+    {
+        ScreenWorldPosition origin = stops[0]->AsBuilding()->StaffPosition();
+        ScreenWorldPosition position;
+        float x = RandomBetween(-100.0f, 100.0f);
+        long double y = RandomBetween(-100.0f, 100.0f);
+        position.x = static_cast<float>(static_cast<long double>(origin.x) + x);
+        position.y = static_cast<float>(y + origin.y);
+        position.z = origin.z;
+        int attempts = 0;
+        while (!(((CurrentScreenTerrain()->CellAt(position)->flags_48 & 0x10000082)
+                         && !(CurrentScreenTerrain()->CellAt(position)->flags_48 & 0x8000)
+                     || attempts >= 1000)
+                 && position.x < 4096.0f && position.x >= 0.0f && position.y < 8192.0f && position.y >= 0.0f))
+        {
+            x = RandomBetween(-100.0f, 100.0f);
+            y = RandomBetween(-100.0f, 100.0f);
+            position.x = static_cast<float>(static_cast<long double>(origin.x) + x);
+            position.y = static_cast<float>(y + origin.y);
+            position.z = origin.z;
+            ++attempts;
+        }
+        if (attempts == 1000)
+        {
+            position.x = origin.x;
+            position.y = origin.y;
+        }
+        word_250 = 0;
+        walkpoints_22c[0].x = position.x;
+        walkpoints_22c[0].y = position.y;
+        ScreenModeCommand command;
+        command.words[0] = id_28;
+        command.words[1] = id_28;
+        command.words[2] = 8;
+        command.words[3] = static_cast<int>(position.x);
+        command.words[4] = static_cast<int>(position.y);
+        screen_mode_commands->QueueCommand(&command);
+    }
+    else
+        StartupFatal("No Wharf or Bustop Found");
+}
