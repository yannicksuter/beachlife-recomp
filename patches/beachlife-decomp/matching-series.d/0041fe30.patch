+unsigned int WorldCleaningManager::FindUrgentTask(const ScreenWorldPosition* position,
+    unsigned int* kind, unsigned char bins, unsigned char litter, unsigned char toilets)
+{
+    std::_List_node_base* selected;
+    unsigned int id = ~0u;
+    bool found = false;
+    for (WorldCleaningRequestList::iterator it = requests_00.begin(); it != requests_00.end(); ++it)
+    {
+        std::_List_node_base* node = it._M_node;
+        WorldCleaningRequest* request = static_cast<WorldCleaningRequestNode*>(node)->_M_data;
+        if (request->time_08 == 0.0f || !request->flag_0c)
+            continue;
+        WorldStaticEntity* entity = static_cast<WorldStaticEntity*>(variable_world->FindObject(request->id_00));
+        if (entity->NeedsCleaning())
+            continue;
+        if (strcmp(entity->name_06, "Bin") == 0)
+        {
+            if (bins && !static_cast<WorldSceneryEntity*>(entity)->byte_a0 && !entity->NeedsRepair())
+            {
+                selected = node;
+                found = true;
+            }
+        }
+        else if (entity->kind_2c == 2)
+        {
+            if (toilets && !entity->FlagAt00460310() && !entity->FlagAt00460340())
+            {
+                selected = node;
+                found = true;
+            }
+        }
+        else if (litter)
+        {
+            selected = node;
+            found = true;
+        }
+    }
+    if (found)
+    {
+        id = static_cast<WorldCleaningRequestNode*>(selected)->_M_data->id_00;
+        *kind = ~0u;
+        VariableEntity* entity = variable_world->FindObject(id);
+        if (strcmp(entity->name_06, "Litter") == 0)
+            *kind = 0;
+        else if (strcmp(entity->name_06, "Bin") == 0)
+            *kind = 1;
+        else if (strcmp(entity->name_06, "LOO") == 0)
+            *kind = 2;
+        AddAssignment(id, 1);
+        entity->SetFlag5a(1);
+        delete static_cast<WorldCleaningRequestNode*>(selected)->_M_data;
+        requests_00.erase(WorldCleaningRequestList::iterator(static_cast<WorldCleaningRequestNode*>(selected)));
+    }
+    return id;
+}
