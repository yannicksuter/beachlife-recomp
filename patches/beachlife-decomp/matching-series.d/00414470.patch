+#include "startup_screen_dialog_resource.h"
+#include "startup_screen_overlay_layout.h"
+
+// FUNCTION: BEACHLIFE 0x00414470
+void ScreenDialogResource::UpdateBuildingTiles(const ScreenRectangle* rectangle, int tile_x, int tile_y,
+    int offset_x, int offset_y, float depth_step, unsigned int depth)
+{
+    if (record->format_18 != 5)
+        return;
+
+    ScreenDialogResourceFrame* color_frame = record->frames[0];
+    const unsigned char* pixels = color_frame->SelectData(word_14, word_18);
+    ScreenDialogResourceFrame* depth_frame = record->frames[1];
+    const unsigned char* depths = depth_frame->SelectData(word_14, word_18);
+    OverlayMapPrefix* map = overlay_map;
+    unsigned short* palette = *record->palettes;
+    int width = record->frames[word_10]->width_0e;
+    int x;
+    int y;
+    signed char c;
+
+    for (y = 0; y < rectangle->top; y++)
+    {
+        x = 0;
+        while (x < width)
+        {
+            c = *pixels++;
+            depths++;
+            if (c > 0)
+            {
+                x += c;
+                pixels += c;
+                depths += c;
+            }
+            else
+            {
+                x -= c;
+            }
+        }
+    }
+
+    for (y = rectangle->top; y < rectangle->bottom; y++)
+    {
+        x = 0;
+        while (x < width)
+        {
+            c = *pixels++;
+            depths++;
+            for (; c > 0; c--)
+            {
+                if (x >= rectangle->left && x < rectangle->right)
+                {
+                    int px = x + offset_x;
+                    int py = y + offset_y;
+                    int gx = px / 128 + tile_x;
+                    int gy = py / 128 + tile_y;
+                    if (!map->cached_tiles_e0[map->cache_height_d8 * gy + gx].ready)
+                        map->MapCachedTile(gx, gy);
+                    if (!map->cached_tiles_e0[map->cache_width_d4 * gy + gx].ready)
+                        map->MapCachedTile(gx, gy);
+                    unsigned int* view = static_cast<unsigned int*>(map->cached_tiles_e0[map->cache_width_d4 * gy + gx].view);
+                    unsigned int value = ((unsigned short)(*depths * depth_step) + (unsigned short)depth) << 16;
+                    value = (value & 0xFFFEFFFF) + 0x10000;
+                    int index = (py % 128) * 128 + (px % 128);
+                    if ((view[index] & 0xFFFF0000) <= value)
+                        view[index] = palette[*pixels] + value;
+                }
+                pixels++;
+                depths++;
+                x++;
+            }
+            x -= c;
+        }
+    }
+}
