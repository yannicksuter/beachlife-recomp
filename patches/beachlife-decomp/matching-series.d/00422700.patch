+// FUNCTION: BEACHLIFE 0x00422700
+void VariableBuildingStatus::PrepareBuilderLocations(unsigned int id)
+{
+    WorldBuildingEntity* entity = static_cast<WorldBuildingEntity*>(variable_world->FindObject(id));
+    VariableBuilding* building = entity->building_60;
+    const VariableBuilding* definition = building;
+    std::_List_node_base* node = FindBuildingStatusNode(tasks_00, id);
+    BuildingStatusEntry* task = node != tasks_00.end()._M_node ? static_cast<BuildingStatusNode*>(node)->_M_data : 0;
+    ScreenPoint row_start = entity->TilePosition();
+    ScreenPoint tile = row_start;
+    unsigned int rotation = entity->keyline_state_44->word_18;
+    unsigned int columns = building->footprint_x_1d4 + 2;
+    unsigned int rows = building->footprint_y_1d8 + 2;
+    unsigned int odd = rotation & 1;
+    if (odd == 1)
+    {
+        std::swap(columns, rows);
+    }
+    int column_direction;
+    int row_direction;
+    unsigned int count = 0;
+    screen_terrain_grid->BuildingBounds(row_start, rows, columns, &column_direction, &row_direction, rotation);
+    tile = row_start;
+    for (unsigned int row = 0; row < rows; ++row)
+    {
+        for (unsigned int column = 0; column < columns; ++column)
+        {
+            unsigned int first;
+            unsigned int second;
+            if ((rotation & 1) == 0)
+            {
+                first = row;
+                second = column;
+            }
+            else
+            {
+                first = column;
+                second = row;
+            }
+            unsigned int flags = definition->footprint_e14[0x9cc / 4 + first * 25 + second];
+            if (flags != 0x80000000 && flags != 0 && !(flags & 0x40000800))
+            {
+                ScreenWorldPosition position = screen_terrain_grid->TilePosition(tile, 4);
+                task->details_2c[count]->word_00 = static_cast<int>(position.x);
+                task->details_2c[count]->word_04 = static_cast<int>(position.y);
+                unsigned int direction = definition->footprint_e14[0x9cc / 4 + first * 25 + second];
+                if (flags & 0x80000000)
+                    direction &= 0x7fffffff;
+                task->details_2c[count]->word_08 = direction;
+                ++count;
+            }
+            screen_terrain_grid->Step(tile, column_direction, &tile);
+        }
+        tile.x = row_start.x;
+        tile.y = row_start.y;
+        screen_terrain_grid->Step(tile, row_direction, &tile);
+        row_start = tile;
+    }
+}
