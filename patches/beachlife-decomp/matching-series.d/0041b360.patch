+#include "startup_screen_overlay_layout.h"
+#include "startup_screen_mode_world.h"
+#include "startup_screen_position_inlines.h"
+#include <math.h>
+
+// FUNCTION: BEACHLIFE 0x0041b360
+ScreenWorldPosition OverlayMapPrefix::ScreenToWorld(const ScreenPoint& point)
+{
+    unsigned char done = 0;
+    double grid_scale = screen_terrain_grid->height_scale_14;
+    long double initial = static_cast<int>(static_cast<float>(grid_scale) * 255.0f) * 0.5f;
+    float height = initial;
+    float step = initial;
+    int iteration = 0;
+    while (!done)
+    {
+        if (iteration >= 100)
+            break;
+        float sampled = HeightAt(point.x, point.y + static_cast<int>(height));
+        if (fabs(sampled - height) > 3.0f)
+        {
+            step *= 0.5f;
+            if (sampled > height)
+                height = step + height;
+            else
+                height -= step;
+        }
+        else
+            done = 1;
+        ++iteration;
+    }
+    ScreenWorldPosition result;
+    result.x = static_cast<float>(point.x);
+    result.y = (point.y + height) * 2.0f;
+    result.z = 0.0f;
+    return result;
+}
