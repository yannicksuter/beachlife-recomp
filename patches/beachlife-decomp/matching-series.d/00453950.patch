+#include "startup_screen_position_inlines.h"
+
+// FUNCTION: BEACHLIFE 0x00453950
+void VariableEntity::SetWorldPosition(const ScreenWorldPosition* position)
+{
+    ScreenTerrainCell* cell = CurrentScreenTerrain()->CellAt(*position);
+    if (!cell->ContainsEntity(this))
+    {
+        ScreenTerrainCell* old = CurrentScreenTerrain()->CellAt(position_30);
+        old->RemoveEntity(this);
+        cell->AddEntity(this);
+    }
+    position_30.x = position->x;
+    position_30.y = position->y;
+    position_30.z = position->z;
+    position_30.z = overlay_map->WorldHeightAt(static_cast<int>(position->x), static_cast<int>(position->y));
+}
