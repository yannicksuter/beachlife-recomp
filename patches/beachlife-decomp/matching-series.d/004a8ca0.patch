+// FUNCTION: BEACHLIFE 0x004a8ca0
+unsigned char ScreenMode4Controller::SelectGuestAtPointer(unsigned char flag, ScreenPoint* point, int previous)
+{
+    unsigned char selected = 0;
+    ScreenPoint scrolled = *point;
+    scrolled.x += overlay_map->scroll_x_c4;
+    scrolled.y += overlay_map->scroll_y_c8;
+    ScreenPoint tile;
+    tile = CurrentScreenTerrain()->WorldToTile(CurrentOverlayMap()->ScreenToWorld(scrolled));
+    TerrainEntityList* objects = screen_terrain_grid->ObjectsAt(tile.x, tile.y);
+    for (TerrainEntityList::iterator it = objects->begin(); it != objects->end() && !selected; ++it)
+    {
+        VariableEntity* entity = *it;
+        if (entity->kind_2c >= 7 && entity->kind_2c <= 12)
+        {
+            if (flag)
+            {
+                if (entity->selection_state_54 == 1 || entity->selection_state_54 == 2)
+                    selected = entity->SelectStaffPointer(point);
+            }
+            else if (entity->selection_state_54 == 0)
+            {
+                if (previous != -1)
+                {
+                    if (entity->MatchesPointerGroup(previous))
+                        selected = entity->SelectStaffPointer(point);
+                }
+                else
+                    selected = entity->SelectStaffPointer(point);
+            }
+        }
+    }
+    if (selected)
+        return selected;
+    ScreenTerrainCell* neighbours[8];
+    screen_terrain_grid->Neighbours(tile, neighbours);
+    for (int index = 0; index < 8 && !selected; ++index)
+    {
+        objects = neighbours[index]->Objects();
+        for (TerrainEntityList::iterator it2 = objects->begin(); it2 != objects->end() && !selected; ++it2)
+        {
+            VariableEntity* entity = *it2;
+            if (entity->kind_2c >= 7 && entity->kind_2c <= 12)
+            {
+                if (flag)
+                {
+                    if (entity->selection_state_54 == 1 || entity->selection_state_54 == 2)
+                        selected = entity->SelectStaffPointer(point);
+                }
+                else if (entity->selection_state_54 == 0)
+                {
+                    if (previous != -1)
+                    {
+                        if (entity->MatchesPointerGroup(previous))
+                            selected = entity->SelectStaffPointer(point);
+                    }
+                    else
+                        selected = entity->SelectStaffPointer(point);
+                }
+            }
+        }
+    }
+    return selected;
+}
