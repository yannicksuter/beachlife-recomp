+#include "startup_screen_renderer_inlines.h"
+#include "surface_error_sink.h"
+
+// FUNCTION: BEACHLIFE 0x0040e7f0
+void ScreenRequestRenderer::BlitBetweenSurfaces(int x, int y, int destination, int source)
+{
+    if (software_mode)
+    {
+        unsigned int key = fill_color;
+        if (x < 0 || y < 0)
+            return;
+        ScreenSurfacePosition* image = surfaces[source];
+        unsigned int columns = image->pitch >> 1;
+        unsigned short* from = image->pixels;
+        unsigned int rows = image->height;
+        current_surface = destination;
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+            return;
+        unsigned int pitch = surfaces[current_surface]->pitch >> 1;
+        unsigned short* row = pixels + y * pitch + x;
+        for (unsigned int line = 0; line < rows; ++line)
+        {
+            unsigned short* to = row;
+            for (unsigned int column = 0; column < columns; ++column)
+            {
+                unsigned short value = *from++;
+                if (value != key)
+                    *to = value;
+                ++to;
+            }
+            row += pitch;
+        }
+        UnlockPixels();
+        return;
+    }
+    DirectDrawSurface7Prefix* surface = surfaces[destination]->surface;
+    ScreenSurfacePosition* image = surfaces[source];
+    if (image->video_memory)
+    {
+        SurfaceResult result = surface->vtable->BltFast(surface, x, y, image->surface, 0, 0x11);
+        if (result < 0)
+            IgnoreSurfaceError(result);
+    }
+    else
+    {
+        ScreenRectangle rectangle;
+        rectangle.left = x;
+        rectangle.top = y;
+        rectangle.bottom = y + image->height;
+        rectangle.right = x + image->width;
+        SurfaceResult result = surface->vtable->Blt(surface, reinterpret_cast<SurfaceApiRectangle*>(&rectangle), image->surface, 0, 0x01008000, 0);
+        if (result < 0)
+            IgnoreSurfaceError(result);
+    }
+}
