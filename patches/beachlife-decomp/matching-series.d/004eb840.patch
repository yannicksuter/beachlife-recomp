+#include "tga_image.h"
+#include "tiff_read_context.h"
+
+// Expands a 4-bit image (two pixels per byte, high nibble first) into a new 8-bit paletted image and copies the
+// first eight palette entries.
+// FUNCTION: BEACHLIFE 0x004eb840
+TgaImage* TiffExpandFourBits(TgaImage* image)
+{
+    int width = image->width;
+    unsigned char* nibbles = image->pixels;
+    int height = image->height;
+    TgaImage* expanded;
+    expanded = new TgaImage(width, height, 8, 1);
+    unsigned char* destination = expanded->pixels;
+    for (int k = 0; k < 24; k += 3)
+    {
+        unsigned char* source = image->palette + k;
+        unsigned char entry[3];
+        entry[0] = source[0];
+        entry[1] = source[1];
+        entry[2] = source[2];
+        unsigned char* target = expanded->palette + k;
+        target[0] = entry[0];
+        target[1] = entry[1];
+        target[2] = entry[2];
+    }
+    int count = height * width;
+    unsigned char mask = 0xF0;
+    unsigned char shift = 4;
+    for (int i = 0; i < count; i++)
+    {
+        destination[i] = (nibbles[i / 2] & mask) >> shift;
+        mask = ~mask;
+        shift ^= 4;
+    }
+    return expanded;
+}
