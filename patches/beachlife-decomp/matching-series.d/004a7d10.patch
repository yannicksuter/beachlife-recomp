+// FUNCTION: BEACHLIFE 0x004a7d10
+unsigned char ScreenMode5Controller::CanPlace(ScreenPoint point, unsigned char draw)
+{
+    unsigned int rotation = preview_08->word_18;
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    ScreenPoint row = point;
+    unsigned int width = building_0c->footprint_x_1d4 + 2;
+    unsigned int height = building_0c->footprint_y_1d8 + 2;
+    if ((rotation & 1) == 1)
+    {
+        unsigned int old = width;
+        width = height;
+        height = old;
+    }
+    int first;
+    int last;
+    screen_terrain_grid->BuildingBounds(row, height, width, &first, &last, rotation);
+    ScreenPoint tile = row;
+    unsigned char valid = 1;
+    for (unsigned int r = 0; r < height; ++r)
+    {
+        for (unsigned int c = 0; c < width; ++c)
+        {
+            unsigned char cell_valid = 1;
+            unsigned int flags = grid->cells_0c[grid->TileIndex(tile.x, tile.y)].flags_48;
+            unsigned int required;
+            if (!(rotation & 1))
+                required = building_0c->footprint_e14[2 + 25 * r + c];
+            else
+                required = building_0c->footprint_e14[2 + r + 25 * c];
+            if (required)
+            {
+                if (required != 0x200)
+                {
+                    if ((flags & 0x50) || (flags & 0x8000))
+                        valid = cell_valid = 0;
+                    if (flags & 0x100)
+                    {
+                        if (!(required & 4))
+                            valid = cell_valid = 0;
+                    }
+                    else if (!(required & flags))
+                        valid = cell_valid = 0;
+                }
+                else if (!screen_terrain_grid->CanPlaceBuilding(tile.x, tile.y, building_0c))
+                {
+                    valid = 0;
+                    cell_valid = 0;
+                }
+                TerrainEntityList* objects = screen_terrain_grid->ObjectsAt(tile.x, tile.y);
+                for (TerrainEntityList::iterator node = objects->begin(); node != objects->end(); ++node)
+                {
+                    if (strcmp((*node)->name_06, "Bin") == 0)
+                    {
+                        valid = 0;
+                        cell_valid = 0;
+                    }
+                }
+            }
+            if (draw && required)
+            {
+                if (cell_valid)
+                    overlay_map->DrawTile(tile.x, tile.y, colour_14);
+                else
+                    overlay_map->DrawTile(tile.x, tile.y, colour_10);
+            }
+            grid->Step(tile, first, &tile);
+        }
+        tile.x = row.x;
+        tile.y = row.y;
+        grid->Step(tile, last, &tile);
+        row = tile;
+    }
+    return valid;
+}
