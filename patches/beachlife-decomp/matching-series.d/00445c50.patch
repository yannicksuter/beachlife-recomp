+#include "startup_screen_mode_world.h"
+#include "tga_image.h"
+#include <new>
+
+// Retail's unwind table for this destructor has a second state (1 -> 0, no
+// action) that no instruction enters. VC6 leaves exactly that entry when the
+// optimizer removes a block holding a destructible local and a call. The
+// original block cannot be recovered; this compiled-out stand-in leaves the
+// same entry and no code.
+static const bool terrain_debug_dump = false;
+
+// FUNCTION: BEACHLIFE 0x00445c50
+ScreenTerrainGrid::~ScreenTerrainGrid()
+{
+    while (routes_20)
+    {
+        ScreenTerrainRouteNode* node = routes_20;
+        routes_20 = node->next_30;
+        if (node)
+        {
+            if (node->data_00)
+                ::operator delete(node->data_00);
+            ::operator delete(node);
+        }
+    }
+    while (routes_1c)
+    {
+        ScreenTerrainRouteNode* node = routes_1c;
+        routes_1c = node->next_30;
+        if (node)
+        {
+            if (node->data_00)
+                ::operator delete(node->data_00);
+            ::operator delete(node);
+        }
+    }
+    delete height_map_10;
+    delete[] cells_0c;
+    if (terrain_debug_dump)
+    {
+        TgaImage dump(0x80, 0x80);
+        SaveGridMap();
+    }
+}
