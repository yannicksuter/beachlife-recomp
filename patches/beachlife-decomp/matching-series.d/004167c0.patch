+
+extern const float motion_full_turn;
+
+static inline bool InUnitRange(float value)
+{
+    return value < 1.0f && value > -1.0f;
+}
+
+// FUNCTION: BEACHLIFE 0x004167c0
+void ScreenDialogResource::FaceDirection(ScreenMapPosition direction)
+{
+    float vertical = direction.y * -1.0f;
+    float angle = 0.0f;
+    if (InUnitRange(vertical))
+        angle = static_cast<float>(acos(vertical));
+    if (direction.x < 0.0f)
+        angle = motion_full_turn - angle;
+    int count = SelectedFrame()->plane_count_0c;
+    int index = static_cast<int>(angle / (motion_full_turn / (count * 2)));
+    if (index % 2 != 0)
+        index++;
+    index = index / 2 % count;
+    if (index == 0 && direction.y > 0.0f)
+        index = 4;
+    if (index == 4 && direction.y < 0.0f)
+        index = 0;
+    SelectVariant(index);
+}
