+static inline unsigned int TileIndex(ScreenTerrainGrid* terrain, int x, int y)
+{
+    return (static_cast<unsigned int>(y) % terrain->height_08) * terrain->width_04
+         + static_cast<unsigned int>(x) % terrain->width_04;
+}
+
+static inline bool PathHasClearNeighbours(const ScreenPoint* point)
+{
+    ScreenTerrainCell* neighbours[8];
+    screen_terrain_grid->Neighbours(*point, neighbours);
+    for (int index = 0; index < 8; ++index)
+        if (neighbours[index]->flags_48 & 0x10)
+            return false;
+    return true;
+}
+
+// FUNCTION: BEACHLIFE 0x004a72e0
+unsigned char ScreenMode10Controller::CanRemove(const ScreenPoint* point)
+{
+    unsigned char removable = 0;
+    bool occupied = false;
+    TerrainEntityList* list = screen_terrain_grid->ObjectsAt(point->x, point->y);
+    for (TerrainEntityList::iterator object = list->begin(); object != list->end(); ++object)
+    {
+        occupied = true;
+        VariableEntity* entity = *object;
+        switch (entity->kind_2c)
+        {
+        case 1:
+            if (entity->AsScenery()->scenery_f4->removable_311 && entity->state_3c != 4)
+                removable = 1;
+            break;
+        }
+    }
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    unsigned int flags = grid->cells_0c[TileIndex(grid, point->x, point->y)].flags_48;
+    if (!occupied)
+    {
+        if (flags & 0x7000)
+            return 1;
+        if ((flags & 1) && (flags & 0x80000000) && (flags & 0x10000000) && PathHasClearNeighbours(point))
+            return 1;
+    }
+    return removable;
+}
