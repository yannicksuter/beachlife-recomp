+// FUNCTION: BEACHLIFE 0x00414240
+void ScreenDialogResource::UpdateBuildingRectangle(ScreenRectangle* rectangle, const ScreenWorldPosition* position,
+    unsigned int width, unsigned int height)
+{
+    ScreenDialogResourceRecord* resource = record;
+    if (resource->format_18 != 5)
+        return;
+    ScreenPoint screen = overlay_map->WorldToScreen(*position);
+    if (word_10)
+    {
+        word_10 = 0;
+        word_14 = 0;
+    }
+    screen.x += CurrentFrameValue();
+    screen.y += SelectedFrame()->word_14;
+    ScreenPoint first;
+    first = CurrentScreenTerrain()->WorldToTile(*position);
+    ScreenPoint last = first;
+    for (int count = static_cast<int>(width - 1); count > 0; --count)
+        screen_terrain_grid->Step(last, 0, &last);
+    for (int height_count = static_cast<int>(height - 1); height_count > 0; --height_count)
+        screen_terrain_grid->Step(last, 6, &last);
+
+    OverlayMapPrefix* map = overlay_map;
+    unsigned int first_depth = map->DepthAt(&screen_terrain_grid->TilePosition(last, 0));
+    map = overlay_map;
+    unsigned int last_depth = map->DepthAt(&screen_terrain_grid->TilePosition(first, 1));
+    float depth_difference = static_cast<float>(static_cast<int>(last_depth - first_depth));
+    float clock0 = window_deactivation_state->clock_158;
+    resource->frames[0]->time_04 = clock0;
+    float clock1 = window_deactivation_state->clock_158;
+    resource->frames[1]->time_04 = clock1;
+    unsigned char divisor = resource->unknown_20[word_18];
+    screen.x += overlay_map->scroll_x_c4;
+    screen.y += overlay_map->scroll_y_c8;
+    rectangle->left -= screen.x;
+    rectangle->top -= screen.y;
+    rectangle->right -= screen.x;
+    rectangle->bottom -= screen.y;
+
+    float depth_step = depth_difference / divisor;
+    int size = overlay_map->tile_size_dc;
+    UpdateBuildingTiles(rectangle, screen.x / size, screen.y / size, screen.x % size, screen.y % size, depth_step, first_depth);
+}
