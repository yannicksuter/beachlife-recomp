+// Fast reciprocal estimate refined by one Newton step, then a scale by it.
+static inline ScreenMapPosition SteeringDivided(const ScreenMapPosition& vector, float divisor)
+{
+    float reciprocal;
+    __asm
+    {
+        mov eax, 0x7f000000
+        sub eax, divisor
+        mov reciprocal, eax
+        fld divisor
+        fmul reciprocal
+        fsubr fast_reciprocal_two
+        fmul reciprocal
+        fstp reciprocal
