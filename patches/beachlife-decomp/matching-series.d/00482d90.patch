+    *reinterpret_cast<unsigned int*>(&value) = square_root_mantissas[(*reinterpret_cast<unsigned int*>(&value) >> 8) & 0xffff]
+                                             | ((((*reinterpret_cast<unsigned int*>(&value) - 0x3f800000u) >> 1) + 0x3f800000u) & 0x7f800000u);
