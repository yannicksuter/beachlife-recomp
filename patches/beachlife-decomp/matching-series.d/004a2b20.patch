+#include "startup_screen_button_actions.h"
+#include "startup_screen_manager.h"
+#include "startup_variable_state.h"
+#include "window_activation.h"
+
+// FUNCTION: BEACHLIFE 0x004a2b20
+void ScreenButtonActionAt004a2b20(unsigned int)
+{
+    const char* building_name;
+    const char* no_space;
+    const char* no_home;
+    // The retail switch leaves the names uninitialized for other selectors.
+    switch (screen_manager->word_80)
+    {
+    case 0:
+        building_name = "CLEANERSHACK";
+        no_space = "STAFFB_NOSPACE_CLEANERS";
+        no_home = "STAFFB_NOHOME_CLEANERS";
+        break;
+    case 1:
+        building_name = "BUILDERYARD";
+        no_space = "STAFFB_NOSPACE_BUILDERS";
+        no_home = "STAFFB_NOHOME_BUILDERS";
+        break;
+    case 2:
+        building_name = "HANDYMAN";
+        no_space = "STAFFB_NOSPACE_MECHANICS";
+        no_home = "STAFFB_NOHOME_MECHANICS";
+        break;
+    case 5:
+        building_name = "SECURITY_POST";
+        no_space = "STAFFB_NOSPACE_SECURITY";
+        no_home = "STAFFB_NOHOME_SECURITY";
+        break;
+    case 3:
+        building_name = "REP";
+        no_space = "STAFFB_NOSPACE_REPS";
+        no_home = "STAFFB_NOHOME_REPS";
+        break;
+    case 4:
+        building_name = "BAYWATCH";
+        no_space = "STAFFB_NOSPACE_LIFEGUARDS";
+        no_home = "STAFFB_NOHOME_LIFEGUARDS";
+        break;
+    }
+
+    unsigned int index = variable_catalog->FindBuilding(building_name);
+    unsigned int capacity = variable_catalog->Building(index)->capacity_288;
+    unsigned int count;
+    VariableEntity** buildings = variable_world->FindNamed(building_name, &count);
+    for (unsigned int i = 0; i < count; ++i)
+    {
+        VariableEntity* building = buildings[i];
+        if (building->AsBuilding()->staff_count_8c + building->AsBuilding()->pending_staff_90 < capacity
+            && !building->FlagAt00460310() && !building->FlagAt00460340())
+        {
+            building->HireStaff();
+            screen_manager->RefreshScreenContents();
+            return;
+        }
+    }
+    if (!count)
+        screen_manager->RequestMessageScreen("MessageOKBox", no_home, 0, 1);
+    else
+        screen_manager->RequestMessageScreen("MessageOKBox", no_space, 0, 1);
+}
