+
+// FUNCTION: BEACHLIFE 0x0043ef30
+void WindowDeactivationState::UpdateAt0043ef30()
+{
+    if (clock_158 > value_178)
+    {
+        int absent = 0;
+        unsigned int counts[5];
+        counts[0] = world_10->CountType(11);
+        counts[1] = world_10->CountType(9);
+        counts[2] = world_10->CountType(8);
+        counts[3] = world_10->CountType(12);
+        counts[4] = world_10->CountType(7);
+        for (int i = 0; i < 5; ++i)
+            if (counts[i] == 0)
+                ++absent;
+        if (absent != 0)
+        {
+            int selected = rand() % absent;
+            {
+                for (int i = 0; i < 5; ++i)
+                {
+                    if (selected == 0 && counts[i] == 0)
+                    {
+                        switch (i)
+                        {
+                        case 0:
+                            ticker_30->AddMessage("FEEDBACK_NO_CLEANERS", -2, 12);
+                            break;
+                        case 1:
+                            ticker_30->AddMessage("FEEDBACK_NO_REPS", -2, 10);
+                            break;
+                        case 2:
+                            ticker_30->AddMessage("FEEDBACK_NO_MECHANICS", -2, 9);
+                            break;
+                        case 3:
+                            ticker_30->AddMessage("FEEDBACK_NO_SECURITY", -2, 13);
+                            break;
+                        case 4:
+                            ticker_30->AddMessage("FEEDBACK_NO_LIFEGUARDS", -2, 8);
+                            break;
+                        }
+                        i = 5;
+                    }
+                    else if (counts[i] == 0)
+                        --selected;
+                }
+            }
+        }
+        int day_length;
+        startup_config_owner->GetInteger(&day_length, "iDAY_LENGTH_IN_SECONDS");
+        float hour = day_length * (1.0f / 24.0f);
+        value_178 = hour * 3.0f + clock_158;
+    }
+}
