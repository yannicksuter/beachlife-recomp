+// FUNCTION: BEACHLIFE 0x004a9c10
+unsigned char ScreenMode1Controller::CanPlace(const ScreenPoint* point)
+{
+    unsigned char valid = 1;
+    if (screen_terrain_grid->OutsideArea(point->x, point->y, scenery_08->footprint_x_2c8, scenery_08->footprint_y_2cc))
+        return 0;
+    ScreenPoint row;
+    ScreenPoint tile;
+    SetPoint(row, *point);
+    SetPoint(tile, *point);
+    unsigned int rotation = word_0c->word_18;
+    unsigned int height = scenery_08->footprint_y_2cc;
+    unsigned int width = scenery_08->footprint_x_2c8;
+    if ((rotation & 1) == 1)
+    {
+        unsigned int old = width;
+        width = height;
+        height = old;
+    }
+    for (unsigned int x = 0; x < width && valid; ++x)
+    {
+        for (unsigned int y = 0; y < height && valid; ++y)
+        {
+            if (!screen_terrain_grid->CanPlaceScenery(tile.x, tile.y, scenery_08))
+                valid = 0;
+            else
+            {
+                TerrainEntityList* objects = screen_terrain_grid->ObjectsAt(tile.x, tile.y);
+                for (TerrainEntityList::iterator node = objects->begin(); node != objects->end() && valid; ++node)
