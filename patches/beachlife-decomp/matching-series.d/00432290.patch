+#include "startup_world_cursor_names.h"
+
+static inline int CursorFrameWhitespace(const char* text)
+{
+    int count = 0;
+    while (text[count] == ' ' || text[count] == '\r' || text[count] == '\n' || text[count] == '\t')
+        count++;
+    return count;
+}
+
+static inline const char* CursorFrameOffset(const char* text, int offset)
+{
+    const char* result = text + offset;
+    return result;
+}
+
+// FUNCTION: BEACHLIFE 0x00432290
+int SkipCursorFrameComments(const char* text)
+{
+    int count = 0;
+    if (*text == '/')
+    {
+        count = 1;
+        while (*++text != '\n')
+            count++;
+        int skipped = CursorFrameWhitespace(text);
+        text += skipped;
+        count += skipped;
+        skipped = SkipCursorFrameComments(text);
+        count += skipped;
+        count += CursorFrameWhitespace(CursorFrameOffset(text, skipped));
+    }
+    return count;
+}
