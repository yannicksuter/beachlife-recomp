+    if (data[offset] == '/')
+    {
+        ++offset;
+        while (data[offset] != '\n')
+            ++offset;
+        offset += lookup->SkipWhitespace(data + offset);
+        offset += lookup->SkipComments(data + offset);
+        offset += lookup->SkipWhitespace(data + offset);
+    }
+    return offset;
+}
