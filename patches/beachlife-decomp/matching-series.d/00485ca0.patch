+#include "startup_screen_terrain_tile_index.h"
+#include "startup_world_entities.h"
+
+static inline ScreenTerrainCell* RouteCell(ScreenTerrainGrid* grid, const ScreenPoint& point)
+{
+    return &grid->cells_0c[grid->TileIndex(point.x, point.y)];
+}
+
+static inline unsigned int RouteFlags(ScreenTerrainGrid* grid, const ScreenPoint& point)
+{
+    return grid->cells_0c[grid->TileIndex(point.x, point.y)].flags_48;
+}
+
+static inline void ClearFlags(ScreenTerrainCell* cell, unsigned int flags)
+{
+    cell->flags_48 &= ~flags;
+}
+
+// A transition cell (0x100) that is not yet blocked (0x10).
+static inline bool IsTransition(ScreenPoint point)
+{
+    return (RouteFlags(screen_terrain_grid, point) & 0x100) && !(RouteFlags(screen_terrain_grid, point) & 0x10);
+}
+
+static inline bool IsTransitionAt(const ScreenPoint& point)
+{
+    return (RouteFlags(screen_terrain_grid, ScreenPoint(point)) & 0x100) && !(RouteFlags(screen_terrain_grid, point) & 0x10);
+}
+
+static inline void ClearTransition(const ScreenPoint& point)
+{
+    ScreenTerrainCell* cell = RouteCell(screen_terrain_grid, point);
+    cell->flags_48 &= ~0xd0000080;
+}
+
+static inline void ClearTransitionFlags(const ScreenPoint& point)
+{
+    ClearFlags(RouteCell(screen_terrain_grid, point), 0xd0000080);
+}
+
+// Clears the route transition marks around both route ends.
+// FUNCTION: BEACHLIFE 0x00485ca0
+void WorldMovingEntity::NotifyRouteTransition(ScreenPoint* start, ScreenPoint* end, unsigned int flags)
+{
+    ScreenPoint first = *start;
+    ScreenPoint last = *end;
+    if (IsTransitionAt(first))
+    {
+        ClearTransitionFlags(first);
+        for (int direction = 0; direction < 8; ++direction)
+        {
+            ScreenPoint neighbour;
+            screen_terrain_grid->Step(first, direction, &neighbour);
+            if (IsTransitionAt(neighbour))
+                ClearTransition(neighbour);
+        }
+    }
+    if (IsTransition(last))
+    {
+        ClearTransition(last);
+        for (int direction = 0; direction < 8; ++direction)
+        {
+            ScreenPoint neighbour;
+            screen_terrain_grid->Step(last, direction, &neighbour);
+            if (IsTransition(neighbour))
+                ClearTransition(neighbour);
+        }
+    }
+}
