+static inline ScreenWorldPosition CenterOfTile(ScreenTerrainGrid* grid, const ScreenPoint& tile)
+{
+    ScreenWorldPosition position = grid->TileOrigin(tile);
+    position.y += static_cast<unsigned int>(grid->tile_size_00) >> 1;
+    return position;
+}
+
+// FUNCTION: BEACHLIFE 0x004453b0
+void ScreenTerrainGrid::RectangleTiles(const ScreenRectangle* rectangle, int* left, int* top, int* width, int* height)
+{
+    ScreenWorldPosition first_world = overlay_map->ScreenToWorld(ScreenPoint(rectangle->left, rectangle->top));
+    ScreenWorldPosition last_world = overlay_map->ScreenToWorld(ScreenPoint(rectangle->right, rectangle->bottom));
+    ScreenPoint first = WorldToTile(first_world);
+    ScreenPoint last = WorldToTile(last_world);
+    ScreenWorldPosition first_origin = CenterOfTile(this, first);
+    ScreenWorldPosition last_origin = CenterOfTile(this, last);
+    overlay_map->WorldToScreen(first_origin);
+    ScreenPoint projected;
+    projected = overlay_map->WorldToScreen(last_origin);
+    projected.x += overlay_map->scroll_x_c4;
+    projected.y += overlay_map->scroll_y_c8;
+    bool below_top = projected.y > rectangle->top;
+    bool above_bottom = projected.y < rectangle->bottom;
+    bool left_of_right = projected.x < rectangle->right;
+    if (projected.x > rectangle->left)
+        --first.x;
+    if (below_top && (first.x & 1))
+        --first.y;
+    int first_y = first.y;
+    if (left_of_right)
+        ++last.x;
+    int last_x = last.x;
+    int last_y = last.y;
+    if (above_bottom)
+        ++last_y;
+    if (first.x > last_x)
+        last_x = 128;
+    if (first_y > last_y)
+        last_y = 128;
+    if (first.x < 0)
+        first.x = 0;
+    else if (first.x > 128)
+        first.x = 128;
+    if (first_y < 0)
+        first_y = 0;
+    else if (first_y > 128)
+        first_y = 128;
+    if (last_x < 0)
+        last_x = 0;
+    else if (last_x > 128)
+        last_x = 128;
+    if (last_y < 0)
+        last_y = 0;
+    else if (last_y > 128)
+        last_y = 128;
+    *left = first.x;
+    *top = first_y;
+    *width = last_x - first.x + 1;
+    *height = last_y - first_y + 1;
+}
