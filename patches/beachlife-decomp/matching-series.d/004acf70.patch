+void GuiParserState::ParseImageList()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        int value_a;
+        ReadInteger(value_a, true);
+        int value_b;
+        ReadInteger(value_b, true);
+        char name[64];
+        ReadText(name);
+        char second_name[64];
+        ReadText(second_name);
+        ScreenImageList* list = new ScreenImageList(rectangle, name, second_name, value_a, value_b);
+        RegisterItem(list, 0);
+    }
+    else
+    {
+        StartupFatal("GUI_Parser::ProcessImageList - Script Error \r\nNo open bracket found at "
+                     "file offset - %u",
