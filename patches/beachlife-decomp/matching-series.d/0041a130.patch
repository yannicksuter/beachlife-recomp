+#include "startup_screen_overlay_layout.h"
+
+// FUNCTION: BEACHLIFE 0x0041a130
+void OverlayMapPrefix::DrawTileMask(int tile_x, int tile_y, int x, int y, const unsigned char* data)
+{
+    archive_154->Depths(tile_x, tile_y);
+    archive_154->Colours(tile_x, tile_y);
+    if (!overlay_map->cached_tiles_e0[(tile_y) * (overlay_map->cache_height_d8) + (tile_x)].ready)
+    {
+        OverlayMapPrefix* map = overlay_map;
+        map->cached_tiles_e0[tile_y * map->cache_width_d4 + tile_x].ready = 1;
+        unsigned int pixels = static_cast<unsigned int>(map->tile_size_dc) * map->tile_size_dc;
+        unsigned int offset = (tile_y * map->cache_width_d4 + tile_x) * pixels * 4;
+        void* view = map->mapped_file_f4->MapView(offset, pixels * 4);
+        map->cached_tiles_e0[tile_y * map->cache_width_d4 + tile_x].view = view;
+    }
+    if (!this->cached_tiles_e0[(tile_y) * (cache_width_d4) + (tile_x)].ready)
+        this->MapCachedTile(tile_x, tile_y);
+    int active_y = tile_y;
+    int size = tile_size_dc;
+    unsigned int data_index = 0;
+    for (int row = 0; row < 33; ++row)
+    {
+        int active_x = tile_x;
+        int column = x;
+        int decoded = 0;
+        int row_y = y + row;
+        if (row_y > size - 1)
+            active_y = tile_y + row_y / size;
+        int row_offset = (row_y % size) * size;
+        int pixel = row_offset + x;
+        if (!overlay_map->cached_tiles_e0[(active_y) * (overlay_map->cache_height_d8) + (tile_x)].ready)
+        {
+            OverlayMapPrefix* map = overlay_map;
+            map->cached_tiles_e0[active_y * map->cache_width_d4 + tile_x].ready = 1;
+            unsigned int pixels = static_cast<unsigned int>(map->tile_size_dc) * map->tile_size_dc;
+            unsigned int offset = (active_y * map->cache_width_d4 + tile_x) * pixels * 4;
+            map->cached_tiles_e0[active_y * map->cache_width_d4 + tile_x].view = map->mapped_file_f4->MapView(offset, pixels * 4);
+        }
+        if (!this->cached_tiles_e0[(active_y) * (cache_width_d4) + (tile_x)].ready)
+            this->MapCachedTile(tile_x, active_y);
+        unsigned int* view = static_cast<unsigned int*>(cached_tiles_e0[active_y * cache_width_d4 + tile_x].view);
+        const unsigned short* colours = archive_154->Colours(tile_x, active_y);
+        const unsigned short* depths = archive_154->Depths(tile_x, active_y);
+        while (decoded < 62)
+        {
+            signed char run = data[data_index++];
+            if (run >= 0)
+            {
+                while (run--)
+                {
+                    if (column >= size)
+                    {
+                        active_x = (active_x + 1) % static_cast<int>(cache_width_d4);
+                        column %= size;
+                        if (!overlay_map->cached_tiles_e0[(active_y) * (overlay_map->cache_height_d8) + (active_x)].ready)
+                        {
+                            OverlayMapPrefix* map = overlay_map;
+                            map->cached_tiles_e0[active_y * map->cache_width_d4 + active_x].ready = 1;
+                            unsigned int pixels = static_cast<unsigned int>(map->tile_size_dc) * map->tile_size_dc;
+                            unsigned int offset = (active_y * map->cache_width_d4 + active_x) * pixels * 4;
+                            void* view = map->mapped_file_f4->MapView(offset, pixels * 4);
+                            map->cached_tiles_e0[active_y * map->cache_width_d4 + active_x].view = view;
+                        }
+                        if (!this->cached_tiles_e0[(active_y) * (cache_width_d4) + (active_x)].ready)
+                            this->MapCachedTile(active_x, active_y);
+                        view = static_cast<unsigned int*>(cached_tiles_e0[active_y * cache_width_d4 + active_x].view);
+                        colours = archive_154->Colours(active_x, active_y);
+                        depths = archive_154->Depths(active_x, active_y);
+                        pixel = row_offset + column;
+                    }
+                    unsigned int value = view[pixel];
+                    if (static_cast<unsigned short>(value >> 16) == depths[pixel])
+                        view[pixel] = (value & 0xffff0000u) + colours[pixel];
+                    ++pixel;
+                    ++column;
+                    ++decoded;
+                    ++data_index;
+                }
+            }
+            else
+            {
+                decoded -= run;
+                column -= run;
+                if (column > size)
+                {
+                    column %= size;
+                    active_x = (active_x + 1) % static_cast<int>(cache_width_d4);
+                    if (!overlay_map->cached_tiles_e0[(active_y) * (overlay_map->cache_height_d8) + (active_x)].ready)
+                    {
+                        OverlayMapPrefix* map = overlay_map;
+                        map->cached_tiles_e0[active_y * map->cache_width_d4 + active_x].ready = 1;
+                        unsigned int pixels = static_cast<unsigned int>(map->tile_size_dc) * map->tile_size_dc;
+                        unsigned int offset = (active_y * map->cache_width_d4 + active_x) * pixels * 4;
+                        void* view = map->mapped_file_f4->MapView(offset, pixels * 4);
+                        map->cached_tiles_e0[active_y * map->cache_width_d4 + active_x].view = view;
+                    }
+                    OverlayMapPrefix* map = overlay_map;
+                    OverlayCachedTile* tile = &map->cached_tiles_e0[active_y * map->cache_width_d4 + active_x];
+                    if (!tile->ready)
+                    {
+                        tile->ready = 1;
+                        unsigned int pixels = static_cast<unsigned int>(map->tile_size_dc) * map->tile_size_dc;
+                        unsigned int offset = (active_y * map->cache_width_d4 + active_x) * pixels * 4;
+                        void* view = map->mapped_file_f4->MapView(offset, pixels * 4);
+                        map->cached_tiles_e0[active_y * map->cache_width_d4 + active_x].view = view;
+                    }
+                    view = static_cast<unsigned int*>(map->cached_tiles_e0[active_y * map->cache_width_d4 + active_x].view);
+                    colours = archive_154->Colours(active_x, active_y);
+                    depths = archive_154->Depths(active_x, active_y);
+                    pixel = row_offset + column;
+                }
+                else
+                    pixel -= run;
+            }
+        }
+    }
+}
