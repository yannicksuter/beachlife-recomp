+// Draws an RLE-packed 8-bit sprite through a 16-bit palette into four-byte
+// pixels (palette value minus 0x10000), clipped to the rectangle
+// left/top/right/bottom given in sprite pixels. Packets as in
+// ResourceRaster1Packed. When the left edge is clipped the drawn runs only
+// count the clipped pixels down and write nothing (retail behaviour).
+// FUNCTION: BEACHLIFE 0x004018d0 FOLDED
+void ResourceRaster1Direct(unsigned short* destination, const unsigned char* source, const unsigned short* palette,
+    unsigned int stride, int x, int y, int width, int height, int left, int top, int right, int bottom)
+{
+    unsigned int* row = reinterpret_cast<unsigned int*>(destination) + stride * y;
+
+    // Nothing is clipped.
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int j = 0; j < height; j++)
+        {
+            unsigned int* output = row + j * stride + x;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    column += count;
+                    packet -= count;
+                    do
+                    {
+                        *output++ = palette[*source++] - 0x10000;
+                    } while (--count != 0);
+                }
+                output -= packet;
+                column -= packet;
+            }
+        }
+        return;
+    }
+
+    // Left edge clipped: the first `left` pixels of every row are dropped.
+    if (left > 0)
+    {
+        for (int skip = top; skip > 0; skip--)
+        {
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    column += packet;
+                    source += packet;
+                }
+                else
+                {
+                    column -= packet;
+                }
+            }
+        }
+
+        for (int j = 0; j < bottom - top; j++)
+        {
+            unsigned int* output = row + j * stride + x;
+            int remaining_left = left;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    source += count;
+                    column += count;
+                    packet -= count;
+                    do
+                    {
+                        if (remaining_left != 0)
+                            remaining_left--;
+                    } while (--count != 0);
+                }
+                packet = -packet;
+                while (remaining_left != 0 && packet != 0)
+                {
+                    remaining_left--;
+                    column++;
+                    packet--;
+                }
+                column += packet;
+                output += packet;
+            }
+        }
+        return;
+    }
+
+    // Top, right or bottom edge clipped: pixels from `right` on are dropped.
+    for (int skip = top; skip > 0; skip--)
+    {
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet >= 0)
+            {
+                column += packet;
+                source += packet;
+            }
+            else
+            {
+                column -= packet;
+            }
+        }
+    }
+
+    for (int j = 0; j < bottom - top; j++)
+    {
+        unsigned int* output = row + j * stride + x;
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet > 0)
+            {
+                int count = packet;
+                packet -= count;
+                do
+                {
+                    if (column < right)
+                        *output++ = palette[*source] - 0x10000;
+                    source++;
+                    column++;
+                } while (--count != 0);
+            }
+            if (column < right)
+                output -= packet;
+            column -= packet;
+        }
+    }
+}
