+unsigned int WindowDeactivationState::CycleStaff(unsigned int id, unsigned int type, unsigned char forward)
+{
+    std::vector<VariableEntity*> staff;
+    VariableEntity** first = variable_world->entities_14060;
+    unsigned int count = variable_world->entities_0c;
+    staff.clear();
+    for (unsigned int i = 0; i < count; ++i)
