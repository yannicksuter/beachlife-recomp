+#include "tga_image.h"
+#include "tiff_read_context.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// The eight-byte little-endian TIFF file header.
+struct TiffLoaderHeader
+{
+    unsigned short byte_order;
+    unsigned short magic;
+    unsigned int directory_offset;
+};
+
+TgaImage* LoadTiffFile(const char* filename);
+
+// FUNCTION: BEACHLIFE 0x004ebd80
+TgaImage* LoadTiffFile(const char* filename)
+{
+    TiffReadContext* context = static_cast<TiffReadContext*>(malloc(sizeof(TiffReadContext)));
+    memset(context, 0, sizeof(TiffReadContext));
+    if (!context)
+        return 0;
+    context->file = fopen(filename, "rb");
+    if (!context->file)
+    {
+        free(context);
+        return 0;
+    }
+    TiffLoaderHeader header;
+    fread(&header, 8, 1, context->file);
+    if (header.byte_order != 0x4949)
+        return 0;
+    if (header.magic != 42)
+        return 0;
+    TiffReadDirectory(header.directory_offset, context);
+    TgaImage* image = new TgaImage(context->width, context->height, context->samples_per_pixel << 3, context->palette_offset != 0);
+    if (!context->tile_offsets_position)
+    {
+        switch (context->compression)
+        {
+        case 1:
+            TiffDecodeStrips(image, context);
+            break;
+        case 0x8005:
+            TiffDecodePackBits(image, context);
+            break;
+        }
+    }
+    else
+        TiffDecodeTiles(image, context);
+    if (context->palette_offset)
+        TiffReadPalette(context, image->palette);
+    fclose(context->file);
+    if (context->samples_per_pixel == 4)
+    {
+        TgaImage* converted = TiffConvertFourSamples(image);
+        delete image;
+        image = converted;
+    }
+    if (context->bits_per_sample == 4)
+    {
+        TgaImage* converted = TiffExpandFourBits(image);
+        delete image;
+        image = converted;
+    }
+    ::operator delete(context->strip_byte_counts);
+    ::operator delete(context->strip_offsets);
+    ::operator delete(context->tile_offsets);
+    ::operator delete(context->tile_byte_counts);
+    free(context);
+    return image;
+}
