+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_slider.h"
+#include "startup_screen_text.h"
+
+// FUNCTION: BEACHLIFE 0x004ac980
+void GuiParserState::ParseSlider()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        char name[64];
+        ReadText(name);
+        float value_a;
+        ReadFloat(value_a);
+        float value_b;
+        ReadFloat(value_b);
+        int value_c;
+        ReadInteger(value_c, true);
+        ScreenSlider* slider = new ScreenSlider(rectangle, name, value_a, value_b, value_c);
+        RegisterItem(slider, 0);
+
+        data = buffer;
+        if (data[cursor] != ')')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            char text[64];
+            ReadText(text);
+            slider->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+        else
+        {
+            ++cursor;
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_slider - Script Error \r\nNo open bracket found at file "
+                     "offset - %u",
+            cursor);
+    }
+}
