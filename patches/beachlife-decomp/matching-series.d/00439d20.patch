+#include "startup_variable_state.h"
+#include "startup_screen_renderer.h"
+#include <stdlib.h>
+#include <string.h>
+#include <new>
+#include "startup_resource_rasters.h"
+static inline float HazeWeight(float row, float height)
+{
+    float weight = row / height * 0.5f;
+    return weight + 0.5f;
+}
+
+// FUNCTION: BEACHLIFE 0x00439d20
+void VariableWeather::PrepareHaze()
+{
+    int height = static_cast<int>(screen_request_renderer->height);
+    unsigned int bytes = static_cast<unsigned int>(height) * 200;
+    int row = 0;
+    int level = 100;
+    haze_2b68 = ::operator new(bytes);
+    memset(haze_2b68, 0, bytes);
+    while (row < height)
+    {
+        float screen_height = static_cast<float>(height);
+        int target = 50 + static_cast<int>((rand() % 100) * HazeWeight(static_cast<float>(row), screen_height));
+        int end = rand() % 50 + row + 10;
+        int start = row;
+        int start_level = level;
+        float slope = static_cast<float>(static_cast<long double>(target - level) / static_cast<long double>(end - row));
+        while (row < height && row < end)
+        {
+            ++row;
+            level = start_level + static_cast<int>(static_cast<float>(row - start) * slope);
+            float current_row = static_cast<float>(row);
+            weather_haze_jitter += static_cast<int>((rand() % 5 - 2) * HazeWeight(current_row, screen_height));
+            if (weather_haze_jitter > 15)
+                weather_haze_jitter = 15;
+            else if (weather_haze_jitter < -15)
+                weather_haze_jitter = -15;
+            int length = static_cast<int>(static_cast<float>(current_row)
+                                          / (static_cast<float>(screen_height) * 0.5f) * 15.0f);
+            int offset = (height - row) * 200 + level + weather_haze_jitter;
+            memset(static_cast<unsigned char*>(haze_2b68) + offset, 0x11, length);
+        }
+    }
+}
