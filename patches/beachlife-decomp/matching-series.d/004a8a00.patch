+unsigned char ScreenMode4Controller::SelectAtPointer()
+{
+    ScreenPoint pointer;
+    pointer = startup_input_motion_state->Position();
+    int previous = -1;
+    unsigned int count;
+    VariableEntity** selected = variable_world->Selected(&count);
+    for (unsigned int i = 0; i < count && previous == -1; ++i)
+        if (selected[i]->kind_2c == 2)
+            previous = selected[i]->id_28;
+    unsigned char result = SelectBuildingAtPointer(1, &pointer, previous);
+    if (!result)
+        result = SelectGuestAtPointer(1, &pointer, previous);
+    if (!result)
+        result = SelectBuildingAtPointer(0, &pointer, previous);
+    if (!result)
+        result = SelectGuestAtPointer(0, &pointer, previous);
+    if (!result && count)
+    {
+        VariableEntity* entity = selected[0];
+        entity->Unknown50(1, 0);
+        unsigned int id = entity->id_28;
+        ScreenModeCommand command;
+        command.words[0] = id;
+        command.words[1] = id;
+        command.words[2] = 101;
+        command.words[3] = 0;
+        command.words[4] = 0;
+        screen_mode_commands->QueueCommand(&command);
+        result = 1;
+    }
+    return result;
+}
