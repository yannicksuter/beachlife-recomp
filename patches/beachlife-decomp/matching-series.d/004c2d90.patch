+
+// FUNCTION: BEACHLIFE 0x004c2d90
+void ScreenLoadPanel13c::RefreshList(unsigned char clear_selection)
+{
+    list_04->ClearEntries();
+    if (clear_selection)
+        list_04->ClearSelection();
+    int count = owner_00->EntryCount();
+    int current = owner_00->index_10;
+    int colour = 0;
+    int i;
+    for (i = 0; i < count; ++i)
+        if (owner_00->ReadRepeat(i))
+            colour = 0x808080;
+    for (i = 0; i < count; ++i)
+    {
+        const char* title = owner_00->ReadTitle(i);
+        const char* artist = owner_00->ReadArtist(i);
+        char text[256];
+        if (artist)
+            sprintf(text, "%s - %s", artist, title);
+        else
+            sprintf(text, "%s", title);
+        int selected = 0;
+        if (i == current)
+            selected = 1;
+        if (owner_00->ReadRepeat(i))
+        {
+            list_04->AddTextEntry(i, 0, 240, 15, 2, selected, 0, text, 1);
+            list_04->AddImageEntry(i, 240, panel13c_repeat_icon);
+        }
+        else
+            list_04->AddTextEntry(i, 0, 240, 15, 2, selected, colour, text, 1);
+        if (mode_10 == 0)
+        {
+            if (owner_00->ReadEntryWord10(i) == 0)
+                list_04->AddImageEntry(i, 255, panel13c_sun_icon);
+            else
+                list_04->AddImageEntry(i, 255, panel13c_moon_icon);
+        }
+        unsigned int duration = owner_00->ReadEntryWord18(i);
+        if (duration)
+        {
+            int seconds = static_cast<int>(duration) / 1000;
+            sprintf(text, "%d:%02d", seconds / 60, seconds % 60);
+            list_04->AddTextEntry(i, 285, 35, 15, 2, selected, colour, text, 0);
+        }
+    }
+    ScreenPlacementStore* store = screen_request_game->placement;
+    store->ClearMusicEntries();
+    for (i = 0; i < owner_00->EntryCount(); ++i)
+    {
+        store->AddMusicEntry(owner_00->ReadEntryDirectory(i), owner_00->ReadEntryName(i), owner_00->ReadEntryWord10(i), owner_00->ReadEntryWord18(i));
+    }
+}
