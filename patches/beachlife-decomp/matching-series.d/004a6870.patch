+    ScreenDialogResourceLookup* resources = screen_dialog_resources;
+    ScreenDialogResource* resource = resources->Find("ui3_cam_upper_left");
+    int upper_height = resource->record->frames[resource->word_10]->height_10;
+    int left_width = resource->record->frames[resource->word_10]->width_0e;
+    resource->Draw(0, 0, 65535, elapsed_08);
+    resources->Release(resource);
+    resource = resources->Find("ui3_cam_upper_right");
+    resource->Draw(width - resource->record->frames[resource->word_10]->width_0e, 0, 65535, elapsed_08);
+    int right_height = resource->record->frames[resource->word_10]->height_10;
+    resources->Release(resource);
+    resource = resources->Find("ui3_cam_lowleft");
