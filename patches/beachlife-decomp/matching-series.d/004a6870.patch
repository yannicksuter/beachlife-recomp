+    resource->Draw(width - resource->record->frames[resource->word_10]->width_0e,
+        height - resource->record->frames[resource->word_10]->height_10,
+        65535,
+        elapsed_08);
+    resources->Release(resource);
+    {
+        ScreenDialogResource* left;
+        ScreenDialogResource* right;
+        ScreenDialogResource* top;
+        ScreenDialogResource* bottom;
+        ScreenDialogResource* strip;
+        switch (width)
