+            right = resources->Find("ui3_cam_c_right");
+            top = resources->Find("ui3_cam_c_top");
+            bottom = resources->Find("ui3_cam_c_bottom");
+            strip = resources->Find("ui3_cam_c_filmstrip");
+            break;
+        }
+        left->Draw(0, upper_height, 65535, elapsed_08);
+        right->Draw(width - right->record->frames[right->word_10]->width_0e, right_height, 65535, elapsed_08);
+        top->Draw(left_width, 0, 65535, elapsed_08);
+        bottom->Draw(lower_width, height - bottom->record->frames[bottom->word_10]->height_10, 65535, elapsed_08);
+        strip->Draw(463, height - 70, 65535, elapsed_08);
+        resources->Release(left);
+        resources->Release(right);
+        resources->Release(top);
+        resources->Release(bottom);
+        resources->Release(strip);
+    }
