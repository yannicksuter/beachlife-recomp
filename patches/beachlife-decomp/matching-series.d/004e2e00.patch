+
+#include <new>
+#include <stdio.h>
+
+#include "startup_game_save_record.h"
+
+// Retail expands SaveScenarioProgress (0x004e4100) and ClearSaveRecords
+// (0x004e4c80) here; the scenario names are released between them.
+static inline void SaveProgress(ScreenRequestGamePrefix* game)
+{
+    FILE* file = fopen(startup_game_state_path, "wb");
+    if (file)
+    {
+        fwrite(game->words_70, 0x30, 1, file);
+        fclose(file);
+    }
+}
+
+static inline void ClearNames(ScreenRequestGamePrefix* game)
+{
+    for (unsigned int i = 0; i < game->scenario_names.size(); ++i)
+        delete game->scenario_names[i];
+    game->scenario_names.clear();
+}
+
+static inline void ClearSaves(ScreenRequestGamePrefix* game)
+{
+    for (GameSaveRecord** record = game->saves.begin(); record != game->saves.end(); ++record)
+    {
+        if (*record)
+            delete *record;
+    }
+    game->saves.clear();
+    game->save_info_enabled = 0;
+}
+
+// FUNCTION: BEACHLIFE 0x004e2e00
+ScreenRequestGamePrefix::~ScreenRequestGamePrefix()
+{
+    SaveProgress(this);
+    if (placement)
+        delete placement;
+    if (text)
+        delete text;
+    if (controller_selection.first_controller)
+        delete controller_selection.first_controller;
+    delete controller_selection.controllers[0];
+    delete controller_selection.controllers[1];
+    delete controller_selection.controllers[2];
+    delete controller_selection.controllers[3];
+    delete controller_selection.controllers[4];
+    delete controller_selection.controllers[5];
+    delete screens;
+    delete audio;
+    delete update_pair;
+    delete debug_font;
+    delete input_motion;
+    delete profiler;
+    delete clock;
+    delete input;
+    delete renderer;
+    delete resources;
+    ClearNames(this);
+    ClearSaves(this);
+}
