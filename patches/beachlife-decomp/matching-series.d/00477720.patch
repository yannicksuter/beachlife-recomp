+#include "startup_screen_position_inlines.h"
+#include "startup_world_guest_action_helpers.h"
+#include "startup_world_entities.h"
+#include "startup_screen_mode_world.h"
+#include "window_activation.h"
+#include <stdlib.h>
+
+static inline float RandomUnit()
+{
+    float unit = rand() * 3.0518509447574615e-5f;
+    return unit;
+}
+
+static inline unsigned int CellFlags(const ScreenPoint* tile)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    unsigned int index = (static_cast<unsigned int>(tile->y) % grid->height_08) * grid->width_04
+                       + static_cast<unsigned int>(tile->x) % grid->width_04;
+    return grid->cells_0c[index].flags_48;
+}
+
+// FUNCTION: BEACHLIFE 0x00477720
+void WorldGuestEntity::PerformAction14()
+{
+    ScreenPoint tile = TilePosition();
+    bool outside = true;
+    WorldBuildingEntity* building = variable_world->FindObject(word_98)->AsBuilding();
+    ScreenPoint origin = building->TilePosition();
+    ScreenPoint point = origin;
+    ScreenPoint row = origin;
+    int width;
+    int height;
+    if (building->keyline_state_44->rotation_18 % 2)
+    {
+        height = building->building_60->footprint_x_1d4;
+        width = building->building_60->footprint_y_1d8;
+    }
+    else
+    {
+        width = building->building_60->footprint_x_1d4;
+        height = building->building_60->footprint_y_1d8;
+    }
+    tile.x += -8 - static_cast<int>(RandomUnit() * -16.0f);
+    tile.y += -8 - static_cast<int>(RandomUnit() * -16.0f);
+
+    for (;;)
+    {
+        unsigned int flags = CellFlags(&tile);
+        if (flags & 0x800)
+        {
+            ScreenPoint current;
+            current = TilePosition();
+            if ((tile.x != current.x || tile.y != current.y) && !outside && tile.x < 128 && tile.x >= 0 && tile.y >= 0)
+                break;
+        }
+        ScreenPoint next;
+        next = TilePosition();
+        tile = next;
+        tile.x += -8 - static_cast<int>(RandomUnit() * -16.0f);
+        tile.y += -8 - static_cast<int>(RandomUnit() * -16.0f);
+        outside = true;
+        for (int ix = 0; ix < width; ++ix)
+        {
+            for (int iy = 0; iy < height; ++iy)
+            {
+                if (tile.x == point.x && tile.y == point.y)
+                    outside = false;
+                screen_terrain_grid->Step(point, 0, &point);
+            }
+            screen_terrain_grid->Step(row, 6, &row);
+            point = row;
+        }
+        point = origin;
+        row = origin;
+    }
+    ScreenWorldPosition position;
+    position = screen_terrain_grid->TilePosition(tile, 4);
+    position.x = RandomUnit() * 20.0f + position.x - 10.0f;
+    position.y = RandomUnit() * 20.0f + position.y - 10.0f;
+    ScreenModeCommand command;
+    command.words[0] = id_28;
+    command.words[1] = id_28;
+    command.words[2] = 8;
+    command.words[3] = static_cast<int>(position.x);
+    command.words[4] = static_cast<int>(position.y);
+    screen_mode_commands->QueueCommand(&command);
+}
