+        switch (state_3c)
+        {
+        case 1:
+            swprintf(output, L"Startup");
+            break;
+        case 0x41:
+            swprintf(output, L"Waiting Guests");
+            break;
+        case 0x44:
+            swprintf(output, L"Ride In Progress");
+            break;
+        case 0x42:
+            swprintf(output, L"Heading Stop");
+            break;
+        case 0x43:
+            swprintf(output, L"Unloading Guests");
+            break;
+        default:
+            swprintf(output, L"Unknown State");
+            break;
+        }
+    }
+    else
+        StartupFatal("Invalid Vehicle Variable been requested");
+}
