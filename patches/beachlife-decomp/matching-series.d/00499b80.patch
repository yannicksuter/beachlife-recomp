+void WorldVehicleEntity::ReadText(const char* key, unsigned short* output)
+{
+    if (strcmp(key, "VEHICLE_NAME") == 0)
+        MultiByteToWideChar(0, 0, definition_f4->name_04 + 0x40, -1, output, 256);
+    else if (strcmp(key, "VEHICLE_STATE") == 0)
