+// FUNCTION: BEACHLIFE 0x00408b50
+void ResourceRaster2(unsigned short* destination, const unsigned char* source,
+    const unsigned short* palette, unsigned int stride, int x, int y,
+    int width, int height, int left, int top, int right, int bottom)
+{
+    unsigned int* output;
+    bool adjacent;
+    int column;
+    signed char packet;
+    unsigned short colour;
+    unsigned int* row = reinterpret_cast<unsigned int*>(destination) + stride * y;
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int j = 0; j < height; j++)
+        {
+            output = row + j * stride + x;
+            adjacent = false;
+            column = 0;
+            while (column < width)
+            {
+                packet = *source++;
+                if (packet >= 0)
+                {
+                    colour = palette[*source++];
+                    --packet;
+                    ++column;
+                    if (!adjacent)
+                        *output = (*output & 0xffff0000) + static_cast<unsigned short>(width);
+                    else
+                        *output = (*output & 0xffff0000) + colour;
+                    ++output;
+                    if (packet)
+                    {
+                        while (packet-- > 1)
+                        {
+                            *output = (*output & 0xffff0000) + palette[*source];
+                            ++output;
+                            ++source;
+                            ++column;
+                        }
+                        colour = palette[*source++];
+                        ++column;
+                        *output = (*output & 0xffff0000) + colour;
+                        ++output;
+                    }
+                    adjacent = true;
+                }
+                else
+                {
+                    output -= packet;
+                    column -= packet;
+                    adjacent = false;
+                }
+            }
+        }
+        return;
+    }
+    ResourceRaster1Direct(destination, source, palette, stride, x, y, width, height, left, top, right, bottom);
+}
