+
+static inline int RandomWalkOffset()
+{
+    return -300 - static_cast<int>(-600.0f * (rand() * (1.0f / 32767)));
+}
+
+// FUNCTION: BEACHLIFE 0x004900e0
+void WorldStaffEntity::ChooseRandomDestination()
+{
+    unsigned int tries = 0;
+    ScreenWorldPosition target = position_30;
+    target.x += RandomWalkOffset();
+    target.y += RandomWalkOffset();
+    if (target.x < 0.0f || target.x >= 4096.0f)
+        target.x = position_30.x;
+    if (target.y < 0.0f || target.y >= 8192.0f)
+        target.y = position_30.y;
+    ScreenPoint* found;
+    {
+        found = &overlay_map->WorldToTile(&target);
+    }
+    unsigned int x = found->x;
+    unsigned int y = found->y;
+    for (;;)
+    {
+        ScreenTerrainGrid* terrain = screen_terrain_grid;
+        unsigned int flags = terrain->cells_0c[(y % terrain->height_08) * terrain->width_04 + x % terrain->width_04].flags_48;
+        if ((flags & 0x10000002) && !(flags & 0x10))
+            break;
+        if (tries >= 1000)
+            break;
+        target = position_30;
+        target.x += RandomWalkOffset();
+        target.y += RandomWalkOffset();
+        if (target.x < 0.0f || target.x >= 4096.0f)
+            target.x = position_30.x;
+        if (target.y < 0.0f || target.y >= 8192.0f)
+            target.y = position_30.y;
+        found = &overlay_map->WorldToTile(&target);
+        x = found->x;
+        y = found->y;
+        tries++;
+    }
+    directed_y_76c = target.y;
+    directed_x_768 = target.x;
+}
