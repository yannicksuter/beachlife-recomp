+#include "startup_world_entities.h"
+#include "startup_variable_state.h"
+#include "startup_world_power_factors.h"
+#include <stdlib.h>
+
+// GLOBAL: BEACHLIFE 0x004f3668
+extern const float building_power_factor_full = 1.0f;
+// GLOBAL: BEACHLIFE 0x004f366c
+extern const float building_power_factor_high = 0.75f;
+// GLOBAL: BEACHLIFE 0x004f3670
+extern const float building_power_factor_half = 0.5f;
+// GLOBAL: BEACHLIFE 0x004f3674
+extern const float building_power_factor_low = 0.25f;
+
+// FUNCTION: BEACHLIFE 0x004607f0
+int VariableEntity::PowerOutput()
+{
+    int output = AsBuilding()->building_60->power_cf4;
+    if (output < 0)
+    {
+        if (AsBuilding()->building_state_19c == 0)
+        {
+            output = abs(output);
+            switch (AsBuilding()->power_state_33c)
+            {
+            case 0:
+                return output * building_power_factor_full;
+            case 1:
+                return output * building_power_factor_high;
+            case 2:
+                return output * building_power_factor_half;
+            case 3:
+                return output * building_power_factor_low;
+            }
+        }
+        else
+            return 0;
+    }
+    return output;
+}
