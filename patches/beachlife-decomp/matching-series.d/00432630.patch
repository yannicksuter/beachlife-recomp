+static inline int CursorFrameWhitespace(const char* text)
+{
+    int count = 0;
+    while (text[count] == ' ' || text[count] == '\r' || text[count] == '\n' || text[count] == '\t')
+        count++;
+    return count;
+}
+
+static inline const char* CursorFrameOffset(const char* text, int offset)
+{
+    const char* result = text + offset;
+    return result;
+}
+
+// Two inline levels of SkipCursorFrameComments 0x00432290 (the nested call stays
+// out of line). The copy before the loop measures the trailing whitespace from a
+// temporary position; the copy inside the loop advances the text first.
+static inline int SkipLeadingCursorFrameComments(const char* text)
+{
+    int count = 0;
+    if (*text == '/')
+    {
+        const char* line = text + 1;
+        count = 1;
+        while (*line != '\n')
+        {
+            count++;
+            line++;
+        }
+        int skipped = CursorFrameWhitespace(line);
+        line += skipped;
+        count += skipped;
+        skipped = SkipCursorFrameComments(line);
+        count += skipped;
+        count += CursorFrameWhitespace(CursorFrameOffset(line, skipped));
+    }
+    return count;
+}
+
+static inline int SkipCursorFrameRecordComments(const char* text)
+{
+    int count = 0;
+    if (*text == '/')
+    {
+        const char* line = text + 1;
+        count = 1;
+        while (*line != '\n')
+        {
+            count++;
+            line++;
+        }
+        int skipped = CursorFrameWhitespace(line);
+        line += skipped;
+        count += skipped;
+        skipped = SkipCursorFrameComments(line);
+        count += skipped;
+        line += skipped;
+        count += CursorFrameWhitespace(line);
+    }
+    return count;
+}
