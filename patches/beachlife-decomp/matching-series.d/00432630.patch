+// FUNCTION: BEACHLIFE 0x00432630
+void WorldCursorNames::LoadFrames(const char* path)
+{
+    char token[32];
+    int length = strlen(path);
+    char* name = new char[length + 1];
+    strcpy(name, path);
+    name[length - 4] = '.';
+    name[length - 3] = 'b';
+    name[length - 2] = 'l';
+    name[length - 1] = 'e';
+    int size = GetFileSize(name);
+    char* text = LoadBleFile(name);
+    char* data = text;
+    delete name;
+
+    int position = CursorFrameWhitespace(text);
+    text += position;
+    int skipped = SkipLeadingCursorFrameComments(text);
+    position += skipped;
+    text += skipped;
+    while (position < size)
+    {
+        int frame = 0;
+        int bit;
+        for (bit = 0; bit < 8; bit++)
+        {
+            skipped = ReadCursorFrameToken(token, text);
+            text += skipped;
+            position += skipped;
+            frame += atoi(token) << bit;
+        }
+        skipped = ReadCursorFrameToken(token, text);
+        text += skipped;
+        position += skipped;
+        frames_34[frame] = static_cast<unsigned char>(atoi(token));
+        skipped = CursorFrameWhitespace(text);
+        text += skipped;
+        position += skipped;
+        skipped = SkipCursorFrameRecordComments(text);
+        position += skipped;
+        text += skipped;
+    }
+    delete data;
+}
