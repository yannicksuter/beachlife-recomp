+#include "startup_screen_renderer.h"
+#include <windows.h>
+
+// Flip is the surface's slot 11 (+0x2c), inside the declared prefix's unused slots.
+typedef SurfaceResult(SURFACE_STDCALL* SurfaceFlipMethod)(DirectDrawSurface7Prefix*, DirectDrawSurface7Prefix*, unsigned int);
+
+// FUNCTION: BEACHLIFE 0x0040f5f0
+void ScreenRequestRenderer::Present()
+{
+    char message[4];
+
+    if (capture_pending_ac)
+    {
+        ScreenRectangle bounds;
+        bounds.left = 0;
+        bounds.top = 0;
+        bounds.right = width;
+        bounds.bottom = height;
+        CaptureFrame(bounds);
+    }
+
+    if (software_mode)
+    {
+        current_surface = 0;
+        unsigned short* pixels = AccessPixels();
+
+        if (render_effect_active)
+        {
+            if (render_effect_mode == 0 && render_effect_countdown != 0)
+            {
+                render_effect_countdown--;
+            }
+
+            if (render_effect_hold)
+            {
+                ApplyPresentEffect(pixels, width, height, 4);
+                if (--render_effect_countdown == 0)
+                {
+                    render_effect_hold = 0;
+                }
+            }
+            else
+            {
+                ApplyPresentEffect(pixels, width, height, render_effect_mode);
+                if (!render_effect_decreasing)
+                {
+                    if (render_effect_mode == 4)
+                    {
+                        render_effect_countdown = 0x14;
+                        render_effect_decreasing = 1;
+                        render_effect_hold = 1;
+                    }
+                    else if (static_cast<int>(render_effect_step++) > 1)
+                    {
+                        render_effect_mode++;
+                        render_effect_step = 0;
+                    }
+                }
+                else
+                {
+                    if (render_effect_mode == 0)
+                    {
+                        render_effect_active = 0;
+                        render_effect_decreasing = 0;
+                    }
+                    else if (static_cast<int>(render_effect_step++) > 1)
+                    {
+                        render_effect_mode--;
+                        render_effect_step = 0;
+                    }
+                }
+            }
+        }
+
+        if (!pixels)
+        {
+            return;
+        }
+
+        int result = StretchDIBits(static_cast<HDC>(device_context_64), 0, 0, width, height, 0, 0, width, height, pixels, static_cast<const BITMAPINFO*>(bitmap_info), 0, SRCCOPY);
+        if (result == -1)
+        {
+            FormatMessageA(0x1300, 0, GetLastError(), 0x400, message, 0, 0);
+        }
+
+        if (!software_mode)
+        {
+            DirectDrawSurface7Prefix* surface = surfaces[current_surface]->surface;
+            surface->vtable->Unlock(surface, 0);
+        }
+        pixels_locked = 0;
+    }
+    else
+    {
+        DirectDrawSurface7Prefix* primary = primary_surface;
+        reinterpret_cast<SurfaceFlipMethod>(primary->vtable->unused_18[5])(primary, 0, 0);
+    }
+}
