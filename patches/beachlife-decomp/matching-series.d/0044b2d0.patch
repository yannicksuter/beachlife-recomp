+#include "startup_screen_mode_world.h"
+#include "startup_variable_state.h"
+#include "startup_variable_catalog_fields.h"
+#include "startup_game_file.h"
+#include <stdlib.h>
+#include <string.h>
+
+// startup_screen_mode_world.h supplies the retail unit context that lets VC6
+// share the copy tails of the NAME, SPRITE, ANIM and MENU branches.
+
+// FUNCTION: BEACHLIFE 0x0044b2d0
+void VariableCatalog::ParseScenery(unsigned int id, const char* key, const char* value)
+{
+    VariableScenery* record = reinterpret_cast<VariableScenery*>(reinterpret_cast<unsigned char*>(this) + 0x5409c) + id;
+    if (strcmp(key, "NAME") == 0)
+        strcpy(record->model_44, value);
+    else if (strcmp(key, "SPRITE") == 0)
+        strcpy(record->resource_c4, value);
+    else if (strcmp(key, "ANIM") == 0)
+        strcpy(record->animation_1c4, value);
+    else if (strcmp(key, "GRIDWIDTH") == 0)
+        record->footprint_x_2c8 = atoi(value);
+    else if (strcmp(key, "GRIDHEIGHT") == 0)
+        record->footprint_y_2cc = atoi(value);
+    else if (strcmp(key, "COST2BUILD") == 0)
+        record->cost_2d0 = atoi(value);
+    else if (strcmp(key, "BUILDON") == 0)
+    {
+        if (strcmp(value, "SHALLOW_WATER") == 0)
+            record->terrain_flags_2d4 |= 4;
+        else if (strcmp(value, "LAND") == 0)
+            record->terrain_flags_2d4 |= 1;
+        else if (strcmp(value, "DEEP_SEA") == 0)
+            record->terrain_flags_2d4 |= 8;
+        else if (strcmp(value, "BEACH") == 0)
+            record->terrain_flags_2d4 |= 2;
+        else if (strcmp(value, "PATH") == 0)
+            record->terrain_flags_2d4 |= 128;
+    }
+    else if (strcmp(key, "COLLIDE") == 0)
+    {
+        if (atoi(value))
+            record->unknown_2d8[0] = 1;
+        else
+            record->unknown_2d8[0] = 0;
+    }
+    else if (strcmp(key, "CAPACITY") == 0)
+        record->capacity_2dc = atoi(value);
+    else if (strcmp(key, "MENU") == 0)
+        strcpy(record->service_2e0, value);
+    else if (strcmp(key, "ICON") == 0)
+        record->preview_frame_300 = atoi(value);
+    else if (strcmp(key, "CATEGORY") == 0)
+    {
+        if (strcmp(value, "FURNITURE") == 0)
+            record->list_kind_2c4 = 0;
+        else if (strcmp(value, "PATHS") == 0)
+            record->list_kind_2c4 = 1;
+        else if (strcmp(value, "PLANTS") == 0)
+            record->list_kind_2c4 = 2;
+        else if (strcmp(value, "ORNAMENTS") == 0)
+            record->list_kind_2c4 = 3;
+        else if (strcmp(value, "TREES") == 0)
+            record->list_kind_2c4 = 4;
+        else if (strcmp(value, "SHRUBS") == 0)
+            record->list_kind_2c4 = 5;
+        else if (strcmp(value, "BILLBOARD") == 0)
+            record->list_kind_2c4 = 6;
+        else if (strcmp(value, "OTHER") == 0)
+            record->list_kind_2c4 = 7;
+        else
+            StartupFatal("Unknown scenery category");
+    }
+    else if (strcmp(key, "RATING") == 0)
+        record->rating_304 = static_cast<float>(atof(value));
+    else if (strcmp(key, "CLEAN") == 0)
+    {
+        if (atoi(value))
+            record->cleanable_308 = 1;
+        else
+            record->cleanable_308 = 0;
+    }
+    else if (strcmp(key, "REPAIR") == 0)
+    {
+        if (atoi(value))
+            record->repairable_309 = 1;
+        else
+            record->repairable_309 = 0;
+    }
+    else if (strcmp(key, "BURN") == 0)
+    {
+        if (atoi(value))
+            record->unknown_310 = 1;
+        else
+            record->unknown_310 = 0;
+    }
+    else if (strcmp(key, "USERREMOVE") == 0)
+    {
+        if (atoi(value))
+            record->removable_311 = 1;
+        else
+            record->removable_311 = 0;
+    }
+    else if (strcmp(key, "VEGFLAG") == 0)
+    {
+        if (atoi(value))
+            record->blocks_tile_312 = 1;
+        else
+            record->blocks_tile_312 = 0;
+    }
+    else if (strcmp(key, "PATHFLAG") == 0)
+        record->flag_30c = atoi(value);
+    else if (strcmp(key, "WATER") == 0)
+    {
+        if (atoi(value))
+            record->serviceable_30a = 1;
+        else
+            record->serviceable_30a = 0;
+    }
+}
