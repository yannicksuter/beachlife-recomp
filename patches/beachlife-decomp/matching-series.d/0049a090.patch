+#include "startup_world_vehicle_helpers.h"
+#include "startup_screen_command_inlines.h"
+#include "startup_screen_position_inlines.h"
+// FUNCTION: BEACHLIFE 0x0049a090
+bool WorldVehicleEntity::FindFishingPoint()
+{
+    {
+        ScreenTerrainCell* neighbours[8];
+        screen_terrain_grid->Neighbours(current_grid_964, neighbours);
+        for (int i = 0; i < 8; ++i)
+            neighbours[i]->flags_48 &= ~0x10u;
+    }
+    ScreenPoint tile;
+    tile = TilePosition();
+    int facing = (heading_5d0 + 2) % 8;
+    int count = 0;
+    ScreenPoint point;
+    point = tile;
+    ScreenPoint last;
+    while (1)
+    {
+        if (count >= 15)
+            break;
+        screen_terrain_grid->Step(point, (facing + 7) % 8, &point);
+        ScreenTerrainGrid* grid = screen_terrain_grid;
+        unsigned int flags = grid->cells_0c[grid->TileIndex(point.x, point.y)].flags_48;
+        if (point.x < 2 || point.x > 126 || point.y < 2 || point.y > 126
+            || !(flags & 0x60000000) || (flags & 0x10))
+            break;
+        if (count > 1)
+        {
+            ScreenTerrainCell* neighbours[8];
+            screen_terrain_grid->Neighbours(point, neighbours);
+            bool clear = true;
+            for (int i = 0; i < 8; ++i)
+                if (!(neighbours[i]->flags_48 & 0x60000000) || (neighbours[i]->flags_48 & 0x10))
+                    clear = false;
+            if (!clear)
+                break;
+        }
+        ++count;
+        last = point;
+    }
+    if (count <= 4)
+        return false;
+    SetMoving(0);
+    roam_point_8e8 = screen_terrain_grid->TilePosition(last, 4);
+    if (facing % 8 == keyline_state_44->word_18)
+    {
+        ScreenModeCommand command;
+        command.words[0] = id_28;
+        command.words[1] = id_28;
+        command.words[2] = 10;
+        command.words[3] = static_cast<int>(roam_point_8e8.x);
+        command.words[4] = static_cast<int>(roam_point_8e8.y);
+        screen_mode_commands->QueueCommand(&command);
+    }
+    else
+        FaceVehicle(facing % 8);
+    {
+        ScreenTerrainCell* neighbours[8];
+        screen_terrain_grid->Neighbours(current_grid_964, neighbours);
+        for (int j = 0; j < 8; ++j)
+            neighbours[j]->flags_48 |= 0x10;
+    }
+    return true;
+}
