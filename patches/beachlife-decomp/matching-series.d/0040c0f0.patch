+void ScreenRequestRenderer::FillRectangle(const ScreenRectangle& bounds, unsigned short colour)
+{
+    ScreenRectangle area;
+    area.left = bounds.left;
+    area.top = bounds.top;
+    area.right = bounds.right;
+    area.bottom = bounds.bottom;
+    area.bottom -= area.top;
+    int draw_width = area.right - area.left;
+    if (area.top < 0)
+    {
+        area.bottom += area.top;
+        area.top = 0;
+    }
+    if (area.left < 0)
+    {
+        draw_width += area.left;
+        area.left = 0;
+    }
+    if (draw_width + area.left > static_cast<int>(width))
+        draw_width = width - area.left;
+    if (area.bottom + area.top > static_cast<int>(height))
+        area.bottom = height - area.top;
+    if (unscaled_clip_5c)
+    {
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+            return;
+        ScreenSurfacePosition* entry = surfaces[current_surface];
+        unsigned int pitch = entry->pitch;
+        ScreenPoint origin = entry->position;
+        unsigned short* row = pixels + (pitch >> 1) * (area.top - origin.y) - origin.x + area.left;
+        for (int rows = area.bottom; rows > 0; --rows)
+        {
+            unsigned short* pixel = row;
+            for (int columns = draw_width; columns > 0; --columns)
+                *pixel++ = colour;
+            row += pitch >> 1;
+        }
+        UnlockPixels();
+        return;
+    }
+    unsigned int* row = reinterpret_cast<unsigned int*>(pixels_1c) + width * area.top + area.left;
+    for (int y = 0; y < area.bottom; ++y)
+    {
+        for (int x = 0; x < draw_width; ++x)
+            row[x] = (row[x] & 0xffff0000u) + colour;
+        row += width;
+    }
+}
