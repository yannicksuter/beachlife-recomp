+#include "startup_screen_renderer.h"
+#include "startup_game_file.h"
+#include <string.h>
+
+// Creates a DirectDraw surface (video memory first, system memory when video memory is exhausted or requested) or,
+// in software mode, a heap pixel buffer, and records its size and pitch in the entry.
+// FUNCTION: BEACHLIFE 0x0040e500
+void ScreenRequestRenderer::InitializeSurface(int width, int height, ScreenSurfacePosition* entry, unsigned char mode)
+{
+    if (!software_mode)
+    {
+        SurfaceDescription description;
+        memset(&description, 0, sizeof(description));
+        description.size = sizeof(description);
+        description.flags = 7;
+        description.caps = 0x4040;
+        if (mode)
+            description.caps = 0x840;
+        description.width = width;
+        description.height = height;
+        entry->video_memory = 1;
+        SurfaceResult result = draw->vtable->CreateSurface(draw, &description, &entry->surface, 0);
+        if (result == (SurfaceResult)0x8876017c)
+        {
+            entry->video_memory = 0;
+            description.caps = 0x840;
+            result = draw->vtable->CreateSurface(draw, &description, &entry->surface, 0);
+            if (result != 0)
+                StartupFatal("Error creating surface");
+        }
+        entry->width = width;
+        entry->height = height;
+        entry->software = 0;
+        memset(&description, 0, sizeof(description));
+        description.size = sizeof(description);
+        entry->surface->vtable->GetSurfaceDesc(entry->surface, &description);
+        entry->pitch = description.pitch;
+        entry->prepared = 0;
+    }
+    else
+    {
+        entry->software = 1;
+        entry->pixels = new unsigned short[width * height];
+        entry->width = width;
+        entry->height = height;
+        entry->pitch = width * 2;
+        entry->prepared = 0;
+    }
+}
