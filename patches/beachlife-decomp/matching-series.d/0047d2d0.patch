+// Animation name handed to the script by the lifeguard's rescue queries.
+// GLOBAL: BEACHLIFE 0x005badf8
+char lifeguard_animation_name[32];
+
+// FUNCTION: BEACHLIFE 0x0047d2d0
+const char* WorldLifeguardEntity::Notification(unsigned int flags)
+{
+    const char* text = WorldStaffEntity::Notification(flags);
+    if (flags & 2)
+        text = "FEEDBACK_LIFEGUARD_GUESTS_DROWNED";
+    else if (flags & 4)
+        text = "FEEDBACK_LIFEGUARD_SWIM_IN_TROUBLE";
+    else if (flags & 8)
+        text = "FEEDBACK_LIFEGUARD_CANT_SAVE";
+    else if (flags & 0x10)
+        text = "FEEDBACK_LIFEGUARD_ALREADY_SAVED";
+    else if (flags & 0x20)
+        text = "FEEDBACK_LIFEGUARD_IS_OK";
+    else if (flags & 0x100000)
+        text = "FEEDBACK_LIFEGUARD_UNHAPPY";
+    else if (flags & 0x40)
+        text = "FEEDBACK_LIFEGUARD_GUESTINTROUBLE";
+    else if (flags & 0x80)
+        text = "FEEDBACK_LIFEGUARD_GUESTRESCUED";
+    else if (flags & 0x20000000)
+    {
+        VariableCatalog* catalog = variable_catalog;
+        VariableStaffState* staff = catalog->Staff(variable_catalog->FindStaff(name_06));
+        switch (rand() % 3)
+        {
+        case 0:
+            text = staff->female_c4 == 0 ? "FEEDBACK_LIFEGUARD_INNERTOUGHT_MALE_STANDIDLE_01"
+                                         : "FEEDBACK_LIFEGUARD_INNERTOUGHT_FEMALE_STANDIDLE_01";
+            break;
+        case 1:
+            text = staff->female_c4 == 0 ? "FEEDBACK_LIFEGUARD_INNERTOUGHT_MALE_STANDIDLE_02"
+                                         : "FEEDBACK_LIFEGUARD_INNERTOUGHT_FEMALE_STANDIDLE_02";
+            break;
+        case 2:
+            text = staff->female_c4 == 0 ? "FEEDBACK_LIFEGUARD_INNERTOUGHT_MALE_STANDIDLE_03"
+                                         : "FEEDBACK_LIFEGUARD_INNERTOUGHT_FEMALE_STANDIDLE_03";
+            break;
+        }
+    }
+    return text;
+}
+
+// FUNCTION: BEACHLIFE 0x0047dc50
+WorldScriptValue WorldLifeguardEntity::Unknown2c(WorldScriptValue key)
+{
+    WorldScriptValue result;
+    switch (static_cast<int>(key.kind))
+    {
+    case 0x32:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = flag_7e8;
+        break;
+    case 0x3d:
+        result.kind = 1;
+        result.data = reinterpret_cast<unsigned int>(current_animation_7bc);
+        break;
+    case 0x40:
+        result.kind = 2;
+        result.data = action_state_7ec;
+        break;
+    case 0x97:
+        result.kind = 3;
+        *reinterpret_cast<float*>(&result.data) = exit_point_788.x;
+        break;
+    case 0x98:
+        result.kind = 3;
+        *reinterpret_cast<float*>(&result.data) = exit_point_788.y;
+        break;
+    case 0x99:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = flag_778;
+        break;
+    case 0x9a:
+        result.kind = 2;
+        result.data = saving_id_77c;
+        break;
+    case 0x9b:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = flags_828[1];
+        break;
+    case 0x9c:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = flags_828[2];
+        break;
+    case 0x9d:
+        result.kind = 2;
+        result.data = word_820;
+        break;
+    case 0x9e:
+        result.kind = 3;
+        {
+            ScreenWorldPosition position = variable_world->FindObject(saving_id_77c)->position_30;
+            *reinterpret_cast<float*>(&result.data) = position.x;
+        }
+        break;
+    case 0x9f:
+        result.kind = 3;
+        {
+            ScreenWorldPosition position = variable_world->FindObject(saving_id_77c)->position_30;
+            *reinterpret_cast<float*>(&result.data) = position.y;
+        }
+        break;
+    case 0xa0:
+    {
+        result.kind = 3;
+        ScreenWorldPosition position = variable_world->FindObject(saving_id_77c)->position_30;
+        long double x = position_30.x - position.x;
+        long double y = position_30.y - position.y;
+        long double z = position_30.z - position.z;
+        *reinterpret_cast<float*>(&result.data) = sqrt(z * z + y * y + x * x);
+        break;
+    }
+    case 0xfc:
+        result.kind = 0;
+        {
+            unsigned int id = home_id_100;
+            *reinterpret_cast<unsigned char*>(&result.data) = !variable_world->FindObject(id)->FlagAt00460370();
+        }
+        break;
+    case 0xa1:
+        result.kind = 2;
+        strcpy(lifeguard_animation_name, "rescue");
+        result.data = reinterpret_cast<unsigned int>(lifeguard_animation_name);
+        break;
+    case 0xa2:
+        result.kind = 2;
+        strcpy(lifeguard_animation_name, "rescue_swim");
+        result.data = reinterpret_cast<unsigned int>(lifeguard_animation_name);
+        break;
+    case 0xe0:
+        result.kind = 2;
+        strcpy(lifeguard_animation_name, "D_STAND_SAD");
+        result.data = reinterpret_cast<unsigned int>(lifeguard_animation_name);
+        break;
+    case 0xa3:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = flags_828[0];
+        break;
+    case 0xa4:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = flags_828[3];
+        break;
+    case 0xa6:
+        result.kind = 2;
+        result.data = 600;
+        break;
+    case 0xa7:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = flag_779;
+        break;
+    case 0xa8:
+        result.kind = 0;
+        *reinterpret_cast<unsigned char*>(&result.data) = variable_world->FindObject(saving_id_77c)->AsGuest()->lightning_state_318 == 1;
+        break;
+    default:
+        result = WorldStaffEntity::Unknown2c(key);
+        break;
+    }
+    return result;
+}
