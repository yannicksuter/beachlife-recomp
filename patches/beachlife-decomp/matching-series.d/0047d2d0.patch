+#include "startup_world_entities.h"
+#include "startup_variable_state.h"
+#include <stdlib.h>
+
+// FUNCTION: BEACHLIFE 0x0047d2d0
+const char* WorldLifeguardEntity::Notification(unsigned int flags)
+{
+    const char* text = WorldStaffEntity::Notification(flags);
+    if (flags & 2)
+        text = "FEEDBACK_LIFEGUARD_GUESTS_DROWNED";
+    else if (flags & 4)
+        text = "FEEDBACK_LIFEGUARD_SWIM_IN_TROUBLE";
+    else if (flags & 8)
+        text = "FEEDBACK_LIFEGUARD_CANT_SAVE";
+    else if (flags & 0x10)
+        text = "FEEDBACK_LIFEGUARD_ALREADY_SAVED";
+    else if (flags & 0x20)
+        text = "FEEDBACK_LIFEGUARD_IS_OK";
+    else if (flags & 0x100000)
+        text = "FEEDBACK_LIFEGUARD_UNHAPPY";
+    else if (flags & 0x40)
+        text = "FEEDBACK_LIFEGUARD_GUESTINTROUBLE";
+    else if (flags & 0x80)
+        text = "FEEDBACK_LIFEGUARD_GUESTRESCUED";
+    else if (flags & 0x20000000)
+    {
+        VariableCatalog* catalog = variable_catalog;
+        VariableStaffState* staff = catalog->Staff(variable_catalog->FindStaff(name_06));
+        switch (rand() % 3)
+        {
+        case 0:
+            text = staff->female_c4 == 0 ? "FEEDBACK_LIFEGUARD_INNERTOUGHT_MALE_STANDIDLE_01"
+                                         : "FEEDBACK_LIFEGUARD_INNERTOUGHT_FEMALE_STANDIDLE_01";
+            break;
+        case 1:
+            text = staff->female_c4 == 0 ? "FEEDBACK_LIFEGUARD_INNERTOUGHT_MALE_STANDIDLE_02"
+                                         : "FEEDBACK_LIFEGUARD_INNERTOUGHT_FEMALE_STANDIDLE_02";
+            break;
+        case 2:
+            text = staff->female_c4 == 0 ? "FEEDBACK_LIFEGUARD_INNERTOUGHT_MALE_STANDIDLE_03"
+                                         : "FEEDBACK_LIFEGUARD_INNERTOUGHT_FEMALE_STANDIDLE_03";
+            break;
+        }
+    }
+    return text;
+}
