+#include "render_mask_setup.h"
+#include "startup_renderer_present_effect.h"
+
+// FUNCTION: BEACHLIFE 0x004017e0
+void ApplyPresentEffect(unsigned short* pixels, int width, int height, unsigned char mode)
+{
+    unsigned short color;
+    unsigned short* p = pixels;
+    for (int y = 0; y < height; y++)
+    {
+        for (int x = 0; x < width; x++)
+        {
+            unsigned short pixel = *p;
+            switch (mode)
+            {
+            case 0:
+                color = pixel;
+                break;
+            case 1:
+                // Retail reads the 16-bit bias as a dword; only its low half reaches the colour.
+                color = ((pixel >> 1) & (render_half_mask >> 1)) + (*reinterpret_cast<int*>(&render_quarter_bias) + ((pixel >> 2) & (render_quarter_mask >> 2)));
+                break;
+            case 2:
+                color = ((pixel >> 1) & (render_half_mask >> 1)) + render_half_bias;
+                break;
+            case 3:
+                color = ((pixel >> 2) & (render_quarter_mask >> 2)) + render_sum_bias;
+                break;
+            case 4:
+                color = 0xffff;
+                break;
+            }
+            *p++ = color;
+        }
+    }
+}
