+#include "startup_world_subsystems.h"
+#include "startup_world_script_actions.h"
+#include "startup_world_script_message_names.h"
+#include "startup_game_file.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004d5e70
+int WorldSubsystemScript::ParseStateActions(unsigned int phase)
+{
+    int count = ReadToken(world_object_script_token);
+    while (strcmp(world_object_script_token, "End") != 0)
+    {
+        if (strcmp(world_object_script_token, "PlayAnimation") == 0)
+            count += ParsePlayAnimationAction(phase);
+        else if (strcmp(world_object_script_token, "Function") == 0)
+            count += ParseFunctionAction(phase);
+        else if (strcmp(world_object_script_token, "Message") == 0)
+            count += ParseMessageAction(phase);
+        else if (strcmp(world_object_script_token, "ChangeState") == 0)
+            count += ParseChangeStateAction(phase);
+        else if (strcmp(world_object_script_token, "If") == 0)
+            count += ParseIfAction(phase);
+        else if (strcmp(world_object_script_token, "Else") == 0)
+        {
+            if (word_5914)
+                word_5914->parsing_else_1c = 1;
+            else
+                StartupFatal("ObjectScript::ProcessCommands - Else statement without if statement");
+        }
+        else if (strcmp(world_object_script_token, "Switch") == 0)
+            count += ParseSwitchAction(phase);
+        else if (strcmp(world_object_script_token, "Case") == 0)
+            count += ParseCaseAction(phase);
+        else if (strcmp(world_object_script_token, "Add") == 0)
+            count += ParseAddAction(phase);
+        else if (strcmp(world_object_script_token, "Minus") == 0)
+            count += ParseMinusAction(phase);
+        else if (strcmp(world_object_script_token, "Divide") == 0)
+            count += ParseDivideAction(phase);
+        else if (strcmp(world_object_script_token, "Multiply") == 0)
+            count += ParseMultiplyAction(phase);
+        else if (strcmp(world_object_script_token, "Set") == 0)
+            count += ParseSetAction(phase);
+        else if (strcmp(world_object_script_token, "PlaySound") == 0)
+            count += ParsePlaySoundAction(phase);
+        else
+            StartupFatal("ObjectScript::ProcessCommand Invalid Command : %s", world_object_script_token);
+        count += ReadToken(world_object_script_token);
+    }
+    return count;
+}
