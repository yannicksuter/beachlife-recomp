+#include "startup_world_motion_helpers.h"
+
+static __forceinline unsigned int RouteFlags(ScreenPoint point)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    return grid->cells_0c[grid->TileIndex(point.x, point.y)].flags_48;
+}
+
+static __forceinline unsigned int IndexedRouteFlags(ScreenPoint point)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    unsigned int index = (static_cast<unsigned int>(point.y) % grid->height_08) * grid->width_04 + static_cast<unsigned int>(point.x) % grid->width_04;
+    return grid->cells_0c[index].flags_48;
+}
+
+static __forceinline void MarkRouteCell(ScreenTerrainCell* cell)
+{
+    cell->flags_48 |= 0xc0000080u;
+}
+
+static __forceinline void MarkRouteTile(ScreenPoint point)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    MarkRouteCell(&grid->cells_0c[grid->TileIndex(point.x, point.y)]);
+}
+
+static __forceinline void MarkIndexedRouteTile(ScreenPoint point)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    unsigned int index = (static_cast<unsigned int>(point.y) % grid->height_08) * grid->width_04 + static_cast<unsigned int>(point.x) % grid->width_04;
+    MarkRouteCell(&grid->cells_0c[index]);
+}
+
+// FUNCTION: BEACHLIFE 0x00485f20
+bool WorldMovingEntity::AdjustRouteEndpoints(ScreenPoint* start, ScreenPoint* end, unsigned int flags)
+{
+    ScreenPoint first = *start;
+    ScreenPoint last = *end;
+    ScreenPoint neighbour;
+    bool first_valid;
+    bool last_valid;
+    if ((RouteFlags(*start) & flags) && !(RouteFlags(first) & 0x8000))
+        first_valid = true;
+    else if ((RouteFlags(first) & 0x100) && !(RouteFlags(first) & 0x10))
+    {
+        MarkRouteTile(first);
+        for (int direction = 0; direction < 8; ++direction)
+        {
+            screen_terrain_grid->Step(first.x, first.y, direction, &neighbour);
+            if ((RouteFlags(neighbour) & 0x100) && !(RouteFlags(neighbour) & 0x10))
+                MarkRouteTile(neighbour);
+        }
+        first_valid = (RouteFlags(first) & flags) != 0;
+    }
+    else
+    {
+        for (int direction = 0; direction < 8; direction += 2)
+        {
+            screen_terrain_grid->Step(first.x, first.y, direction, &neighbour);
+            if ((RouteFlags(neighbour) & flags) && !(RouteFlags(neighbour) & 0x8000))
+            {
+                first = neighbour;
+                direction = 8;
+                first_valid = true;
+            }
+            else
+                first_valid = false;
+        }
+    }
+    if ((RouteFlags(last) & flags) && !(RouteFlags(last) & 0x8000))
+        last_valid = true;
+    else if ((RouteFlags(last) & 0x100) && !(RouteFlags(last) & 0x10))
+    {
+        MarkIndexedRouteTile(last);
+        for (int direction = 0; direction < 8; ++direction)
+        {
+            screen_terrain_grid->Step(last.x, last.y, direction, &neighbour);
+            if ((RouteFlags(neighbour) & 0x100) && !(RouteFlags(neighbour) & 0x10))
+                MarkIndexedRouteTile(neighbour);
+        }
+        last_valid = (IndexedRouteFlags(last) & flags) != 0;
+    }
+    else
+    {
+        for (int direction = 0; direction < 8; direction += 2)
+        {
+            screen_terrain_grid->Step(last.x, last.y, direction, &neighbour);
+            unsigned int adjacent = IndexedRouteFlags(neighbour);
+            if ((adjacent & flags) && !(adjacent & 0x8000))
+            {
+                last = neighbour;
+                direction = 8;
+                last_valid = true;
+            }
+            else
+                last_valid = false;
+        }
+    }
+    if (first_valid && last_valid)
+    {
+        *start = first;
+        end->y = last.y;
+        end->x = last.x;
+        return true;
+    }
+    return false;
+}
