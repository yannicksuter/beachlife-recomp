+#include "startup_screen_mode_world.h"
+#include "startup_variable_state.h"
+#include "startup_variable_catalog_fields.h"
+#include "startup_game_file.h"
+#include <stdlib.h>
+#include <string.h>
+
+template <class T>
+static T& CatalogField(void* record, unsigned int offset)
+{
+    return *reinterpret_cast<T*>(static_cast<unsigned char*>(record) + offset);
+}
+
+// Retail expands VariableCatalog::FindStaff (0x00449440) inline here.
+static inline unsigned int FindStaffId(VariableCatalog* catalog, const char* name)
+{
+    unsigned char* storage = reinterpret_cast<unsigned char*>(catalog);
+    unsigned int count = *reinterpret_cast<unsigned int*>(storage + 0x14);
+    for (unsigned int index = 0; index < count; ++index)
+    {
+        const char* record = reinterpret_cast<const char*>(catalog) + 0x384c4 + index * 0x224;
+        if (strcmp(record, name) == 0)
+            return *reinterpret_cast<unsigned int*>(reinterpret_cast<unsigned char*>(catalog) + 0x384c0 + index * 0x224);
+    }
+    StartupFatal("WorldParams::GetStaffID - keyword not found - %s", name);
+    return 0;
+}
+
+// FUNCTION: BEACHLIFE 0x0044f260
+void VariableCatalog::ParseVehicle(unsigned int id, const char* key, const char* value)
+{
+    unsigned char* record = CatalogRecordAddress(this, 0x3fb24, 0x274, id);
+    if (strcmp(key, "NAME") == 0)
+    {
+        strcpy(reinterpret_cast<char*>(record + 0x44), value);
+    }
+    else if (strcmp(key, "SPRITE") == 0)
+    {
+        strcpy(reinterpret_cast<char*>(record + 0xc4), value);
+    }
+    else if (strcmp(key, "GRIDWIDTH") == 0)
+    {
+        CatalogField<int>(record, 0x1c4) = atoi(value);
+    }
+    else if (strcmp(key, "GRIDHEIGHT") == 0)
+    {
+        CatalogField<int>(record, 0x1c8) = atoi(value);
+    }
+    else if (strcmp(key, "CAPACITY") == 0)
+    {
+        CatalogField<int>(record, 0x1cc) = atoi(value);
+    }
+    else if (strcmp(key, "TERRAIN") == 0)
+    {
+        return;
+    }
+    else if (strcmp(key, "MAX_SPEED") == 0)
+    {
+        CatalogField<float>(record, 0x1d4) = static_cast<float>(atof(value));
+    }
+    else if (strcmp(key, "TOWED") == 0)
+    {
+        strcpy(reinterpret_cast<char*>(record + 0x1e4), value);
+    }
+    else if (strcmp(key, "FORCE") == 0)
+    {
+        CatalogField<float>(record, 0x1d0) = static_cast<float>(atof(value));
+    }
+    else if (strcmp(key, "MASS") == 0)
+    {
+        CatalogField<float>(record, 0x1d8) = static_cast<float>(atof(value));
+    }
+    else if (strcmp(key, "MOVETYPE") == 0)
+    {
+        if (strcmp(value, "POINTS") == 0)
+        {
+            record[0x1dc] = 1;
+        }
+        else if (strcmp(value, "BOUNDARY") == 0)
+        {
+            record[0x1dc] = 2;
+        }
+        else
+        {
+            StartupFatal("WorldParams::AddVehicleData - Invalid Movement Type - %s", value);
+        }
+    }
+    else if (strcmp(key, "ANIMSET") == 0)
+    {
+        strcpy(reinterpret_cast<char*>(record + 0x224), value);
+    }
+    else if (strcmp(key, "STAFF") == 0)
+    {
+        unsigned int staff = FindStaffId(this, value);
+        unsigned int& count = CatalogField<unsigned int>(record, 0x1e0);
+        CatalogField<unsigned int>(record, 0x264 + count * 4) = staff;
+        ++count;
+    }
+    else if (strcmp(key, "CREATION_PNTX") == 0)
+    {
+        CatalogField<float>(record, 0x26c) = static_cast<float>(atof(value));
+    }
+    else if (strcmp(key, "CREATION_PNTY") == 0)
+    {
+        CatalogField<float>(record, 0x270) = static_cast<float>(atof(value));
+    }
+    else
+    {
+        StartupFatal("WorldParams::AddVehicleData - unrecognised Vehicle keyword - %s", key);
+    }
+}
