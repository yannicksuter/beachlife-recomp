+        ReadRectangle(rectangle, current_context);
+        char resource_name[64];
+        ReadText(resource_name);
+        char name[64];
+        ReadText(name);
+        ScreenCheckBox* item = new ScreenCheckBox(rectangle, resource_name, name);
+        RegisterItem(item, 0);
+
+        data = buffer;
+        if (data[cursor - 1] == ',')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            char text[64];
+            ReadText(text);
+            item->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_checkbox - Script Error \r\nNo open bracket found at "
+                     "file offset - %u",
+            cursor);
+    }
+}
