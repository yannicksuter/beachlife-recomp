+#include "startup_screen_manager.h"
+#include "startup_config_owner.h"
+#include "startup_screen_renderer.h"
+#include "window_activation.h"
+
+#include "startup_render_rectangle.h"
+
+// FUNCTION: BEACHLIFE 0x004e3a50
+void ScreenRequestGamePrefix::Render()
+{
+    if (reload_screen)
+    {
+        const char* path = controller_selection.active->ScriptPath();
+        screens->LoadScreen(path);
+        screens->ScreenSelect();
+        reload_screen = 0;
+    }
+
+    controller_selection.active->RenderBeforeScreens();
+    ScreenRequestRenderer* rectangle_renderer = screen_request_renderer;
+    int height = rectangle_renderer->height;
+    int width = rectangle_renderer->width;
+    RenderRectangle bounds = { 0, 0, width, height };
+    reinterpret_cast<RenderRectangleState*>(rectangle_renderer)->SetRectangle(bounds);
+    screens->RenderScreens();
+
+    bool night_day_enabled;
+    startup_config_owner->GetBool(&night_day_enabled, "bNIGHT_DAY_ENABLED");
+    if (night_day_enabled && window_deactivation_state)
+    {
+        float value = window_deactivation_state->render_value_160;
+        renderer->RenderNightDay(value);
+    }
+    else
+    {
+        renderer->RenderDefault();
+    }
+
+    reinterpret_cast<RenderRectangleState*>(renderer)->RestoreSurfaces();
+    controller_selection.active->RenderAfterScreens();
+    screens->RenderPointer();
+    renderer->Present();
+}
