+#include "startup_application.h"
+#include "startup_screen_position_inlines.h"
+#include "startup_screen_terrain_tile_index.h"
+#include "startup_screen_mode_world.h"
+#include "startup_world_entities.h"
+#include <math.h>
+#include <stdlib.h>
+
+// Retail keeps the result in a function-local static; its guard, array and
+// empty atexit destructor are written out here so each has a name.
+// GLOBAL: BEACHLIFE 0x005badb6
+static unsigned char beach_walkpoints_initialized;
+// GLOBAL: BEACHLIFE 0x005badc0
+static ScreenWorldPosition beach_walkpoints[2];
+
+// FUNCTION: BEACHLIFE 0x00469510
+void DestroyBeachWalkpoints()
+{
+}
+
+static inline ScreenWorldPosition Difference(const ScreenWorldPosition& a, const ScreenWorldPosition& b)
+{
+    return ScreenWorldPosition(a.x - b.x, a.y - b.y, a.z);
+}
+
+static inline float BeachDistance(const ScreenWorldPosition& offset)
+{
+    return sqrt(offset.y * offset.y + offset.z * offset.z + offset.x * offset.x);
+}
+
+static inline unsigned int BeachFlags(ScreenTerrainGrid* grid, ScreenPoint tile)
+{
+    return grid->cells_0c[grid->TileIndex(tile.x, tile.y)].flags_48;
+}
+
+// FUNCTION: BEACHLIFE 0x00468ac0
+ScreenWorldPosition* WorldGuestEntity::FindBeachWalkpoints(ScreenWorldPosition position)
+{
+    if (!(beach_walkpoints_initialized & 1))
+    {
+        beach_walkpoints_initialized |= 1;
+        atexit(DestroyBeachWalkpoints);
+    }
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    ScreenTerrainRouteNode* selected = grid->routes_20;
+    while (selected && selected->disabled_2c)
+        selected = selected->Next();
+    if (selected)
+    {
+        unsigned int count;
+        ScreenPoint* points = selected->Points(&count);
+        unsigned int index = 0;
+        ScreenPoint neighbour0, neighbour1, neighbour2, neighbour3;
+        ScreenPoint nearest;
+        ScreenWorldPosition offset, previous;
+        grid->Step(points[index], 0, &neighbour0);
+        grid->Step(points[index], 2, &neighbour1);
+        grid->Step(points[index], 4, &neighbour2);
+        grid->Step(points[index], 6, &neighbour3);
+        while (!(!(BeachFlags(grid, points[index]) & 0x10) && !(BeachFlags(grid, neighbour0) & 0x10) && !(BeachFlags(grid, neighbour1) & 0x10) && !(BeachFlags(grid, neighbour2) & 0x10) && !(BeachFlags(grid, neighbour3) & 0x10)))
+        {
+            if (++index == count)
+            {
+                selected = selected->Next();
+                if (!selected)
+                    StartupFatal("I hope This Never Happens ( Cant Get Sea Entry Point)");
+                points = selected->Points(&count);
+                index = 0;
+            }
+            grid->Step(points[index], 0, &neighbour0);
+            grid->Step(points[index], 2, &neighbour1);
+            grid->Step(points[index], 4, &neighbour2);
+            grid->Step(points[index], 6, &neighbour3);
+        }
+        nearest = ScreenPoint(points[index].x, points[index].y);
+        for (unsigned int i = index + 1; i < count; ++i)
+        {
+            grid->Step(points[i], 0, &neighbour0);
+            grid->Step(points[i], 2, &neighbour1);
+            grid->Step(points[i], 4, &neighbour2);
+            grid->Step(points[i], 6, &neighbour3);
+            offset = Difference(grid->TileOrigin(points[i]), position);
+            previous = Difference(grid->TileOrigin(nearest), position);
+            if (BeachDistance(offset) < BeachDistance(previous) && !(BeachFlags(grid, points[i]) & 0x10) && !(BeachFlags(grid, neighbour0) & 0x10) && !(BeachFlags(grid, neighbour1) & 0x10) && !(BeachFlags(grid, neighbour2) & 0x10) && !(BeachFlags(grid, neighbour3) & 0x10))
+                nearest = ScreenPoint(points[i].x, points[i].y);
+        }
+        for (ScreenTerrainRouteNode* route = selected->Next(); route; route = route->Next())
+        {
+            if (route->disabled_2c)
+                continue;
+            points = route->Points(&count);
+            for (unsigned int i = 0; i < count; ++i)
+            {
+                grid->Step(points[i], 0, &neighbour0);
+                grid->Step(points[i], 2, &neighbour1);
+                grid->Step(points[i], 4, &neighbour2);
+                grid->Step(points[i], 6, &neighbour3);
+                offset = Difference(grid->TileOrigin(points[i]), position);
+                previous = Difference(grid->TileOrigin(nearest), position);
+                if (BeachDistance(offset) < BeachDistance(previous) && !(BeachFlags(grid, points[i]) & 0x10) && !(BeachFlags(grid, neighbour0) & 0x10) && !(BeachFlags(grid, neighbour1) & 0x10) && !(BeachFlags(grid, neighbour2) & 0x10) && !(BeachFlags(grid, neighbour3) & 0x10))
+                {
+                    selected = route;
+                    nearest = ScreenPoint(points[i].x, points[i].y);
+                }
+            }
+        }
+        if (selected)
+        {
+            ScreenPoint lower = selected->Bounds()[0];
+            ScreenPoint upper = selected->Bounds()[3];
+            float width = upper.x - lower.x;
+            ScreenPoint tile;
+            tile.x = lower.x + static_cast<int>(width * (rand() * 3.0518509e-5f));
+            float height = upper.y - lower.y;
+            tile.y = lower.y + static_cast<int>(height * (rand() * 3.0518509e-5f));
+            grid->Step(tile, 0, &neighbour0);
+            grid->Step(neighbour0, 0, &neighbour0);
+            grid->Step(tile, 2, &neighbour1);
+            grid->Step(neighbour1, 2, &neighbour1);
+            grid->Step(tile, 4, &neighbour2);
+            grid->Step(neighbour2, 4, &neighbour2);
+            grid->Step(tile, 6, &neighbour3);
+            grid->Step(neighbour3, 6, &neighbour3);
+            for (;;)
+            {
+                unsigned int flags = BeachFlags(grid, tile);
+                if ((flags & 4) && !(flags & 0x10)
+                    && (BeachFlags(grid, neighbour0) & 0xc)
+                    && (BeachFlags(grid, neighbour1) & 0xc)
+                    && (BeachFlags(grid, neighbour2) & 0xc)
+                    && (BeachFlags(grid, neighbour3) & 0xc))
+                    break;
+                tile.x = lower.x + static_cast<int>(width * (rand() * 3.0518509e-5f));
+                tile.y = lower.y + static_cast<int>(height * (rand() * 3.0518509e-5f));
+                grid->Step(tile, 0, &neighbour0);
+                grid->Step(neighbour0, 0, &neighbour0);
+                grid->Step(tile, 2, &neighbour1);
+                grid->Step(neighbour1, 2, &neighbour1);
+                grid->Step(tile, 4, &neighbour2);
+                grid->Step(neighbour2, 4, &neighbour2);
+                // Retail steps the direction-six neighbour only once on each retry.
+                grid->Step(tile, 6, &neighbour3);
+            }
+            beach_walkpoints[0] = grid->TilePosition(nearest, 4);
+            beach_walkpoints[1] = grid->TileOrigin(tile);
+            return beach_walkpoints;
+        }
+    }
+    return 0;
+}
