+
+// FUNCTION: BEACHLIFE 0x004dea00
+int WorldSubsystem20::ParseFunctionAction()
+{
+    char token[64];
+    int count = ReadToken(token);
+    unsigned int* data = new unsigned int(9);
+    if (_stricmp(token, "PauseGame") == 0)
+        *data = 0;
+    else if (_stricmp(token, "ResumeGame") == 0)
+        *data = 1;
+    else if (_stricmp(token, "LockMap") == 0)
+        *data = 2;
+    else if (_stricmp(token, "UnlockMap") == 0)
+        *data = 3;
+    else if (_stricmp(token, "NoBreakDowns") == 0)
+        *data = 4;
+    else if (_stricmp(token, "AllowBreakDowns") == 0)
+        *data = 5;
+    else if (_stricmp(token, "UnlockNextScenario") == 0)
+        *data = 6;
+    else if (_stricmp(token, "Debug") == 0)
+        *data = 7;
+    else if (_stricmp(token, "NoLitter") == 0)
+        *data = 8;
+    else
+        StartupFatal("WorldScript::FunctionCommand - Invalid Function %s", token);
+    count += ReadToken(token);
+    Action* action = new Action;
+    if (action)
+    {
+        action->data_08 = data;
+        action->kind_04 = 0;
+        action->next = 0;
+    }
+    else
+        action = 0;
+    AppendAction(action);
+    return count;
+}
