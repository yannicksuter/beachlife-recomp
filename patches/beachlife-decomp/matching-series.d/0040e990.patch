+#include "startup_directdraw_surface.h"
+#include "startup_screen_item.h"
+#include "startup_screen_renderer.h"
+#include "surface_error_sink.h"
+
+// FUNCTION: BEACHLIFE 0x0040e990
+void ScreenRequestRenderer::BlitSurfaceRegion(const ScreenRectangle& destination, const ScreenRectangle& source, int surface)
+{
+    if (software_mode)
+    {
+        unsigned int key = fill_color;
+        if (source.left > source.right || source.right < 0 || source.top > source.bottom)
+        {
+            return;
+        }
+
+        ScreenSurfacePosition* image = surfaces[surface];
+        unsigned int source_pitch = image->pitch >> 1;
+        unsigned short* from = image->pixels + source.top * source_pitch;
+        unsigned int rows = source.bottom - source.top;
+        unsigned int columns = source.right - source.left;
+        current_surface = 0;
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+        {
+            return;
+        }
+
+        unsigned int pitch = surfaces[current_surface]->pitch >> 1;
+        unsigned short* row = pixels + destination.top * pitch + destination.left;
+        for (unsigned int line = 0; line < rows; ++line)
+        {
+            unsigned short* out = row;
+            const unsigned short* in = from + source.left;
+            for (unsigned int column = 0; column < columns; ++column)
+            {
+                unsigned short value = *in++;
+                if (value != key)
+                {
+                    *out = value;
+                }
+                ++out;
+            }
+            row += pitch;
+            from += source_pitch;
+        }
+
+        if (!software_mode)
+        {
+            DirectDrawSurface7Prefix* locked = surfaces[current_surface]->surface;
+            locked->vtable->Unlock(locked, 0);
+        }
+        pixels_locked = 0;
+        return;
+    }
+
+    int result = back_surface->vtable->Blt(back_surface,
+        reinterpret_cast<SurfaceApiRectangle*>(const_cast<ScreenRectangle*>(&destination)),
+        surfaces[surface]->surface,
+        reinterpret_cast<SurfaceApiRectangle*>(const_cast<ScreenRectangle*>(&source)),
+        0x01008000,
+        0);
+    if (result < 0)
+    {
+        IgnoreSurfaceError(result);
+    }
+}
