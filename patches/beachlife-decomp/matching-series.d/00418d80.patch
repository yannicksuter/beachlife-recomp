+#include "startup_screen_overlay_layout.h"
+#include "startup_screen_mode_world.h"
+#include "tga_image.h"
+
+// Bilinear terrain height at a map pixel from the terrain grid's height map, scaled by its height scale; zero
+// outside the map or without a height map.
+// FUNCTION: BEACHLIFE 0x00418d80
+float OverlayMapPrefix::HeightAt(int x, int y)
+{
+    if (x < 0 || x >= map_width_cc || y < 0 || y >= map_height_d0)
+        return 0.0f;
+    float result;
+    if (screen_terrain_grid->height_map_10 != 0)
+    {
+        TgaImage* map = screen_terrain_grid->height_map_10;
+        unsigned char* data = map->pixels;
+        int cell_width = map_width_cc / map->width;
+        int cell_height = map_height_d0 / map->height;
+        int grid_x = x / cell_width;
+        int grid_y = y / cell_height;
+        int fraction_x = x % cell_width;
+        float tx = (float)fraction_x / cell_width;
+        int fraction_y = y % cell_height;
+        float ty = (float)fraction_y / cell_height;
+        if (grid_x > map->width - 2)
+            grid_x = map->width - 2;
+        if (grid_y > map->height - 2)
+            grid_y = map->height - 2;
+        unsigned char h00 = data[grid_y * map->width + grid_x];
+        unsigned char h10 = data[(grid_y + 1) * map->width + grid_x];
+        unsigned char h01 = data[grid_y * map->width + grid_x + 1];
+        unsigned char h11 = data[(grid_y + 1) * map->width + grid_x + 1];
+        float top = (h01 - h00) * tx + h00;
+        float bottom = (h11 - h10) * tx + h10;
+        result = ((bottom - top) * ty + top) * screen_terrain_grid->height_scale_14;
+    }
+    else
+    {
+        result = 0.0f;
+    }
+    return result;
+}
