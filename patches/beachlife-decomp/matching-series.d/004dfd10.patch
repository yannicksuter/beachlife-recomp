+#include "startup_application.h"
+#include "startup_world_script_actions.h"
+#include "startup_world_subsystems.h"
+#include <stdlib.h>
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004dfd10
+int WorldSubsystem20::ParseAreaAction()
+{
+    char token[0x34];
+    WorldActionRouteData* data = new WorldActionRouteData;
+    int count = ReadToken(token);
+    if (_stricmp(token, "Beach") == 0)
+    {
+        data->kind_00 = 1;
+    }
+    else if (_stricmp(token, "Sea") == 0)
+    {
+        data->kind_00 = 2;
+    }
+    else
+    {
+        StartupFatal("Undefined Type in Area Command");
+    }
+    count += ReadToken(token);
+    int point_count = atoi(token);
+    data->points_08 = new ScreenPoint[point_count];
+    data->count_04 = 0;
+    int index;
+    for (index = 0; index < point_count; index++)
+    {
+        count += ReadToken(token);
+        const_cast<ScreenPoint*>(data->points_08)[data->count_04].x = atoi(token);
+        count += ReadToken(token);
+        const_cast<ScreenPoint*>(data->points_08)[data->count_04].y = atoi(token);
+        data->count_04++;
+    }
+    for (index = 0; index < 4; index++)
+    {
+        count += ReadToken(token);
+        data->words_0c[index * 2] = atoi(token);
+        count += ReadToken(token);
+        data->words_0c[index * 2 + 1] = atoi(token);
+    }
+    count += ReadToken(token);
+    Action* action = static_cast<Action*>(::operator new(sizeof(Action)));
+    AppendAction(action ? (action->data_08 = data, action->kind_04 = 16, action->next = 0, action) : 0);
+    return count;
+}
