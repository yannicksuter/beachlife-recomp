+#include "startup_resource_rasters.h"
+
+// Copies the clipped rectangle of a width-byte haze sprite into a byte buffer
+// at (x, y), keeping the larger value per byte. Sprite rows start at top and
+// columns at left, while the destination columns start at x itself.
+// FUNCTION: BEACHLIFE 0x004070a0
+void RasterWeatherHaze(unsigned char* destination, const unsigned char* source, unsigned short* pixels,
+    unsigned int pitch, int x, int y, int width, int height, int left, int top, int right, int bottom)
+{
+    unsigned char* row = destination + y * pitch;
+    source += width * top;
+    for (int rows = bottom - top; rows > 0; --rows)
+    {
+        int offset = x;
+        for (int column = left; column < right; ++column)
+        {
+            if (source[column] > row[offset])
+                row[offset] = source[column];
+            ++offset;
+        }
+        source += width;
+        row += pitch;
+    }
+}
