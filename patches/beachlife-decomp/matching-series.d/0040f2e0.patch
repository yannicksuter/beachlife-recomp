+#include "startup_screen_renderer.h"
+#include "tga_image.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0040f2e0
+void ScreenRequestRenderer::ResizeSurfaceImageEntries(
+    ScreenSurfacePosition* source, ScreenSurfacePosition* destination)
+{
+    if (software_mode)
+    {
+        TgaImage from(source->width, source->height);
+        TgaImage to(destination->width, destination->height);
+        unsigned char* source_pixels = reinterpret_cast<unsigned char*>(source->pixels);
+        unsigned char* destination_pixels = reinterpret_cast<unsigned char*>(destination->pixels);
+        from.pixels = source_pixels;
+        to.pixels = destination_pixels;
+        ResizeImages(&from, &to);
+        from.pixels = 0;
+        to.pixels = 0;
+    }
+    else
+    {
+        SurfaceDescription from_description;
+        SurfaceDescription to_description;
+        memset(&from_description, 0, sizeof(from_description));
+        from_description.size = 0x7c;
+        memset(&to_description, 0, sizeof(to_description));
+        to_description.size = 0x7c;
+        if (source->surface->vtable->Lock(source->surface, 0, &from_description, 0, 0) < 0)
+            return;
+        if (destination->surface->vtable->Lock(destination->surface, 0, &to_description, 0, 0) < 0)
+            return;
+
+        TgaImage from(source->pitch >> 1, source->height);
+        TgaImage to(destination->pitch >> 1, destination->height);
+        unsigned char* source_pixels = static_cast<unsigned char*>(from_description.pixels);
+        unsigned char* destination_pixels = static_cast<unsigned char*>(to_description.pixels);
+        from.pixels = source_pixels;
+        to.pixels = destination_pixels;
+        ResizeImages(&from, &to);
+        source->surface->vtable->Unlock(source->surface, 0);
+        destination->surface->vtable->Unlock(destination->surface, 0);
+        from.pixels = 0;
+        to.pixels = 0;
+    }
+}
