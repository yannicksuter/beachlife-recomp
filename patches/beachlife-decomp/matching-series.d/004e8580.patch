+// FUNCTION: BEACHLIFE 0x004e8580
+int GameWonController::Update()
+{
+    bool advance = false;
+    float delta = startup_frame_clock->delta_seconds;
+    if (delta > 0.1f)
+        delta = 0.1f;
+    elapsed += delta;
+    if (elapsed > 20.0f && stage != 8)
+        advance = true;
+    if (startup_input_state->ReadFirstButtonTransition() == 1 || advance)
+    {
+        elapsed = 0.0f;
+        ++stage;
+        if (stage >= 9)
+        {
+            screen_request_game->controller_selection.SelectPendingController(1);
+            screen_request_game->SetMenuReturnFlag(1);
+        }
+        else
+            ShowStage();
+    }
+    return 0;
+}
