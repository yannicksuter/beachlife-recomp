+#include "startup_resource_rasters.h"
+#include "render_mask_setup.h"
+
+// Draws an RLE-packed sprite whose source bytes carry a blend mode in their
+// top two bits and a palette index below them into four-byte pixels (blended colour minus 0x10000),
+// clipped like ResourceRaster1Packed: mode 0x00 is opaque, 0x40 three
+// quarters colour, 0x80 half colour, 0xc0 one quarter colour over the
+// destination pixel (render_half_mask/render_quarter_mask). The 0x100 case can
+// never be selected; retail still tests it.
+// FUNCTION: BEACHLIFE 0x00401df0
+void ResourceRasterAt00401df0(unsigned short* destination, const unsigned char* source, const unsigned short* palette,
+    unsigned int stride, int x, int y, int width, int height, int left, int top, int right, int bottom)
+{
+    int column;
+    int value;
+    unsigned char mode;
+    unsigned short pixel;
+    unsigned short color;
+    unsigned short result;
+    signed char packet;
+    unsigned int* row = reinterpret_cast<unsigned int*>(destination) + (stride * y + x);
+
+    // Nothing is clipped.
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int j = 0; j < height; j++)
+        {
+            unsigned int* output = row + j * stride;
+            column = 0;
+            while (column < width)
+            {
+                packet = *source++;
+                if (packet >= 0)
+                {
+                    while (packet--)
+                    {
+                        {
+                            value = *source;
+                            mode = value & 0xc0;
+                            pixel = *output;
+                            color = palette[(unsigned char)value - mode];
+
+                            switch (mode)
+                            {
+                            case 0x00:
+                                result = color;
+                                break;
+                            case 0x40:
+                                result = ((render_half_mask >> 1) & (color >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                                break;
+                            case 0x80:
+                                result = ((color >> 1) & (render_half_mask >> 1)) + ((pixel >> 1) & (render_half_mask >> 1));
+                                break;
+                            case 0xc0:
+                                result = ((render_half_mask >> 1) & (pixel >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                                break;
+                            case 0x100:
+                                result = pixel;
+                                break;
+                            }
+                            *output++ = result - 0x10000;
+                        }
+                        source++;
+                        column++;
+                    }
+                }
+                else
+                {
+                    output -= packet;
+                    column -= packet;
+                }
+            }
+        }
+        return;
+    }
+
+    // Left edge clipped: the first `left` pixels of every row are dropped.
+    if (left > 0)
+    {
+        for (int skip = top; skip > 0; skip--)
+        {
+            column = 0;
+            while (column < width)
+            {
+                packet = *source++;
+                if (packet >= 0)
+                {
+                    column += packet;
+                    source += packet;
+                }
+                else
+                {
+                    column -= packet;
+                }
+            }
+        }
+
+        for (int j = 0; j < bottom - top; j++)
+        {
+            unsigned int* output = row + j * stride;
+            int remaining_left = left;
+            column = 0;
+            while (column < width)
+            {
+                packet = *source++;
+                if (packet >= 0)
+                {
+                    while (packet--)
+                    {
+                        if (remaining_left != 0)
+                            remaining_left--;
+                        else
+                        {
+                            value = *source;
+                            mode = value & 0xc0;
+                            pixel = *output;
+                            color = palette[(unsigned char)value - mode];
+
+                            switch (mode)
+                            {
+                            case 0x00:
+                                result = color;
+                                break;
+                            case 0x40:
+                                result = ((render_half_mask >> 1) & (color >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                                break;
+                            case 0x80:
+                                result = ((color >> 1) & (render_half_mask >> 1)) + ((pixel >> 1) & (render_half_mask >> 1));
+                                break;
+                            case 0xc0:
+                                result = ((render_half_mask >> 1) & (pixel >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                                break;
+                            case 0x100:
+                                result = pixel;
+                                break;
+                            }
+                            *output++ = result - 0x10000;
+                        }
+                        source++;
+                        column++;
+                    }
+                }
+                else
+                {
+                    packet = -packet;
+                    while (remaining_left != 0 && packet != 0)
+                    {
+                        remaining_left--;
+                        column++;
+                        packet--;
+                    }
+                    output += packet;
+                    column += packet;
+                }
+            }
+        }
+        return;
+    }
+
+    // Top, right or bottom edge clipped: pixels from `right` on are dropped.
+    for (int skip = top; skip > 0; skip--)
+    {
+        column = 0;
+        while (column < width)
+        {
+            packet = *source++;
+            if (packet >= 0)
+            {
+                column += packet;
+                source += packet;
+            }
+            else
+            {
+                column -= packet;
+            }
+        }
+    }
+
+    for (int j = 0; j < bottom - top; j++)
+    {
+        unsigned int* output = row + j * stride;
+        column = 0;
+        while (column < width)
+        {
+            packet = *source++;
+            if (packet >= 0)
+            {
+                while (packet--)
+                {
+                    if (column < right)
+                    {
+                        value = *source;
+                        mode = value & 0xc0;
+                        pixel = *output;
+                        color = palette[(unsigned char)value - mode];
+
+                        switch (mode)
+                        {
+                        case 0x00:
+                            result = color;
+                            break;
+                        case 0x40:
+                            result = ((render_half_mask >> 1) & (color >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                            break;
+                        case 0x80:
+                            result = ((color >> 1) & (render_half_mask >> 1)) + ((pixel >> 1) & (render_half_mask >> 1));
+                            break;
+                        case 0xc0:
+                            result = ((render_half_mask >> 1) & (pixel >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                            break;
+                        case 0x100:
+                            result = pixel;
+                            break;
+                        }
+                        *output++ = result - 0x10000;
+                    }
+                    source++;
+                    column++;
+                }
+            }
+            else
+            {
+                if (column < right)
+                    output -= packet;
+                column -= packet;
+            }
+        }
+    }
+}
