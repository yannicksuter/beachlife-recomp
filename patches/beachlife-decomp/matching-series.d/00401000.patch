+#include "render_mask_setup.h"
+
+// Selects the 16-bit pixel masks and shifts for RGB565 (format 0) or RGB555 and derives the blend biases.
+// FUNCTION: BEACHLIFE 0x00401000
+void SetupRenderMasks(unsigned short* pixels, unsigned int width, unsigned int format)
+{
+    if (format == 0)
+    {
+        render_quarter_mask = 0xE79C;
+        render_half_mask = 0xF7DE;
+        render_red_mask = 0xF800;
+        render_green_mask = 0x7E0;
+        render_blue_mask = 0x1F;
+        render_red_shift = 0xB;
+        render_green_bits = 6;
+        render_green_levels = 0x3F;
+        render_full_mask = 0xFFFF;
+    }
+    else
+    {
+        render_quarter_mask = 0x739C;
+        render_half_mask = 0x7BDE;
+        render_red_mask = 0x7C00;
+        render_green_mask = 0x3E0;
+        render_blue_mask = 0x1F;
+        render_red_shift = 0xA;
+        render_green_bits = 5;
+        render_green_levels = 0x1F;
+        render_full_mask = 0x7FFF;
+    }
+    render_sum_bias = (unsigned short)((render_quarter_mask >> 2) + (render_half_mask >> 1));
+    render_half_bias = render_half_mask >> 1;
+    render_quarter_bias = render_quarter_mask >> 2;
+    render_mask_format = format;
+    render_mask_pixels = pixels;
+    render_mask_width = width;
+}
