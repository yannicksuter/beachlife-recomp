+
+// FUNCTION: BEACHLIFE 0x004cd7b0
+void DrawAppealStars(const char* resource, ScreenRectangle bounds, int count)
+{
+    ScreenDialogResource* image = screen_dialog_resources->Find(resource);
+    int width = image->SelectedFrame()->width_0e;
+    unsigned int threshold = 0;
+    unsigned int half = 10;
+    int x = bounds.left;
+    for (int remaining = 5; remaining != 0; --remaining)
+    {
+        image->SelectVariant(0);
+        if (static_cast<unsigned int>(count) > threshold)
+            image->SelectVariant(1);
+        if (static_cast<unsigned int>(count) > half)
+            image->SelectVariant(2);
+        image->Draw(x, bounds.top, 0, 999999.0f);
+        x += width;
+        threshold += 20;
+        half = threshold + 10;
+    }
+    screen_dialog_resources->Release(image);
+}
