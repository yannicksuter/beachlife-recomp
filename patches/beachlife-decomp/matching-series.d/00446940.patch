+#include "startup_screen_terrain_inlines.h"
+#include "startup_screen_overlay_layout.h"
+
+static inline ScreenWorldPosition TileCorner(ScreenTerrainGrid* grid, ScreenPoint tile)
+{
+    ScreenWorldPosition position = grid->TileOrigin(tile);
+    position.y += static_cast<unsigned int>(grid->tile_size_00 - 1);
+    return position;
+}
+
+static inline ScreenWorldPosition TileCentre(ScreenTerrainGrid* grid, ScreenPoint tile)
+{
+    ScreenWorldPosition position = grid->TileOrigin(tile);
+    position.x += static_cast<unsigned int>(grid->tile_size_00) >> 1;
+    position.y += static_cast<unsigned int>(grid->tile_size_00) >> 1;
+    return position;
+}
+
+static inline void CopyPosition(ScreenWorldPosition& to, const ScreenWorldPosition& from)
+{
+    to.x = from.x;
+    to.y = from.y;
+    to.z = from.z;
+}
+
+// FUNCTION: BEACHLIFE 0x00446940
+ScreenMapPosition ScreenTerrainGrid::BuildingOffset(
+    ScreenPoint tile, unsigned int width, unsigned int height, ScreenMapPosition offset, unsigned int rotation)
+{
+    int remaining;
+    ScreenPoint current = tile;
+    ScreenWorldPosition position;
+    switch (rotation)
+    {
+    case 0:
+        CopyPosition(position, TileCorner(screen_terrain_grid, current));
+        position.x += offset.x;
+        position.y += offset.y;
+        break;
+    case 1:
+        for (remaining = width - 1; remaining > 0; --remaining)
+            screen_terrain_grid->Step(current, 0, &current);
+        CopyPosition(position, TileCentre(screen_terrain_grid, current));
+        position.x += offset.y;
+        position.y -= offset.x;
+        overlay_map->WorldToScreen(position);
+        break;
+    case 2:
+        for (remaining = height - 1; remaining > 0; --remaining)
+            screen_terrain_grid->Step(current, 0, &current);
+        for (remaining = width - 1; remaining > 0; --remaining)
+            screen_terrain_grid->Step(current, 6, &current);
+        position = screen_terrain_grid->TilePosition(current, 0);
+        position.x -= offset.x;
+        position.y -= offset.y;
+        break;
+    case 3:
+        for (remaining = height - 1; remaining > 0; --remaining)
+            screen_terrain_grid->Step(current, 6, &current);
+        position = screen_terrain_grid->TilePosition(current, 2);
+        position.x -= offset.y;
+        position.y += offset.x;
+        break;
+    }
+    ScreenMapPosition result;
+    result.x = position.x;
+    result.y = position.y;
+    return result;
+}
