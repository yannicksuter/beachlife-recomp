+// FUNCTION: BEACHLIFE 0x004556d0
+void WorldBuilderEntity::FindHomePoint()
+{
+    unsigned int count;
+    VariableEntity** guests = variable_world->ByType(3, &count);
+    bool found = false;
+    for (unsigned int i = 0; i < count; ++i)
+    {
+        ScreenPoint guest = guests[i]->TilePosition();
+        ScreenPoint builder = TilePosition();
+        if (abs(guest.x - builder.x) <= 2.0f && abs(guest.y - builder.y) <= 2.0f
+            && guests[i]->AsGuest()->guest_f4->word_1c4 == 1 && world_builders_whistling < 2)
+        {
+            ++world_builders_whistling;
+            found = true;
+            ScreenModeCommand command;
+            command.words[0] = id_28;
+            command.words[1] = id_28;
+            command.words[2] = 0x36;
+            command.words[3] = 0;
+            command.words[4] = 0;
+            command.words[6].number = 0.0f;
+            command.words[5] = 103;
+            screen_mode_commands->QueueCommand(&command);
+        }
+    }
+    if (!found)
+    {
+        ScreenModeCommand command;
+        command.words[0] = id_28;
+        command.words[1] = id_28;
+        command.words[2] = 0x3c;
+        command.words[3] = 0;
+        command.words[4] = 0;
+        command.words[6].number = 0.0f;
+        command.words[5] = 103;
+        screen_mode_commands->QueueCommand(&command);
+    }
+}
