+void WindowAudioState::UpdateVoiceFades(float delta)
+{
+    for (int index = 0; index < 24; ++index)
+    {
+        WindowSoundVoice*& current = index < 16 ? voices_74[index] : voices_b4[index - 16];
+        void*& sample = index < 16 ? samples_14[index] : samples_54[index - 16];
+        WindowSoundVoice* voice = current;
+        if (!voice || !voice->word_10)
+        {
+            continue;
+        }
+
+        // FST stores binary32 without popping the value used by FCOMP.
+        float remaining = static_cast<float>(voice->fade_28) - static_cast<float>(delta);
+        voice->fade_28 = static_cast<float>(remaining);
+        if (!(remaining >= 0.0f))
