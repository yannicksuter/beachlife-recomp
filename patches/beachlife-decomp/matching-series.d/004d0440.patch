+            int converted_volume = static_cast<int>(voice->volume_18);
+            if (current)
+            {
+                if (index >= 16)
+                {
+                    AIL_set_3D_sample_volume(sample, converted_volume);
+                }
+                else
+                {
+                    AIL_set_sample_volume(sample, converted_volume);
+                }
+            }
+
+            if (voice->word_10 == 2 && index >= 0 && current)
+            {
+                if (index >= 16)
+                {
+                    if (enabled_3d)
+                        AIL_end_3D_sample(sample);
+                }
+                else
+                {
+                    AIL_end_sample(sample);
+                }
+            }
+            voice->word_10 = 0;
+        }
+        else
+        {
+            float volume = voice->volume_18 - voice->word_1c;
+            volume /= static_cast<float>(voice->fade_24);
+            volume *= static_cast<float>(delta);
+            volume += static_cast<float>(voice->word_20);
+            // The following _ftol consumes the retained value, not this store.
+            voice->word_20 = static_cast<float>(volume);
+            int converted_volume = static_cast<int>(volume);
+            if (current)
+            {
+                if (index >= 16)
+                {
+                    AIL_set_3D_sample_volume(sample, converted_volume);
+                }
+                else
+                {
+                    AIL_set_sample_volume(sample, converted_volume);
+                }
+            }
+        }
+    }
+}
