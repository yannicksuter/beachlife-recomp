+#include "startup_world_subsystems.h"
+#include "startup_world_entities.h"
+#include "startup_screen_text.h"
+#include "window_activation.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static inline WindowDeactivationState* Activation()
+{
+    return window_deactivation_state;
+}
+
+// FUNCTION: BEACHLIFE 0x00424900
+unsigned int WorldSubsystem4c::FindGuestFeature(unsigned int* feature, unsigned char* found, unsigned int* broken,
+    unsigned int* closed, unsigned int* beach_closed, unsigned char* unavailable, unsigned int gender,
+    unsigned int desire, const ScreenPoint* tile, unsigned int previous, unsigned int guest)
+{
+    if (counts_6c[desire])
+    {
+        *broken = 0;
+        bool selected = false;
+        unsigned char has_unavailable = 0;
+        // Retail only assigns the selection words when a candidate is chosen.
+        struct
+        {
+            float score;
+            unsigned int id;
+            unsigned int feature;
+        } best;
+        best.score = -1.0f;
+        for (unsigned int i = 0; i < counts_6c[desire]; ++i)
+        {
+            WorldBuildingEntity* building = variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding();
+            if (building->id_28 != previous)
+            {
+                bool available = FeatureUnavailable(data_04[desire][i].id_00, data_04[desire][i].index_04);
+                if (building->FlagAt00460370() && available)
+                {
+                    const ScreenPoint& candidate = data_04[desire][i].tile_0c;
+                    float distance = static_cast<float>(abs(tile->y - candidate.y) + abs(tile->x - candidate.x));
+                    float rating;
+                    if (gender == 0)
+                        rating = building->FeatureRating(data_04[desire][i].index_04, 0);
+                    else
+                        rating = building->FeatureRating(data_04[desire][i].index_04, 1);
+                    float random = static_cast<float>(rand()) * 3.0518509447574615e-5f;
+                    random *= -0.0009000000427477062f;
+                    float score = 1.0f - distance * 0.00390625f + random + rating + 0.0010000000474974513f;
+                    if (score > best.score)
+                    {
+                        best.score = score;
+                        best.id = data_04[desire][i].id_00;
+                        best.feature = data_04[desire][i].index_04;
+                        selected = true;
+                    }
+                    continue;
+                }
+
+                float condition = static_cast<float>(static_cast<int>(3u - building->power_state_33c)) * 0.33f;
+                // Retail compares the scaled condition with 3.0f, so the broken branch never runs.
+                if (condition == 3.0f)
+                {
+                    char key[252];
+                    if (!selected)
+                        best.id = data_04[desire][i].id_00;
+                    ++*broken;
+                    strcpy(key, "GUEST_THOUGHT_BROKEN_");
+                    strcat(key, variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding()->building_60->name_04);
+                    char number[2];
+                    _itoa(rand() % 3 + 1, number, 10);
+                    strcat(key, number);
+                    const unsigned short* text = screen_text_lookup->LookupText(key);
+                    static_cast<WorldBuildingEntity*>(variable_world->FindObject(data_04[desire][i].id_00))
+                        ->AddThought(text, guest);
+                }
+                else if (building->FlagAt00460380())
+                {
+                    char key[252];
+                    if (!selected && !*broken)
+                        best.id = data_04[desire][i].id_00;
+                    ++*closed;
+                    strcpy(key, "GUEST_THOUGHT_CLOSED_");
+                    strcat(key, variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding()->building_60->name_04);
+                    char number[2];
+                    _itoa(rand() % 3 + 1, number, 10);
+                    strcat(key, number);
+                    const unsigned short* text = screen_text_lookup->LookupText(key);
+                    static_cast<WorldBuildingEntity*>(variable_world->FindObject(data_04[desire][i].id_00))
+                        ->AddThought(text, guest);
+                }
+                else if (!available)
+                {
+                    char key[252];
+                    if (!selected && !*broken && !*closed)
+                    {
+                        best.id = data_04[desire][i].id_00;
+                        best.feature = data_04[desire][i].index_04;
+                    }
+                    ++*beach_closed;
+                    strcpy(key, "GUEST_THOUGHT_BEACH_CLOSED_");
+                    building = variable_world->FindObject(data_04[desire][i].id_00)->AsBuilding();
+                    unsigned int kind = building->building_60->features_1fc[data_04[desire][i].index_04];
+                    strcat(key, variable_catalog->FeatureKey(kind));
+                    char number[2];
+                    _itoa(rand() % 3 + 1, number, 10);
+                    strcat(key, number);
+                    const unsigned short* text = screen_text_lookup->LookupText(key);
+                    static_cast<WorldBuildingEntity*>(variable_world->FindObject(data_04[desire][i].id_00))
+                        ->AddThought(text, guest);
+                }
+                else
+                    has_unavailable = 1;
+            }
+            else if (!selected)
+                has_unavailable = 1;
+        }
+        if (selected)
+        {
+            *found = 1;
+            *feature = best.feature;
+            *unavailable = 0;
+            return best.id;
+        }
+        *feature = best.feature;
+        *unavailable = has_unavailable;
+        *found = 0;
+        return best.id;
+    }
+    else
+    {
+        if (desire != 10 || Activation()->CanBuild(variable_catalog->FindBuilding("SOUVSHOP")))
+            ++messages_d4[desire];
+        *found = 0;
+        *unavailable = 0;
+        *broken = 0;
+        *closed = 0;
+        *beach_closed = 0;
+        return 0;
+    }
+}
