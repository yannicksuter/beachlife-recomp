+#include "startup_world_entities.h"
+#include "startup_variable_state.h"
+#include "window_activation.h"
+
+// FUNCTION: BEACHLIFE 0x004885f0
+void WorldRepresentativeEntity::UpdateFeedback()
+{
+    if (feedback_870[1] != 0)
+        return;
+    unsigned int flag;
+    // Retail tests the feedback mask against the row index.
+    unsigned int shown = window_deactivation_state->ticker_30->Feedback(9);
+    if (!(feedback_870[0] & shown))
+    {
+        variable_world->CountType(3);
+        unsigned int count;
+        if (guest_opinion_8a8 < 2)
+        {
+            count = values_77c[feedback_870[0] * 5 + 1] + values_77c[feedback_870[0] * 5];
+            switch (feedback_870[0])
+            {
+            case 0:
+                flag = 0x2;
+                break;
+            case 1:
+                flag = 0x4;
+                break;
+            case 2:
+                flag = 0x8;
+                break;
+            case 3:
+                flag = 0x10;
+                break;
+            case 4:
+                flag = 0x20;
+                break;
+            case 5:
+                flag = 0x40;
+                break;
+            case 6:
+                flag = 0x80;
+                break;
+            }
+        }
+        else
+        {
+            count = values_77c[feedback_870[0] * 5 + 3] + values_77c[feedback_870[0] * 5 + 4];
+            switch (feedback_870[0])
+            {
+            case 0:
+                flag = 0x100;
+                break;
+            case 1:
+                flag = 0x200;
+                break;
+            case 2:
+                flag = 0x400;
+                break;
+            case 3:
+                flag = 0x800;
+                break;
+            case 4:
+                flag = 0x1000;
+                break;
+            case 5:
+                flag = 0x2000;
+                break;
+            case 6:
+                flag = 0x4000;
+                break;
+            }
+        }
+        if (count > 5)
+        {
+            window_deactivation_state->ticker_30->AddFeedback(flag, 9);
+            VariableTicker* ticker = window_deactivation_state->ticker_30;
+            ticker->AddMessage(Notification(flag), id_28, 7);
+            if (guest_opinion_8a8 < 2)
+            {
+                values_77c[feedback_870[0] * 5] = 0;
+                values_77c[feedback_870[0] * 5 + 1] = 0;
+            }
+            else
+            {
+                // Retail clears columns 2 and 3, although it sums 3 and 4.
+                values_77c[feedback_870[0] * 5 + 2] = 0;
+                values_77c[feedback_870[0] * 5 + 3] = 0;
+            }
+        }
+        feedback_870[1] = 1;
+        feedback_870[0] &= ~feedback_870[0];
+    }
+    if (!(feedback_870[0] & 0x800000) && morale_10c < 0.6f)
+    {
+        feedback_870[0] |= 0x800000;
+        feedback_870[1] |= 0x800000;
+        VariableTicker* ticker = window_deactivation_state->ticker_30;
+        ticker->AddMessage(Notification(0x100000), id_28, 7);
+        AddThought(0x800000);
+    }
+}
