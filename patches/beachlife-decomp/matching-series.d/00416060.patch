+
+// FUNCTION: BEACHLIFE 0x00416060
+void ScreenDialogResource::DrawTerrain(const ScreenWorldPosition* position,
+    unsigned int width, unsigned int height)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    OverlayMapPrefix* map = overlay_map;
+    ScreenDialogResourceRecord* resource = record;
+    ScreenPoint screen = map->WorldToScreen(*position);
+    screen.x -= 31;
+    screen.y -= 32;
+    ScreenPoint first;
+    first = grid->WorldToTile(*position);
+    ScreenPoint last = first;
+    for (int count = static_cast<int>(width - 1); count > 0; --count)
+        grid->Step(last, 0, &last);
+    for (int height_count = static_cast<int>(height - 1); height_count > 0; --height_count)
+        grid->Step(last, 6, &last);
+    unsigned int first_depth = map->DepthAt(&grid->TilePosition(last, 0));
+    unsigned int last_depth = map->DepthAt(&grid->TilePosition(first, 1));
+    float difference = static_cast<float>(static_cast<int>(last_depth - first_depth));
+    float clock = window_deactivation_state->clock_158;
+    resource->frames[0]->time_04 = clock;
+    screen.x += map->scroll_x_c4;
+    screen.y += map->scroll_y_c8;
+    int size = map->tile_size_dc;
+    DrawTerrainTiles(screen.x / size, screen.y / size, screen.x % size, screen.y % size, difference * 0.004f, first_depth);
+}
