+#include "tga_image.h"
+#include "tiff_read_context.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+// Decodes every PackBits strip into the image pixels through one buffer of the largest strip size.
+// FUNCTION: BEACHLIFE 0x004eb610
+void TiffDecodePackBits(TgaImage* image, TiffReadContext* context)
+{
+    int height = image->height;
+    unsigned int last_rows = height % context->rows_per_strip;
+    if (last_rows == 0)
+        last_rows = context->rows_per_strip;
+    int row_bytes = image->bytes_per_pixel * image->width;
+
+    unsigned int compressed_size = 0;
+    int strip_count = static_cast<int>(context->strip_count);
+    for (int scan = 0; scan < strip_count; ++scan)
+    {
+        unsigned int count = context->strip_byte_counts[scan];
+        if (count > compressed_size)
+            compressed_size = count;
+    }
+    unsigned char* buffer = static_cast<unsigned char*>(malloc(compressed_size));
+    for (int strip = 0; strip < static_cast<int>(context->strip_count); ++strip)
+    {
+        fseek(context->file, context->strip_offsets[strip], SEEK_SET);
+        fread(buffer, context->strip_byte_counts[strip], 1, context->file);
+        int strip_rows;
+        if (static_cast<unsigned int>(strip) == context->strip_count - 1u)
+            strip_rows = static_cast<int>(last_rows);
+        else
+            strip_rows = static_cast<int>(context->rows_per_strip);
+
+        unsigned char* source = buffer;
+        for (int row = 0; row < strip_rows; ++row)
+        {
+            int produced = 0;
+            unsigned char* destination = image->pixels + (context->rows_per_strip * strip + row) * row_bytes;
+            while (produced < row_bytes)
+            {
+                signed char control = static_cast<signed char>(*source++);
+                if (control >= 0 && control <= 0x7F)
+                {
+                    while (control-- + 1 != 0)
+                    {
+                        *destination++ = *source++;
+                        ++produced;
+                    }
+                }
+                else if (control != -128)
+                {
+                    unsigned char count = static_cast<unsigned char>(1 - control);
+                    while (count-- != 0)
+                    {
+                        *destination++ = *source;
+                        ++produced;
+                    }
+                    ++source;
+                }
+            }
+        }
+    }
+    free(buffer);
+}
