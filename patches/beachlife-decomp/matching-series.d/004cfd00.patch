+#include "miles_imports.h"
+#include <stdio.h>
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004cfd00
+int WindowAudioState::FindVoice(const char* name)
+{
+    int result = -1;
+    if (!enabled)
+        return -1;
+    char filename[64];
+    sprintf(filename, "%s%s", name, window_sound_wave_extension);
+    for (int i = 0; i < 24; ++i)
+    {
+        WindowSoundVoice* voice = voices[i];
+        if (voice && _stricmp(voice->name, filename) == 0)
+        {
+            result = i;
+            break;
+        }
+    }
+    return result;
+}
