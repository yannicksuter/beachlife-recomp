+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_button.h"
+#include "startup_screen_text.h"
+
+// FUNCTION: BEACHLIFE 0x004abfe0
+void GuiParserState::ParseButton()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (
+            data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        char first_name[64];
+        ReadText(first_name);
+        char second_name[64];
+        ReadText(second_name);
+        char first_action[64];
+        ReadText(first_action);
+        char second_action[64];
+        ReadText(second_action);
+        ScreenButtonPrefix* item = new ScreenButtonPrefix(rectangle, first_name, second_name, first_action, second_action);
+        RegisterItem(item, 0);
+
+        data = buffer;
+        if (data[cursor - 1] == ',')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            char text[64];
+            ReadText(text);
+            item->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_button - Script Error \r\nNo open bracket found at file "
+                     "offset - %u",
+            cursor);
+    }
+}
