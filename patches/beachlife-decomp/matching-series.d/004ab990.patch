+// FUNCTION: BEACHLIFE 0x004ab990
+void GuiParserState::ParseMainItem()
+{
+    if (screen_request_renderer->width < 800u)
+    {
+        const char* data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+        if (data[cursor] == '{')
+        {
+            ++cursor;
+            unsigned int nesting = 1;
+            do
+            {
+                if (data[cursor] == '{')
+                    ++nesting;
+                if (data[cursor] == '}')
+                    --nesting;
+                ++cursor;
+            } while (nesting != 0);
+        }
+        return;
+    }
+
+    ScreenRectangle rectangle;
+    rectangle.right = 0;
+    rectangle.left = 0;
+    rectangle.top = 0;
+    rectangle.bottom = 0;
+    ScreenFrameItem* item = new ScreenFrameItem(rectangle, 0);
+    manager->item_90 = item;
+    const char* data = buffer;
+    while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+    if (data[cursor] == '{')
+    {
+        PushContext(item);
+        ++cursor;
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_main - Script Error \r\nNo open brace found at file offset - %u", cursor);
+    }
+}
