+#include "startup_world_entities.h"
+#include "startup_screen_mode_world.h"
+#include "startup_screen_overlay_layout.h"
+#include "startup_screen_position_inlines.h"
+#include <stdlib.h>
+
+static inline float RandomUnit()
+{
+    return rand() * (1.0f / 32767);
+}
+
+static inline void RandomPosition(ScreenWorldPosition& position)
+{
+    float random = RandomUnit();
+    position.x = random * 3998.0f + 1.0f;
+    random = RandomUnit();
+    position.y = random * 7998.0f + 1.0f;
+    position.z = 0.0f;
+}
+
+// FUNCTION: BEACHLIFE 0x00468990
+ScreenWorldPosition WorldGuestEntity::RandomWalkPosition()
+{
+    ScreenWorldPosition position;
+    RandomPosition(position);
+    ScreenPoint* found;
+    {
+        found = &overlay_map->WorldToTile(&position);
+    }
+    unsigned int x = found->x;
+    unsigned int y = found->y;
+    for (;;)
+    {
+        ScreenTerrainGrid* terrain = screen_terrain_grid;
+        unsigned int flags = terrain->cells_0c[(y % terrain->height_08) * terrain->width_04 + x % terrain->width_04].flags_48;
+        if ((flags & 0x10000082) && !(flags & 0x8010))
+            break;
+        RandomPosition(position);
+        found = &overlay_map->WorldToTile(&position);
+        x = found->x;
+        y = found->y;
+    }
+    return position;
+}
