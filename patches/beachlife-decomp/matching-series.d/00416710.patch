+
+extern float fast_reciprocal_two;
+// Retail loads the zero result as the single-precision 0.0f literal; VC6
+// widens a float literal returned as double, so the source names it (compared
+// as that literal, comparison_literal_copies).
+extern const float fast_square_root_zero = 0.0f;
+
+// Table square root (fastmath fastsqrt); the double result stays on the FPU.
+static inline double FastSquareRoot(float value)
+{
+    unsigned int& bits = *reinterpret_cast<unsigned int*>(&value);
+    if (bits == 0)
+        return fast_square_root_zero;
+    bits = square_root_mantissas[(bits >> 8) & 0xffff] | ((((bits - 0x3f800000) >> 1) + 0x3f800000) & 0x7f800000);
+    return value;
+}
+
+// FUNCTION: BEACHLIFE 0x00416710
+void ScreenDialogResource::FacePositions(ScreenWorldPosition first, ScreenWorldPosition second)
+{
+    ScreenMapPosition direction;
+    direction.x = first.x - second.x;
+    direction.y = first.y - second.y;
+    float root = static_cast<float>(FastSquareRoot(direction.y * direction.y + direction.x * direction.x));
+    float inverse;
+    // Fastmath reciprocal estimate refined by one Newton step.
+    __asm
+        {
+        mov eax, 0x7f000000
+        sub eax, dword ptr [root]
+        mov dword ptr [inverse], eax
+        fld dword ptr [root]
+        fmul dword ptr [inverse]
+        fsubr dword ptr [fast_reciprocal_two]
+        fmul dword ptr [inverse]
+        fstp dword ptr [inverse]
+        }
+    direction.x *= inverse;
+    direction.y *= inverse;
+    FaceDirection(direction);
+}
