+// Retail expands these WorldSubsystem20 helpers inline here.
+static inline int SkipStateWhitespace(WorldSubsystem20* script)
+{
+    int count = 0;
+    while (*script->cursor_00 == ' ' || *script->cursor_00 == '\r' || *script->cursor_00 == '\n'
+           || *script->cursor_00 == '\t')
+    {
+        count++;
+        script->cursor_00++;
+    }
+    return count;
+}
+
+static inline int SkipStateComments(WorldSubsystem20* script)
+{
+    int count = 0;
+    if (*script->cursor_00 == '/')
+    {
+        script->cursor_00++;
+        count = 1;
+        if (*script->cursor_00 != '\n')
+        {
+            do
+            {
+                count++;
+                script->cursor_00++;
+            } while (*script->cursor_00 != '\n');
+        }
+        int leading = 0;
+        while (*script->cursor_00 == ' ' || *script->cursor_00 == '\r' || *script->cursor_00 == '\n'
+               || *script->cursor_00 == '\t')
+        {
+            leading++;
+            script->cursor_00++;
+        }
+        count += script->SkipComments() + leading;
+        int trailing = 0;
+        while (*script->cursor_00 == ' ' || *script->cursor_00 == '\r' || *script->cursor_00 == '\n'
+               || *script->cursor_00 == '\t')
+        {
+            trailing++;
+            script->cursor_00++;
+        }
+        count += trailing;
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x004e1d10
+int WorldSubsystem20::ReadToken(char* token)
+{
+    int count = SkipStateWhitespace(this);
+    count += SkipStateComments(this);
+    if (*cursor_00 == ';')
+    {
+        token[0] = ';';
+        ++count;
+        ++cursor_00;
+        token[1] = 0;
+    }
+    else
+    {
+        while (1)
+        {
+            if (*cursor_00 == ' ' || *cursor_00 == '\n' || *cursor_00 == '\t' || *cursor_00 == '\r')
+                break;
+            ++count;
+            *token++ = *cursor_00;
+            if (*++cursor_00 == ';')
+                break;
+        }
+        *token = 0;
+    }
+    return count;
+}
