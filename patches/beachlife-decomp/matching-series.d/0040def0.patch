+int ScreenRequestRenderer::CreateSurface(int width, int height, int mode)
+{
+    ScreenSurfacePosition* selected = 0;
+    int result;
+    for (unsigned int i = 0; i < surfaces.size(); ++i)
+    {
+        if (surfaces[i]->active == 0)
+        {
+            selected = surfaces[i];
+            result = i;
+            break;
+        }
+    }
+    if (selected != 0)
+    {
+        selected->active = 1;
+    }
+    else
+    {
+        selected = new ScreenSurfacePosition;
+        result = surfaces.size();
+        surfaces.push_back(selected);
+    }
+    InitializeSurface(width, height, selected, static_cast<unsigned char>(mode));
+    return result;
+}
