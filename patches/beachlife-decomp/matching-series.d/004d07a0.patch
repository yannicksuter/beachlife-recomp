+
+// Retail expands the comment skipper (0x004d0d40) here twice; its recursion
+// and, in the '/' command's copy, its whitespace calls stay out of line.
+static inline int SkipLeadingComments(AnimationSoundLookup* lookup, const char* data)
+{
+    int offset = 0;
+    offset += lookup->SkipWhitespace(data);
+    if (data[offset] == '/')
+    {
+        ++offset;
+        while (data[offset] != '\n')
+            ++offset;
+        offset += lookup->SkipWhitespace(data + offset);
+        offset += lookup->SkipComments(data + offset);
+        offset += lookup->SkipWhitespace(data + offset);
+    }
+    return offset;
+}
+
+// Groups: index/limit token pairs up to "End".
+static inline int ReadGroups(AnimationSoundLookup* lookup, const char* data)
+{
+    char value[52];
+    int offset = lookup->SkipWhitespace(data);
+    offset += lookup->ReadToken(value, data + offset);
+    if (strcmp(value, "End"))
+    {
+        do
+        {
+            int index = atoi(value);
+            offset += lookup->ReadToken(value, data + offset);
+            lookup->limits_51c[index] = atoi(value);
+            offset += lookup->ReadToken(value, data + offset);
+        } while (strcmp(value, "End"));
+    }
+    return offset;
+}
+
+// FUNCTION: BEACHLIFE 0x004d07a0
+void AnimationSoundLookup::Load(const char* filename)
+{
+    int offset = 0;
+    unsigned int length = strlen(filename);
+    char* path = static_cast<char*>(::operator new(length + 1));
+    strcpy(path, filename);
+    path[length - 4] = '.';
+    path[length - 3] = 'b';
+    path[length - 2] = 'l';
+    path[length - 1] = 'e';
+    int size = GetFileSize(path);
+    char* data = LoadBleFile(path);
+    ::operator delete(path);
+    char token[52];
+    while (size > offset)
+    {
+        offset += SkipWhitespace(data + offset);
+        offset += SkipLeadingComments(this, data + offset);
+        if (size <= offset)
+            break;
+        offset += ReadToken(token, data + offset);
+        if (!strcmp(token, "SpriteSounds"))
+            offset += ParseSpriteSounds(data + offset);
+        else if (!strcmp(token, "BuildingSounds"))
+            offset += ParseBuildingSounds(data + offset);
+        else if (!strcmp(token, "CrowdSound"))
+            offset += ParseCrowdSound(data + offset);
+        else if (!strcmp(token, "OpinionSounds"))
+            offset += ParseOpinionSounds(data + offset);
+        else if (!strcmp(token, "Groups"))
+            offset += ReadGroups(this, data + offset);
+        else if (token[0] == '/')
+            offset += SkipLeadingComments(this, data + offset);
+        else
+            StartupFatal("Invalid Command Recieved in ScriptedSound %s", token);
+    }
+    ::operator delete(data);
+}
