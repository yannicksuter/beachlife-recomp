+    reinterpret_cast<unsigned int*>(unknown_20)[1] = 0;
+    drink_count_28 = 0;
+    reinterpret_cast<unsigned int*>(unknown_2c)[0] = 0;
+    object_count_30 = 0;
+    scenery_count_34 = 0;
+    unsigned char* storage = reinterpret_cast<unsigned char*>(this);
+    memset(storage + 0x38, 0, 0x498 * 4);
+    memset(storage + 0x1298, 0, 0x802 * 4);
+    memset(storage + 0x32a0, 0, 0x5f * 4);
+    memset(buildings_341c, 0, sizeof(buildings_341c));
+    memset(CatalogRecordAddress(this, 0x37490, 0, 0), 0, 0x40c * 4);
+    memset(CatalogRecordAddress(this, 0x384c0, 0, 0), 0, 0xb3d * 4);
+    memset(CatalogRecordAddress(this, 0x3b1b4, 0, 0), 0, 0x125c * 4);
+    memset(CatalogRecordAddress(this, 0x3fb24, 0, 0), 0, 0x3ae * 4);
+    memset(objects_4f1a4, 0, sizeof(objects_4f1a4));
+    memset(CatalogRecordAddress(this, 0x4e5e8, 0, 0), 0, 0x1b8 * 4);
+    memset(CatalogRecordAddress(this, 0x4f114, 0, 0), 0, 0x24 * 4);
+    memset(CatalogRecordAddress(this, 0x5409c, 0, 0), 0, 0x4856 * 4);
+    // One clear spans the three name lists and their counts.
+    memset(male_names_409dc, 0, 0x3703 * 4);
+
+    unsigned int length = strlen(buildings);
+    char* path = static_cast<char*>(::operator new(length + 1));
+    strcpy(path, buildings);
+    path[length - 4] = '.';
+    path[length - 3] = 'b';
+    path[length - 2] = 'l';
+    path[length - 1] = 'e';
