+// FUNCTION: BEACHLIFE 0x004cf7b0
+int WindowAudioState::PlaySoundAtPosition(
+    const char* name, const WindowAudioVector* position, unsigned int flags, int voice)
+{
+    int result = -1;
+    if (!enabled_3d)
+    {
+        float far_distance = value_f0;
+        float scale = scale_d8;
+        float dx = position_e0.x - position->x;
+        float near_distance = value_ec;
+        float dy = position_e0.y - position->y;
+        double distance = sqrt(dx * dx + dy * dy);
+        float attenuation;
+        bool audible = true;
+        if (static_cast<float>(distance) > far_distance)
+        {
+            attenuation = 0.0f;
+            audible = false;
+        }
+        else if (static_cast<float>(distance) < near_distance)
+        {
+            attenuation = 1.0f;
+        }
+        else
+        {
+            attenuation = 1.0f - (static_cast<float>(distance) - near_distance) / (far_distance - near_distance);
+        }
+        float attenuated = attenuation * scale;
+        if (audible)
+        {
+            int volume = SoundVolume(attenuated);
+            result = PlaySoundWithParameters(name, volume, flags, 0, attenuated);
+        }
+    }
+    else
+    {
+        result = Play3DSoundWithParameters(name, volume_d4, position, flags, voice);
+    }
+    return result;
+}
