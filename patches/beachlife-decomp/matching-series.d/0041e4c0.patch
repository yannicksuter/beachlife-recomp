+#include "startup_world_entities.h"
+#include "startup_world_repairs.h"
+#include "startup_world_subsystems.h"
+#include "startup_screen_text.h"
+#include "startup_variable_state.h"
+#include "startup_game_file.h"
+#include "window_activation.h"
+#include <stdio.h>
+#include <string.h>
+#include <wchar.h>
+
+// FUNCTION: BEACHLIFE 0x0041e4c0
+void WorldSceneryEntity::ReadText(const char* key, unsigned short* output)
+{
+    if (strcmp(key, "BIN_LITTER") == 0)
+    {
+        swprintf(output, L"%d", word_90);
+    }
+    else if (strcmp(key, "BI_CALL_CLEANER_STATE") == 0)
+    {
+        bool enabled = true;
+        if (cleaning_requested_5e != 0)
+            enabled = false;
+        if (variable_world->CountType(11) != 0 && enabled)
+            swprintf(output, L"%d", 1);
+        else
+            swprintf(output, L"%d", 0);
+    }
+    else if (strcmp(key, "BI_CALL_MECHANIC_STATE") == 0)
+    {
+        bool enabled = true;
+        if (repair_requested_5f != 0)
+            enabled = false;
+        if (variable_world->CountType(8) != 0 && enabled)
+            swprintf(output, L"%d", 1);
+        else
+            swprintf(output, L"%d", 0);
+    }
+    else if (strcmp(key, "SCENERY_REPAIRSTATUS") == 0)
+    {
+        WorldRepairManager* repairs = window_deactivation_state->repairs_28;
+        switch (repairs->ObjectStatus(id_28))
+        {
+        case 0:
+            wcscpy(output, screen_text_lookup->LookupText("BI_REPAIR_NO_MECHANICS"));
+            break;
+        case 1:
+            wcscpy(output, screen_text_lookup->LookupText("BI_REPAIR_CANT_REACH"));
+            break;
+        case 2:
+            if (flags_5a[3] == 0 && repair_requested_5f == 0)
+                wcscpy(output, screen_text_lookup->LookupText("BI_REPAIR_NOT_NEEDED"));
+            else
+                wcscpy(output, screen_text_lookup->LookupText("BI_REPAIR_WAITING"));
+            break;
+        case 3:
+            wcscpy(output, screen_text_lookup->LookupText("BI_REPAIR_REQUIRED"));
+            break;
+        case 5:
+            wcscpy(output, screen_text_lookup->LookupText("BI_REPAIR_MECHANIC_COMING"));
+            break;
+        case 6:
+            wcscpy(output, screen_text_lookup->LookupText("BI_REPAIR_REPAIRING"));
+            break;
+        case 4:
+            wcscpy(output, screen_text_lookup->LookupText("BI_INSPECT_REQUIRED"));
+            break;
+        }
+    }
+    else if (strcmp(key, "SCENERY_CLEANINGSTATUS") == 0)
+    {
+        WorldCleaningManager* cleaning = window_deactivation_state->cleaning_2c;
+        switch (cleaning->ObjectTask(id_28))
+        {
+        case 2:
+            wcscpy(output, screen_text_lookup->LookupText("BI_CLEAN_NOT_NEEDED"));
+            break;
+        case 3:
+            wcscpy(output, screen_text_lookup->LookupText("BI_CLEAN_REQUIRED"));
+            break;
+        case 4:
+            wcscpy(output, screen_text_lookup->LookupText("BI_CLEAN_ONROUTE"));
+            break;
+        case 5:
+            wcscpy(output, screen_text_lookup->LookupText("BI_CLEAN_CLEANING"));
+            break;
+        case 1:
+            wcscpy(output, screen_text_lookup->LookupText("BI_CLEAN_NO_CLEANERS"));
+            break;
+        default:
+            wcscpy(output, screen_text_lookup->LookupText("BI_CLEAN_NOT_NEEDED"));
+            break;
+        }
+    }
+    else
+    {
+        StartupFatal("Scenery::GetVariable - data keyword not recognised - %s", key);
+    }
+}
