+void GuiParserState::ParseTabWindow()
+{
+    const char* data = buffer;
+    while (
+        data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+
+    if (data[cursor] == '(')
+    {
+        ++cursor;
