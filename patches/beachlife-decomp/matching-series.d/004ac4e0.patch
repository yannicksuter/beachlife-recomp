+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, 0);
+        int value;
+        ReadInteger(value, true);
+        ScreenLinearContainer* item = new ScreenLinearContainer(rectangle, value);
+        RegisterItem(item, 0);
+        PushContext(item);
+
+        data = buffer;
+        while (
+            data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
