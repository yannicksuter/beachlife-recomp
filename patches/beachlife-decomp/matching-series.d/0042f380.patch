+// FUNCTION: BEACHLIFE 0x0042f380
+bool IsPointerSelectedEntity(const VariableEntity* entity_in, const void*)
+{
+    VariableEntity* entity = const_cast<VariableEntity*>(entity_in);
+    if (!entity->CanSelectAtPointer() || !overlay_map->ContainsEntity(entity) || !entity->visible_40)
