+        if (selected != -1 && resource->word_10 != static_cast<unsigned int>(selected))
+        {
+            resource->word_10 = selected;
+            resource->word_14 = 0;
+        }
+    }
+    ScreenWorldPosition position(entity->position_30);
+    ScreenPoint point;
+    point = overlay_map->WorldToScreen(position);
+    point.x += entity->keyline_state_44->CurrentFrameValue();
+    point.y += entity->keyline_state_44->SelectedFrame()->word_14;
