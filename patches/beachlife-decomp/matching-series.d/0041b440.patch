+ScreenPoint OverlayMapPrefix::TileToScreen(const ScreenPoint& tile)
+{
+    unsigned int size = static_cast<unsigned int>(screen_terrain_grid->tile_size_00);
+    ScreenPoint result;
+    result.x = static_cast<int>(tile.x * (size >> 1));
+    result.y = static_cast<int>(tile.y * (size >> 1) + ((tile.x & 1) - 1) * (size >> 2));
+    result.y -= static_cast<int>(HeightAt(result.x, result.y));
+    return result;
+}
