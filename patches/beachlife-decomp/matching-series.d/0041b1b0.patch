+// FUNCTION: BEACHLIFE 0x0041b1b0
+bool OverlayMapPrefix::RenderWater()
+{
+    int first_column = scroll_x_c4 / tile_size_dc;
+    int first_row = scroll_y_c8 / tile_size_dc;
+    int last_column = (scroll_x_c4 + static_cast<int>(static_cast<long double>(static_cast<unsigned int>(view_ac.right)) / screen_request_renderer->value_58)) / 128 + 1;
+    int last_row = (scroll_y_c8 + static_cast<int>(static_cast<long double>(static_cast<unsigned int>(view_ac.bottom)) / screen_request_renderer->value_58)) / 128 + 1;
+    int row = first_row;
+    if (first_row < last_row)
+    {
+        do
+        {
+            for (int column = first_column; column < last_column; ++column)
+            {
+                OverlayCachedTile& tile = cached_tiles_e0[row * cache_width_d4 + column];
+                if (!tile.ready)
+                    continue;
+                ScreenPoint position;
+                position.x = column * tile_size_dc - scroll_x_c4;
+                position.y = row * tile_size_dc - scroll_y_c8;
+                ScreenRectangle bounds;
+                bounds.left = 0;
+                bounds.top = 0;
+                bounds.right = 0;
+                bounds.bottom = 0;
+                overlay_water_image.pixels = static_cast<unsigned char*>(tile.view);
+                if (cached_tiles_e0[row * cache_width_d4 + column].water_01)
+                    renderer_fc->DrawWaterTile(column, row, position, bounds, &overlay_water_image, 8, 0, 1);
+                else
+                    renderer_fc->DrawWaterTile(column, row, position, bounds, &overlay_water_image, 8, 0, 0);
+            }
+        } while (++row < last_row);
+    }
+    ScreenRectangle bounds;
+    while (screen_request_renderer->TakeDirtyRectangle(bounds))
+    {
+    }
+    overlay_water_image.pixels = 0;
+    return true;
+}
