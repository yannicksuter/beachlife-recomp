+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_combo_box.h"
+#include "startup_screen_text.h"
+
+// FUNCTION: BEACHLIFE 0x004ac180
+void GuiParserState::ParseComboBox()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        char name[64];
+        ReadText(name);
+        // The script order differs from the constructor order.
+        int value_c;
+        ReadInteger(value_c, true);
+        int value_a;
+        ReadInteger(value_a, true);
+        int value_b;
+        ReadInteger(value_b, true);
+        int value_d;
+        ReadInteger(value_d, true);
+        int value_e;
+        ReadInteger(value_e, true);
+        ScreenComboBox* combo = new ScreenComboBox(rectangle, name, value_a, value_b, value_c, value_d, value_e);
+        RegisterItem(combo, 0);
+
+        data = buffer;
+        if (data[cursor] != ')')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            char text[64];
+            ReadText(text);
+            combo->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+        else
+        {
+            ++cursor;
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_combobox - Script Error \r\nNo open bracket found at "
+                     "file offset - %u",
+            cursor);
+    }
+}
