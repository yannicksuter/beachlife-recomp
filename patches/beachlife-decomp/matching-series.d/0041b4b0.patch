+#include "startup_screen_mode_world.h"
+#include "startup_screen_overlay_layout.h"
+#include "startup_screen_point.h"
+#include "startup_screen_position_inlines.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x0041b4b0
+float OverlayMapPrefix::WaterCoverage()
+{
+    // word_58 holds the renderer's float scale.
+    float scale = *reinterpret_cast<float*>(&screen_request_renderer->word_58);
+    int width = static_cast<int>(static_cast<float>(static_cast<unsigned int>(view_ac.right)) / scale);
+    int height = static_cast<int>(static_cast<float>(static_cast<unsigned int>(view_ac.bottom)) / scale);
+    ScreenWorldPosition first(static_cast<float>(scroll_x_c4), static_cast<float>(scroll_y_c8) * 2);
+    ScreenPoint low = CurrentScreenTerrain()->WorldToTile(first);
+    ScreenWorldPosition second(static_cast<float>(width - 1) + scroll_x_c4, static_cast<float>(height + scroll_y_c8 - 1) * 2);
+    ScreenPoint high = CurrentScreenTerrain()->WorldToTile(second);
+    if (high.x == 0)
+        high.x = 128;
+    if (high.y == 0)
+        high.y = 128;
+    if (low.x == 128)
+        low.x = 0;
+    if (low.y == 128)
+        low.y = 0;
+    int count = screen_terrain_grid->CountWaterTiles(low.x, low.y, high.x, high.y);
+    if (count > 0)
+    {
+        unsigned int rows = static_cast<unsigned int>(high.y) - static_cast<unsigned int>(low.y);
+        unsigned int columns = static_cast<unsigned int>(high.x) - static_cast<unsigned int>(low.x);
+        return static_cast<float>(count) / static_cast<int>(rows * columns);
+    }
+    return 0.0f;
+}
