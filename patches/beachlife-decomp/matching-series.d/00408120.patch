+#include "startup_resource_rasters.h"
+#include "render_mask_setup.h"
+#include <stdlib.h>
+
+// Darkens the pixels under an RLE packet sprite (a shadow) in a four-byte
+// surface whose high word holds a depth: positive packets cover that many
+// pixels, any other packet skips -n. Each covered pixel whose depth is not
+// above the row depth becomes half its colour (render_half_mask) with the row
+// depth in the high word. The depth starts from the low word of flags minus
+// 16 per sprite row and grows by 16 per row. The packet stream carries no
+// palette indices, so palette is unused.
+// FUNCTION: BEACHLIFE 0x00408120
+void ResourceRasterFlagged(unsigned short* destination, const unsigned char* source, const unsigned short* palette,
+    unsigned int stride, int x, int y, int width, int height, int left, int top, int right, int bottom,
+    unsigned int flags)
+{
+    unsigned int* row = reinterpret_cast<unsigned int*>(destination) + (stride * y + x);
+    unsigned int depth = (height * 0xfff0 + (flags & 0xffff)) << 16;
+
+    // Nothing is clipped.
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int j = 0; j < height; j++)
+        {
+            depth += 0x100000;
+            unsigned int* output = row + j * stride;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    column += count;
+                    packet -= count;
+                    do
+                    {
+                        unsigned int pixel = *output;
+                        if ((pixel & 0xffff0000) <= depth)
+                            *output = ((pixel >> 1) & (render_half_mask >> 1)) + depth;
+                        output++;
+                    } while (--count != 0);
+                }
+                output -= packet;
+                column -= packet;
+            }
+        }
+        return;
+    }
+
+    // Left edge clipped.
+    if (left > 0)
+    {
+        for (int skip = top; skip > 0; skip--)
+        {
+            depth += 0x100000;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                column += abs(packet);
+            }
+        }
+
+        for (int j = 0; j < bottom - top; j++)
+        {
+            unsigned int* output = row + j * stride;
+            int remaining_left = left;
+            depth += 0x100000;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    packet -= count;
+                    do
+                    {
+                        if (remaining_left != 0)
+                            remaining_left--;
+                        else if (column < right)
+                        {
+                            unsigned int pixel = *output;
+                            if ((pixel & 0xffff0000) <= depth)
+                                *output = ((pixel >> 1) & (render_half_mask >> 1)) + depth;
+                            output++;
+                        }
+                        column++;
+                    } while (--count != 0);
+                }
+                packet = -packet;
+                while (remaining_left != 0 && packet != 0)
+                {
+                    remaining_left--;
+                    column++;
+                    packet--;
+                }
+                column += packet;
+                output += packet;
+            }
+        }
+        return;
+    }
+
+    // Top, right or bottom edge clipped.
+    for (int skip = top; skip > 0; skip--)
+    {
+        depth += 0x100000;
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            column += abs(packet);
+        }
+    }
+
+    for (int j = 0; j < bottom - top; j++)
+    {
+        unsigned int* output = row + j * stride;
+        depth += 0x100000;
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet > 0)
+            {
+                int count = packet;
+                packet -= count;
+                do
+                {
+                    if (column < right)
+                    {
+                        unsigned int pixel = *output;
+                        if ((pixel & 0xffff0000) <= depth)
+                            *output = ((pixel >> 1) & (render_half_mask >> 1)) + depth;
+                        output++;
+                    }
+                    column++;
+                } while (--count != 0);
+            }
+            if (column < right)
+                output -= packet;
+            column -= packet;
+        }
+    }
+}
