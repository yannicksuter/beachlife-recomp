+            ScreenModeCommand copy = *command;
+            found = *variable_world->FindNamed("WHARF", &count);
+            copy.words[1].data = found->id_28;
+            if (count != 0)
+            {
+                DispatchBroadcast(&copy);
+            }
+            else
+            {
+                found = *variable_world->FindNamed("BUSSTOP", &count);
+                copy.words[1].data = found->id_28;
