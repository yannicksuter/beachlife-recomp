+}
+
+inline bool ScreenModeCommandQueue::QueueCommand(ScreenModeCommand* command)
+{
+    if (window_deactivation_state->deactivation_requested && command->words[0] != -3)
+        return screen_mode_commands->QueueDelayed(command, 0.0001f);
+    float clock = window_deactivation_state->clock_158;
+    command->words[7].number = clock;
+    Append(variable_world->FindObject(command->words[1]), command, 0);
+    return true;
+}
+
+static inline bool DispatchBroadcast(ScreenModeCommand* command)
+{
+    ScreenModeCommandQueue* queue = CommandQueue();
