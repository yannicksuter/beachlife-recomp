+#include "startup_world_entities.h"
+#include <stdlib.h>
+
+// FUNCTION: BEACHLIFE 0x00482140
+const char* WorldMechanicEntity::Notification(unsigned int flags)
+{
+    const char* result = WorldStaffEntity::Notification(flags);
+    if (flags & 2)
+        result = "FEEDBACK_MECHANIC_TOO_BUSY";
+    else if (flags & 0x100000)
+        result = "FEEDBACK_MECHANIC_UNHAPPY";
+    else if (flags & 4)
+        result = "FEEDBACK_MECHANIC_INNERTOUGHT_INSPECTIONMADE";
+    else if (flags & 8)
+        result = "FEEDBACK_MECHANIC_BUILDING_INNERTOUGHT_REPAIRMADE";
+    else if (flags & 0x10)
+        result = "FEEDBACK_MECHANIC_SCENERY_INNERTOUGHT_REPAIRMADE";
+    else if (flags & 0x20)
+        result = "FEEDBACK_MECHANIC_SCENERY_INNERTOUGHT_WATERED";
+    else if (flags & 0x20000000)
+    {
+        switch (rand() % 3)
+        {
+        case 0:
+            result = "FEEDBACK_MECHANIC_INNERTOUGHT_STANDIDLE_01";
+            break;
+        case 1:
+            result = "FEEDBACK_MECHANIC_INNERTOUGHT_STANDIDLE_02";
+            break;
+        case 2:
+            result = "FEEDBACK_MECHANIC_INNERTOUGHT_STANDIDLE_03";
+            break;
+        }
+    }
+    return result;
+}
