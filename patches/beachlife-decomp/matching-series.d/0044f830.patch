+
+template <class T>
+static T& CatalogField(void* record, unsigned int offset)
+{
+    return *reinterpret_cast<T*>(static_cast<unsigned char*>(record) + offset);
+}
+// FUNCTION: BEACHLIFE 0x0044f830
+void VariableCatalog::ParseName(const char* kind, const char* value)
+{
+    unsigned char* names = CatalogRecordAddress(this, 0x409dc, 0, 0);
+    if (strcmp(kind, "MALENAME") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(names, 0xdc00);
+        strcpy(reinterpret_cast<char*>(names + count * 64), value);
+        ++count;
+    }
+    else if (strcmp(kind, "FEMALENAME") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(names, 0xdc04);
+        strcpy(reinterpret_cast<char*>(names + (count + 0x8c) * 64), value);
+        ++count;
+    }
+    else if (strcmp(kind, "SURNAME") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(names, 0xdc08);
+        strcpy(reinterpret_cast<char*>(names + (count + 0x118) * 64), value);
+        ++count;
+    }
+    else
+        StartupFatal("WorldParams::AddNameData - unrecognised comment keyword - %s", kind);
+}
