+void ScreenRequestRenderer::DrawLine(int x1, int y1, int x2, int y2, unsigned short colour)
+{
+    if (x1 >= clip_rectangle.width || x2 < 0 || y1 >= clip_rectangle.height || y2 <= 0)
+    {
+        return;
+    }
+
+    if (y1 > y2)
+    {
+        int saved = y1;
+        y1 = y2;
+        y2 = saved;
+        saved = x1;
+        x1 = x2;
+        x2 = saved;
+    }
+    int delta_y = y2 - y1;
+    int delta_x = x2 - x1;
+
+    if (unscaled_clip_5c)
+    {
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+        {
+            return;
+        }
+        ScreenRequestRenderer* renderer = screen_request_renderer;
+        ScreenSurfacePosition* entry = renderer->surfaces[renderer->current_surface];
+        ScreenPoint position = entry->position;
+        x1 -= position.x;
+        y1 -= position.y;
+        unsigned int pitch = surfaces[current_surface]->pitch;
+
+        if (delta_x > 0)
+        {
+            if (delta_x > delta_y)
+            {
+                RasterLinePackedX(x1, y1, delta_x, delta_y, 1, colour, pixels, pitch >> 1);
+            }
+            else
+            {
+                RasterLinePackedY(x1, y1, delta_x, delta_y, 1, colour, pixels, pitch >> 1);
+            }
+        }
+        else
+        {
+            delta_x = -delta_x;
+            if (delta_x > delta_y)
+            {
+                RasterLinePackedX(x1, y1, delta_x, delta_y, -1, colour, pixels, pitch >> 1);
+            }
+            else
+            {
+                RasterLinePackedY(x1, y1, delta_x, delta_y, -1, colour, pixels, pitch >> 1);
+            }
+        }
+
+        if (!software_mode)
+        {
+            DirectDrawSurface7Prefix* surface = surfaces[current_surface]->surface;
+            surface->vtable->Unlock(surface, 0);
+        }
+        pixels_locked = 0;
+        return;
+    }
+
+    if (delta_x > 0)
+    {
+        if (delta_x > delta_y)
+        {
+            RasterLineDirectX(x1, y1, delta_x, delta_y, 1, colour, pixels_1c, width);
+        }
+        else
+        {
+            RasterLineDirectY(x1, y1, delta_x, delta_y, 1, colour, pixels_1c, width);
+        }
+    }
+    else
+    {
+        delta_x = -delta_x;
+        if (delta_x > delta_y)
+        {
