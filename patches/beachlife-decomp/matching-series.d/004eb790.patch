+#include "tga_image.h"
+#include "tiff_read_context.h"
+
+static inline int Width(TgaImage* image)
+{
+    return image->width;
+}
+
+static inline int Height(TgaImage* image)
+{
+    return image->height;
+}
+
+// Drops the fourth sample of every pixel into a new 24-bit image.
+// FUNCTION: BEACHLIFE 0x004eb790
+TgaImage* TiffConvertFourSamples(TgaImage* source)
+{
+    int width = source->width;
+    unsigned char* pixels = source->pixels;
+    int height = source->height;
+    TgaImage* image = new TgaImage(Width(source), Height(source), 24, 0);
+    unsigned char* out = image->pixels;
+    for (int y = 0; y < height; ++y)
+    {
+        for (int x = 0; x < width; ++x)
+        {
+            *out++ = pixels[(y * width + x) * 4];
+            *out++ = pixels[(y * width + x) * 4 + 1];
+            *out++ = pixels[(y * width + x) * 4 + 2];
+        }
+    }
+    return image;
+}
