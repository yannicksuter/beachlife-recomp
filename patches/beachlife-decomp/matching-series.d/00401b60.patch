+#include "startup_resource_rasters.h"
+
+// Draws an RLE-packed 8-bit sprite through a 16-bit palette, clipped to the
+// rectangle left/top/right/bottom given in sprite pixels. Each packed row
+// covers `width` pixels: a positive packet byte is a run of that many palette
+// indices, any other packet skips -n transparent pixels. A drawn run counts n
+// down to zero, so the skip step that follows it changes nothing.
+// FUNCTION: BEACHLIFE 0x00401b60
+void ResourceRaster1Packed(unsigned short* destination, const unsigned char* source, const unsigned short* palette,
+    unsigned int stride, int x, int y, int width, int height, int left, int top, int right, int bottom)
+{
+    unsigned short* row = destination + stride * y;
+
+    // Nothing is clipped.
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int j = 0; j < height; j++)
+        {
+            unsigned short* output = row + j * stride + x;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    column += count;
+                    packet -= count;
+                    do
+                    {
+                        *output++ = palette[*source++];
+                    } while (--count != 0);
+                }
+                output -= packet;
+                column -= packet;
+            }
+        }
+        return;
+    }
+
+    // Left edge clipped: the first `left` pixels of every row are dropped.
+    if (left > 0)
+    {
+        for (int skip = top; skip > 0; skip--)
+        {
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet >= 0)
+                {
+                    column += packet;
+                    source += packet;
+                }
+                else
+                {
+                    column -= packet;
+                }
+            }
+        }
+
+        for (int j = 0; j < bottom - top; j++)
+        {
+            unsigned short* output = row + j * stride + x;
+            int remaining_left = left;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    column += count;
+                    packet -= count;
+                    do
+                    {
+                        if (remaining_left != 0)
+                            remaining_left--;
+                        else
+                            *output++ = palette[*source];
+                        source++;
+                    } while (--count != 0);
+                }
+                packet = -packet;
+                while (remaining_left != 0 && packet != 0)
+                {
+                    remaining_left--;
+                    column++;
+                    packet--;
+                }
+                column += packet;
+                output += packet;
+            }
+        }
+        return;
+    }
+
+    // Top, right or bottom edge clipped: pixels from `right` on are dropped.
+    for (int skip = top; skip > 0; skip--)
+    {
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet >= 0)
+            {
+                column += packet;
+                source += packet;
+            }
+            else
+            {
+                column -= packet;
+            }
+        }
+    }
+
+    for (int j = 0; j < bottom - top; j++)
+    {
+        unsigned short* output = row + j * stride + x;
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet > 0)
+            {
+                int count = packet;
+                packet -= count;
+                do
+                {
+                    if (column < right)
+                        *output++ = palette[*source];
+                    source++;
+                    column++;
+                } while (--count != 0);
+            }
+            if (column < right)
+                output -= packet;
+            column -= packet;
+        }
+    }
+}
