+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_radio_group.h"
+
+// FUNCTION: BEACHLIFE 0x004ad4c0
+void GuiParserState::ParseRadioGroup()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (
+            data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        char variable_name[64];
+        ReadText(variable_name);
+        char resource_name[64];
+        ReadText(resource_name);
+        ScreenRadioGroup* item = new ScreenRadioGroup(rectangle, variable_name, resource_name);
+        RegisterItem(item, 0);
+        PushContext(item);
+
+        data = buffer;
+        while (
+            data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+        if (data[cursor] == '{')
+        {
+            ++cursor;
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::ProcessRadioGroup - Script Error \r\nNo open bracket found at "
+                     "file offset - %u",
+            cursor);
+    }
+}
