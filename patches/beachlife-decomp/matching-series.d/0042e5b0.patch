+ScreenModeCommandIterator ScreenModeCommandQueue::Insert(
+    ScreenModeCommandIterator position, const ScreenModeCommand& command)
+{
+    ScreenModeCommandNode* node = CreateNode(command);
+    ScreenModeCommandNode* previous = position.node->previous;
+    node->next = position.node;
