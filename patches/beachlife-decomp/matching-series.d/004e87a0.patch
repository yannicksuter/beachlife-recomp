+#include "startup_game_won.h"
+#include "startup_game_won_credits.h"
+#include "startup_screen_manager.h"
+#include "startup_screen_text_item.h"
+#include "startup_screen_manager_owner190_rows.h"
+#include <algorithm>
+#include <stdio.h>
+#include <new>
+
+char game_won_screen_format[] = "GameWon%d";
+
+static inline void ClearCredits(GameWonList& items)
+{
+    std::for_each(items.begin(), items.end(), DeleteGameWonItem);
+    items.clear();
+}
+
+static inline void AddCredit(GameWonList& items, ScreenTextItem* const& item)
+{
+    items.insert(items.end(), item);
+}
+
+// FUNCTION: BEACHLIFE 0x004e87a0
+void GameWonController::ShowStage()
+{
+    screen_manager->CloseActiveScreens();
+    char name[128];
+    sprintf(name, game_won_screen_format, stage);
+    screen_manager->RequestScreen(name, 0, 0);
+    ClearCredits(list_90);
+    GameWonCreditLayout* layout = game_won_credit_layouts[stage];
+    for (int i = 0; i < 3; ++i)
+    {
+        if (layout->group == -1)
+            break;
+        int x = layout->x;
+        int y = layout->y;
+        ScreenRectangle bounds;
+        bounds.right = x + layout->width;
+        bounds.bottom = y + 15;
+        for (GameWonCreditEntry* entry = game_won_credit_groups[layout->group]; entry->font != -1; ++entry)
+        {
+            char key[128];
+            sprintf(key, screen_manager_owner190_key_format, entry->text_id);
+            bounds.left = x;
+            bounds.top = y;
+            ScreenTextItem* item = new ScreenTextItem(bounds, key, entry->font, entry->value, 4);
+            AddCredit(list_90, item);
+            if (entry->double_spacing)
+                y += 30;
+            else
+                y += 15;
+            bounds.bottom = y + 15;
+        }
+        ++layout;
+    }
+}
