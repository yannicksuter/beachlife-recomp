+static inline float BuildingClock()
+{
+    return window_deactivation_state->clock_158;
+}
+
+inline int RandomTileOffset(float range)
+{
+    return (int)(range * (rand() * (1.0f / 32767)));
+}
+
+inline bool LoungerTileAvailable(const ScreenPoint& p)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    if (!(grid->cells_0c[grid->TileIndex(p.x, p.y)].flags_48 & 2))
+        return false;
+    grid = screen_terrain_grid;
+    if (grid->cells_0c[grid->TileIndex(p.x, p.y)].flags_48 & 0x10)
+        return false;
+    grid = screen_terrain_grid;
+    if (grid->cells_0c[grid->TileIndex(p.x, p.y)].flags_48 & 0x8000)
+        return false;
+    return true;
+}
+
+// Same test with the last two flags swapped; the original checks the eighth neighbour this way.
+inline bool LastLoungerTileAvailable(const ScreenPoint& p)
+{
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    if (!(grid->cells_0c[grid->TileIndex(p.x, p.y)].flags_48 & 2))
+        return false;
+    grid = screen_terrain_grid;
+    if (grid->cells_0c[grid->TileIndex(p.x, p.y)].flags_48 & 0x8000)
+        return false;
+    grid = screen_terrain_grid;
+    if (grid->cells_0c[grid->TileIndex(p.x, p.y)].flags_48 & 0x10)
+        return false;
+    return true;
+}
+
+inline int BuildingFrameIndex(ScreenDialogResource* keyline, const char* name)
+{
+    for (int i = 0; i < keyline->record->frame_count; ++i)
+        if (strcmp(name, keyline->record->frames[i]->name) == 0)
+            return i;
+    return -1;
+}
