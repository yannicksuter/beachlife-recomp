+    case 0:
+        if (strcmp(name_06, "BEACHHUT") == 0)
+        {
+            for (int count = 0; count < 10; ++count)
+            {
+                float width = 20 - TilePosition().x + TilePosition().x;
+                ScreenPoint tile;
+                tile.x = RandomTileOffset(width);
+                tile.x += TilePosition().x - 10;
+                float height = TilePosition().y - TilePosition().y + 20;
+                tile.y = RandomTileOffset(height);
+                tile.y += TilePosition().y - 10;
+                ScreenPoint n0, n1, n2, n3, n4, n5, n6, n7;
+                screen_terrain_grid->Step(tile, 0, &n0);
+                screen_terrain_grid->Step(tile, 1, &n1);
+                screen_terrain_grid->Step(tile, 2, &n2);
+                screen_terrain_grid->Step(tile, 3, &n3);
+                screen_terrain_grid->Step(tile, 4, &n4);
+                screen_terrain_grid->Step(tile, 5, &n5);
+                screen_terrain_grid->Step(tile, 6, &n6);
+                screen_terrain_grid->Step(tile, 7, &n7);
+                int attempts = 0;
+                while (!(LoungerTileAvailable(tile) && LoungerTileAvailable(n0) && LoungerTileAvailable(n2)
+                           && LoungerTileAvailable(n4) && LoungerTileAvailable(n6) && LoungerTileAvailable(n1)
+                           && LoungerTileAvailable(n3) && LoungerTileAvailable(n5) && LastLoungerTileAvailable(n7))
+                       && attempts < 100)
+                {
+                    float width = 20 - TilePosition().x + TilePosition().x;
+                    tile.x = RandomTileOffset(width);
+                    tile.x += TilePosition().x - 10;
+                    float height = TilePosition().y - TilePosition().y + 20;
+                    tile.y = RandomTileOffset(height);
+                    tile.y += TilePosition().y - 10;
+                    screen_terrain_grid->Step(tile, 0, &n0);
+                    screen_terrain_grid->Step(tile, 1, &n1);
+                    screen_terrain_grid->Step(tile, 2, &n2);
+                    screen_terrain_grid->Step(tile, 3, &n3);
+                    screen_terrain_grid->Step(tile, 4, &n4);
+                    screen_terrain_grid->Step(tile, 5, &n5);
+                    screen_terrain_grid->Step(tile, 6, &n6);
+                    screen_terrain_grid->Step(tile, 7, &n7);
+                    ++attempts;
+                }
+                if (attempts != 100)
+                {
+                    ScreenSceneryPlacement placement;
+                    placement.tile.x = tile.x;
+                    placement.tile.y = tile.y;
+                    placement.enabled = 0;
+                    placement.word_4c = id_28;
+                    strcpy(placement.name, "Lounger");
+                    strcpy(placement.model, "Lounger");
+                    ScreenModeCommand command;
+                    command.words[0].data = -2;
+                    command.words[1].data = -2;
+                    command.words[2].data = 0;
+                    command.words[3].data = 0;
+                    command.words[4].data = 1;
+                    screen_mode_commands->QueuePlacement(&command, &placement);
+                }
+            }
+        }
+        else if (strcmp(name_06, "MAINPOOL") == 0)
+        {
+            ScreenDialogResource* keyline = keyline_state_44;
+            VariableBuilding* building = building_60;
+            ScreenMapPosition offset;
+            offset.x = -208.0f;
+            offset.y = -496.0f;
+            int rotation = keyline->word_18;
+            ScreenMapPosition position = CurrentScreenTerrain()->BuildingOffset(
+                TilePosition(), building->footprint_x_1d4, building->footprint_y_1d8, offset, rotation);
+            pool_position_18c.x = position.x;
+            pool_position_18c.y = position.y;
+            pool_position_18c.z = 0.0f;
+        }
+        animation_sounds->PlayObject(id_28);
+        flag_420 = 1;
+        break;
+    case 1:
+    {
+        shadow_frame_414 = BuildingFrameIndex(keyline_state_44, "shadow");
+        pick_frame_418 = BuildingFrameIndex(keyline_state_44, "pick");
+        light_frame_41c = BuildingFrameIndex(keyline_state_44, "lightmap");
+        for (unsigned int i = 0; i < building_60->resource_count_380; ++i)
+        {
+            resources_140[i]->SelectVariant(static_cast<int>(keyline_state_44->word_18) % resources_140[i]->record->frames[0]->plane_count_0c);
+        }
+        if (window_deactivation_state->flag_17c)
+            ActivateBuilding();
+        else if (window_deactivation_state->building_status_48->AvailableBuilders() == 0)
+        {
+            unsigned int id = id_28;
+            char key[52];
+            unsigned short message[256];
+            strcpy(key, "BUILDING_NAME_");
+            strcat(key, building_60->name_04);
+            ScreenTextLookup* text = screen_text_lookup;
+            swprintf(message, text->LookupText("FEEDBACK_NO_BUILDERS"), screen_text_lookup->LookupText(key));
+            window_deactivation_state->ticker_30->AddMessage(message, id, 4);
+        }
+        construction_time_454 = BuildingClock();
+        window_deactivation_state->building_status_48->StartConstruction(id_28);
+        break;
+    }
+    case 2:
+        flag_368 = 0;
+        window_deactivation_state->building_status_48->StartDemolition(id_28);
+        break;
+    case 3:
+        window_deactivation_state->building_status_48->RemoveBuilding(id_28);
+        if (word_450 != -1)
+        {
+            unsigned int count;
+            unsigned int matching = 0;
+            VariableEntity** buildings = variable_world->FindNamed("BAYWATCH", &count);
+            for (unsigned int i = 0; i < count; ++i)
+                if (buildings[i]->AsBuilding()->word_450 == word_450)
+                    ++matching;
+            if (matching < 2)
+            {
+                screen_terrain_grid->EnableRoute(0, word_450);
+                screen_terrain_grid->EnableRoute(1, word_450);
+            }
+        }
+        break;
+    }
+    return true;
+}
