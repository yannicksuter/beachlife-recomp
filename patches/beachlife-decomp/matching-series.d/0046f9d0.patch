+// Half-width of the random wander square (catalog guest field 0x1d4).
+static inline float& WanderRange(VariableGuestState* guest)
+{
+    return guest->wander_range_1d4;
+}
+
+static inline ScreenTerrainCell* TileCell(ScreenPoint tile)
+{
+    return &screen_terrain_grid->cells_0c[screen_terrain_grid->TileIndex(tile.x, tile.y)];
+}
+
+// Copies a tile through a new point: retail reads both words before it
+// stores either.
+static inline ScreenPoint CopyTile(const ScreenPoint& tile)
+{
+    return ScreenPoint(tile.x, tile.y);
+}
+
+// FUNCTION: BEACHLIFE 0x0046f9d0
+void WorldGuestEntity::PerformAction4()
+{
+    float dx, dy;
+    ScreenWorldPosition target;
+    dx = (rand() * (1.0f / 32767)) * (WanderRange(guest_f4) - -WanderRange(guest_f4)) - WanderRange(guest_f4);
+    dy = (rand() * (1.0f / 32767)) * (WanderRange(guest_f4) - -WanderRange(guest_f4)) - WanderRange(guest_f4);
+    target = position_30;
+    target.x += dx;
+    target.y += dy;
+    if (target.x < 10.0f)
+        target.x = 10.0f;
+    else if (target.x > 4000.0f)
+        target.x = 4000.0f;
+    if (target.y < 10.0f)
+        target.y = 10.0f;
+    else if (target.y > 8000.0f)
+        target.y = 8000.0f;
+    ScreenPoint tile = CurrentScreenTerrain()->WorldToTile(target);
+    while (!(TileCell(tile)->flags_48 & 4) || (TileCell(tile)->flags_48 & 0x10))
+    {
+        dx = (rand() * (1.0f / 32767)) * (WanderRange(guest_f4) - -WanderRange(guest_f4)) - WanderRange(guest_f4);
+        dy = (rand() * (1.0f / 32767)) * (WanderRange(guest_f4) - -WanderRange(guest_f4)) - WanderRange(guest_f4);
+        target = position_30;
+        target.x += dx;
+        target.y += dy;
+        if (target.x < 10.0f)
+            target.x = 10.0f;
+        else if (target.x > 4000.0f)
+            target.x = 4000.0f;
+        if (target.y < 10.0f)
+            target.y = 10.0f;
+        else if (target.y > 8000.0f)
+            target.y = 8000.0f;
+        tile = CopyTile(CurrentScreenTerrain()->WorldToTile(target));
+    }
+    ScreenModeCommand command;
+    command.words[0] = id_28;
+    command.words[1] = id_28;
+    command.words[2] = 11;
+    command.words[3] = static_cast<int>(target.x);
+    command.words[4] = static_cast<int>(target.y);
+    screen_mode_commands->QueueCommand(&command);
+}
