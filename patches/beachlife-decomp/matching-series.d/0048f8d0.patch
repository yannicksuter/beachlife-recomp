+#include "startup_screen_mode_world.h"
+#include "startup_world_entities.h"
+#include "startup_screen_text.h"
+#include "startup_game_file.h"
+#include <string.h>
+#include <wchar.h>
+
+// FUNCTION: BEACHLIFE 0x0048f8d0
+void WorldStaffEntity::ReadText(const char* key, unsigned short* output)
+{
+    if (strcmp(key, "STAFF_ACTIVITY") == 0)
+    {
+        switch (state_3c)
+        {
+        case 0:
+            wcscpy(output, screen_text_empty);
+            break;
+        case 1:
+            wcscpy(output, screen_text_lookup->LookupText("STARTING_WORK"));
+            break;
+        case 76:
+            wcscpy(output, screen_text_lookup->LookupText("SACKED"));
+            break;
+        case 6:
+            wcscpy(output, screen_text_lookup->LookupText("SACKED"));
+            break;
+        case 77:
+            wcscpy(output, screen_text_lookup->LookupText("REQUIRES_ATTENTION"));
+            break;
+        case 131:
+        case 132:
+            wcscpy(output, screen_text_lookup->LookupText("BEING_DIRECTED"));
+            break;
+        default:
+        {
+            wcscpy(output, L"Not done yet");
+            break;
+        }
+        }
+    }
+    else if (strncmp(key, "STAFF_WAGES", 11) == 0)
+        swprintf(output, L"%d", wages_108);
+    else if (strcmp(key, "STAFF_DAY_WAGES_$") == 0)
+        swprintf(output, L"$%d", wages_108 * 10);
+    else if (strcmp(key, "STAFF_HAPPY_PERCENT") == 0)
+        swprintf(output, L"%d%%", static_cast<int>(morale_10c * 100.0f));
+    else if (strcmp(key, "STAFF_HOME") == 0)
+    {
+        VariableBuilding* building = static_cast<WorldBuildingEntity*>(variable_world->FindObject(home_id_100))->building_60;
+        char name[52];
+        strcpy(name, "BUILDING_NAME_");
+        strcat(name, building->name_04);
+        wcscpy(output, screen_text_lookup->LookupText(name));
+    }
+    else if (strcmp(key, "STAFF_HIRED_ON") == 0)
+        swprintf(output, screen_text_lookup->LookupText("STAFF_DAY_TEXT"), next_day_150);
+    else if (strcmp(key, "STAFF_START_HOUR") == 0)
+        swprintf(output, L"%d", shift_start_114);
+    else if (strcmp(key, "STAFF_END_HOUR") == 0)
+        swprintf(output, L"%d", shift_end_118);
+    else if (strcmp(key, "STAFF_HOUR_SEP") == 0)
+        swprintf(output, screen_text_lookup->LookupText("STAFFB_HOUR_SEP"));
+    else if (strncmp(key, "STAFF_FEEDBACK_MESS0", 20) == 0)
+        wcscpy(output, text_158[0]);
+    else if (strncmp(key, "STAFF_FEEDBACK_MESS1", 20) == 0)
+        wcscpy(output, text_158[1]);
+    else if (strncmp(key, "STAFF_FEEDBACK_MESS2", 20) == 0)
+        wcscpy(output, text_158[2]);
+    else if (strcmp(key, "STAFF_DISMISS_CONFIRM") == 0)
+    {
+        unsigned int wage = staff_104->base_wage_20c * 10;
+        swprintf(output, screen_text_lookup->LookupText("STAFFB_DISMISS_CONFIRM"), wage);
+    }
+    else
+        StartupFatal("StaffObject::GetVariable - data keyword not recognised - %s", key);
+}
