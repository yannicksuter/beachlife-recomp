+                        column++;
+                        packet--;
+                    }
+                    if (odd)
+                        output += packet / 2 + (column & 1);
+                    column += packet;
+                }
+            }
+        }
+        return;
+    }
+
+    // Top, right or bottom edge clipped.
+    for (int skip = top; skip > 0; skip--)
+    {
+        depth += 0x100000;
+        column = 0;
+        while (column < width)
+        {
+            packet = *source++;
+            if (packet >= 0)
+            {
+                column += packet;
+                source += packet;
+            }
+            else
+            {
+                column -= packet;
+            }
+        }
+    }
+
+    for (row = 0; row < bottom - top; row++)
+    {
+        bool odd = row % 2 != 0;
+        output = base + row / 2 * stride;
+        column = 0;
+        depth += 0x100000;
+        while (column < width)
+        {
+            packet = *source++;
+            if (packet >= 0)
+            {
+                while (packet--)
+                {
+                    if (column < right && (column & 1) && odd)
+                    {
+                        if ((*output & 0xffff0000) <= depth)
+                        {
+                            value = *source;
+                            mode = value & 0xc0;
+                            pixel = *output;
+                            unsigned short sprite_color = palette[(unsigned char)value - mode];
+                            switch (mode)
+                            {
+                            case 0x00:
+                                result = sprite_color;
+                                break;
+                            case 0x40:
+                                result = ((render_half_mask >> 1) & (sprite_color >> 1)) + ((sprite_color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                                break;
+                            case 0x80:
+                                result = ((sprite_color >> 1) & (render_half_mask >> 1)) + ((pixel >> 1) & (render_half_mask >> 1));
+                                break;
+                            case 0xc0:
+                                result = ((render_half_mask >> 1) & (pixel >> 1)) + ((sprite_color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+                                break;
+                            case 0x100:
+                                result = pixel;
+                                break;
+                            }
+                            *output = result + depth;
+                        }
+                        output++;
+                    }
+                    source++;
+                    column++;
+                }
+            }
+            else
+            {
+                if (column < right && odd)
+                    output += (column & 1) - packet / 2;
+                column -= packet;
+            }
+        }
+    }
+}
