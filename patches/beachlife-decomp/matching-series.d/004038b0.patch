+// The half-resolution blend of a sprite colour over the old pixel: the
+// source byte's top two bits select opaque, three quarters, half or one
+// quarter colour.
+static inline unsigned short BlendHalfPixel(int mode, int value, const unsigned int* output, const unsigned short* palette)
+{
+    unsigned short result;
+    unsigned short pixel = *output;
+    unsigned short color = palette[value - mode];
+    switch (mode)
+    {
+    case 0x00:
+        result = color;
+        break;
+    case 0x40:
+        result = ((color >> 1) & (render_half_mask >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+        break;
+    case 0x80:
+        result = ((color >> 1) & (render_half_mask >> 1)) + ((pixel >> 1) & (render_half_mask >> 1));
+        break;
+    case 0xc0:
+        result = ((pixel >> 1) & (render_half_mask >> 1)) + ((color >> 2) & (render_quarter_mask >> 2)) + ((pixel >> 2) & (render_quarter_mask >> 2));
+        break;
+    case 0x100:
+        result = pixel;
+        break;
+    }
+    return result;
+}
+
+// FUNCTION: BEACHLIFE 0x004038b0
+void ResourceRaster12Mode2(unsigned short* destination, const unsigned char* source, const unsigned short* palette,
+    unsigned int stride, int x, int y, int width, int height, int left, int top, int right, int bottom,
+    unsigned int flags)
+{
+    int row;
+    unsigned int* output;
+    int column;
+    signed char packet;
+    int value;
+    unsigned char mode;
+    unsigned short pixel;
+    unsigned short color;
+    unsigned short result;
+    unsigned int* base = reinterpret_cast<unsigned int*>(destination) + (y / 2 * stride + x / 2);
+    unsigned int depth = (height * 0xfff0 + (flags & 0xffff)) << 16;
+
+    // Nothing is clipped.
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (row = 0; row < height; row++)
+        {
+            depth += 0x100000;
+            unsigned char odd = row & 1;
+            output = base + row / 2 * stride;
+            column = 0;
+            while (column < width)
+            {
+                packet = *source++;
+                if (packet > 0)
+                {
+                    do
+                    {
+                        if (odd)
+                        {
+                            if ((*output & 0xffff0000) <= depth)
+                            {
+                                value = *source;
+                                int mode1 = value & 0xc0;
+                                result = BlendHalfPixel(mode1, value, output, palette);
+                                *output = result + depth;
+                            }
+                            output++;
+                        }
+                        if (packet > 1)
+                        {
+                            column += 2;
+                            source += 2;
+                            packet -= 2;
+                        }
+                        else
+                        {
+                            packet--;
+                            column++;
+                            source++;
+                        }
+                    } while (packet > 0);
+                }
+                if (odd)
+                    output -= packet / 2;
+                column -= packet;
+            }
+        }
+        return;
+    }
+
+    // Left edge clipped.
+    if (left > 0)
+    {
+        for (int skip = top; skip > 0; skip--)
+        {
+            column = 0;
+            depth += 0x100000;
+            while (column < width)
+            {
+                packet = *source++;
+                if (packet >= 0)
+                {
+                    column += packet;
+                    source += packet;
+                }
+                else
+                {
+                    column -= packet;
+                }
+            }
+        }
+
+        for (row = 0; row < bottom - top; row++)
+        {
+            bool odd = row % 2 != 0;
+            output = base + row / 2 * stride;
+            int remaining_left = left;
+            column = 0;
+            depth += 0x100000;
+            while (column < width)
+            {
+                packet = *source++;
+                if (packet >= 0)
+                {
+                    while (packet--)
+                    {
+                        if (remaining_left != 0)
+                            remaining_left--;
+                        else if ((column & 1) && odd)
+                        {
+                            if ((*output & 0xffff0000) <= depth)
