+
+// FUNCTION: BEACHLIFE 0x004d1640
+int AnimationSoundLookup::ParseOpinionSounds(const char* data)
+{
+    char token[52];
+    int offset = SkipWhitespace(data);
+    offset += ReadToken(token, data + offset);
+    while (strcmp(token, "End"))
+    {
+        for (int opinion = 0; opinion < 16; ++opinion)
+        {
+            if (!strcmp(animation_opinion_names[opinion], token))
+                goto found_opinion;
+        }
+        StartupFatal("ProcessOpinionSound, unknown or missing opinion, %s", token);
+        goto next_opinion;
+    found_opinion:
+        {
+            offset += ReadToken(token, data + offset);
+            if (!strcmp("Group", token))
+            {
+                offset += ReadToken(token, data + offset);
+                groups_418[group_count_518].word_04 = atoi(token);
+                offset += ReadToken(token, data + offset);
+            }
+            else
+                groups_418[group_count_518].word_04 = -1;
+            int count = atoi(token);
+            groups_418[group_count_518].count_00 = count;
+            groups_418[group_count_518].volumes_08 = static_cast<float*>(::operator new(count * sizeof(float)));
+            groups_418[group_count_518].sounds_0c = static_cast<char**>(::operator new(count * sizeof(char*)));
+            for (int sound = 0; sound < count; ++sound)
+            {
+                offset += ReadToken(token, data + offset);
+                groups_418[group_count_518].sounds_0c[sound] = static_cast<char*>(::operator new(strlen(token) + 1));
+                strcpy(groups_418[group_count_518].sounds_0c[sound], token);
+                if (!window_audio_state->HasSound(token))
+                    StartupFatal("Sound File Doesnt Exist %s", token);
+                offset += ReadToken(token, data + offset);
+                groups_418[group_count_518].volumes_08[sound] = static_cast<float>(atof(token));
+            }
+        }
+    next_opinion:
+        ++group_count_518;
+        offset += ReadToken(token, data + offset);
+    }
+    return offset;
+}
