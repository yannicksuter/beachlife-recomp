+// FUNCTION: BEACHLIFE 0x004e30b0
+void ScreenRequestGamePrefix::ReadText(const char* key, unsigned short* output)
+{
+    wchar_t* text = reinterpret_cast<wchar_t*>(output);
+    if (strcmp(key, "GAME_NUDGE") == 0)
+    {
+        swprintf(text, L"%d", static_cast<int>(placement->flag_34));
+    }
+    else if (strcmp(key, "GAME_SEA") == 0)
+    {
+        swprintf(text, L"%d", static_cast<int>(placement->flag_35));
+    }
+    else if (strcmp(key, "GAME_LIGHTS") == 0)
+    {
+        swprintf(text, L"%d", static_cast<int>(placement->flag_36));
+    }
+    else if (strcmp(key, "GAME_KEYLINES") == 0)
+    {
+        swprintf(text, L"%d", static_cast<int>(placement->flag_37));
+    }
+    else if (strcmp(key, "STAFF_MAKEALL_STATE") == 0 || strcmp(key, "STAFF_DISMISS_STATE") == 0)
+    {
+        if (screens->word_84 != -1)
+            swprintf(text, L"%d", 1);
+        else
+            swprintf(text, L"%d", 0);
+    }
+    else if (strcmp(key, "LOADSAVE_LOAD_STATE") == 0 || strcmp(key, "LOADSAVE_LOADDELETE_STATE") == 0)
+    {
+        ScreenListBoxPrefix* list = screens->FindListBox(game_load_list_box_name);
+        bool enabled = true;
+        if (saves.end - saves.begin == 0)
+            enabled = false;
+        if (GameSelectionCount(&list->selection) != 1)
+        {
+            enabled = false;
+        }
+        if (enabled)
+            swprintf(text, L"%d", 1);
+        else
+            swprintf(text, L"%d", 0);
+    }
+    else if (strcmp(key, "LOADSAVE_SAVE_STATE") == 0)
+    {
+        ScreenListBoxPrefix* list = screens->FindListBox(game_save_list_box_name);
+        if (GameSelectionCount(&list->selection) == 1)
+            swprintf(text, L"%d", 1);
+        else
+            swprintf(text, L"%d", 0);
+    }
+    else if (strcmp(key, "LOADSAVE_SAVEDELETE_STATE") == 0)
+    {
+        ScreenListBoxPrefix* list = screens->FindListBox(game_save_list_box_name);
+        bool enabled = true;
+        if (saves.end - saves.begin == 0)
+            enabled = false;
+        if (GameSelectionCount(&list->selection) != 1)
+        {
+            enabled = false;
+        }
+        if (GameSelectionCount(&list->selection) != 0)
+        {
+            list->word_84 = 0;
+            if (*list->selection.begin == 0)
+            {
+                enabled = false;
+            }
+        }
+        if (enabled)
+            swprintf(text, L"%d", 1);
+        else
+            swprintf(text, L"%d", 0);
+    }
+    else if (strcmp(key, "GAME_SCENARIO_SELECT") == 0)
+    {
+        swprintf(text, L"%d", static_cast<int>(scenario_a0));
+    }
+    else if (strncmp(key, "GAME_SCENARIO_SELECT_STATUS_", 28) == 0)
+    {
+        int index = atoi(key + 28);
+        unsigned char mode = byte_a4;
+        if (mode == 0)
+        {
+            if (static_cast<unsigned char>(words_70[index]) & 1)
+                goto scenario_disabled;
+            goto scenario_enabled;
+        }
+        if (static_cast<unsigned char>(words_70[index]) & 0x0c)
+            goto scenario_enabled;
+    scenario_disabled:
+        swprintf(text, L"%d", 0);
+        return;
+    scenario_enabled:
+        swprintf(text, L"%d", 1);
+    }
+    else if (strcmp(key, "GAME_GAME_SPEED") == 0)
+    {
+        swprintf(text, L"%d", static_cast<int>(window_deactivation_state->speed_index_174));
+    }
+    else if (strncmp(key, "GAME_GAME_SPEED_STATUS_", 23) == 0)
+    {
+        swprintf(text, L"%d", 1);
+    }
+    else if (strcmp(key, "PLAYLIST_MODE") == 0)
+    {
+        int mode = screen_manager->panel_13c->mode_10;
+        switch (mode)
+        {
+        case 0:
+            swprintf(text, L"%d", 1);
+            break;
+        case 1:
+            swprintf(text, L"%d", 0);
+            break;
+        }
+    }
+    else if (strncmp(key, "PLAYLIST_MODE_STATUS_", 21) == 0)
+    {
+        swprintf(text, L"%d", 1);
+    }
+    else
+    {
+        StartupFatal("Game::GetVariable - data keyword not recognised - %s", key);
+    }
+}
