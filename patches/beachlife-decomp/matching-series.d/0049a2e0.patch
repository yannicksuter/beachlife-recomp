+    __asm {
+        mov eax, 0x7f000000
+        sub eax, value
+        mov estimate, eax
+        fld value
+        fmul estimate
+        fsubr fast_reciprocal_two
+        fmul estimate
+        fstp estimate
+    }
+    return estimate;
+}
