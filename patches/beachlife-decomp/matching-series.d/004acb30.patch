+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_text.h"
+#include "startup_screen_variable_image.h"
+
+// FUNCTION: BEACHLIFE 0x004acb30
+void GuiParserState::ParseVariableImage()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle rectangle;
+        ReadRectangle(rectangle, current_context);
+        char name[64];
+        ReadText(name);
+        ScreenVariableImage* image = new ScreenVariableImage(rectangle, name);
+        RegisterItem(image, 0);
+
+        // ReadText consumed the delimiter: a ',' introduces the tip text.
+        data = buffer;
+        if (data[cursor - 1] == ',')
+        {
+            while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+            {
+                ++cursor;
+            }
+            char text[64];
+            ReadText(text);
+            image->SetOwnedText(text);
+            screen_text_lookup->LookupText(text);
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_variableimage - Script Error \r\nNo open bracket found "
+                     "at file offset - %u",
+            cursor);
+    }
+}
