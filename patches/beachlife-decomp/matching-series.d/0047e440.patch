+// FUNCTION: BEACHLIFE 0x0047e440
+void WorldLifeguardEntity::ReadText(const char* key, unsigned short* output)
+{
+    wchar_t* text = reinterpret_cast<wchar_t*>(output);
+    swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_empty));
+    Notification(feedback_7fc[2]);
+    if (!strcmp(key, "STAFF_ACTIVITY"))
+    {
+        switch (state_3c)
+        {
+        case 0x4e:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_PATROL")));
+            break;
+        case 0x4f:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_RESTING")));
+            break;
+        case 0x50:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_RESCUE")));
+            break;
+        case 0x51:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_GOTO_TOWER")));
+            break;
+        case 0x52:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_LEAVING_TOWER")));
+            break;
+        case 0x53:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_ON_TOWER")));
+            break;
+        case 0x54:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_TALKING")));
+            break;
+        case 0x55:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_empty));
+            break;
+        case 0x56:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_TELLOFF")));
+            break;
+        case 0x57:
+            swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("LIFEGUARD_IDLE")));
+            break;
+        default:
+            WorldStaffEntity::ReadText(key, output);
+        }
+    }
+    else if (!strcmp(key, "STAFF_NAME"))
+        swprintf(text, reinterpret_cast<const wchar_t*>(personal_name_f8));
+    else if (!strcmp(key, "RESCUE_ATTEMPTS_TODAY"))
+        swprintf(text, L"%d", word_810 + word_814);
+    else if (!strcmp(key, "RESCUES_TODAY"))
+        swprintf(text, L"%d", word_810);
+    else if (!strcmp(key, "STAFF_JOB_TITLE"))
+        swprintf(text, reinterpret_cast<const wchar_t*>(screen_text_lookup->LookupText("STAFFB_TITLE_LIFEGUARD")));
+    else if (!strcmp(key, "STAFF_BEACH_OPEN"))
+    {
+        if (variable_world->FindObject(home_id_100)->AsBuilding()->BeachOpen(0))
+            swprintf(text, L"%d", 1);
+        else
+            swprintf(text, L"%d", 0);
+    }
+    else if (!strncmp(key, "STAFF_BEACH_OPEN_STATUS_", 24))
+        swprintf(text, L"%d", 1);
+    else
+        WorldStaffEntity::ReadText(key, output);
+}
