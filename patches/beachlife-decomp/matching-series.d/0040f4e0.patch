+
+static inline int Width(TgaImage* image)
+{
+    return image->width;
+}
+
+static inline int Height(TgaImage* image)
+{
+    return image->height;
+}
+
+// FUNCTION: BEACHLIFE 0x0040f4e0
+void ScreenRequestRenderer::ResizeImages(TgaImage* source, TgaImage* destination)
+{
+    TgaImage* images[6];
+    images[0] = source;
+    int level = 0;
+    while (1)
+    {
+        int width = images[level]->width;
+        int target_width = destination->width;
+        if (width / 2 < target_width)
+            break;
+        level++;
+        images[level] = new TgaImage(Width(images[level - 1]) / 2, Height(images[level - 1]) / 2, 16, 0);
+        if (format_44 == 0)
+            ResizeImage565(images[level - 1], images[level]);
+        else
+            ResizeImage555(images[level - 1], images[level]);
+        if (level > 1)
+            delete images[level - 1];
+    }
+    if (format_44 == 0)
+        ResizeImage565(images[level], destination);
+    else
+        ResizeImage555(images[level], destination);
+    if (level > 0)
+        delete images[level];
+}
