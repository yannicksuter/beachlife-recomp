+#include "startup_world_subsystems.h"
+#include "startup_pointer_list_operations.h"
+#include "startup_world_entities.h"
+#include "startup_screen_overlay_layout.h"
+#include "window_activation.h"
+#include <stdlib.h>
+#include <string.h>
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x00420070
+unsigned int WorldCleaningManager::FindTask(const ScreenWorldPosition* position,
+    unsigned int* kind, unsigned char bins, unsigned char litter, unsigned char toilets)
+{
+    if (requests_00.empty())
+        return ~0u;
+    int best_score = 99999;
+    ScreenPoint tile = overlay_map->WorldToTile(position);
+    int score;
+    unsigned int candidate_kind;
+    WorldCleaningRequestList::iterator selected;
+    bool found = false;
+    for (WorldCleaningRequestList::iterator node = requests_00.begin(); node != requests_00.end();)
+    {
+        WorldCleaningRequest* request = *node;
+        WorldStaticEntity* entity = static_cast<WorldStaticEntity*>(variable_world->FindObject(request->id_00));
+        if (!entity)
+        {
+            delete *node;
+            requests_00.erase(node++);
+            continue;
+        }
+        ScreenPoint target = entity->TilePosition();
+        int distance = abs(target.x - tile.x) + abs(target.y - tile.y);
+        if (strcmp(entity->name_06, "Litter") == 0)
+        {
+            score = distance - 50;
+            candidate_kind = 0;
+        }
+        else if (strcmp(entity->name_06, "Bin") == 0)
+        {
+            score = distance - 70;
+            candidate_kind = 1;
+        }
+        else if (strcmp(entity->name_06, "LOO") == 0)
+        {
+            score = distance - 100;
+            candidate_kind = 2;
+        }
+        if (score < best_score)
+        {
+            switch (candidate_kind)
+            {
+            case 0:
+                if (litter && !entity->NeedsCleaning())
+                {
+                    selected = node;
+                    best_score = score;
+                    *kind = 0;
+                    found = true;
+                }
+                break;
+            case 1:
+                if (bins && !static_cast<WorldSceneryEntity*>(entity)->byte_a0
+                    && (!entity->NeedsCleaning() || !entity->NeedsRepair()))
+                {
+                    selected = node;
+                    best_score = score;
+                    *kind = 1;
+                    found = true;
+                }
+                break;
+            case 2:
+                if (toilets && !entity->FlagAt00460310() && !entity->FlagAt00460340() && !entity->NeedsCleaning()
+                    && !entity->NeedsRepair())
+                {
+                    selected = node;
+                    best_score = score;
+                    *kind = 2;
+                    found = true;
+                }
+                break;
+            }
+        }
+        ++node;
+    }
+    if (!found)
+        return ~0u;
+    unsigned int id = (*selected)->id_00;
+    AddAssignment(id, 0);
+    VariableEntity* assigned = variable_world->FindObject(id);
+    assigned->SetFlag5a(1);
+    delete *selected;
+    requests_00.erase(selected);
+    return id;
+}
