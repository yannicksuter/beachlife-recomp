+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_table.h"
+
+// FUNCTION: BEACHLIFE 0x004ac7d0
+void GuiParserState::ParseTable()
+{
+    const char* data = buffer;
+    while (
+        data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        ScreenRectangle initial;
+        ReadRectangle(initial, current_context);
+        ScreenRectangle content;
+        ReadRectangle(content, current_context);
+        char name[64];
+        ReadText(name);
+        int value_a;
+        ReadInteger(value_a, true);
+        int value_b;
+        ReadInteger(value_b, true);
+        int value_flag;
+        ReadInteger(value_flag, true);
+        bool flag = false;
+        if (value_flag)
+        {
+            flag = true;
+        }
+        ScreenTable* table = new ScreenTable(initial, content, name, value_a, value_b, flag);
+        RegisterItem(table, 0);
+        // The table stays open for its "<COL" entries.
+        alternate_context_14 = table;
+
+        data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+        // A missing open brace is not reported.
+        if (data[cursor] == '{')
+        {
+            ++cursor;
+        }
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_table - Script Error \r\nNo open bracket found at file "
+                     "offset - %u",
+            cursor);
+    }
+}
