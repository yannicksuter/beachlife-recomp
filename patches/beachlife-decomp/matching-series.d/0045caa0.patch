+// Rounds with the current FPU mode, as the retail fistp does.
+static inline void RoundBuildingCents(float value, int* result)
+{
+    __asm {
+        mov eax, result
+        fld value
+        fistp DWORD PTR [eax]
+    }
+}
+
+static inline void BuildingText(unsigned short* output, const char* name)
