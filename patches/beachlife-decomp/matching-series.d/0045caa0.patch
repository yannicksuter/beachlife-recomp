+    swprintf(output, L"%d", value);
+}
+
+static inline void BuildingMoney(unsigned short* output, float value)
+{
+    bool negative = false;
+    float fraction;
+    {
+        double integral;
+        fraction = modf(value, &integral);
+    }
+    if (value < 0.0f)
+        negative = true;
+    int whole = static_cast<int>(ceil(static_cast<float>(fabs(value)) * 100.0f)) / 100;
+    int cents;
+    RoundBuildingCents(fraction * 100.0f, &cents);
+    if (negative)
+        swprintf(output, L"-$%d.%02d", abs(whole), abs(cents));
+    else
+        swprintf(output, L"$%d.%02d", whole, abs(cents));
+    unsigned short* end = wcsrchr(output, L'.') + 3;
+    if (*end)
+        *end = 0;
+}
