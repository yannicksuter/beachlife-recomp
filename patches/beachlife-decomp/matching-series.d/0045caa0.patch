+        else if (strcmp(suffix, "_START_TIME") == 0)
+        {
+            float time = events_170->StartTime(index);
+            swprintf(output, Lookup()->LookupText("BI_EVENT_TIME"), index + 1, Game()->TimeHours(time), Game()->TimeMinutes(time));
+        }
+    }
+    else if (strcmp(key, "STAFF_BEACH_OPEN") == 0)
+    {
+        if (screen_terrain_grid->RouteEnabled(0, word_450) && screen_terrain_grid->RouteEnabled(1, word_450))
+            BuildingNumber(output, 1);
+        else
+            BuildingNumber(output, 0);
+    }
+    else if (strncmp(key, "STAFF_BEACH_OPEN_STATUS_", 24) == 0)
+    {
+        if (pending_staff_90 + staff_count_8c == 0)
+            BuildingNumber(output, 0);
+        else
+            BuildingNumber(output, 1);
+    }
+    else
+        StartupFatal("BuildingObject::GetVariable - data keyword not recognised - %s", key);
+}
