+#include "startup_screen_manager.h"
+#include "startup_screen_placement.h"
+#include "startup_screen_renderer.h"
+#include "startup_screen_load_dependencies.h"
+#include "startup_variable_state.h"
+#include "window_activation.h"
+#include "startup_application.h"
+
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004e3640
+void ScreenRequestGamePrefix::WriteInteger(const char* key, int* value)
+{
+    if (strcmp(key, "GAME_NUDGE") == 0)
+    {
+        if (*value)
+            placement->flag_34 = 1;
+        else
+            placement->flag_34 = 0;
+    }
+    else if (strcmp(key, "GAME_SEA") == 0)
+    {
+        if (*value)
+        {
+            placement->flag_35 = 1;
+            screen_request_renderer->SetSeaEnabled(1);
+        }
+        else
+        {
+            placement->flag_35 = 0;
+            screen_request_renderer->SetSeaEnabled(0);
+        }
+    }
+    else if (strcmp(key, "GAME_LIGHTS") == 0)
+    {
+        if (*value)
+            placement->flag_36 = 1;
+        else
+            placement->flag_36 = 0;
+    }
+    else if (strcmp(key, "GAME_KEYLINES") == 0)
+    {
+        if (*value)
+        {
+            placement->flag_37 = 1;
+            variable_world->SetKeylines(1);
+        }
+        else
+        {
+            placement->flag_37 = 0;
+            variable_world->SetKeylines(0);
+        }
+    }
+    else if (strcmp(key, "GAME_SCENARIO_SELECT") == 0)
+    {
+        scenario_a0 = *value;
+    }
+    else if (strcmp(key, "GAME_GAME_SPEED") == 0)
+    {
+        window_deactivation_state->SetGameSpeed(*value);
+    }
+    else if (strcmp(key, "PLAYLIST_MODE") == 0)
+    {
+        if (*value == 0)
+            screen_manager->panel_13c->HandleAction(9);
+        else
+            screen_manager->panel_13c->HandleAction(8);
+    }
+    else
+    {
+        StartupFatal("Unknown set variable in Game");
+    }
+}
