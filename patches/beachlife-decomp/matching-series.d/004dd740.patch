+static int SkipWhitespace(char*& cursor)
+{
+    int count = 0;
+    while (*cursor == ' ' || *cursor == '\r' || *cursor == '\n' || *cursor == '\t')
+    {
+        ++cursor;
+        ++count;
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x004dd740
+int WorldSubsystem20::ParseStateActions(unsigned int kind)
+{
+    word_358 = kind;
+    char token[64];
+    int count = ReadToken(token);
+    while (strcmp(token, "End") != 0)
+    {
+        if (strcmp(token, "Function") == 0)
+            count += ParseFunctionAction();
+        else if (strcmp(token, "Message") == 0)
+            count += ParseMessageAction();
+        else if (strcmp(token, "Create") == 0)
+            count += ParseCreateAction();
+        else if (strcmp(token, "Path") == 0)
+            count += ParsePathAction();
+        else if (strcmp(token, "Grass") == 0)
+            count += ParseGrassAction();
+        else if (strcmp(token, "LoadScript") == 0)
+            count += ParseLoadScriptAction();
+        else if (_stricmp(token, "Area") == 0)
+            count += ParseAreaAction();
+        else if (strcmp(token, "BoatPoint") == 0)
+            count += ParseBoatPointAction();
+        else if (strcmp(token, "BoatEntry") == 0)
+            count += ParseBoatEntryAction();
+        else if (strcmp(token, "BoatExit") == 0)
+            count += ParseBoatExitAction();
+        else if (strcmp(token, "BoatEvent") == 0)
+            count += ParseBoatEventAction();
+        else if (strcmp(token, "CircuitPoint") == 0)
+            count += ParseCircuitPointAction();
+        else if (strcmp(token, "Disaster") == 0)
+            count += ParseDisasterAction();
+        else if (strcmp(token, "Weather") == 0)
+            count += ParseWeatherAction();
+        else if (strcmp(token, "If") == 0)
+            count += ParseIfAction();
+        else if (strcmp(token, "Else") == 0)
+        {
+            if (word_04)
+                word_04->parsing_else_1c = 1;
+            else
+                StartupFatal("WorldScript::ProcessCommands - Else statement without if statement");
+        }
+        else if (strcmp(token, "Add") == 0)
+            count += ParseAddAction();
+        else if (strcmp(token, "Minus") == 0)
+            count += ParseMinusAction();
+        else if (strcmp(token, "Divide") == 0)
+            count += ParseDivideAction();
+        else if (strcmp(token, "Multiply") == 0)
+            count += ParseMultiplyAction();
+        else if (strcmp(token, "Set") == 0)
+            count += ParseSetAction();
+        else if (strcmp(token, "PlaySound") == 0)
+            count += ParsePlaySoundAction();
+        else if (strcmp(token, "MoveCamera") == 0)
+            count += ParseMoveCameraAction();
+        else if (strcmp(token, "ShowMenu") == 0)
+            count += ParseShowMenuAction();
+        else if (strcmp(token, "ChangeState") == 0)
+            count += ParseChangeStateAction();
+        count += ReadToken(token);
+    }
+    return count;
+}
