+            *type = static_cast<WorldRepairEntryNode*>(node)->_M_data->word_14;
+            ::operator delete(static_cast<WorldRepairEntryNode*>(node)->_M_data);
+            repairs_00.erase(WorldRepairList::iterator(static_cast<WorldRepairEntryNode*>(node)));
+        }
+        else
+        {
+            AddAssignment(target, 1, 2);
+            *type = 2;
+        }
+    }
+    else if (kind == 1)
