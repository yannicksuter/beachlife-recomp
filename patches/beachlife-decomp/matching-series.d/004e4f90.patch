+#include <windows.h>
+#include "startup_game_save_record.h"
+#include "startup_screen_list_box.h"
+#include "startup_screen_manager.h"
+#include "startup_screen_text.h"
+#include <stdio.h>
+#include <time.h>
+#include <wchar.h>
+
+static inline unsigned int SaveCount(const GameSaveRecordRange* saves)
+{
+    return saves->size();
+}
+
+// FUNCTION: BEACHLIFE 0x004e4f90
+void ScreenRequestGamePrefix::PopulateSaveList(
+    ScreenListBoxPrefix* list, unsigned int row_word, unsigned char clear)
+{
+    if (clear)
+    {
+        list->ClearEntries();
+    }
+    list->state_58 = 0;
+    unsigned int index = 0;
+    selected_save = 0;
+
+    unsigned int count = SaveCount(&saves);
+    for (; index < count; ++index, ++row_word)
+    {
+        GameSaveRecord* record = saves[index];
+        list->AddEntry(static_cast<int>(row_word), 0, 300, 15, 2, 0, 0, screen_text_lookup->LookupText(record->name_1c), 1);
+
+        // The original MSVCRT ABI uses 16-bit wchar_t and 32-bit time_t.
+        unsigned short text[128];
+        swprintf(text, screen_text_lookup->LookupText("LOADSAVE_INFO_CONTENTS"), record->day_0c + 1, static_cast<double>(record->cash_14));
+        list->AddEntry(static_cast<int>(row_word), 279, 106, 15, 2, 0, 0, text, 0);
+
+        time_t timestamp = record->time_04;
+        tm* local = localtime(&timestamp);
+        swprintf(text, screen_text_lookup->LookupText("LOADSAVE_TIME_CONTENTS"), local->tm_hour, local->tm_min, local->tm_mday, local->tm_mon + 1, local->tm_year + 1900);
+        list->AddEntry(static_cast<int>(row_word), 390, 115, 15, 2, 0, 0, text, 0);
+    }
+    if (count)
+    {
+        list->SelectRow(0, 1);
+    }
+}
