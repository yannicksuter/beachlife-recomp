+#include "startup_resource_rasters.h"
+
+// FUNCTION: BEACHLIFE 0x00407110
+void ResourceLightRaster(unsigned char* light, const unsigned char* source, unsigned short* palette,
+    unsigned int pitch, int x, int y, int width, int height, int left, int top, int right, int bottom)
+{
+    unsigned char* row = light + pitch * y + x;
+
+    // Nothing is clipped.
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int j = 0; j < height; j++)
+        {
+            unsigned char* output = row + j * pitch;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    column += count;
+                    packet -= count;
+                    do
+                    {
+                        if (*source - 24 > *output)
+                            *output = *source - 24;
+                        source++;
+                        output++;
+                    } while (--count != 0);
+                }
+                output -= packet;
+                column -= packet;
+            }
+        }
+        return;
+    }
+
+    // Left edge clipped.
+    if (left > 0)
+    {
+        for (int skip = top; skip > 0; skip--)
+        {
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet >= 0)
+                {
+                    column += packet;
+                    source += packet;
+                }
+                else
+                    column -= packet;
+            }
+        }
+
+        for (int j = 0; j < bottom - top; j++)
+        {
+            unsigned char* output = row + j * pitch;
+            int remaining_left = left;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = *source++;
+                if (packet > 0)
+                {
+                    int count = packet;
+                    packet -= count;
+                    do
+                    {
+                        if (remaining_left != 0)
+                            remaining_left--;
+                        else if (column < right)
+                        {
+                            if (*source - 24 > *output)
+                                *output = *source - 24;
+                            output++;
+                        }
+                        source++;
+                        column++;
+                    } while (--count != 0);
+                }
+                packet = -packet;
+                while (remaining_left != 0 && packet != 0)
+                {
+                    remaining_left--;
+                    column++;
+                    packet--;
+                }
+                column += packet;
+                output += packet;
+            }
+        }
+        return;
+    }
+
+    // Top, right or bottom edge clipped.
+    for (int skip = top; skip > 0; skip--)
+    {
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet >= 0)
+            {
+                column += packet;
+                source += packet;
+            }
+            else
+                column -= packet;
+        }
+    }
+
+    for (int j = 0; j < bottom - top; j++)
+    {
+        unsigned char* output = row + j * pitch;
+        int column = 0;
+        while (column < width)
+        {
+            signed char packet = *source++;
+            if (packet >= 0)
+            {
+                while (packet--)
+                {
+                    if (column < right)
+                    {
+                        if (*source - 24 > *output)
+                            *output = *source - 24;
+                        output++;
+                    }
+                    source++;
+                    column++;
+                }
+            }
+            else
+            {
+                if (column < right)
+                    output -= packet;
+                column -= packet;
+            }
+        }
+    }
+}
