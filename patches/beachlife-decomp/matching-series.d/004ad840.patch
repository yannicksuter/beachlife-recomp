+#include "startup_renderer_display.h"
+#include "startup_gui_parser.h"
+#include "startup_screen_list_box.h"
+
+// FUNCTION: BEACHLIFE 0x004ad840
+void GuiParserState::ParseListBox()
+{
+    const char* data = buffer;
+    if (data[cursor] == '(')
+    {
+        ++cursor;
+        while (
+            data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+
+        ScreenRectangle initial;
+        ReadRectangle(initial, current_context);
+        ScreenRectangle inner;
+        ReadRectangle(inner, current_context);
+        char name[64];
+        ReadText(name);
+        int first_word;
+        ReadInteger(first_word, true);
+        int second_word;
+        ReadInteger(second_word, true);
+        ScreenListBoxPrefix* item = new ScreenListBoxPrefix(initial,
+            inner,
+            name,
+            static_cast<unsigned int>(first_word),
+            static_cast<unsigned int>(second_word));
+        RegisterItem(item, 0);
+    }
+    else
+    {
+        StartupFatal("GUIManager::ProcessListBox - Script Error \r\nNo open bracket found at file "
+                     "offset - %u",
+            cursor);
+    }
+}
