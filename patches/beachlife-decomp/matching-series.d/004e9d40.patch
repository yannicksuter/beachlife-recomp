+// FUNCTION: BEACHLIFE 0x004e9d40
+void WorldTestController::UpdateCrowdSound(float level)
+{
+    float maximum = CrowdMaximum(animation_sounds);
+    float fade = CrowdFade(animation_sounds);
+    unsigned int count = overlay_map->visible_count_158;
+    float crowd = static_cast<float>(count) / CrowdDivisor(animation_sounds) * maximum;
+    if (crowd > maximum)
+        crowd = maximum;
+    if (fabs(crowd - ambience_time_a0) < FLT_EPSILON)
+        return;
+    window_audio_state->FadeSoundLevel(crowd_94, crowd, fade);
+    ambience_time_a0 = crowd;
+    float time = window_deactivation_state->render_value_160;
+    if (time > 21.0f || time < 5.0f)
+    {
+        if (level < crowd_cricket_wave_limit)
+        {
+            window_audio_state->FadeSoundLevel(crickets_98, crowd_cricket_level - crowd, fade);
+            return;
+        }
+    }
+    window_audio_state->FadeSoundLevel(crickets_98, 0.0f, fade);
+}
+
