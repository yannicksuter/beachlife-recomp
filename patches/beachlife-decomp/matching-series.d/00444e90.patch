+VariableEntity** LowerBoundPointer(VariableEntity** first, VariableEntity** last, VariableEntity* const& value, BuildingNameOrder order)
+{
+    int count = static_cast<int>(last - first);
+    while (count > 0)
+    {
+        int half = count >> 1;
+        VariableEntity** middle = first + half;
+        bool before = strcmp((*middle)->AsBuilding()->building_60->name_04 + 0x40, (value)->AsBuilding()->building_60->name_04 + 0x40) < 0;
+        if (before)
+        {
+            first = middle + 1;
+            count -= half + 1;
+        }
+        else
+            count = half;
+    }
+    return first;
+}
