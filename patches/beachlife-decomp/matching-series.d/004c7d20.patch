+#include "startup_screen_frame_draw.h"
+#include "startup_screen_dialog_resource.h"
+#include "startup_screen_frame_resources.h"
+#include "startup_screen_item.h"
+#include "startup_screen_renderer.h"
+
+static inline int FrameHeight(ScreenDialogResource* resource)
+{
+    return resource->record->frames[resource->word_10]->height_10;
+}
+
+// FUNCTION: BEACHLIFE 0x004c7d20
+void DrawFrameStyle4(const ScreenRectangle& rectangle)
+{
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    int x = rectangle.left;
+    int top = rectangle.top;
+    int bottom = rectangle.bottom - 1;
+    unsigned short colour;
+    colour = renderer->ConvertColour(0xb7, 0xce, 0xfe);
+    renderer->DrawLine(x, top, x, bottom, colour);
+    ++x;
+    colour = renderer->ConvertColour(0xb2, 0xc9, 0xfe);
+    renderer->DrawLine(x, top, x, bottom, colour);
+    ++x;
+    colour = renderer->ConvertColour(0xa0, 0xbc, 0xfd);
+    renderer->DrawLine(x, top, x, bottom, colour);
+    ++x;
+    colour = renderer->ConvertColour(0x93, 0xb2, 0xfd);
+    ScreenRectangle fill;
+    fill.left = x;
+    fill.top = top;
+    fill.bottom = bottom;
+    fill.right = x + 8;
+    renderer->FillRectangle(fill, colour);
+    x += 8;
+    colour = renderer->ConvertColour(0x83, 0xa2, 0xfa);
+    renderer->DrawLine(x, top, x, bottom, colour);
+    ++x;
+    colour = renderer->ConvertColour(0x5a, 0x7b, 0xf2);
+    renderer->DrawLine(x, top, x, bottom, colour);
+    ++x;
+    colour = renderer->ConvertColour(0x2e, 0x51, 0xe9);
+    renderer->DrawLine(x, top, x, bottom, colour);
+    ScreenDialogResource* resource = screen_dialog_resources->Lookup(screen_frame_style4_name);
+    resource->word_08 = 3;
+    resource->word_14 = 0;
+    resource->Draw(rectangle.left, rectangle.top, 0, 999999.0f);
+    resource->word_14 = 1;
+    resource->Draw(rectangle.left, rectangle.bottom - FrameHeight(resource), 0, 999999.0f);
+    screen_dialog_resources->Release(resource);
+}
