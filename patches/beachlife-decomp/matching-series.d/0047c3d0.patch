+
+// Retail copies the renderer clip rectangle for each field it reads (by-value accessor).
+static inline RenderRectangle ClipRectangle(ScreenRequestRenderer* renderer)
+{
+    return renderer->clip_rectangle;
+}
+
+// The other entity's position is read through a by-value copy (out-of-line copy constructor).
+static inline ScreenWorldPosition WorldPositionOf(VariableEntity* entity)
+{
+    return entity->position_30;
+}
+
+// FUNCTION: BEACHLIFE 0x0047c3d0
+unsigned char VariableEntity::MatchesPointerGroup(int previous)
+{
+    unsigned char result = 0;
+    VariableEntity* other = variable_world->FindObject(previous);
+    if (other)
+    {
+        ScreenWorldPosition other_position = WorldPositionOf(other);
+        if (position_30.y >= other_position.y)
+            result = 1;
+        else
+        {
+            ScreenPoint point = overlay_map->WorldToScreen(position_30);
+            if (screen_request_renderer->clip_mode_54 == 2)
+            {
+                point.x /= 2;
+                point.y /= 2;
+            }
+            if (point.x < 0)
+                point.x = 0;
+            if (point.y < 0)
+                point.y = 0;
+            if (point.x >= ClipRectangle(screen_request_renderer).width)
+                point.x = ClipRectangle(screen_request_renderer).width - 1;
+            if (point.y >= ClipRectangle(screen_request_renderer).height)
+                point.y = ClipRectangle(screen_request_renderer).height - 1;
+            unsigned short depth = overlay_map->DepthAt(&position_30) + 48;
+            ScreenTerrainGrid* terrain = screen_terrain_grid;
+            const ScreenPoint* tile = &TilePosition();
+            unsigned int index = (static_cast<unsigned int>(tile->y) % terrain->height_08) * terrain->width_04
+                               + static_cast<unsigned int>(tile->x) % terrain->width_04;
+            unsigned short combined = static_cast<unsigned short>(terrain->cells_0c[index].depth_50 + depth);
+            unsigned int pixel = reinterpret_cast<const unsigned int*>(
+                screen_request_renderer->pixels_1c)[screen_request_renderer->width * point.y + point.x];
+            if (combined >= static_cast<unsigned short>(pixel >> 16))
+                result = 1;
+        }
+    }
+    return result;
+}
