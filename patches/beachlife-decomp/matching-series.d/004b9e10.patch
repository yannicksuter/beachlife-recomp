+static inline ScreenRequestContext* const& MedianStaffRow(ScreenRequestContext* const& a,
+    ScreenRequestContext* const& b, ScreenRequestContext* const& c, ScreenTableStaffOrder)
+{
+    if (a->id_28 < b->id_28)
+        if (b->id_28 < c->id_28)
+            return b;
+        else if (a->id_28 < c->id_28)
+            return c;
+        else
+            return a;
+    else if (a->id_28 < c->id_28)
+        return a;
+    else if (b->id_28 < c->id_28)
+        return c;
+    else
+        return b;
+}
+
+static inline ScreenRequestContext** PartitionStaffRows(ScreenRequestContext** first, ScreenRequestContext** last,
+    ScreenRequestContext* pivot, ScreenTableStaffOrder)
+{
+    while (true)
+    {
+        while ((*first)->id_28 < pivot->id_28)
+            ++first;
+        --last;
+        while (pivot->id_28 < (*last)->id_28)
+            --last;
+        if (!(first < last))
+            return first;
+        ScreenRequestContext* swapped = *first;
+        *first = *last;
+        *last = swapped;
+        ++first;
+    }
+}
+
+static inline void SortStaffRowHeap(ScreenRequestContext** first, ScreenRequestContext** last, ScreenTableStaffOrder order)
+{
+    while (last - first > 1)
+    {
+        ScreenRequestContext** end = last--;
+        PopStaffRowHeap(first, end - 1, end - 1, *(end - 1), order, 0);
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x004b9e10
+void IntrosortStaffRows(ScreenRequestContext** first, ScreenRequestContext** last, ScreenRequestContext**, int depth,
+    ScreenTableStaffOrder order)
+{
+    while (last - first > 16)
+    {
+        if (depth == 0)
+        {
+            MakeStaffRowHeap(first, last, order, 0, 0);
+            SortStaffRowHeap(first, last, order);
+            return;
+        }
+        --depth;
+        ScreenRequestContext** cut = PartitionStaffRows(
+            first, last, MedianStaffRow(*first, *(first + (last - first) / 2), *(last - 1), order), order);
+        IntrosortStaffRows(cut, last, 0, depth, order);
+        last = cut;
+    }
+}
