+// FUNCTION: BEACHLIFE 0x00415210
+void ScreenDialogResource::BurnTerrainTiles(int tile_x, int tile_y, int offset_x, int offset_y,
+    unsigned short depth)
+{
+    const unsigned char* data = SelectedFrame()->SelectData(word_14, word_18);
+    OverlayMapPrefix* map = overlay_map;
+    const unsigned short* palette = record->palettes[0];
+    int width = SelectedFrame()->width_0e;
+    int height = SelectedFrame()->height_10;
+    int size = map->tile_size_dc;
+    unsigned short half = RenderHalfMask();
+    unsigned short quarter = RenderQuarterMask();
+    int frame_y = SelectedFrame()->word_14;
+    unsigned int row_depth = (depth + frame_y * 0xfff8) << 16;
+    unsigned int pixel_depth;
+    unsigned short colour;
+    for (int row = 0; row < height; ++row)
+    {
+        if (frame_y++ < 0)
+            row_depth -= 0x80000;
+        else
+            row_depth += 0x100000;
+        int column = 0;
+        while (column < width)
+        {
+            signed char run = *data++;
+            if (run > 0)
+            {
+                int y = offset_y + row;
+                for (; run > 0; --run)
+                {
+                    int x = offset_x + column;
+                    int view_x = tile_x + x / size;
+                    int active_y = tile_y + y / size;
+                    if (!map->cached_tiles_e0[active_y * map->cache_height_d8 + view_x].ready)
+                        map->MapCachedTile(view_x, active_y);
+                    if (!map->cached_tiles_e0[active_y * map->cache_width_d4 + view_x].ready)
+                        map->MapCachedTile(view_x, active_y);
+                    unsigned int* view = static_cast<unsigned int*>(map->cached_tiles_e0[active_y * map->cache_width_d4 + view_x].view);
+                    int index = (y % 128) * 128 + x % 128;
+                    unsigned int old_depth = view[index] & 0xffff0000;
+                    if (old_depth <= row_depth)
+                    {
+                        unsigned char mode = *data & 0xc0;
+                        unsigned short source = palette[*data - mode];
+                        unsigned short target = static_cast<unsigned short>(view[index]);
+                        switch (mode)
+                        {
+                        case 0x00:
+                            colour = source;
+                            pixel_depth = row_depth;
+                            break;
+                        case 0x40:
+                            colour = ((source >> 1) & (half >> 1)) + ((target >> 2) & (quarter >> 2)) + ((source >> 2) & (quarter >> 2));
+                            pixel_depth = old_depth;
+                            break;
+                        case 0x80:
+                            colour = ((target >> 1) & (half >> 1)) + ((source >> 1) & (half >> 1));
+                            pixel_depth = old_depth;
+                            break;
+                        case 0xc0:
+                            colour = ((target >> 1) & (half >> 1)) + ((target >> 2) & (quarter >> 2)) + ((source >> 2) & (quarter >> 2));
+                            pixel_depth = old_depth;
+                            break;
+                        }
+                        view[index] = pixel_depth + colour;
+                    }
+                    ++data;
+                    ++column;
+                }
+            }
+            column -= run;
+        }
+    }
+}
