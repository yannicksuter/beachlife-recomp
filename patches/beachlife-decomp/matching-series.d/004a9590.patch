+
+static inline void AssignPosition(ScreenWorldPosition& target, const ScreenWorldPosition& source)
+{
+    target.x = source.x;
+    target.y = source.y;
+    target.z = source.z;
+}
+
+// Retail passes the address of TilePosition's returned temporary straight to DrawWorld.
+static inline const ScreenWorldPosition* PositionAddress(const ScreenWorldPosition& position)
+{
+    return &position;
+}
+
+// Retail copies WorldToTile's result through a by-value point (as SetTile in the mode 9/10 handlers).
+static inline void AssignPoint(ScreenPoint& target, ScreenPoint source)
+{
+    target = source;
+}
+
+// FUNCTION: BEACHLIFE 0x004a9590
+void ScreenMode1Controller::RenderScreens()
+{
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    ScreenTerrainGrid* grid = screen_terrain_grid;
+    OverlayMapPrefix* map = overlay_map;
+    if (manager->IsPointerOverScreen(1))
+    {
+        startup_input_motion_state->SetCursor(0);
+        return;
+    }
+    ScreenPoint point;
+    point = startup_input_motion_state->Position();
+    point.x += map->scroll_x_c4;
+    point.y += map->scroll_y_c8;
+    ScreenWorldPosition position;
+    AssignPosition(position, map->ScreenToWorld(point));
+    ScreenPoint tile;
+    AssignPoint(tile, CurrentScreenTerrain()->WorldToTile(position));
+    AdjustTile(&tile);
+    ScreenPoint preview_tile = tile;
+    grid->TilePosition(tile, 4);
+    unsigned char valid = CanPlace(&tile);
+    unsigned short colour;
+    float money = window_deactivation_state->economy_1c->value_80;
+    money -= static_cast<unsigned int>(scenery_08->cost_2d0);
+    if (money < 0.0f)
+        valid = 0;
+    if (!valid)
+    {
+        startup_input_motion_state->SetCursor(5);
+        colour = invalid_colour_16;
+    }
+    else
+    {
+        startup_input_motion_state->SetCursor(0);
+        colour = valid_colour_14;
+    }
+    int width = scenery_08->footprint_x_2c8;
+    int height = scenery_08->footprint_y_2cc;
+    if (word_0c->word_18 & 1)
+    {
+        int temporary = width;
+        width = height;
+        height = temporary;
+    }
+    ScreenPoint current = tile;
+    for (int row = 0; row < width; ++row)
+    {
+        for (int column = 0; column < height; ++column)
+        {
+            manager->DrawPlacementTile(current, colour);
+            grid->Step(current.x, current.y, 0, &current);
+        }
+        grid->Step(tile.x, tile.y, 6, &tile);
+        current = tile;
+    }
+    renderer->SetUnscaledClip(0);
+    float time = window_deactivation_state->time_158;
+    word_0c->DrawWorld(PositionAddress(grid->TilePosition(preview_tile, 4)), time);
+    renderer->SetUnscaledClip(1);
+}
