+static inline void PlotPixel(int* pixel, unsigned short colour)
+{
+    *pixel = (*pixel & 0xffff0000) + colour;
+}
+
+// FUNCTION: BEACHLIFE 0x00411560
+void RasterLineDirectX(int x, int y, int delta_x, int delta_y, int direction,
+    unsigned int colour, unsigned short* pixels, unsigned int stride)
+{
+    int* destination = reinterpret_cast<int*>(pixels);
+    int twice_y = delta_y * 2;
+    int diagonal = twice_y - delta_x * 2;
+    int error = twice_y - delta_x;
+    if (static_cast<unsigned int>(x) < screen_request_renderer->width && static_cast<unsigned int>(y) < screen_request_renderer->height)
+        PlotPixel(&destination[y * stride + x], colour);
+    while (delta_x--)
+    {
+        if (error >= 0)
+        {
+            y++;
+            error += diagonal;
+        }
+        else
+        {
+            error += twice_y;
+        }
+        x += direction;
+        if (static_cast<unsigned int>(x) < screen_request_renderer->width && static_cast<unsigned int>(y) < screen_request_renderer->height)
+            PlotPixel(&destination[y * stride + x], colour);
+    }
+}
