+#include "startup_screen_dialog_resource.h"
+#include "startup_screen_dialog_resource_inlines.h"
+#include "startup_screen_variable_image.h"
+#include <stdio.h>
+
+// SelectVariant as retail expands it here, through the inline SelectedFrame.
+static inline void ShowVariant(ScreenDialogResource* resource, int variant)
+{
+    if (variant >= resource->SelectedFrame()->plane_count_0c)
+    {
+        char message[80];
+        variant = resource->SelectedFrame()->plane_count_0c - 1;
+        sprintf(message, "%s %d", resource->name, variant);
+    }
+    resource->word_18 = variant;
+}
+
+// FUNCTION: BEACHLIFE 0x004cd630
+void DrawRatingStars(const char* resource, ScreenRectangle bounds, int count)
+{
+    ScreenDialogResource* image = screen_dialog_resources->Find(resource);
+    int width = image->SelectedFrame()->width_0e;
+    unsigned int threshold = 10;
+    unsigned int upper = threshold + 10;
+    int x = bounds.left;
+    int remaining = 5;
+    while (remaining-- != 0)
+    {
+        ShowVariant(image, 0);
+        if (static_cast<unsigned int>(count) >= threshold)
+            ShowVariant(image, 1);
+        if (static_cast<unsigned int>(count) >= upper)
+            ShowVariant(image, 2);
+        image->Draw(x, bounds.top, 0, 999999.0f);
+        x += width;
+        threshold += 20;
+        upper = threshold + 10;
+    }
+    screen_dialog_resources->Release(image);
+}
