--- /dev/null
+++ b/src/startup_screen_table_storage.h
@@ -0,0 +1,47 @@
+#ifndef STARTUP_SCREEN_TABLE_STORAGE_H
+#define STARTUP_SCREEN_TABLE_STORAGE_H
+
+#include "pool_return.h"
+
+#include <new>
+
+// The table and column use three-pointer VC6 vectors. Elements are borrowed
+// pointers; callers explicitly destroy owned widgets before clearing them.
+// Pointer-size changes affect the native allocation's pool size class.
+template <class T>
+struct ScreenTableStorage
+{
+    T* begin;
+    T* end;
+    T* limit;
+
+    ScreenTableStorage()
+        : begin(0)
+        , end(0)
+        , limit(0)
+    {
+    }
+    ~ScreenTableStorage()
+    {
+        if (begin)
+        {
+            unsigned int bytes = static_cast<unsigned int>(limit - begin) * sizeof(T);
+            if (bytes > 128)
+            {
+                ::operator delete(begin);
+            }
+            else
+            {
+                ReturnPool(begin, bytes);
+            }
+        }
+    }
+
+    // The erase(begin,end) instances are expanded inline in the retail bodies.
+    void Clear()
+    {
+        end = begin;
+    }
+};
+
+#endif
