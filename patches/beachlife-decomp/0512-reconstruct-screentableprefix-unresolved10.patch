+#include "pool_return.h"
+#include "startup_screen_table.h"
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004b95c0
+ScreenTableIterator ScreenTableChildRing::Insert(
+    ScreenTableIterator position, ScreenTableChildPrefix* const& item)
+{
+    ScreenTableNode* node = CreateNode(item);
+    ScreenTableNode* previous = position.node->previous;
+    node->next = position.node;
+    node->previous = previous;
+    previous->next = node;
+    position.node->previous = node;
+    ScreenTableIterator result;
+    result.node = node;
+    return result;
+}
