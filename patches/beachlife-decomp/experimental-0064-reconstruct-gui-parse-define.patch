+++ b/src/startup_gui_parse_define.cpp
@@ -0,0 +1,50 @@
+#include "startup_gui_parser.h"
+#include "startup_gui_defined_item.h"
+#include "startup_screen_child_link.h"
+
+void StartupFatal(const char* format, ...);
+
+// FUNCTION: BEACHLIFE 0x004ac360
+void GuiParserState::ParseDefine()
+{
+    const char* data = buffer;
+    while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+
+    char name[64];
+    ReadText(name);
+    GuiDefinedItem* item = new GuiDefinedItem(name);
+
+    data = buffer;
+    while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+    if (data[cursor] == '{')
+    {
+        ++cursor;
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_define - Script Error \r\nNo open bracket found at file offset - %u", cursor);
+    }
+
+    RegisterItem(item, 0);
+    PushContext(item);
+
+    ScreenChildLink* tail = defined_items;
+    if (tail)
+    {
+        while (tail->next)
+        {
+            tail = tail->next;
+        }
+        tail->next = new ScreenChildLink(item);
+    }
+    else
+    {
+        defined_items = new ScreenChildLink(item);
+    }
+}
