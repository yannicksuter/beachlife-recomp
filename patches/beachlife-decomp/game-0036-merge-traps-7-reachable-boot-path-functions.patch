+struct ShadedChannels
+{
+    unsigned short red;
+    unsigned short green;
+    unsigned short blue;
+    unsigned short Colour() const { return static_cast<unsigned short>(red + green + blue); }
+};
+
+inline ShadedChannels Shade(const unsigned short* table, unsigned short pixel, bool rgb555, unsigned int light)
+{
+    unsigned int base = light * 128;
+    return { table[base + (pixel >> (rgb555 ? 10 : 11))],
+        table[base + 32 + ((pixel >> 5) & (rgb555 ? 31 : 63))],
+        table[base + (rgb555 ? 64 : 96) + (pixel & 31)] };
+}
+
+inline unsigned short Average(const ShadedChannels& current, const ShadedChannels& previous, bool rgb555)
+{
+    unsigned short red = rgb555
+                           ? static_cast<unsigned short>(current.red + previous.red) >> 1
+                           : static_cast<unsigned short>((current.red >> 1) + (previous.red >> 1));
+    unsigned short green = static_cast<unsigned short>(current.green + previous.green) >> 1;
+    unsigned short blue = static_cast<unsigned short>(current.blue + previous.blue) >> 1;
+    return static_cast<unsigned short>((red & (rgb555 ? 0x7c00 : 0xf800))
+                                       + (green & (rgb555 ? 0x3e0 : 0x7e0)) + (blue & 31));
+}
+
+inline void Timestamp(unsigned int& low, unsigned int& high)
+{
+    uint64_t ticks = ReadStartupTimestampCounter();
+    low = static_cast<unsigned int>(ticks);
+    high = static_cast<unsigned int>(ticks >> 32);
+}
