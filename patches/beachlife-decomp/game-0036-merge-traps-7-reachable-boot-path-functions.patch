diff --git a/src/startup_world_deque.h b/src/startup_world_deque.h
new file mode 100644
index 0000000000000000000000000000000000000000..294a5522431d711a751a0909b5cb775c24549b4f
--- /dev/null
+++ b/src/startup_world_deque.h
@@ -0,0 +1,67 @@
+#ifndef STARTUP_WORLD_DEQUE_H
+#define STARTUP_WORLD_DEQUE_H
+
+#include "pool_return.h"
+#include <new>
+
+// The event and weather deques use 32-element blocks and four-pointer iterators.
+template <class T>
+struct WorldDequeIterator
+{
+    T* current;
+    T* first;
+    T* last;
+    T** node;
+};
+
+template <class T>
+struct WorldDequeStorage
+{
+    WorldDequeIterator<T> begin;
+    WorldDequeIterator<T> end;
+    T** map;
+    unsigned int map_count;
+
+    T& At(int index)
+    {
+        int offset = static_cast<int>(begin.current - begin.first) + index;
+        if (offset >= 0 && offset < 32)
+            return begin.current[index];
+        int block = offset > 0 ? offset / 32 : (offset + 1) / 32 - 1;
+        return begin.node[block][offset - block * 32];
+    }
+
+    static void FreeSlots(void* storage, unsigned int bytes)
+    {
+        if (storage)
+        {
+            if (bytes > 128)
+                ::operator delete(storage);
+            else
+                ReturnPool(storage, bytes);
+        }
+    }
+
+    // Inline deque clear: retain the first block and the map.
+    void Clear()
+    {
+        for (T** node = begin.node + 1; node < end.node; ++node)
+            FreeSlots(*node, 32 * sizeof(T));
+        if (begin.node != end.node)
+            FreeSlots(end.first, 32 * sizeof(T));
+        end = begin;
+    }
+
+    // Trivial elements have the folded empty destruction callback.
+    void ReleaseStorage()
+    {
+        if (map)
+        {
+            for (T** node = begin.node; node < end.node + 1; ++node)
+                FreeSlots(*node, 32 * sizeof(T));
+            FreeSlots(map, map_count * sizeof(T*));
+        }
+    }
+};
+
+#endif
