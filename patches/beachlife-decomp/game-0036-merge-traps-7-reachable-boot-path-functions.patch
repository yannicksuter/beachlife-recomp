+#ifndef STARTUP_LIST_TYPES_H
+#define STARTUP_LIST_TYPES_H
+
+struct ActiveScreenEntry;
+
+struct SavedScreenPlacement;
+struct WorldTransportRecord;
+struct WorldCleaningRequest;
+struct WorldCleaningAssignment;
+struct SavedScreenPlacementNode;
+
+// Observed node prefix only; the original value type is unknown.
+struct CircularListNode
+{
+    CircularListNode* next;
+    CircularListNode* previous;
+};
+
+struct CircularListIterator
+{
+    CircularListNode* node;
+
+    CircularListIterator() { }
+    // Explicitly retain the implicit memberwise assignment on modern C++.
+    CircularListIterator& operator=(const CircularListIterator&) = default;
+    CircularListIterator(const CircularListIterator& other)
+        : node(other.node)
+    {
+    }
+};
+
+// Observed pointer payload at x86+8. This prefix does not define the 16-byte
+// allocator slot or recover the original generic node declaration.
+struct CircularListValueNode : CircularListNode
+{
+    ActiveScreenEntry* entry;
+};
+
+// Preserve the observed eight-byte pool quantum on the native pointer ABI.
+inline constexpr unsigned int circular_list_node_slot_bytes = (sizeof(CircularListValueNode) + 7u) & ~7u;
+static_assert(alignof(CircularListValueNode) <= 8);
+static_assert(circular_list_node_slot_bytes >= sizeof(CircularListValueNode),
+    "native node does not fit its pool slot");
+static_assert(circular_list_node_slot_bytes <= 128);
+
+// Observed container prefix only; allocator and full library types are unknown.
+struct CircularList
+{
+    CircularListNode* head;
+
+    // Actual 0x004e81d0; releases nodes while retaining the real sentinel.
+    void Clear();
+    void ReleaseStorage(); // 0x004b2f10.
+    bool Empty() const
+    {
+        return head->next == head;
+    }
+    ActiveScreenEntry* Front() const
+    {
+        return static_cast<CircularListValueNode*>(head->next)->entry;
+    }
+    // Actual 0x004209d0; hidden iterator result plus position, RET8.
+    CircularListIterator Erase(CircularListIterator position);
+    CircularListIterator End() const;
+    CircularListIterator Begin() const;
+    CircularListIterator Insert(CircularListIterator position, ActiveScreenEntry* const& entry);
+    CircularListIterator Insert(
+        CircularListIterator position, SavedScreenPlacement* const& placement);
+    CircularListIterator Insert(CircularListIterator position, WorldTransportRecord* const& record);    // 0x0042d940.
+    CircularListIterator Insert(CircularListIterator position, WorldCleaningRequest* const& record);    // 0x00420b40.
+    CircularListIterator Insert(CircularListIterator position, WorldCleaningAssignment* const& record); // 0x00420bb0.
+    CircularListValueNode* CreateNode(ActiveScreenEntry* const& entry);
+    SavedScreenPlacementNode* CreateNode(SavedScreenPlacement* const& placement);
+};
+
+#endif
