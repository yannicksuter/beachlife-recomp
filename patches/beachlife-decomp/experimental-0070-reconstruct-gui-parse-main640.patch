+++ b/src/startup_gui_parse_main640.cpp
@@ -0,0 +1,52 @@
+#include "startup_gui_parser.h"
+#include "startup_screen_frame_item.h"
+#include "startup_screen_manager.h"
+#include "startup_screen_renderer.h"
+
+void StartupFatal(const char* format, ...);
+
+// FUNCTION: BEACHLIFE 0x004abad0
+void GuiParserState::ParseMainItem640()
+{
+    if (screen_request_renderer->width != 640u)
+    {
+        const char* data = buffer;
+        while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+        {
+            ++cursor;
+        }
+        if (data[cursor] == '{')
+        {
+            ++cursor;
+            unsigned int nesting = 1;
+            do
+            {
+                char value = data[cursor];
+                if (value == '{')
+                    ++nesting;
+                if (value == '}')
+                    --nesting;
+                ++cursor;
+            } while (nesting != 0);
+        }
+        return;
+    }
+
+    ScreenRectangle rectangle = { 0, 0, 0, 0 };
+    ScreenFrameItem* item = new ScreenFrameItem(rectangle, 0);
+    manager->item_90 = item;
+    const char* data = buffer;
+    while (data[cursor] == ' ' || data[cursor] == '\r' || data[cursor] == '\n' || data[cursor] == '\t')
+    {
+        ++cursor;
+    }
+    if (data[cursor] == '{')
+    {
+        PushContext(item);
+        ++cursor;
+    }
+    else
+    {
+        StartupFatal("GUIManager::process_main - Script Error \r\nNo open brace found at file offset - %u", cursor);
+    }
+}
