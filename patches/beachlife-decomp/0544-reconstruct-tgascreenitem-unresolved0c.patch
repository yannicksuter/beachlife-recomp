+#include "startup_screen_renderer.h"
+#include "startup_screen_item.h"
+
+// FUNCTION: BEACHLIFE 0x0040cb10
+bool ScreenRequestRenderer::ClipRectangle(int& destination_x, int& destination_y,
+    int& source_left, int& source_top, int& source_right, int& source_bottom)
+{
+    int clip_left = clip_rectangle.x;
+    int clip_top = clip_rectangle.y;
+    int clip_right;
+    int clip_bottom;
+
+    // The source-level default is unresolved. The proposed defined domain uses
+    // modes 0/1/2, or an active unscaled flag; no fallback is invented here.
+    if ((unscaled_clip_5c != 0 && clip_flag_5d == 0) || clip_mode_54 == 1 || unscaled_clip_5c != 0)
+    {
+        clip_right = clip_left + clip_rectangle.width;
+        clip_bottom = clip_top + clip_rectangle.height;
+    }
+    else if (clip_mode_54 == 2)
+    {
+        clip_right = clip_left + clip_rectangle.width * 2;
+        clip_bottom = clip_top + clip_rectangle.height * 2;
+    }
+    else if (clip_mode_54 == 0)
+    {
+        clip_right = clip_left + static_cast<int>(static_cast<unsigned int>(clip_rectangle.width) >> 1);
+        clip_bottom = clip_top + static_cast<int>(static_cast<unsigned int>(clip_rectangle.height) >> 1);
+    }
+
+    if (destination_x > clip_right)
+    {
+        return false;
+    }
+    if (destination_y > clip_bottom)
+    {
+        return false;
+    }
+    if (source_right - source_left + destination_x < clip_left)
+    {
+        return false;
+    }
+    if (destination_y - source_top + source_bottom < clip_top)
+    {
+        return false;
+    }
+
+    if (destination_x < clip_left)
+    {
+        int amount = clip_left - destination_x;
+        destination_x += amount;
+        source_left += amount;
+    }
+    if (source_right - source_left + destination_x > clip_right)
+    {
+        source_right = source_left - destination_x + clip_right;
+    }
+    if (destination_y < clip_top)
+    {
+        int amount = clip_top - destination_y;
+        destination_y += amount;
+        source_top += amount;
+    }
+    if (destination_y - source_top + source_bottom > clip_bottom)
+    {
+        source_bottom = source_top - destination_y + clip_bottom;
+    }
+
+    if (rectangle_enabled_4e != 0 && rectangle_suppressed_4d == 0 && rectangle_ready_4f != 0)
+    {
+        ScreenRectangle bounds = { destination_x, destination_y, source_right - source_left + destination_x, destination_y - source_top + source_bottom };
+        AccumulateRectangle(bounds);
+    }
+    return true;
+}
