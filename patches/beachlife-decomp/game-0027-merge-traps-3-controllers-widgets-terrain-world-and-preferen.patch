+                    if (!(happiness >= 0.22f))
+                        happiness = 0.22f;
+                    guest->SetHappiness(happiness);
+                }
+                ++window_deactivation_state->guests_43c;
+                command.words[0] = -2;
+                command.words[1] = guest->id_28;
+                command.words[2] = 3;
+                command.words[3] = 0;
+                command.words[4] = 0;
+                screen_mode_commands->QueueCommand(&command);
+                command.words[0] = -2;
+                command.words[1] = guest->id_28;
+                command.words[2] = 63;
+                command.words[3] = 0;
+                command.words[4] = 0;
+                ScreenModeCommandQueue* queue = screen_mode_commands;
+                queue->QueueDelayed(&command, static_cast<float>(rand() * static_cast<double>(1.0f / 32767.0f) * 2.0));
+                vehicle->passengers_10c[vehicle->passenger_count_5bc] = guest->id_28;
+                ++vehicle->passenger_count_5bc;
+            }
+            command.words[0] = -2;
+            command.words[1] = vehicle->id_28;
+            command.words[2] = 3;
+            command.words[3] = 0;
+            command.words[4] = 71;
+            screen_mode_commands->QueueCommand(&command);
+            const unsigned short* message;
+            VariableEntity** stops;
+            unsigned int target = -2;
+            if (strcmp(vehicle->name_06, "BUS") == 0)
+            {
+                message = screen_text_lookup->LookupText("FEEDBACK_BUS_ARRIVAL");
+                stops = variable_world->FindNamed("BUSSTOP", &count);
+            }
+            else
+            {
+                message = screen_text_lookup->LookupText("FEEDBACK_FERRY_ARRIVAL");
+                stops = variable_world->FindNamed("WHARF", &count);
+            }
+            if (count == 1)
+                target = stops[0]->id_28;
+            unsigned short text[128];
+            swprintf(text, message, arrival.count);
+            window_deactivation_state->ticker_30->AddMessage(text, target, 1);
+        }
+    }
+    return 0;
+}
