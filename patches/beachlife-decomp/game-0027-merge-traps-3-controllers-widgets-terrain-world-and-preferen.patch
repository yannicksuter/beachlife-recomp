+            ScreenWorldPosition start;
+            ScreenWorldPosition end;
+            ScreenPoint start_tile;
+            ScreenPoint end_tile;
+            int start_heading;
+            int end_heading;
+            screen_terrain_grid->ArrivalPosition(&start, &start_heading, &start_tile);
+            screen_terrain_grid->DeparturePosition(&end, &end_heading, &end_tile);
+            vehicle->heading_5d0 = start_heading;
