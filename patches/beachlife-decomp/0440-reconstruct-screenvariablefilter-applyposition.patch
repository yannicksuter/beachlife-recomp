+void ScreenVariableFilter::ApplyPosition(int dx, int dy)
+{
+    bounds_04.left = initial_14.left + dx;
+    bounds_04.right = initial_14.right + dx;
+    bounds_04.top = initial_14.top + dy;
+    bounds_04.bottom = initial_14.bottom + dy;
+}
