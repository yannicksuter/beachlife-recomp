+// FUNCTION: BEACHLIFE 0x00430850
+float WorldSquareRoot(float value)
+{
+    unsigned int bits = std::bit_cast<unsigned int>(value);
+    if (!bits)
+        return 0.0f;
+    unsigned int exponent = (((bits + 0xc0800000u) >> 1) + 0x3f800000u) & 0x7f800000u;
+    return std::bit_cast<float>(square_root_mantissas[(bits >> 8) & 0xffff] | exponent);
+}
+
+int WorldDirection(ScreenMapPosition direction, unsigned int count)
+{
+    return MotionDirection(direction, count);
+}
+
+// FUNCTION: BEACHLIFE 0x00497940
+void RestoreVehicleReturn(int x, int y, int direction)
+{
+    ScreenTerrainCell* neighbours[8];
+    screen_terrain_grid->Neighbours(x, y, neighbours);
+    switch (direction)
+    {
+    case 1:
+        neighbours[7]->flags_48 &= ~0x10u;
+        neighbours[6]->flags_48 &= ~0x10u;
+        neighbours[5]->flags_48 &= ~0x10u;
+        neighbours[0]->flags_48 &= ~0x10u;
+        break;
+    case 3:
+        neighbours[2]->flags_48 &= ~0x10u;
+        neighbours[1]->flags_48 &= ~0x10u;
+        neighbours[0]->flags_48 &= ~0x10u;
+        neighbours[7]->flags_48 &= ~0x10u;
+        break;
+    case 7:
+        neighbours[3]->flags_48 &= ~0x10u;
+        neighbours[4]->flags_48 &= ~0x10u;
+        neighbours[5]->flags_48 &= ~0x10u;
+        neighbours[6]->flags_48 &= ~0x10u;
+        break;
+    case 5:
+        neighbours[4]->flags_48 &= ~0x10u;
+        neighbours[1]->flags_48 &= ~0x10u;
+        neighbours[2]->flags_48 &= ~0x10u;
+        neighbours[3]->flags_48 &= ~0x10u;
+        break;
+    }
+}
