+// FUNCTION: BEACHLIFE 0x0049a2e0
+void WorldVehicleEntity::FacePoint(ScreenMapPosition point)
+{
+    ScreenMapPosition direction;
+    point.y = static_cast<float>(static_cast<long double>(point.y) + 1.0f);
+    direction.x = static_cast<float>(static_cast<long double>(point.x) + 1.0f - motion_64[0]);
+    long double y = static_cast<long double>(point.y) - motion_64[1];
+    direction.y = y;
+    float length = VehicleSquareRoot(static_cast<float>(y * direction.y + static_cast<long double>(direction.x) * direction.x));
+    float reciprocal = MotionReciprocal(length);
+    direction.x = static_cast<long double>(reciprocal) * direction.x;
+    direction.y = static_cast<long double>(direction.y) * reciprocal;
+    FaceVehicle(WorldDirection(direction, 8));
+}
+
+// FUNCTION: BEACHLIFE 0x0049a3c0
+void WorldVehicleEntity::FaceVehicle(int direction)
+{
+    int current = keyline_state_44->word_18;
+    if (current == direction)
+    {
+        flag_900 = 1;
+        words_904[0] = 0;
+        AnimateVehicle(window_deactivation_state->clock_158);
+        return;
+    }
+    flag_5c = 0;
+    flag_900 = 1;
+    if (current < direction)
+    {
+        words_904[0] = direction - current;
+        if (static_cast<int>(words_904[0]) > 4)
+        {
+            words_904[0] = 8 - words_904[0];
+            flag_901 = 0;
+        }
+        else
+            flag_901 = 1;
+    }
+    else
+    {
+        words_904[0] = current - direction;
+        if (static_cast<int>(words_904[0]) > 4)
+        {
+            flag_901 = 1;
+            words_904[0] = 8 - words_904[0];
+        }
+        else
+            flag_901 = 0;
+    }
+    words_904[1] = MotionWord(window_deactivation_state->clock_158);
+    StartTurnAnimation();
+}
+
+// FUNCTION: BEACHLIFE 0x00495850
+void WorldVehicleEntity::UpdateVehicleTurn(float time)
+{
+    long double finish = static_cast<long double>(MotionFloat(words_904[2])) + MotionFloat(words_904[1]);
+    if (finish > time)
+        return;
+    int direction = keyline_state_44->word_18;
+    if (MotionFloat(words_904[1]) > 0.0f)
+        direction = flag_901 ? (direction + 1) % 8 : direction ? direction - 1
+                                                               : 7;
+    keyline_state_44->SelectVariant(direction);
+    if (static_cast<int>(words_904[0]) > 0)
+    {
+        words_904[1] = MotionWord(time);
+        StartTurnAnimation();
+        return;
+    }
+    flag_5c = 1;
+    if (state_3c == 0x45)
+    {
+        ScreenModeCommand command;
+        command.words[0] = id_28;
+        command.words[1] = id_28;
+        command.words[2] = 10;
+        command.words[3] = static_cast<int>(MotionFloat(words_8e8[0]));
+        command.words[4] = static_cast<int>(MotionFloat(words_8e8[1]));
+        screen_mode_commands->QueueCommand(&command);
+    }
+    AnimateVehicle(time);
+}
+
+// FUNCTION: BEACHLIFE 0x00495f50
+void WorldVehicleEntity::StartCircuit()
+{
+    words_904[6] = (static_cast<int>(words_904[6]) + 1) % static_cast<int>(words_904[3]);
+    ScreenPoint* circuit = static_cast<ScreenPoint*>(circuit_920);
+    while (words_904[6] != words_904[4])
+    {
+        ScreenPoint tile = circuit[words_904[6]];
+        if (!(screen_terrain_grid->cells_0c[screen_terrain_grid->TileIndex(tile.x, tile.y)].flags_48 & 0x10))
+            break;
+        words_904[6] = (static_cast<int>(words_904[6]) + 1) % static_cast<int>(words_904[3]);
+    }
+    ScreenModeCommand command;
+    command.words[0] = id_28;
+    command.words[1] = id_28;
+    if (words_904[6] == words_904[4])
+    {
+        command.words[2] = 3;
+        command.words[3] = 0;
+        command.words[4] = 0x42;
+        screen_mode_commands->QueueCommand(&command);
+    }
+    else
+    {
+        ScreenPoint tile = circuit[words_904[6]];
+        ScreenMapPosition point = screen_terrain_grid->TileWorldPosition(tile.x, tile.y);
+        command.words[2] = 11;
+        command.words[3] = static_cast<int>(point.x);
+        command.words[4] = static_cast<int>(point.y);
+        screen_mode_commands->QueueCommand(&command);
+        if (route_b8 && vehicle_type_f8 != 1)
+            speed_80 = static_cast<WorldRouteReference*>(route_b8)->IsStraight() ? 200.0f : 100.0f;
+    }
+    ScreenPoint tile = circuit[words_904[6]];
+    ScreenWorldPosition point = screen_terrain_grid->TilePosition(tile.x, tile.y, 4);
+    words_8e8[0] = MotionWord(point.x);
+    words_8e8[1] = MotionWord(point.y);
+    words_8e8[2] = MotionWord(point.z);
+}
