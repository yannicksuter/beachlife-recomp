+
+static float AnimateVehiclePassenger(WorldVehicleEntity* vehicle, unsigned int id, const char* animation,
+    float time, unsigned int mode)
+{
+    WorldMovingEntity* passenger = variable_world->FindObject(id)->AsMoving();
+    ScreenWorldPosition position = vehicle->Position();
+    passenger->SetMovementPosition(position);
+    float length = passenger->keyline_state_44->SetAnimation(animation, time, &position);
+    passenger->keyline_state_44->word_08 = mode;
+    return length;
+}
+
+// FUNCTION: BEACHLIFE 0x00495980
+void WorldVehicleEntity::AnimateVehicle(float time)
+{
+    const char* animation = reinterpret_cast<const char*>(static_cast<std::uintptr_t>(MotionWord(time)));
+    const char* first;
+    const char* second;
+    const char* wake = 0;
+    const char* rod1 = 0;
+    const char* rod2 = 0;
+    const char* driver = 0;
+    switch (vehicle_type_f8)
+    {
+    case 0:
+        animation = vehicle_animation_57c31c;
+        first = vehicle_animation_57c3dc;
+        wake = vehicle_animation_57c314;
+        break;
+    case 1:
+        animation = vehicle_animation_57c320;
+        first = vehicle_animation_57c3f4;
+        second = vehicle_animation_57c404;
+        break;
+    case 4:
+        animation = vehicle_animation_57c370;
+        first = vehicle_animation_57c420;
+        second = vehicle_animation_57c428;
+        break;
+    case 6:
+        animation = vehicle_animation_57c388;
+        first = vehicle_animation_57c44c;
+        second = vehicle_animation_57c450;
+        rod1 = vehicle_animation_57c3a8;
+        rod2 = vehicle_animation_57c3c4;
+        driver = world_fishing_driver_animation;
+        break;
+    }
+    ScreenWorldPosition position = Position();
+    keyline_state_44->SetAnimation(animation, time, &position);
+    keyline_state_44->word_08 = 0;
+    if (passenger_count_5bc)
+    {
+        AnimateVehiclePassenger(this, passengers_10c[0], first, time, 0);
+        if (passenger_count_5bc > 1)
+            AnimateVehiclePassenger(this, passengers_10c[1], second, time, 0);
+        if (wake)
+        {
+            resource_fc->SetAnimation(wake, time, &position);
+            resource_fc->word_08 = 0;
+        }
+    }
+    if (rod1)
+    {
+        resource_100->SetAnimation(rod1, time, &position);
+        resource_100->word_08 = 0;
+    }
+    if (rod2)
+    {
+        resource_104->SetAnimation(rod2, time, &position);
+        resource_104->word_08 = 0;
+    }
+    if (resource_108)
+    {
+        resource_108->SetAnimation(driver, time, &position);
+        resource_108->word_08 = 0;
+    }
+    words_904[0] = words_904[1] = words_904[2] = 0;
+    flag_900 = flag_901 = 0;
+}
+
+// FUNCTION: BEACHLIFE 0x004974d0
+void WorldVehicleEntity::PrepareVehicle()
+{
+    const char* animation = 0;
+    const char* rod1 = 0;
+    const char* rod2 = 0;
+    const char* driver = 0;
+    ScreenWorldPosition position = Position();
+    switch (vehicle_type_f8)
+    {
+    case 0:
+        animation = vehicle_normal_animation;
+        break;
+    case 1:
+        animation = speedboat_normal_animation;
+        break;
+    case 4:
+        animation = vehicle_animation_57c36c;
+        keyline_state_44->SetAnimation(animation, window_deactivation_state->clock_158, &position);
+        break;
+    case 6:
+        animation = vehicle_animation_57c384;
+        rod1 = world_fishing_rod1_animation;
+        rod2 = world_fishing_rod2_animation;
+        driver = vehicle_animation_57c398;
+        break;
+    }
+    float time = 0.0f;
+    if (animation)
+    {
+        float now = window_deactivation_state->clock_158;
+        time = static_cast<float>(static_cast<long double>(std::rand() % 100) * 0.01f + now);
+        keyline_state_44->SetAnimation(animation, time, &position);
+        keyline_state_44->word_08 = 0;
+    }
+    if (rod1)
+    {
+        resource_100->SetAnimation(rod1, time, &position);
+        keyline_state_44->word_08 = 0;
+    }
+    if (rod2)
+    {
+        resource_104->SetAnimation(rod2, time, &position);
+        keyline_state_44->word_08 = 0;
+    }
+    if (driver)
+    {
+        resource_108->SetAnimation(driver, time, &position);
+        keyline_state_44->word_08 = 0;
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x00496680
+float WorldVehicleEntity::IdleVehicle()
+{
+    float time = window_deactivation_state->clock_158;
+    if (!passenger_count_5bc)
+        return 0.0f;
+    WorldMovingEntity* passenger = variable_world->FindObject(passengers_10c[0])->AsMoving();
+    ScreenWorldPosition position = Position();
+    passenger->SetMovementPosition(position);
+    bool first_catch = std::rand() % 5 == 0;
+    passenger->keyline_state_44->SetAnimation(first_catch ? vehicle_animation_57c468 : vehicle_animation_57c464, time, &position);
+    passenger->keyline_state_44->word_08 = 0;
+    float length = resource_100->SetAnimation(first_catch ? vehicle_animation_57c3b8 : vehicle_animation_57c3b4, time, 0);
+    if (passenger_count_5bc > 1)
+    {
+        bool second_catch = !first_catch && std::rand() % 5 == 0;
+        passenger = variable_world->FindObject(passengers_10c[1])->AsMoving();
+        passenger->SetMovementPosition(position);
+        passenger->keyline_state_44->SetAnimation(second_catch ? vehicle_animation_57c470 : vehicle_animation_57c46c, time, &position);
+        resource_104->SetAnimation(second_catch ? vehicle_animation_57c3d4 : vehicle_animation_57c3d0, time, 0);
+        passenger->keyline_state_44->word_08 = 0;
+    }
+    return length;
+}
+
+// FUNCTION: BEACHLIFE 0x00496150
+float WorldVehicleEntity::PassengerAnimation(float time, unsigned char boarding, unsigned char additional)
+{
+    const char* animation = 0;
+    const char* first = 0;
+    const char* second = 0;
+    const char* rod1 = 0;
+    const char* rod2 = 0;
+    const char* driver = 0;
+    switch (vehicle_type_f8)
+    {
+    case 0:
+        animation = vehicle_animation_57c300;
+        first = vehicle_animation_57c3d8;
+        break;
+    case 1:
+        animation = vehicle_animation_57c33c;
+        first = additional ? vehicle_animation_57c3f0 : vehicle_animation_57c3ec;
+        if (additional)
+            second = vehicle_animation_57c400;
+        break;
+    case 2:
+        if (!boarding)
+        {
+            unsigned int count;
+            WorldBuildingEntity* building = variable_world->FindNamed("Wharf", &count)[0]->AsBuilding();
+            ScreenMapPosition point = building->ContentPosition(building->count_178 - 1);
+            ScreenWorldPosition position = { point.x, point.y, 0.0f };
+            variable_world->FindObject(passengers_10c[passenger_count_5bc - 1])->SetWorldPosition(&position);
+            variable_world->FindObject(passengers_10c[passenger_count_5bc - 1])->visible_40 = 1;
+        }
+        else
+            variable_world->FindObject(passengers_10c[passenger_count_5bc - 1])->visible_40 = 0;
+        return 0.5f;
+    case 4:
+        animation = additional ? vehicle_animation_57c368 : vehicle_animation_57c364;
+        first = additional ? vehicle_animation_57c414 : vehicle_animation_57c410;
+        if (additional)
+            second = vehicle_animation_57c424;
+        break;
+    case 5:
+        second = boarding ? vehicle_animation_57c47c : vehicle_animation_57c474;
+        break;
+    case 6:
+        animation = vehicle_animation_57c380;
+        if (additional)
+        {
+            first = vehicle_animation_57c44c;
+            second = boarding ? vehicle_animation_57c438 : vehicle_animation_57c440;
+        }
+        else
+            first = boarding ? vehicle_animation_57c434 : vehicle_animation_57c43c;
+        rod1 = vehicle_animation_57c3a0;
+        rod2 = vehicle_animation_57c3bc;
+        driver = world_fishing_driver_animation;
+        break;
+    }
+    ScreenWorldPosition position = Position();
+    if (vehicle_type_f8 == 5)
+    {
+        WorldGuestEntity* guest = variable_world->FindObject(passengers_10c[passenger_count_5bc - 1])->AsGuest();
+        guest->SetMovementPosition(position);
+        guest->visible_40 = 1;
+        guest->keyline_state_44->SelectVariant(keyline_state_44->word_18);
+        guest->keyline_state_44->word_08 = 2;
+        if (guest->word_310)
+        {
+            guest->word_310->SelectVariant(keyline_state_44->word_18);
+            guest->word_310->SetAnimation(vehicle_animation_57c484, time, &position);
+            if (boarding)
+                guest->word_310->word_08 = 1;
+            return guest->keyline_state_44->SetAnimation(second, time, &position);
+        }
+        return guest->keyline_state_44->SetAnimation(boarding ? vehicle_animation_57c480 : vehicle_animation_57c478, time, &position);
+    }
+    unsigned int mode = vehicle_type_f8 == 6 ? 2 : boarding ? 2
+                                                            : 1;
+    float length = keyline_state_44->SetAnimation(animation, time, &position);
+    keyline_state_44->word_08 = mode;
+    if (first)
+        length = AnimateVehiclePassenger(this, passengers_10c[0], first, time, mode);
+    if (second)
+        length = AnimateVehiclePassenger(this, passengers_10c[1], second, time, mode);
+    if (rod1)
+        resource_100->SetAnimation(rod1, time, 0);
+    if (rod2)
+        resource_104->SetAnimation(rod2, time, 0);
+    if (driver)
+        resource_108->SetAnimation(driver, time, 0);
+    return length;
+}
