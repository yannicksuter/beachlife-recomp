+static void StoreVehicleRoamPoint(WorldVehicleEntity* vehicle, ScreenWorldPosition point)
+{
+    vehicle->words_8e8[0] = MotionWord(point.x);
+    vehicle->words_8e8[1] = MotionWord(point.y);
+    vehicle->words_8e8[2] = MotionWord(point.z);
+}
+
+static void MoveVehicleToRoamPoint(WorldVehicleEntity* vehicle)
+{
+    ScreenModeCommand command;
+    command.words[0] = vehicle->id_28;
+    command.words[1] = vehicle->id_28;
+    command.words[2] = 10;
+    command.words[3] = static_cast<int>(MotionFloat(vehicle->words_8e8[0]));
+    command.words[4] = static_cast<int>(MotionFloat(vehicle->words_8e8[1]));
+    screen_mode_commands->QueueCommand(&command);
+}
+
+// FUNCTION: BEACHLIFE 0x00499d50
+void WorldVehicleEntity::Roam()
+{
+    ScreenPoint start = TilePosition();
+    int direction = std::rand() % 8;
+    int best_direction = direction;
+    int best_length = 0;
+    ScreenPoint best;
+    bool found = false;
+    for (int attempt = 0; attempt < 8 && !found; ++attempt)
+    {
+        ScreenPoint point = start;
+        ScreenPoint last;
+        int length = 0;
+        while (length < 8)
+        {
+            screen_terrain_grid->Step(point.x, point.y, direction, &point);
+            ScreenTerrainGrid* grid = screen_terrain_grid;
+            unsigned int flags = grid->cells_0c[grid->TileIndex(point.x, point.y)].flags_48;
+            if (point.x < 2 || point.x > 126 || point.y < 2 || point.y > 126
+                || !(flags & 0x60000000) || (flags & 0x10))
+                break;
+            ++length;
+            last = point;
+        }
+        if (length > best_length)
+        {
+            best_length = length;
+            best_direction = direction;
+            best = last;
+            if (length > 5)
+                found = true;
+        }
+        direction = (direction + 1) % 8;
+    }
+    if (!best_length)
+    {
+        ScreenModeCommand command;
+        command.words[0] = id_28;
+        command.words[1] = id_28;
+        command.words[2] = 3;
+        command.words[3] = 0;
+        command.words[4] = 0x42;
+        screen_mode_commands->QueueCommand(&command);
+        return;
+    }
+    flag_5c = 0;
+    StoreVehicleRoamPoint(this, screen_terrain_grid->TilePosition(best.x, best.y, 4));
+    int facing = (best_direction + 1) % 8;
+    if (facing == keyline_state_44->word_18)
+        MoveVehicleToRoamPoint(this);
+    else
+        FaceVehicle(facing);
+}
+
+// FUNCTION: BEACHLIFE 0x00499f80
+void WorldVehicleEntity::SwimVehicle()
+{
+    ScreenWorldPosition point = screen_terrain_grid->TilePosition(turn_area_8dc.x, turn_area_8dc.y, 4);
+    long double x = static_cast<long double>(x_30) - point.x;
+    long double y = static_cast<long double>(y_34) - point.y;
+    float distance = VehicleSquareRoot(static_cast<float>(y * y + x * x));
+    ScreenModeCommand command;
+    command.words[0] = id_28;
+    command.words[1] = id_28;
+    command.words[2] = 10;
+    if (!(std::fabs(distance) >= 200.0))
+    {
+        command.words[3] = static_cast<int>(point.x);
+        command.words[4] = static_cast<int>(point.y);
+    }
+    else
+    {
+        command.words[3] = static_cast<int>(x_30);
+        command.words[4] = static_cast<int>(y_34);
+    }
+    screen_mode_commands->QueueCommand(&command);
+    flag_8e4 = 1;
+}
+
+// FUNCTION: BEACHLIFE 0x0049a090
+bool WorldVehicleEntity::FindFishingPoint()
+{
+    ScreenTerrainCell* neighbours[8];
+    screen_terrain_grid->Neighbours(word_964, word_968, neighbours);
+    for (int i = 0; i < 8; ++i)
+        neighbours[i]->flags_48 &= ~0x10u;
+    ScreenPoint point = TilePosition();
+    int facing = (heading_5d0 + 2) % 8;
+    int count = 0;
+    ScreenPoint last;
+    while (count < 15)
+    {
+        screen_terrain_grid->Step(point.x, point.y, (facing + 7) % 8, &point);
+        ScreenTerrainGrid* grid = screen_terrain_grid;
+        unsigned int flags = grid->cells_0c[grid->TileIndex(point.x, point.y)].flags_48;
+        if (point.x < 2 || point.x > 126 || point.y < 2 || point.y > 126
+            || !(flags & 0x60000000) || (flags & 0x10))
+            break;
+        if (count > 1)
+        {
+            grid->Neighbours(point.x, point.y, neighbours);
+            bool clear = true;
+            for (int i = 0; i < 8; ++i)
+                if (!(neighbours[i]->flags_48 & 0x60000000) || (neighbours[i]->flags_48 & 0x10))
+                    clear = false;
+            if (!clear)
+                break;
+        }
+        ++count;
+        last = point;
+    }
+    if (count <= 4)
+        return false;
+    flag_5c = 0;
+    StoreVehicleRoamPoint(this, screen_terrain_grid->TilePosition(last.x, last.y, 4));
+    if (facing % 8 == keyline_state_44->word_18)
+        MoveVehicleToRoamPoint(this);
+    else
+        FaceVehicle(facing % 8);
+    screen_terrain_grid->Neighbours(word_964, word_968, neighbours);
+    for (int i = 0; i < 8; ++i)
+        neighbours[i]->flags_48 |= 0x10;
+    return true;
+}
