-#if defined(_M_IX86) || defined(__i386__)
-typedef char DebugFontGlyphOffset[(offsetof(DebugFont, glyphs) == 0x0004) ? 1 : -1];
-typedef char DebugFontKerningOffset[(offsetof(DebugFont, kerning) == 0x0404) ? 1 : -1];
-typedef char DebugFontSizeOffset[(offsetof(DebugFont, size) == 0x4404) ? 1 : -1];
-typedef char DebugFontFlagsOffset[(offsetof(DebugFont, flags) == 0x4408) ? 1 : -1];
-typedef char DebugFontSize[(sizeof(DebugFont) == 0x440c) ? 1 : -1];
