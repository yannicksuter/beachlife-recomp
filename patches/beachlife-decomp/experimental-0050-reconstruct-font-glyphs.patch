@@ -0,0 +1,57 @@
+#include "startup_screen_text.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x0049ff20
+void ScreenFontRenderer::DrawGlyphSurface(const unsigned char* source,
+    int source_stride, unsigned short* destination, int destination_stride,
+    int source_x, int source_y, int destination_x, int destination_y,
+    int width, int height, const unsigned short* palette)
+{
+    source += (source_y + height - 1) * source_stride + source_x;
+    destination += (destination_y + height - 1) * destination_stride + destination_x;
+
+    unsigned int value = word_10;
+    unsigned short colour = static_cast<unsigned short>(
+        screen_request_renderer->ConvertColour((value >> 16) & 0xff,
+            (value >> 8) & 0xff,
+            value & 0xff));
+
+    if (state_14)
+    {
+        while (height != 0)
+        {
+            int remaining = width;
+            while (remaining != 0)
+            {
+                if (*source & 1)
+                    *destination = 0xffff;
+                if (*source & 2)
+                    *destination = 0;
+                ++destination;
+                ++source;
+                --remaining;
+            }
+            source -= source_stride + width;
+            destination -= destination_stride + width;
+            --height;
+        }
+    }
+    else
+    {
+        while (height != 0)
+        {
+            int remaining = width;
+            while (remaining != 0)
+            {
+                if (*source & 1)
+                    *destination = colour;
+                ++destination;
+                ++source;
+                --remaining;
+            }
+            destination -= destination_stride + width;
+            source -= source_stride + width;
+            --height;
+        }
+    }
+}
