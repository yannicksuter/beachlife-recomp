+#include "startup_frame_clock.h"
+#include "startup_input_motion.h"
+
+// FUNCTION: BEACHLIFE 0x004adb00
+bool ScreenItem::HandleTimedCoordinates(int x, int y, int value)
+{
+    if (owned_text)
+    {
+        float delta = startup_frame_clock->delta_seconds;
+        if (TestRectangle(x, y))
+        {
+            float threshold = screen_manager->ReadItemThreshold();
+            if (!(elapsed_24 >= threshold))
+            {
+                if (x == last_x && y == last_y)
+                {
+                    elapsed_24 = delta + elapsed_24;
+                }
+                else
+                {
+                    elapsed_24 = 0.0f;
+                }
+            }
+            if ((value == 1 || value == 2 || value == 3) && elapsed_24 >= threshold)
+            {
+                screen_manager->ClearItemReference(this);
+                elapsed_24 = 7.0f;
+            }
+            if (elapsed_24 >= 7.0f)
+            {
+                screen_manager->ClearItemReference(this);
+                last_y = y;
+                last_x = x;
+                return false;
+            }
+            if (elapsed_24 >= threshold)
+            {
+                const char* text = owned_text;
+                screen_manager->ShowItemText(this, x, y, text);
+                float elapsed = delta + elapsed_24;
+                last_y = y;
+                last_x = x;
+                elapsed_24 = elapsed;
+                return false;
+            }
+        }
+        else
+        {
+            screen_manager->ClearItemReference(this);
+            elapsed_24 = 0.0f;
+        }
+    }
+    last_y = y;
+    last_x = x;
+    return false;
+}
