+#include "startup_screen_text.h"
+#include "startup_screen_font_data.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x0049f780
+void ScreenFontRenderer::DrawText(int x, int y, const unsigned short* text)
+{
+    ScreenFontData* data = data_1c;
+    const unsigned short* cursor = text;
+    const unsigned short* line_start = text;
+    const unsigned short* word_start = text;
+    unsigned int line_characters = 0;
+    unsigned int word_characters = 0;
+    int line_width = x;
+    bool stopped = false;
+    bool forced_break = false;
+    unsigned int height = data->unknown_10804[0];
+    int adjustment = static_cast<int>(height * -1.2f);
+
+    if (static_cast<int>(height - adjustment) > rectangle.height)
+    {
+        DrawTextLine(x, y, text);
+        return;
+    }
+
+    unsigned short scratch[256];
+    while (*cursor != 0 && !stopped)
+    {
+        unsigned int current = *cursor;
+        unsigned short advance = static_cast<unsigned short>(
+            data->glyphs[current][2] - data->glyphs[current][0]);
+        unsigned int next = cursor[1];
+        if (next != 0)
+        {
+            advance = static_cast<unsigned short>(
+                advance + data->kerning[current * 255 + next]);
+        }
+        line_width += advance;
+
+        if (cursor != text)
+        {
+            if (current != ' ' && cursor[-1] == ' ')
+            {
+                word_start = cursor;
+                word_characters = 0;
+            }
+            if (current == '~')
+            {
+                ++cursor;
+                forced_break = true;
+                word_start = cursor;
+                word_characters = 0;
+            }
+        }
+        if (*cursor != ' ' && cursor[-1] != '~')
+            ++word_characters;
+
+        if ((line_width > rectangle.width && line_characters > word_characters)
+            || forced_break)
+        {
+            forced_break = false;
+            memset(scratch, 0, sizeof(scratch));
+            unsigned int copy_bytes = (line_characters - word_characters) * 2;
+            memcpy(scratch, line_start, copy_bytes);
+            DrawTextLine(x, y, scratch);
+
+            height = data_1c->unknown_10804[0];
+            adjustment = static_cast<int>(height * -1.2f);
+            y += 2 - adjustment;
+            cursor = word_start;
+            line_characters = 0;
+            word_characters = 0;
+            line_start = cursor;
+            line_width = x;
+            if (static_cast<int>(height + y) > rectangle.height)
+                stopped = true;
+        }
+        else
+        {
+            ++cursor;
+            ++line_characters;
+        }
+    }
+    if (!stopped)
+        DrawTextLine(x, y, line_start);
+}
