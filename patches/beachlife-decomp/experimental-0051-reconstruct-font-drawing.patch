+#include "startup_screen_text.h"
+#include "startup_screen_font_data.h"
+#include "startup_screen_renderer.h"
+#include "tga_image.h"
+
+void ScreenFontRenderer::DrawTextLine(int x, int y, const unsigned short* text)
+{
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    unsigned int alignment = word_18;
+    ScreenFontData* data = data_1c;
+    const unsigned short* cursor = text;
+
+    if (alignment == 1 || alignment == 2)
+    {
+        unsigned int measured_width = 0;
+        for (const unsigned short* measure = text; *measure != 0; ++measure)
+        {
+            unsigned int current = *measure;
+            unsigned short advance = static_cast<unsigned short>(
+                data->glyphs[current][2] - data->glyphs[current][0]);
+            unsigned int next = measure[1];
+            if (next != 0)
+            {
+                advance = static_cast<unsigned short>(advance + data->kerning[current * 255 + next]);
+            }
+            measured_width += advance;
+        }
+        unsigned int offset = static_cast<unsigned int>(rectangle.width) - measured_width;
+        if (alignment == 2)
+        {
+            offset >>= 1;
+        }
+        x += static_cast<int>(offset);
+    }
+
+    RenderRectangle left_clip = renderer->clip_rectangle;
+    RenderRectangle top_clip = renderer->clip_rectangle;
+    RenderRectangle right_clip = renderer->clip_rectangle;
+    int clip_right = left_clip.x + right_clip.width;
+    RenderRectangle bottom_clip = renderer->clip_rectangle;
+    int clip_bottom = top_clip.y + bottom_clip.height;
+
+    TgaImage* image = data->image;
+    const unsigned char* source = image->pixels;
+    int source_stride = image->width;
+    const unsigned short* palette = image->converted_palette;
+
+    if (renderer->unscaled_clip_5c != 0)
+    {
+        unsigned short* destination = renderer->AccessPixels();
+        if (destination == 0)
+        {
+            return;
+        }
+        int destination_stride = static_cast<int>(renderer->SurfacePitch() >> 1);
+        ScreenPoint position = renderer->SurfacePosition();
+
+        while (*cursor != 0)
+        {
+            int destination_y = rectangle.y + y - position.y;
+            int destination_x = rectangle.x + x - position.x;
+            unsigned int current = *cursor;
+            int source_top = data->glyphs[current][1];
+            int source_left = data->glyphs[current][0];
+            int source_right = data->glyphs[current][2];
+            int source_bottom = data->glyphs[current][3];
+
+            bool rejected = false;
+            if (destination_x > clip_right)
+            {
+                rejected = true;
+            }
+            if (destination_y > clip_bottom)
+            {
+                rejected = true;
+            }
+            if (source_right - source_left + destination_x < left_clip.x)
+            {
+                rejected = true;
+            }
+            if (source_bottom - source_top + destination_y >= top_clip.y && !rejected)
+            {
+                if (destination_x < left_clip.x)
+                {
+                    int difference = left_clip.x - destination_x;
+                    destination_x += difference;
+                    source_left += difference;
+                }
+                if (source_right - source_left + destination_x > clip_right)
+                {
+                    source_right = source_left - destination_x + clip_right;
+                }
+                if (destination_y < top_clip.y)
+                {
+                    int difference = top_clip.y - destination_y;
+                    destination_y += difference;
+                    source_top += difference;
+                }
+                if (source_bottom - source_top + destination_y > clip_bottom)
+                {
+                    source_bottom = source_top - destination_y + clip_bottom;
+                }
+                DrawGlyphSurface(source, source_stride, destination, destination_stride, source_left, source_top, destination_x, destination_y, source_right - source_left, source_bottom - source_top, palette);
+            }
+
+            current = *cursor;
+            x += static_cast<int>(data->glyphs[current][2]) - data->glyphs[current][0];
+            unsigned int next = cursor[1];
+            if (next != 0)
+            {
+                x += data->kerning[current * 255 + next];
+            }
+            ++cursor;
+        }
+        renderer->UnlockPixels();
+        return;
+    }
+
+    bool has_text = *cursor != 0;
+    unsigned short* destination = renderer->pixels_1c;
+    int destination_stride = static_cast<int>(renderer->width);
+    if (has_text)
+    {
+        do
+        {
+            int destination_x = rectangle.x + x;
+            int destination_y = rectangle.y + y;
+            unsigned int current = *cursor;
+            int source_top = data->glyphs[current][1];
+            int source_right = data->glyphs[current][2];
+            int source_left = data->glyphs[current][0];
+            int source_bottom = data->glyphs[current][3];
+
+            bool rejected = false;
+            if (destination_x > clip_right)
+            {
+                rejected = true;
+            }
+            if (destination_y > clip_bottom)
+            {
+                rejected = true;
+            }
+            if (source_right - source_left + destination_x < left_clip.x)
+            {
+                rejected = true;
+            }
+            if (source_bottom - source_top + destination_y >= top_clip.y && !rejected)
+            {
+                if (destination_x < left_clip.x)
+                {
+                    int difference = left_clip.x - destination_x;
+                    destination_x += difference;
+                    source_left += difference;
+                }
+                if (source_right - source_left + destination_x > clip_right)
+                {
+                    source_right = source_left - destination_x + clip_right;
+                }
+                if (destination_y < top_clip.y)
+                {
+                    int difference = top_clip.y - destination_y;
+                    destination_y += difference;
+                    source_top += difference;
+                }
+                if (source_bottom - source_top + destination_y > clip_bottom)
+                {
+                    source_bottom = source_top - destination_y + clip_bottom;
+                }
+                DrawGlyphDirect(source, source_stride, destination, destination_stride, source_left, source_top, destination_x, destination_y, source_right - source_left, source_bottom - source_top, palette);
+            }
+
+            current = *cursor;
+            x += static_cast<int>(data->glyphs[current][2]) - data->glyphs[current][0];
+            unsigned int next = cursor[1];
+            if (next != 0)
+            {
+                x += data->kerning[current * 255 + next];
+            }
+            ++cursor;
+        } while (*cursor != 0);
+    }
+}
