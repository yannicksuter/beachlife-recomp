diff --git a/src/startup_float_to_integer.h b/src/startup_float_to_integer.h
new file mode 100644
index 0000000..990e70b
--- /dev/null
+++ b/src/startup_float_to_integer.h
@@ -0,0 +1,13 @@
+#ifndef STARTUP_FLOAT_TO_INTEGER_H
+#define STARTUP_FLOAT_TO_INTEGER_H
+
+// Retail _ftol truncates to a signed 64-bit integer, then these callers use
+// only EAX. The x87 integer-indefinite result also has a zero low word.
+inline int TruncateFloatToWord(long double value)
+{
+    if (!(value >= -9223372036854775808.0L && value < 9223372036854775808.0L))
+        return 0;
+    return static_cast<int>(static_cast<unsigned int>(static_cast<__int64>(value)));
+}
+
+#endif
