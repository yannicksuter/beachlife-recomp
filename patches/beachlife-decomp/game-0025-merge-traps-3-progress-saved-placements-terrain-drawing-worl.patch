+// Library-side list size as the original expands it: the end and begin
+// iterators and an empty iterator-category temporary are passed by reference
+// to the shared counting body. Descriptive names; the original library
+// declarations are not recovered.
+struct ListIteratorTag
+{
+};
+
+// Actual shared cdecl body 0x00420d60: counts nodes from first up to last.
+int CountListRange(const CircularListIterator& first, const CircularListIterator& last, const ListIteratorTag& category);
+
+inline ListIteratorTag ListIteratorCategory(const CircularListIterator&)
+{
+    return ListIteratorTag();
+}
+
+inline CircularListIterator ListBegin(const CircularList& list)
+{
+    CircularListIterator result;
+    result.node = list.head->next;
+    return result;
+}
+
+inline CircularListIterator ListEnd(const CircularList& list)
+{
+    CircularListIterator result;
+    result.node = list.head;
+    return result;
+}
+
+inline int ListDistance(const CircularListIterator& first, const CircularListIterator& last)
+{
+    return CountListRange(first, last, ListIteratorCategory(first));
+}
