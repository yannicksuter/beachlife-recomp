+#ifndef STARTUP_SCREEN_MODE_CONTROLLER_H
+#define STARTUP_SCREEN_MODE_CONTROLLER_H
+
+struct ScreenManager;
+
+// Actual base constructor 0x004a6180 publishes manager+4 and table0x004f44c0.
+// The seven remaining entries of that eight-slot table are actual _purecall.
+// Derived table0x004f4548 and real callers bound the argument widths below;
+// descriptive word parameters do not recover their original signedness.
+// Actual constructor/destructor and derived owners remain separate sources.
+struct ScreenModeController
+{
+    virtual ~ScreenModeController();
+    virtual void Enter() = 0;
+    virtual void Exit() = 0;
+    virtual void Update(float elapsed) = 0;
+    virtual void RenderScreens() = 0;
+    virtual void RenderPointer() = 0;
+    virtual unsigned char HandleThreeWords(unsigned int word0, unsigned int word1, unsigned int word2) = 0;
+    virtual unsigned char HandleFourWords(unsigned int word0, unsigned int word1, unsigned int word2, unsigned int word3) = 0;
+
+    ScreenManager* manager;
+
+protected:
+    ScreenModeController(ScreenManager* owner);
+};
+
+#endif
