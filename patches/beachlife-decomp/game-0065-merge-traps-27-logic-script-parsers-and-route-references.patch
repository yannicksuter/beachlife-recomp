+#include "startup_screen_renderer.h"
+#include "render_mask_setup.h"
+
+// FUNCTION: BEACHLIFE 0x0040bf90
+unsigned short ScreenRequestRenderer::BlendColour(unsigned short first, unsigned short second, float factor)
+{
+    long double inverse = 1.0L - factor;
+    unsigned char blue = static_cast<unsigned char>(static_cast<long long>(
+        (second & render_blue_mask & 0xff) * inverse
+        + static_cast<long double>(first & render_blue_mask & 0xff) * factor));
+    unsigned char green = static_cast<unsigned char>(static_cast<long long>(
+        (((second & render_green_mask) >> render_green_bits) & 0xff) * inverse
+        + static_cast<long double>(((first & render_green_mask) >> render_green_bits) & 0xff) * factor));
+    unsigned char red = static_cast<unsigned char>(static_cast<long long>(
+        (((second & render_red_mask) >> render_red_shift) & 0xff) * inverse
+        + static_cast<long double>(((first & render_red_mask) >> render_red_shift) & 0xff) * factor));
+    if (red > 31)
+        red = 31;
+    if (green > render_green_levels)
+        green = render_green_levels;
+    if (blue > 31)
+        blue = 31;
+    return static_cast<unsigned short>((static_cast<unsigned int>(red) << render_red_shift)
+                                       + (static_cast<unsigned int>(green) << render_green_bits) + blue);
+}
