+// FUNCTION: BEACHLIFE 0x004e8270
+// Scalar deleting wrapper: 0x004e8250.
+ExitGameController::~ExitGameController()
+{
+    if (active)
+        ControllerState::Exit();
+}
+
+// FUNCTION: BEACHLIFE 0x004e8290
+int ExitGameController::Update()
+{
+    float delta = startup_frame_clock->delta_seconds;
+    if (delta > 0.1f)
+        delta = 0.1f;
+    elapsed += delta;
+    if (elapsed > 15.0f)
+        screen_request_game->controller_selection.SelectPendingController(2);
+    if (startup_input_state->ReadFirstButtonTransition() == 1)
+        elapsed = 15.0f;
+    return 0;
+}
