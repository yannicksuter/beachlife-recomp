+{
+    value = 0;
+    while (buffer[cursor] == ' ' || buffer[cursor] == '\r' || buffer[cursor] == '\n' || buffer[cursor] == '\t')
+    {
+        ++cursor;
+    }
+
+    while (buffer[cursor] != ' ' && buffer[cursor] != ',' && buffer[cursor] != ')')
+    {
+        value = value * 10 + static_cast<signed char>(buffer[cursor]) - '0';
+        ++cursor;
+    }
+
+    while (buffer[cursor] == ' ' || buffer[cursor] == '\r' || buffer[cursor] == '\n' || buffer[cursor] == '\t')
+    {
+        ++cursor;
+    }
+
+    if (consume_delimiter)
+    {
+        if (buffer[cursor] == ',' || buffer[cursor] == ')')
+        {
+            ++cursor;
+        }
+        while (buffer[cursor] == ' ' || buffer[cursor] == '\r' || buffer[cursor] == '\n' || buffer[cursor] == '\t')
+        {
+            ++cursor;
+        }
+    }
+}
