+#include "startup_screen_renderer.h"
+#include "runtime/renderer_fullscreen_display.h"
+#include "runtime/renderer_word_surface.h"
+#include <stdexcept>
+
+// FUNCTION: BEACHLIFE 0x0040e650
+void ScreenRequestRenderer::BlitSurface(int x, int y, int surface)
+{
+    if (software_mode)
+    {
+        unsigned int key = fill_color;
+        if (x < 0 || y < 0)
+            return;
+
+        ScreenSurfacePosition* source = surface_storage[surface];
+        unsigned int columns = source->pitch >> 1;
+        unsigned short* from = source->pixels;
+        unsigned int rows = source->height;
+        current_surface = 0;
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+            return;
+
+        unsigned int pitch = surface_storage[current_surface]->pitch >> 1;
+        unsigned short* row = pixels + pitch * y + x;
+        for (unsigned int line = 0; line < rows; ++line)
+        {
+            unsigned short* to = row;
+            for (unsigned int column = 0; column < columns; ++column)
+            {
+                unsigned short value = *from++;
+                if (value != key)
+                    *to = value;
+                ++to;
+            }
+            row += pitch;
+        }
+
+        if (!software_mode)
+        {
+            DirectDrawSurface7Prefix* locked = surface_storage[current_surface]->surface;
+            locked->vtable->Unlock(locked, 0);
+        }
+        pixels_locked = 0;
+        return;
+    }
+
+    ScreenSurfacePosition* source = surface_storage[surface];
+    if (!native_chain || native_back != &native_chain->back_surface() || !source->native_surface)
+        throw std::logic_error("BlitSurface requires the real mode0 back and source surfaces");
+
+    // BltFast's null source rectangle uses the whole actual source. Blt also
+    // uses the whole source, but its destination dimensions come from the
+    // entry. Normal initialization keeps those dimensions identical. Stretch
+    // and clipping are separate host capabilities, never successful no-ops.
+    const auto description = source->native_surface->description();
+    if (!source->video_memory && (source->width != static_cast<unsigned int>(description.width) || source->height != static_cast<unsigned int>(description.height)))
+        throw std::logic_error("BlitSurface stretching is outside the typed copy domain");
+
+    native_back->copy_from(*source->native_surface,
+        { 0, 0, description.width, description.height },
+        x,
+        y,
+        true);
+}
