+
+// FUNCTION: BEACHLIFE 0x0040e990
+void ScreenRequestRenderer::BlitSurfaceRegion(
+    const ScreenRectangle& destination, const ScreenRectangle& source, int surface)
+{
+    if (software_mode)
+    {
+        unsigned int key = fill_color;
+        if (source.left > source.right || source.right < 0 || source.top > source.bottom)
+            return;
+
+        ScreenSurfacePosition* image = surface_storage[surface];
+        unsigned int source_pitch = image->pitch >> 1;
+        unsigned short* from = image->pixels + source.top * source_pitch;
+        unsigned int rows = source.bottom - source.top;
+        unsigned int columns = source.right - source.left;
+        current_surface = 0;
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+            return;
+
+        unsigned int pitch = surface_storage[current_surface]->pitch >> 1;
+        unsigned short* row = pixels + destination.top * pitch + destination.left;
+        for (unsigned int line = 0; line < rows; ++line)
+        {
+            unsigned short* out = row;
+            const unsigned short* in = from + source.left;
+            for (unsigned int column = 0; column < columns; ++column)
+            {
+                unsigned short value = *in++;
+                if (value != key)
+                    *out = value;
+                ++out;
+            }
+            row += pitch;
+            from += source_pitch;
+        }
+
+        if (!software_mode)
+        {
+            DirectDrawSurface7Prefix* locked = surface_storage[current_surface]->surface;
+            locked->vtable->Unlock(locked, 0);
+        }
+        pixels_locked = 0;
+        return;
+    }
+
+    ScreenSurfacePosition* image = surface_storage[surface];
+    if (!native_chain || native_back != &native_chain->back_surface() || !image->native_surface)
+        throw std::logic_error("BlitSurfaceRegion requires the real mode0 back and source surfaces");
+
+    // The original Blt permits distinct source/destination rectangles. The real
+    // native copy service has a contained, unscaled domain; it must not silently
+    // ignore either destination edge or invent successful clipping/stretching.
+    const std::int64_t source_width = std::int64_t(source.right) - source.left;
+    const std::int64_t source_height = std::int64_t(source.bottom) - source.top;
+    const std::int64_t destination_width = std::int64_t(destination.right) - destination.left;
+    const std::int64_t destination_height = std::int64_t(destination.bottom) - destination.top;
+    if (source_width != destination_width || source_height != destination_height)
+        throw std::logic_error("BlitSurfaceRegion stretching is outside the typed copy domain");
+
+    native_back->copy_from(*image->native_surface,
+        { source.left, source.top, source.right, source.bottom },
+        destination.left,
+        destination.top,
+        true);
+}
