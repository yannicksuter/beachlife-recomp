--- /dev/null
+++ b/src/startup_renderer_rectangle_surface.cpp
@@ -0,0 +1,75 @@
+#include "startup_screen_item.h"
+#include "startup_screen_renderer.h"
+#include "surface_error_sink.h"
+#include "runtime/renderer_word_surface.h"
+#include <stdexcept>
+
+// Observed DirectDraw flag word: DDBLT_WAIT.
+static const unsigned int kBltWait = 0x01000000;
+
+// FUNCTION: BEACHLIFE 0x00410d20
+int ScreenRequestRenderer::CreateRectangleSurface(const ScreenRectangle& bounds)
+{
+    int columns = bounds.right - bounds.left;
+    int rows = bounds.bottom - bounds.top;
+    int surface = CreateSurface(columns, rows, 0);
+    PrepareSurface(surface);
+
+    if (!format_44)
+    {
+        if (native_chain)
+        {
+            // Entry zero is the original source, not an inferred selected or
+            // global renderer. The new target owns its real offscreen storage.
+            const auto* screen = surface_storage[0]->native_surface;
+            auto* target = surface_storage[surface]->native_surface;
+            if (!screen || !target)
+                throw std::logic_error("CreateRectangleSurface requires real mode0 surfaces");
+            target->copy_from(*screen,
+                { bounds.left, bounds.top, bounds.right, bounds.bottom },
+                0,
+                0,
+                false);
+            return surface;
+        }
+
+        // ScreenRectangle has the RECT layout DirectDraw expects.
+        DirectDrawSurface7Prefix* screen = surface_storage[0]->surface;
+        DirectDrawSurface7Prefix* target = surface_storage[surface]->surface;
+        SurfaceResult result = target->vtable->Blt(target, 0, screen, reinterpret_cast<SurfaceApiRectangle*>(const_cast<ScreenRectangle*>(&bounds)), kBltWait, 0);
+        if (result < 0)
+            IgnoreSurfaceError(result);
+        return surface;
+    }
+
+    // The screen is unlocked again at once; its pointer is still used below.
+    current_surface = 0;
+    unsigned short* screen = AccessPixels();
+    if (!software_mode)
+    {
+        DirectDrawSurface7Prefix* locked = surface_storage[current_surface]->surface;
+        locked->vtable->Unlock(locked, 0);
+    }
+    pixels_locked = 0;
+
+    current_surface = surface;
+    unsigned short* row = AccessPixels();
+    if (row)
+    {
+        for (int y = bounds.top; y < bounds.top + rows; ++y)
+        {
+            unsigned short* out = row;
+            for (int x = bounds.left; x < bounds.left + columns; ++x)
+                *out++ = screen[width * y + x];
+            row += columns;
+        }
+    }
+
+    if (!software_mode)
+    {
+        DirectDrawSurface7Prefix* locked = surface_storage[current_surface]->surface;
+        locked->vtable->Unlock(locked, 0);
+    }
+    pixels_locked = 0;
+    return surface;
+}
