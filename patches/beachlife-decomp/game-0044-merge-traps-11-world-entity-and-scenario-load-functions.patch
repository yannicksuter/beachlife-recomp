+#ifndef STARTUP_WORLD_STAFF_NAMES_H
+#define STARTUP_WORLD_STAFF_NAMES_H
+#include "startup_variable_state.h"
+#include "startup_screen_text.h"
+#include <windows.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+#include <new>
+
+// Shared spelling of the inline name generation in the staff constructors.
+static void AssignStaffName(WorldStaffEntity* staff, bool female, const unsigned short* format, int count)
+{
+    const unsigned char* catalog = reinterpret_cast<const unsigned char*>(variable_catalog);
+    unsigned int names;
+    memcpy(&names, catalog + (female ? 0x4e5e0 : 0x4e5dc), sizeof(names));
+    unsigned int index = static_cast<unsigned int>(rand()) % names;
+    catalog = reinterpret_cast<const unsigned char*>(variable_catalog);
+    const char* key = reinterpret_cast<const char*>(catalog + (female ? 0x42cdc : 0x409dc) + index * 64);
+    unsigned short* wide = static_cast<unsigned short*>(::operator new((strlen(key) + 1) * sizeof(unsigned short)));
+    MultiByteToWideChar(0, 0, key, -1, reinterpret_cast<LPWSTR>(wide), strlen(key) + 1);
+    unsigned short surname[64];
+    swprintf(surname, format, rand() % count + 1);
+    const unsigned short* first = screen_text_lookup->LookupText(wide);
+    const unsigned short* last = screen_text_lookup->LookupText(surname);
+    ::operator delete(wide);
+    unsigned int length = wcslen(last) + wcslen(first) + 2;
+    staff->personal_name_f8 = static_cast<unsigned short*>(::operator new(length * sizeof(unsigned short)));
+    wcscpy(staff->personal_name_f8, first);
+    static const unsigned short space[] = { ' ', 0 };
+    wcscat(staff->personal_name_f8, space);
+    wcscat(staff->personal_name_f8, last);
+}
+#endif
