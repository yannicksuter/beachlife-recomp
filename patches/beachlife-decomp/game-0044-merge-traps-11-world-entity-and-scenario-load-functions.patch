index 0000000000000000000000000000000000000000..f8cc51497dc3072bd953792e8ef1cfdac457b024
--- /dev/null
+++ b/src/startup_animation_sound_load.cpp
@@ -0,0 +1,57 @@
+#include "startup_animation_sound.h"
+#include "startup_ble_file.h"
+#include "startup_game_file.h"
+#include <new>
+#include <stdlib.h>
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004d07a0
+void AnimationSoundLookup::Load(const char* filename)
+{
+    unsigned int length = strlen(filename);
+    char* path = static_cast<char*>(::operator new(length + 1));
+    strcpy(path, filename);
+    path[length - 4] = '.';
+    path[length - 3] = 'b';
+    path[length - 2] = 'l';
+    path[length - 1] = 'e';
+    int size = GetFileSize(path);
+    char* data = LoadBleFile(path);
+    ::operator delete(path);
+    int offset = 0;
+    char token[52];
+    char value[52];
+    while (offset < size)
+    {
+        offset += SkipWhitespace(data + offset);
+        offset += SkipComments(data + offset);
+        if (offset >= size)
+            break;
+        offset += ReadToken(token, data + offset);
+        if (!strcmp(token, "SpriteSounds"))
+            offset += ParseSpriteSounds(data + offset);
+        else if (!strcmp(token, "BuildingSounds"))
+            offset += ParseBuildingSounds(data + offset);
+        else if (!strcmp(token, "CrowdSound"))
+            offset += ParseCrowdSound(data + offset);
+        else if (!strcmp(token, "OpinionSounds"))
+            offset += ParseOpinionSounds(data + offset);
+        else if (!strcmp(token, "Groups"))
+        {
+            offset += SkipWhitespace(data + offset);
+            offset += ReadToken(value, data + offset);
+            while (strcmp(value, "End"))
+            {
+                int index = atoi(value);
+                offset += ReadToken(value, data + offset);
+                limits_51c[index] = atoi(value);
+                offset += ReadToken(value, data + offset);
+            }
+        }
+        else if (token[0] == '/')
+            offset += SkipComments(data + offset);
+        else
+            StartupFatal("Invalid Command Recieved in ScriptedSound %s", token);
+    }
+    ::operator delete(data);
+}
