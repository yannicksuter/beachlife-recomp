+// FUNCTION: BEACHLIFE 0x004453b0
+void ScreenTerrainGrid::RectangleTiles(const ScreenRectangle* rectangle,
+    int* left, int* top, int* width, int* height)
+{
+    ScreenPoint corner = { rectangle->left, rectangle->top };
+    ScreenWorldPosition first_world = overlay_map->ScreenToWorld(corner);
+    corner.x = rectangle->right;
+    corner.y = rectangle->bottom;
+    ScreenWorldPosition last_world = overlay_map->ScreenToWorld(corner);
+    ScreenPoint first = WorldToTile(first_world);
+    ScreenPoint last = WorldToTile(last_world);
+    first_world = TileOrigin(first.x, first.y);
+    first_world.y += static_cast<unsigned int>(tile_size_00) >> 1;
+    last_world = TileOrigin(last.x, last.y);
+    last_world.y += static_cast<unsigned int>(tile_size_00) >> 1;
+    overlay_map->WorldToScreen(first_world);
+    ScreenPoint projected = overlay_map->WorldToScreen(last_world);
+    projected.x += overlay_map->scroll_x_c4;
+    projected.y += overlay_map->scroll_y_c8;
+    if (projected.x > rectangle->left)
+        --first.x;
+    if (projected.y > rectangle->top && (first.x & 1))
+        --first.y;
+    if (projected.x < rectangle->right)
+        ++last.x;
+    if (projected.y < rectangle->bottom)
+        ++last.y;
+    if (first.x > last.x)
+        last.x = 128;
+    if (first.y > last.y)
+        last.y = 128;
+    if (first.x < 0)
+        first.x = 0;
+    else if (first.x > 128)
+        first.x = 128;
+    if (first.y < 0)
+        first.y = 0;
+    else if (first.y > 128)
+        first.y = 128;
+    if (last.x < 0)
+        last.x = 0;
+    else if (last.x > 128)
+        last.x = 128;
+    if (last.y < 0)
+        last.y = 0;
+    else if (last.y > 128)
+        last.y = 128;
+    *left = first.x;
+    *top = first.y;
+    *width = last.x - first.x + 1;
+    *height = last.y - first.y + 1;
+}
