+#include "startup_screen_point.h"
+#include <cmath>
+
+// FUNCTION: BEACHLIFE 0x00430890
+int MotionDirection(ScreenMapPosition direction, unsigned int count)
+{
+    float vertical = -direction.y;
+    if (vertical > 1.0)
+        vertical = 1.0f;
+    else if (!(vertical >= -1.0f))
+        vertical = -1.0f;
+    long double angle = std::acos(static_cast<long double>(vertical));
+    if (!(direction.x >= 0.0f))
+        angle = static_cast<long double>(6.2831854820251465f) - angle;
+    int sectors = static_cast<int>(count * 2u);
+    long double width = static_cast<long double>(6.2831854820251465f) / sectors;
+    int index = static_cast<int>(static_cast<long long>(angle / width));
+    if (index % 2)
+        index = static_cast<int>(static_cast<unsigned int>(index) + 1u);
+    return index / 2 % static_cast<int>(count);
+}
