+#ifndef NODE_STORAGE_H
+#define NODE_STORAGE_H
+
+#include "pool_chunk_acquire.h"
+#include "pool_lock_acquire.h"
+#include "pool_lock_guard.h"
+#include "pool_refill.h"
+#include "pool_return.h"
+
+#include <new>
+
+// Library inlines of the container storage front end observed expanded in
+// game methods: blocks above 128 bytes use the heap, smaller blocks the
+// locked size buckets. No separate retail bodies; no game-byte credit.
+inline const unsigned int& MaxUnsigned(const unsigned int& left, const unsigned int& right)
+{
+    return left < right ? right : left;
+}
+
+inline void* AllocateNodeStorage(unsigned int bytes)
+{
+    if (bytes > 128)
+    {
+        return ::operator new(bytes);
+    }
+    PoolChunkLink* volatile* bucket = pool_chunk_buckets + (bytes - 1) / 8;
+    AcquirePoolLock(&pool_lock_word);
+    PoolLockGuard guard;
+    PoolChunkLink* result = *bucket;
+    if (result != 0)
+    {
+        *bucket = result->next;
+    }
+    else
+    {
+        result = static_cast<PoolChunkLink*>(RefillPool(bytes));
+    }
+    return result;
+}
+
+inline void ReleaseNodeStorage(void* storage, unsigned int bytes)
+{
+    if (bytes > 128)
+    {
+        ::operator delete(storage);
+    }
+    else
+    {
+        ReturnPool(storage, bytes);
+    }
+}
+
+#endif
diff --git a/src/pool_refill.cpp b/src/pool_refill.cpp
new file mode 100644
--- /dev/null
+++ b/src/pool_refill.cpp
@@ -0,0 +1,30 @@
+#include "pool_refill.h"
+
+// FUNCTION: BEACHLIFE 0x004127e0
+void* RefillPool(unsigned int bytes)
+{
+    unsigned int block_size = (bytes + 7) & ~7u;
+    int count = 20;
+    char* chunk = AcquirePoolChunk(block_size, count);
+    if (count == 1)
+    {
+        return chunk;
+    }
+
+    PoolChunkLink* volatile* bucket = pool_chunk_buckets + (block_size - 1) / 8;
+    PoolChunkLink* result = reinterpret_cast<PoolChunkLink*>(chunk);
+    PoolChunkLink* next = reinterpret_cast<PoolChunkLink*>(chunk + block_size);
+    *bucket = next;
+    for (int index = 1;; ++index)
+    {
+        PoolChunkLink* current = next;
+        next = reinterpret_cast<PoolChunkLink*>(reinterpret_cast<char*>(next) + block_size);
+        if (count - 1 == index)
+        {
+            current->next = 0;
+            break;
+        }
+        current->next = next;
+    }
+    return result;
+}
