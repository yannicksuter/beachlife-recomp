+#include <stdio.h>
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004b4450
+void ScreenImageList::PopulateScenery(int kind, const char* thumbnail)
+{
+    unsigned int count = variable_catalog->scenery_count_34;
+    for (unsigned int index = 0; index < count; ++index)
+    {
+        VariableScenery* scenery = variable_catalog->Scenery(index);
+        if (scenery->list_kind_2c4 != kind)
+            continue;
+        char text[0x80];
+        sprintf(text, "SP_DESC_%s", scenery->name_04);
+        _strupr(text);
+        ScreenImageListFrame* frame = new ScreenImageListFrame;
+        frame->thumbnail_00 = thumbnail;
+        frame->preview_frame_04 = scenery->preview_frame_300;
+        frame->feature_0c = index;
+        frame->text_08 = new char[strlen(text) + 1];
+        strcpy(frame->text_08, text);
+
+        // Library push_back, expanded here with its growth and node storage.
+        ScreenImageListFrame** position = vector_60.end;
+        if (position != vector_60.capacity.data)
+        {
+            ::new (position) ScreenImageListFrame*(frame);
+            ++vector_60.end;
+        }
+        else
+        {
+            unsigned int minimum = 1;
+            unsigned int size = static_cast<unsigned int>(position - vector_60.begin);
+            unsigned int length = size + MaxUnsigned(size, minimum);
+            ScreenImageListFrame** storage = length
+                                               ? static_cast<ScreenImageListFrame**>(AllocateNodeStorage(length * sizeof(ScreenImageListFrame*)))
+                                               : 0;
+            ScreenImageListFrame** stored
+                = static_cast<ScreenImageListFrame**>(CopyTrivial(vector_60.begin, position, storage));
+            *stored = frame;
+            position = stored + 1;
+            if (vector_60.begin)
+                ReleaseNodeStorage(vector_60.begin,
+                    static_cast<unsigned int>(vector_60.capacity.data - vector_60.begin) * sizeof(ScreenImageListFrame*));
+            vector_60.begin = storage;
+            vector_60.end = position;
+            vector_60.capacity.data = storage + length;
+        }
+    }
+    flag_5c = 0;
+}
