+// FUNCTION: BEACHLIFE 0x0044f260
+void VariableCatalog::ParseVehicle(unsigned int id, const char* key, const char* value)
+{
+    unsigned char* record = reinterpret_cast<unsigned char*>(this) + 0x3fb24 + id * 0x274;
+    if (strcmp(key, "NAME") == 0)
+        strcpy(reinterpret_cast<char*>(record + 0x44), value);
+    else if (strcmp(key, "SPRITE") == 0)
+        strcpy(reinterpret_cast<char*>(record + 0xc4), value);
+    else if (strcmp(key, "GRIDWIDTH") == 0)
+        CatalogField<int>(record, 0x1c4) = atoi(value);
+    else if (strcmp(key, "GRIDHEIGHT") == 0)
+        CatalogField<int>(record, 0x1c8) = atoi(value);
+    else if (strcmp(key, "CAPACITY") == 0)
+        CatalogField<int>(record, 0x1cc) = atoi(value);
+    else if (strcmp(key, "TERRAIN") == 0)
+        return;
+    else if (strcmp(key, "MAX_SPEED") == 0)
+        CatalogField<float>(record, 0x1d4) = static_cast<float>(atof(value));
+    else if (strcmp(key, "TOWED") == 0)
+        strcpy(reinterpret_cast<char*>(record + 0x1e4), value);
+    else if (strcmp(key, "FORCE") == 0)
+        CatalogField<float>(record, 0x1d0) = static_cast<float>(atof(value));
+    else if (strcmp(key, "MASS") == 0)
+        CatalogField<float>(record, 0x1d8) = static_cast<float>(atof(value));
+    else if (strcmp(key, "MOVETYPE") == 0)
+    {
+        if (strcmp(value, "POINTS") == 0)
+            record[0x1dc] = 1;
+        else if (strcmp(value, "BOUNDARY") == 0)
+            record[0x1dc] = 2;
+        else
+            StartupFatal("WorldParams::AddVehicleData - Invalid Movement Type - %s", value);
+    }
+    else if (strcmp(key, "ANIMSET") == 0)
+        strcpy(reinterpret_cast<char*>(record + 0x224), value);
+    else if (strcmp(key, "STAFF") == 0)
+    {
+        unsigned int staff = FindStaff(value);
+        unsigned int& count = CatalogField<unsigned int>(record, 0x1e0);
+        CatalogField<unsigned int>(record, 0x264 + count * 4) = staff;
+        ++count;
+    }
+    else if (strcmp(key, "CREATION_PNTX") == 0)
+        CatalogField<float>(record, 0x26c) = static_cast<float>(atof(value));
+    else if (strcmp(key, "CREATION_PNTY") == 0)
+        CatalogField<float>(record, 0x270) = static_cast<float>(atof(value));
+    else
+        StartupFatal("WorldParams::AddVehicleData - unrecognised Vehicle keyword - %s", key);
+}
+
+// FUNCTION: BEACHLIFE 0x0044f830
+void VariableCatalog::ParseName(const char* kind, const char* value)
+{
+    unsigned char* names = reinterpret_cast<unsigned char*>(this) + 0x409dc;
+    if (strcmp(kind, "MALENAME") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(names, 0xdc00);
+        strcpy(reinterpret_cast<char*>(names + count * 64), value);
+        ++count;
+    }
+    else if (strcmp(kind, "FEMALENAME") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(names, 0xdc04);
+        strcpy(reinterpret_cast<char*>(names + (count + 0x8c) * 64), value);
+        ++count;
+    }
+    else if (strcmp(kind, "SURNAME") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(names, 0xdc08);
+        strcpy(reinterpret_cast<char*>(names + (count + 0x118) * 64), value);
+        ++count;
+    }
+    else
+        StartupFatal("WorldParams::AddNameData - unrecognised comment keyword - %s", kind);
+}
+
+// FUNCTION: BEACHLIFE 0x0044f9d0
+void VariableCatalog::ParseEvent(unsigned int id, const char* key, const char* value)
+{
+    unsigned char* record = reinterpret_cast<unsigned char*>(this) + 0x4e5e8 + id * 0x58;
+    if (strcmp(key, "COST") == 0)
+        CatalogField<float>(record, 0x4c) = static_cast<float>(atof(value));
+    else if (strcmp(key, "DEF_PRICE") == 0)
+        CatalogField<float>(record, 0x48) = static_cast<float>(atof(value));
+    else if (strcmp(key, "MALE_INTENSITY") == 0)
+        CatalogField<float>(record, 0x50) = static_cast<float>(atof(value));
+    else if (strcmp(key, "FEMALE_INTENSITY") == 0)
+        CatalogField<float>(record, 0x54) = static_cast<float>(atof(value));
+    else
+        StartupFatal("WorldParams::AddEventData - unrecognised event keyword - %s", key);
+}
+
+// FUNCTION: BEACHLIFE 0x0044fb40
+void VariableCatalog::ParseUnlock(unsigned int id, const char* key, const char* value)
+{
+    unsigned char* record = reinterpret_cast<unsigned char*>(this) + 0x4ecc8 + id * 0xdc;
+    record[0xd8] = 1;
+    if (strcmp(key, "BRAND") == 0)
+        strcpy(reinterpret_cast<char*>(record + 0x44), value);
+    else if (strcmp(key, "BASECOST") == 0)
+        CatalogField<float>(record, 0xc4) = static_cast<float>(atof(value));
+    else if (strcmp(key, "COCKTAIL") == 0)
+        strcpy(reinterpret_cast<char*>(record + 0x84), value);
+    else if (strcmp(key, "STRCOST") == 0)
+        CatalogField<float>(record, 0xc8) = static_cast<float>(atof(value));
+    else if (strcmp(key, "ALCSTR") == 0)
+        CatalogField<float>(record, 0xd0) = static_cast<float>(atof(value));
+    else if (strcmp(key, "PRICE") == 0)
+        CatalogField<float>(record, 0xcc) = static_cast<float>(atof(value));
+    else if (strcmp(key, "EFFECT") == 0)
+    {
+        if (strcmp(value, "FIGHT") == 0)
+            CatalogField<unsigned int>(record, 0xd4) = 0;
+        else if (strcmp(value, "FLIRT") == 0)
+            CatalogField<unsigned int>(record, 0xd4) = 1;
+        else if (strcmp(value, "VANDAL") == 0)
+            CatalogField<unsigned int>(record, 0xd4) = 2;
+        else if (strcmp(value, "HAPPY") == 0)
+            CatalogField<unsigned int>(record, 0xd4) = 3;
+        else if (strcmp(value, "SAD") == 0)
+            CatalogField<unsigned int>(record, 0xd4) = 4;
+        else
+            StartupFatal("WorldParams::AddBeerData - Invalid beer effect Type %s", value);
+    }
+    else
+        StartupFatal("WorldParams::AddEventData - unrecognised event keyword - %s", key);
+}
