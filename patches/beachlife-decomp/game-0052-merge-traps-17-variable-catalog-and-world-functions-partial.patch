+static unsigned int& CatalogWord(void* base, unsigned int offset)
+{
+    return *reinterpret_cast<unsigned int*>(static_cast<unsigned char*>(base) + offset);
+}
+
+static unsigned char* CatalogRecord(VariableCatalog* catalog, unsigned int offset, unsigned int stride, unsigned int index)
+{
+    return reinterpret_cast<unsigned char*>(catalog) + offset + stride * index;
+}
+
+static unsigned char* FindCatalogRecord(VariableCatalog* catalog, unsigned int count_offset, unsigned int offset, unsigned int stride, const char* name)
+{
+    for (unsigned int index = 0; index < CatalogWord(catalog, count_offset); ++index)
+    {
+        unsigned char* record = CatalogRecord(catalog, offset, stride, index);
+        if (strcmp(reinterpret_cast<char*>(record + 4), name) == 0)
+            return record;
+    }
+    return 0;
+}
+
+static unsigned char* BeginCatalogRecord(VariableCatalog* catalog, unsigned int count_offset, unsigned int offset, unsigned int stride, const char* name)
+{
+    unsigned int id = CatalogWord(catalog, count_offset);
+    unsigned char* record = CatalogRecord(catalog, offset, stride, id);
+    CatalogWord(record, 0) = id;
+    strcpy(reinterpret_cast<char*>(record + 4), name);
+    return record;
+}
+
+static unsigned int NextCatalogValue(const char* data, unsigned int index)
+{
+    while (data[index] != '"')
+        ++index;
+    return index + 1;
+}
