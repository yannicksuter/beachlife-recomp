+// FUNCTION: BEACHLIFE 0x004497a0
+void VariableCatalog::ParseBuilding(unsigned int id, const char* key, char* value)
+{
+    VariableBuilding* building = Building(id);
+    building->default_drink_e18 = 0;
+    if (strcmp(key, "NAME") == 0)
+        strcpy(building->name_04 + 0x40, value);
+    else if (strcmp(key, "SPRITE") == 0)
+        strcpy(building->resource_c4, value);
+    else if (strcmp(key, "ICON") == 0)
