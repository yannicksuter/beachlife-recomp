+// FUNCTION: BEACHLIFE 0x0044ff10
+void VariableCatalog::ParseData(char* data, int size)
+{
+    bool quoted = false;
+    for (unsigned int index = 0; index < static_cast<unsigned int>(size); ++index)
+    {
+        if (data[index] == '"')
+        {
+            if (quoted)
+                data[index] = 0;
+            quoted = !quoted;
+        }
+        else if (!quoted)
+            data[index] = 0;
+    }
+    if (quoted)
+        StartupFatal("WorldParams::Process - odd number of quotes in gameplay file");
+    for (unsigned int index = 0; index < static_cast<unsigned int>(size); ++index)
+    {
+        if (data[index] != '"')
+            continue;
+        char key[256] = { };
+        unsigned int cursor = index + 1;
+        char* destination = key;
+        for (;;)
+        {
+            char value = data[cursor];
+            if (value == '_' && strcmp(key, "JETTY") != 0 && strcmp(key, "SECURITY") != 0)
+                break;
+            if (value == '"')
+                break;
+            *destination++ = value;
+            ++cursor;
+        }
+        const char* value = data + cursor + 1;
+        unsigned char* record;
+        if (strcmp(key, "COMFAM") == 0)
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            record = BeginCatalogRecord(this, 0, 0x38, 0xc4, value);
+            strcpy(reinterpret_cast<char*>(record + 0x44), data + index);
+            ++CatalogWord(this, 0);
+        }
+        else if (strcmp(key, "COM") == 0)
+        {
+            unsigned int display = NextCatalogValue(data, cursor + 1);
+            index = NextCatalogValue(data, display);
+            record = BeginCatalogRecord(this, 4, 0x1298, 0xc8, value);
+            strcpy(reinterpret_cast<char*>(record + 0x44), data + display);
+            CatalogWord(record, 0xc4) = FindFeatureType(data + index);
+            ++CatalogWord(this, 4);
+        }
+        else if (strcmp(key, "HOURS") == 0)
+        {
+            unsigned int first = NextCatalogValue(data, cursor + 1);
+            index = NextCatalogValue(data, first);
+            record = BeginCatalogRecord(this, 8, 0x32a0, 0x4c, value);
+            *reinterpret_cast<float*>(record + 0x44) = static_cast<float>(atof(data + first));
+            *reinterpret_cast<float*>(record + 0x48) = static_cast<float>(atof(data + index));
+            ++CatalogWord(this, 8);
+        }
+        else if (strcmp(key, "BUILD") == 0)
+        {
+            record = BeginCatalogRecord(this, 0xc, 0x341c, 0xe1c, value);
+            reinterpret_cast<VariableBuilding*>(record)->footprint_e14 = 0;
+            ++building_count_0c;
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0xc, 0x341c, 0xe1c, key))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            ParseBuilding(FindBuilding(key), value, data + index);
+        }
+        else if (strcmp(key, "DESIRE") == 0)
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            record = BeginCatalogRecord(this, 0x10, 0x37490, 0x128, value);
+            strcpy(reinterpret_cast<char*>(record + 0x44), data + index);
+            CatalogWord(record, 0xc4) = 0;
+            ++CatalogWord(this, 0x10);
+        }
+        else if ((record = FindCatalogRecord(this, 0x10, 0x37490, 0x128, key)))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            unsigned int id = CatalogWord(record, 0);
+            record = CatalogRecord(this, 0x37490, 0x128, id);
+            if (strcmp(value, "COMFAM") == 0)
+            {
+                unsigned int count = CatalogWord(record, 0xc4);
+                CatalogWord(record, 0xc8 + count * 4) = FindFeatureType(data + index);
+                ++CatalogWord(record, 0xc4);
+            }
+            else
+                StartupFatal("WorldParams::AddDesireComFamPull - hmmm - datakeyword should be COMFAM - %s", value);
+        }
+        else if (strcmp(key, "STAFF") == 0)
+        {
+            const char* fields[13];
+            fields[0] = value;
+            index = cursor + 1;
+            for (unsigned int field = 1; field < 13; ++field)
+            {
+                index = NextCatalogValue(data, index);
+                fields[field] = data + index;
+            }
+            ParseStaff(fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], fields[6], fields[7], fields[8], fields[9], fields[10], fields[11], fields[12]);
+        }
+        else if (strcmp(key, "GUEST") == 0)
+        {
+            BeginCatalogRecord(this, 0x18, 0x3b1b4, 0x3ac, value);
+            ++guest_count_18;
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0x18, 0x3b1b4, 0x3ac, key))
+        {
+            unsigned int id = FindGuest(key);
+            if (GuestValueKey(value))
+            {
+                index = NextCatalogValue(data, cursor + 1);
+                ParseGuestValue(id, value, data + index);
+            }
+            else if (GuestRangeKey(value))
+            {
+                unsigned int first = NextCatalogValue(data, cursor + 1);
+                index = NextCatalogValue(data, first);
+                ParseGuestRange(id, value, data + first, data + index);
+            }
+            else
+                StartupFatal("WorldParams::Process - unrecognised guest keyword prefix - %s", value);
+        }
+        else if (strcmp(key, "VEHICLE") == 0)
+        {
+            BeginCatalogRecord(this, 0x1c, 0x3fb24, 0x274, value);
+            ++vehicle_count_1c;
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0x1c, 0x3fb24, 0x274, key))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            ParseVehicle(FindVehicle(key), value, data + index);
+        }
+        else if (strcmp(key, "TABLE") == 0)
+        {
+            BeginCatalogRecord(this, 0x30, 0x4f1a4, 0x428, value);
+            ++object_count_30;
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0x30, 0x4f1a4, 0x428, key))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            ParseObject(FindObject(key), value, data + index);
+        }
+        else if (strcmp(key, "SURNAME") == 0 || strcmp(key, "MALENAME") == 0 || strcmp(key, "FEMALENAME") == 0)
+        {
+            index = cursor + 1;
+            ParseName(key, data + index);
+        }
+        else if (strcmp(key, "EVENT") == 0)
+        {
+            BeginCatalogRecord(this, 0x24, 0x4e5e8, 0x58, value);
+            ++CatalogWord(this, 0x24);
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0x24, 0x4e5e8, 0x58, key))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            ParseEvent(FindEvent(key), value, data + index);
+        }
+        else if (strcmp(key, "BEER") == 0)
+        {
+            BeginCatalogRecord(this, 0x28, 0x4ecc8, 0xdc, value);
+            ++drink_count_28;
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0x28, 0x4ecc8, 0xdc, key))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            ParseUnlock(FindUnlock(key), value, data + index);
+        }
+        else if (strcmp(key, "FINE") == 0)
+        {
+            BeginCatalogRecord(this, 0x2c, 0x4f114, 0x48, value);
+            ++CatalogWord(this, 0x2c);
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0x2c, 0x4f114, 0x48, key))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            unsigned int id = FindCrime(key);
+            if (strcmp(value, "COST") == 0)
+                *reinterpret_cast<float*>(CatalogRecord(this, 0x4f114, 0x48, id) + 0x44) = static_cast<float>(atof(data + index));
+            else
+                StartupFatal("WorldParams::AddFineData - unrecognised event keyword - %s", value);
+        }
+        else if (strcmp(key, "SCENERY") == 0)
+        {
+            BeginCatalogRecord(this, 0x34, 0x5409c, 0x314, value);
+            ++scenery_count_34;
+            index = cursor + 1;
+        }
+        else if (FindCatalogRecord(this, 0x34, 0x5409c, 0x314, key))
+        {
+            index = NextCatalogValue(data, cursor + 1);
+            ParseScenery(FindScenery(key), value, data + index);
+        }
+        else
+            StartupFatal("WorldParams::Process - unrecognised keyword prefix - %s", key);
+    }
+}
