+static unsigned int FindCatalogField(VariableCatalog* catalog, unsigned int count_offset, unsigned int records_offset, unsigned int stride, const char* value, const char* error)
+{
+    unsigned int count = CatalogField<unsigned int>(catalog, count_offset);
+    for (unsigned int index = 0; index < count; ++index)
+    {
+        unsigned char* entry = reinterpret_cast<unsigned char*>(catalog) + records_offset + index * stride;
