+template <class T>
+static T& CatalogField(void* record, unsigned int offset)
+{
+    return *reinterpret_cast<T*>(static_cast<unsigned char*>(record) + offset);
+}
+
+static char* CatalogNextField(char* field)
+{
+    while (*field != '"')
+        ++field;
+    return field + 1;
+}
+
+template <unsigned int Count>
+static void CatalogReadFields(char* first, char* (&fields)[Count])
+{
+    fields[0] = first;
+    for (unsigned int index = 1; index < Count; ++index)
+        fields[index] = CatalogNextField(fields[index - 1]);
+}
+
+template <unsigned int Count>
+static void CatalogConsumeFields(char* (&fields)[Count])
+{
+    for (unsigned int index = 1; index < Count; ++index)
+        fields[index][-1] = 0;
+}
