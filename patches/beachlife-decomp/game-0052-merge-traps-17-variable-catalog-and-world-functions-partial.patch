+// FUNCTION: BEACHLIFE 0x0044bd80
+void VariableCatalog::ParseStaff(const char* key, const char* name, const char* gender, const char* wage, const char* resource, const char* role, const char* script, const char* base_wage, const char* value210, const char* value214, const char* morale, const char* shift_start, const char* shift_end)
+{
+    unsigned char* record = BeginCatalogRecord(this, 0x14, 0x384c0, 0x224, key);
+    strcpy(reinterpret_cast<char*>(record + 0x44), name);
+    if (*gender == 'M')
+        CatalogWord(record, 0xc4) = 0;
+    else if (*gender == 'F')
+        CatalogWord(record, 0xc4) = 1;
+    else
+        StartupFatal("WorldParams::AddStaff - sex isn't M or F - %s", key);
+    CatalogWord(record, 0xc8) = atoi(wage);
+    strcpy(reinterpret_cast<char*>(record + 0xcc), resource);
+    strcpy(reinterpret_cast<char*>(record + 0x1cc), role);
+    strcpy(reinterpret_cast<char*>(record + 0x1ec), script);
+    CatalogWord(record, 0x20c) = atoi(base_wage);
+    *reinterpret_cast<float*>(record + 0x210) = static_cast<float>(atof(value210));
+    *reinterpret_cast<float*>(record + 0x214) = static_cast<float>(atof(value214));
+    *reinterpret_cast<float*>(record + 0x218) = static_cast<float>(atof(morale));
+    CatalogWord(record, 0x21c) = atoi(shift_start);
+    CatalogWord(record, 0x220) = atoi(shift_end);
+    ++CatalogWord(this, 0x14);
+}
