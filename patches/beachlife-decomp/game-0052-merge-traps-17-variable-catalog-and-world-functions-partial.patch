+static char* CopyCatalogText(const char* value)
+{
+    char* text = static_cast<char*>(::operator new(strlen(value) + 1));
+    strcpy(text, value);
+    return text;
+}
+
+// FUNCTION: BEACHLIFE 0x0044e410
+void VariableCatalog::ParseObject(unsigned int id, const char* key, const char* value)
+{
+    VariableCatalogObjectDefinition* object = Object(id);
+    if (strcmp(key, "NAME") == 0)
+        strcpy(reinterpret_cast<char*>(object->unknown_00 + 0x44), value);
+    else if (strcmp(key, "TABLE_SPRITE") == 0)
+        strcpy(object->resource_c4, value);
+    else if (strcmp(key, "CHAIR_SPRITE") == 0)
+        strcpy(object->resource_1c4, value);
+    else if (strcmp(key, "GRIDWIDTH") == 0)
+        CatalogField<int>(object->unknown_348, 0x80) = atoi(value);
+    else if (strcmp(key, "GRIDHEIGHT") == 0)
+        CatalogField<int>(object->unknown_348, 0x84) = atoi(value);
+    else if (strcmp(key, "CAPACITY") == 0)
+    {
+        object->frame_count_3d0 = atoi(value);
+        object->data_3f0 = ::operator new(object->frame_count_3d0 * sizeof(unsigned int));
+        object->frames_3f4 = static_cast<void**>(::operator new(object->frame_count_3d0 * sizeof(void*)));
+    }
+    else if (strcmp(key, "NUM_WALK_PTS") == 0)
+        object->data_3e0 = ::operator new(static_cast<unsigned int>(atoi(value)) * sizeof(ScreenMapPosition));
+    else if (strcmp(key, "WALK_PNT_X") == 0)
+        static_cast<ScreenMapPosition*>(object->data_3e0)[CatalogField<unsigned int>(object->unknown_3d8, 4)].x = static_cast<float>(atof(value));
+    else if (strcmp(key, "WALK_PNT_Y") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(object->unknown_3d8, 4);
+        static_cast<ScreenMapPosition*>(object->data_3e0)[count].y = static_cast<float>(atof(value));
+        ++count;
+    }
+    else if (strcmp(key, "NUM_CHAIRPOS_PTS") == 0)
+        object->data_3e8 = ::operator new(static_cast<unsigned int>(atoi(value)) * sizeof(ScreenMapPosition));
+    else if (strcmp(key, "CHAIRPOS_X") == 0)
+        static_cast<ScreenMapPosition*>(object->data_3e8)[CatalogField<unsigned int>(object->unknown_3e4, 0)].x = static_cast<float>(atof(value));
+    else if (strcmp(key, "CHAIRPOS_Y") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(object->unknown_3e4, 0);
+        static_cast<ScreenMapPosition*>(object->data_3e8)[count].y = static_cast<float>(atof(value));
+        ++count;
+    }
+    else if (strcmp(key, "CHAIR_DIRECTION") == 0)
+    {
+        static const char* const directions[] = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" };
+        unsigned int direction = 0;
+        while (direction < 8 && strcmp(value, directions[direction]) != 0)
+            ++direction;
+        unsigned int& count = CatalogField<unsigned int>(object->unknown_3ec, 0);
+        if (direction < 8)
+            static_cast<unsigned int*>(object->data_3f0)[count] = direction;
+        else
+            StartupFatal("Invalid direction in table - %s", value);
+        ++count;
+    }
+    else if (strcmp(key, "CHAIR_NUM_WALKPNT") == 0)
+    {
+        unsigned int size = static_cast<unsigned int>(atoi(value)) * 4 + 4;
+        void* points = ::operator new(size);
+        unsigned int& count = CatalogField<unsigned int>(object->unknown_414, 4);
+        object->frames_3f4[count] = points;
+        *static_cast<int*>(object->frames_3f4[count]) = atoi(value);
+        ++count;
+        CatalogField<unsigned int>(object->unknown_414, 0) = 1;
+    }
+    else if (strcmp(key, "CHAIR_WALKPNT") == 0)
+    {
+        int point = atoi(value);
+        unsigned int count = CatalogField<unsigned int>(object->unknown_414, 4);
+        unsigned int& index = CatalogField<unsigned int>(object->unknown_414, 0);
+        static_cast<int*>(object->frames_3f4[count - 1])[index] = point;
+        ++index;
+    }
+    else if (strcmp(key, "SIT_DOWN_ANIM") == 0)
+        strcpy(reinterpret_cast<char*>(object->unknown_2c4), value);
+    else if (strcmp(key, "NUM_SAT_DOWN_ANIM") == 0)
+        object->names_344 = static_cast<void**>(::operator new(static_cast<unsigned int>(atoi(value)) * sizeof(void*)));
+    else if (strcmp(key, "SAT_DOWN_ANIM") == 0)
+    {
+        object->names_344[object->name_count_3d4] = ::operator new(strlen(value) + 1);
+        strcpy(static_cast<char*>(object->names_344[object->name_count_3d4]), value);
+        ++object->name_count_3d4;
+    }
+    else if (strcmp(key, "GET_UP_ANIM") == 0)
+        strcpy(reinterpret_cast<char*>(object->unknown_348), value);
+    else if (strcmp(key, "SERVE_TABLE") == 0)
+        object->flag_424 = atoi(value) != 0;
+    else if (strcmp(key, "XOFFSET_TABLE") == 0)
+        object->draw_offset_x_41c = atoi(value);
+    else if (strcmp(key, "YOFFSET_TABLE") == 0)
+        object->draw_offset_y_420 = atoi(value);
+    else if (strcmp(key, "HAS_WAITER") == 0)
+        object->flag_3f8 = atoi(value) != 0;
+    else if (strcmp(key, "WAITER_SPRITE") == 0)
+        object->data_40c = CopyCatalogText(value);
+    else if (strcmp(key, "WAITER_WALK_ANIM") == 0)
+        object->data_404 = CopyCatalogText(value);
+    else if (strcmp(key, "WAITER_SERVE_ANIM") == 0)
+        object->data_408 = CopyCatalogText(value);
+    else if (strcmp(key, "CALL_WAITER_ANIM") == 0)
+        object->data_3fc = CopyCatalogText(value);
+    else if (strcmp(key, "WAIT_WAITER_ANIM") == 0)
+        object->data_400 = CopyCatalogText(value);
+    else if (strcmp(key, "WAITER_SERVE_POINT_X") == 0)
+    {
+        if (CatalogField<unsigned int>(object->unknown_3d8, 0) == 0)
+            object->data_410 = ::operator new(object->frame_count_3d0 * sizeof(ScreenMapPosition));
+        static_cast<ScreenMapPosition*>(object->data_410)[CatalogField<unsigned int>(object->unknown_3d8, 0)].x = static_cast<float>(atof(value));
+    }
+    else if (strcmp(key, "WAITER_SERVE_POINT_Y") == 0)
+    {
+        unsigned int& count = CatalogField<unsigned int>(object->unknown_3d8, 0);
+        static_cast<ScreenMapPosition*>(object->data_410)[count].y = static_cast<float>(atof(value));
+        ++count;
+    }
+    else
+        StartupFatal("WorldParams::AddTableData - unrecognised Table keyword - %s", key);
+}
