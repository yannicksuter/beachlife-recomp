diff --git a/tests/float_to_integer.cpp b/tests/float_to_integer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6374aff4c4ed17cad04725367b25535d3dcf606a
--- /dev/null
+++ b/tests/float_to_integer.cpp
@@ -0,0 +1,33 @@
+#include "startup_float_to_integer.h"
+#include <cassert>
+#include <limits>
+
+int main()
+{
+    struct Case
+    {
+        long double value;
+        std::uint32_t expected;
+    };
+    const Case cases[] = {
+        { 0.0L, 0 },
+        { -0.0L, 0 },
+        { 1.9L, 1 },
+        { -1.9L, 0xffffffffu },
+        { 2147483647.0L, 0x7fffffffu },
+        { 2147483648.0L, 0x80000000u },
+        { 4294967295.0L, 0xffffffffu },
+        { 4294967296.0L, 0 },
+        { 4294967297.0L, 1 },
+        { -4294967297.0L, 0xffffffffu },
+        { 9223372036854775808.0L, 0 },
+        { -9223372036854775808.0L, 0 },
+        { std::numeric_limits<long double>::infinity(), 0 },
+        { -std::numeric_limits<long double>::infinity(), 0 },
+        { std::numeric_limits<long double>::quiet_NaN(), 0 },
+        { std::numeric_limits<long double>::max(), 0 },
+        { -std::numeric_limits<long double>::max(), 0 },
+    };
+    for (const Case& item : cases)
+        assert(static_cast<std::uint32_t>(TruncateFloatToWord(item.value)) == item.expected);
+}
diff --git a/tests/frame_clock.cpp b/tests/frame_clock.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b540683584bde6d627bc9a8651459b0fd4ae65dc
--- /dev/null
+++ b/tests/frame_clock.cpp
@@ -0,0 +1,37 @@
+#include "startup_frame_clock.h"
+#include <cassert>
+#include <cmath>
+#include <limits>
+
+FrameClock* startup_frame_clock = 0;
+
+static void CheckElapsed(int start, int end, float expected)
+{
+    FrameClock clock(start);
+    clock.Update(end);
+    assert(std::fabs(clock.seconds - expected) < 0.000001f);
+    assert(clock.delta_seconds == clock.seconds);
+    assert(clock.frames == 1);
+}
+
+int main()
+{
+    CheckElapsed(100, 132, 0.032f);
+    CheckElapsed(std::numeric_limits<int>::max() - 15,
+        std::numeric_limits<int>::min() + 16,
+        0.032f);
+    CheckElapsed(-16, 16, 0.032f);
+    CheckElapsed(std::numeric_limits<int>::min() + 16,
+        std::numeric_limits<int>::max() - 15,
+        -0.032f);
+    CheckElapsed(132, 100, -0.032f);
+
+    FrameClock clock(0);
+    clock.frames = std::numeric_limits<unsigned int>::max();
+    clock.previous_frames = clock.frames;
+    clock.Update(2000);
+    assert(clock.frames == 0);
+    assert(clock.sampled_frames == 1);
+    assert(clock.previous_frames == 0);
+    assert(clock.sample_seconds == 1.0f);
+}
diff --git a/tests/gui_integer.cpp b/tests/gui_integer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fca9ab0c9f6a19b758d09e2cb36dc4edf912bc5a
--- /dev/null
+++ b/tests/gui_integer.cpp
@@ -0,0 +1,36 @@
+#include "startup_gui_parser.h"
+#include <cassert>
+#include <limits>
+
+static void CheckInteger(const char* text, int expected)
+{
+    GuiParserState parser(0);
+    parser.buffer = text;
+    parser.cursor = 0;
+    int value;
+    parser.ReadInteger(value, false);
+    assert(value == expected);
+    assert(text[parser.cursor] == ')');
+}
+
+int main()
+{
+    CheckInteger(" 42)", 42);
+    CheckInteger("2147483647)", std::numeric_limits<int>::max());
+    CheckInteger("2147483648)", std::numeric_limits<int>::min());
+    CheckInteger("4294967295)", -1);
+    CheckInteger("4294967296)", 0);
+    CheckInteger("18446744073709551615)", -1);
+    CheckInteger("-1)", -29);
+    CheckInteger("\xff)", -49);
+
+    GuiParserState parser(0);
+    parser.buffer = "4294967295, \t42) next";
+    parser.cursor = 0;
+    int value;
+    parser.ReadInteger(value, true);
+    assert(value == -1);
+    parser.ReadInteger(value, true);
+    assert(value == 42);
+    assert(parser.buffer[parser.cursor] == 'n');
+}
