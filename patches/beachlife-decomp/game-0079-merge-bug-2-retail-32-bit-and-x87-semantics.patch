+// Retail _ftol truncates to a signed 64-bit integer, then these callers use
+// only EAX. The x87 integer-indefinite result also has a zero low word.
+inline std::int32_t TruncateFloatToWord(long double value)
+{
+    if (!(value >= -9223372036854775808.0L && value < 9223372036854775808.0L))
+        return 0;
+    return static_cast<std::int32_t>(static_cast<std::uint32_t>(static_cast<std::int64_t>(value)));
+}
+
+#endif
