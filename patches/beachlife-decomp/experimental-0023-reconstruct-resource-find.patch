@@ -0,0 +1,27 @@
+#include "startup_screen_dialog_resource.h"
+
+#include <new>
+#include <string.h>
+#if !defined(_WIN32)
+#include <strings.h>
+// Native CRT spelling only; no replacement comparator.
+#define _stricmp strcasecmp
+#endif
+
+// FUNCTION: BEACHLIFE 0x00417c30
+ScreenDialogResource* ScreenDialogResourceLookup::Find(const char* name)
+{
+    for (int index = 0; index < record_count; ++index)
+    {
+        if (_stricmp(records[index]->name, name) == 0)
+        {
+            ScreenDialogResource* resource = new ScreenDialogResource;
+            resource->record = records[index];
+            ++resource->record->reference_count;
+            resource->name = static_cast<char*>(::operator new(strlen(name) + 1));
+            strcpy(resource->name, name);
+            return resource;
+        }
+    }
+    return Find(screen_dialog_fallback_name);
+}
