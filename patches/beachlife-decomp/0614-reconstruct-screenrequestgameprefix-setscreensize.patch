+// FUNCTION: BEACHLIFE 0x004e41e0
+void ScreenRequestGamePrefix::SetScreenSize(int width, int height)
+{
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    if (renderer->width == static_cast<unsigned int>(width)
+        && renderer->height == static_cast<unsigned int>(height))
+    {
+        return;
+    }
+
+    if (!renderer->SetScreenSize(width, height))
+    {
+        // STRING: BEACHLIFE 0x0058649c
+        const unsigned short* message = screen_text_lookup->LookupText("ERROR_DIRECTX");
+        ShowFatalWindowMessage(controller_selection.window, message);
+    }
+
+    startup_input_state->SetScreenSize(width, height);
+    controller_selection.active->ScreenSizeChanged(width, height);
+}
