+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x004c7ec0
+void DrawFrameStyle6(const ScreenRectangle& rectangle)
+{
+    int top = rectangle.top;
+    int left = rectangle.left;
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    int width = rectangle.right - left - 1;
+    unsigned int colour = renderer->ConvertColour(37, 66, 189);
+    int right = width + left - 1;
+    ++left;
+    renderer->DrawLine(left, top, right, top, colour);
+
+    colour = renderer->ConvertColour(147, 178, 253);
+    renderer->DrawLine(left, top + 1, right, top + 1, colour);
+
+    colour = renderer->ConvertColour(187, 208, 255);
+    renderer->DrawLine(left, top + 2, right, top + 2, colour);
+}
