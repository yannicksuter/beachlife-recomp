diff --git a/src/startup_renderer_line.cpp b/src/startup_renderer_line.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_renderer_line.cpp
@@ -0,0 +1,75 @@
+#include "startup_screen_renderer.h"
+#include "startup_renderer_line_raster.h"
+
+// FUNCTION: BEACHLIFE 0x004118a0
+void ScreenRequestRenderer::DrawLine(int x1, int y1, int x2, int y2, unsigned int colour)
+{
+    if (x1 >= clip_rectangle.width || x2 < 0 || y1 >= clip_rectangle.height || y2 <= 0)
+        return;
+
+    if (y1 > y2)
+    {
+        int saved = y1;
+        y1 = y2;
+        y2 = saved;
+        saved = x1;
+        x1 = x2;
+        x2 = saved;
+    }
+    int delta_y = y2 - y1;
+    int delta_x = x2 - x1;
+
+    if (unscaled_clip_5c)
+    {
+        unsigned short* pixels = AccessPixels();
+        if (!pixels)
+            return;
+        ScreenRequestRenderer* position_renderer = screen_request_renderer;
+        ScreenSurfacePosition* position_entry = position_renderer->surfaces[position_renderer->current_surface];
+        int position_x = position_entry->position.x;
+        int position_y = position_entry->position.y;
+        x1 -= position_x;
+        y1 -= position_y;
+        unsigned int pitch = surfaces[current_surface]->pitch;
+
+        if (delta_x > 0)
+        {
+            if (delta_x > delta_y)
+                RasterLinePackedX(x1, y1, delta_x, delta_y, 1, colour, pixels, pitch >> 1);
+            else
+                RasterLinePackedY(x1, y1, delta_x, delta_y, 1, colour, pixels, pitch >> 1);
+        }
+        else
+        {
+            delta_x = -delta_x;
+            if (delta_x > delta_y)
+                RasterLinePackedX(x1, y1, delta_x, delta_y, -1, colour, pixels, pitch >> 1);
+            else
+                RasterLinePackedY(x1, y1, delta_x, delta_y, -1, colour, pixels, pitch >> 1);
+        }
+
+        if (!software_mode)
+        {
+            DirectDrawSurface7Prefix* surface = surfaces[current_surface]->surface;
+            surface->vtable->Unlock(surface, 0);
+        }
+        pixels_locked = 0;
+        return;
+    }
+
+    if (delta_x > 0)
+    {
+        if (delta_x > delta_y)
+            RasterLineDirectX(x1, y1, delta_x, delta_y, 1, colour, pixels_1c, width);
+        else
+            RasterLineDirectY(x1, y1, delta_x, delta_y, 1, colour, pixels_1c, width);
+    }
+    else
+    {
+        delta_x = -delta_x;
+        if (delta_x > delta_y)
+            RasterLineDirectX(x1, y1, delta_x, delta_y, -1, colour, pixels_1c, width);
+        else
+            RasterLineDirectY(x1, y1, delta_x, delta_y, -1, colour, pixels_1c, width);
+    }
+}
