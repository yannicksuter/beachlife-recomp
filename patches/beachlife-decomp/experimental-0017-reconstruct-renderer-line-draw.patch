+#include "startup_renderer_line_raster.h"
+#include "startup_screen_renderer.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x00411560
+void RasterLineDirectX(int x, int y, int delta_x, int delta_y, int direction,
+    unsigned int colour, unsigned short* pixels, unsigned int stride)
+{
+    int twice_y = delta_y + delta_y;
+    int diagonal = twice_y - (delta_x + delta_x);
+    int error = twice_y - delta_x;
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    if (static_cast<unsigned int>(x) < renderer->width && static_cast<unsigned int>(y) < renderer->height)
+    {
+        int offset = (y * static_cast<int>(stride) + x) * 4;
+        unsigned char* destination = reinterpret_cast<unsigned char*>(pixels) + offset;
+        unsigned int pixel;
+        memcpy(&pixel, destination, sizeof(pixel));
+        pixel = (pixel & 0xffff0000u) + (colour & 0xffffu);
+        memcpy(destination, &pixel, sizeof(pixel));
+    }
+
+    if (delta_x != 0)
+    {
+        int row_offset = y * static_cast<int>(stride);
+        int remaining = delta_x;
+        do
+        {
+            if (error >= 0)
+            {
+                ++y;
+                row_offset += static_cast<int>(stride);
+                error += diagonal;
+            }
+            else
+                error += twice_y;
+            x += direction;
+            renderer = screen_request_renderer;
+            if (static_cast<unsigned int>(x) < renderer->width && static_cast<unsigned int>(y) < renderer->height)
+            {
+                int offset = (row_offset + x) * 4;
+                unsigned char* destination = reinterpret_cast<unsigned char*>(pixels) + offset;
+                unsigned int pixel;
+                memcpy(&pixel, destination, sizeof(pixel));
+                pixel = (pixel & 0xffff0000u) + (colour & 0xffffu);
+                memcpy(destination, &pixel, sizeof(pixel));
+            }
+        } while (--remaining != 0);
+    }
+}
