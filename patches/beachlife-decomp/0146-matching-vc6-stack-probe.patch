+// Compile/link-only compiler-support caller. The comparison image is never run.
+// Volatile defined endpoints keep the complete 0x1400-byte local allocation.
+extern "C" __declspec(dllexport) unsigned int __cdecl stack_probe_compile_fixture(unsigned char value)
+{
+    volatile unsigned char frame[0x1400];
+    frame[0] = value;
+    frame[sizeof(frame) - 1] = static_cast<unsigned char>(value ^ 0xa5u);
+    return frame[0] + frame[sizeof(frame) - 1];
+}
