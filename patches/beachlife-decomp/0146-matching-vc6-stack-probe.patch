diff --git a/support/stack_probe.cpp b/support/stack_probe.cpp
new file mode 100644
--- /dev/null
+++ b/support/stack_probe.cpp
@@ -0,0 +1,29 @@
+// VC6 x86 compiler support, reconstructed from the pinned compiler package.
+// EAX supplies the allocation size. The helper probes each 4096-byte step,
+// preserves ECX, moves ESP, and returns to the original return address.
+// This nonstandard compiler ABI requires a naked body; it is not game code.
+extern "C" __declspec(naked) void __cdecl _chkstk()
+{
+    __asm
+    {
+        push ecx
+        cmp eax, 1000h
+        lea ecx, [esp + 8]
+        jb short final_page
+    probe_page:
+        sub ecx, 1000h
+        sub eax, 1000h
+        test dword ptr [ecx], eax
+        cmp eax, 1000h
+        jae short probe_page
+    final_page:
+        sub ecx, eax
+        mov eax, esp
+        test dword ptr [ecx], eax
+        mov esp, ecx
+        mov ecx, dword ptr [eax]
+        mov eax, dword ptr [eax + 4]
+        push eax
+        ret
+    }
+}
