+#ifndef STARTUP_RESOURCE_RASTERS_H
+#define STARTUP_RESOURCE_RASTERS_H
+
+// Actual 0x004018d0 cdecl: twelve argument words and RET0. The existing
+// surface address has unsigned-short storage; direct pixels occupy four bytes.
+void ResourceRaster1Direct(unsigned short* destination, const unsigned char* source,
+    const unsigned short* palette, unsigned int stride, int x, int y,
+    int width, int height, int left, int top, int right, int bottom);
+
