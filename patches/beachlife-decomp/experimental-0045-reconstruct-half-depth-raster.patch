+// FUNCTION: BEACHLIFE 0x00405b20
+void ResourceRasterAt00405b20(unsigned short* destination, const unsigned char* source,
+    const unsigned short* palette, unsigned int stride, int x, int y,
+    int width, int height, int left, int top, int right, int bottom,
+    unsigned int flags, int frame_word)
