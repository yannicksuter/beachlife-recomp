+                source += packet;
+            }
+            else
+                column -= packet;
+        }
+    }
+    int rows = bottom - top;
+    if (left > 0)
+    {
+        for (int row = 0; row < rows; ++row)
+        {
+            bool sampled_row = (row & 1) != 0;
+            unsigned char* output = first_row + (row / 2) * static_cast<int>(stride) * 4;
+            if ((frame++ & 0x80000000u) != 0)
+                depth -= 0x80000u;
+            else
+                depth += 0x100000u;
+            int remaining_left = left;
+            int column = 0;
+            while (column < width)
+            {
+                signed char packet = static_cast<signed char>(*source++);
+                unsigned char phase = static_cast<unsigned char>(column & 1);
+                if (packet > 0)
+                {
+                    int count = packet;
+                    column += count;
+                    do
+                    {
+                        if (remaining_left != 0)
