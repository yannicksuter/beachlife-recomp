+                                    }
+                                    case 0x80:
+                                    {
+                                        unsigned int half = static_cast<unsigned int>(render_half_mask) >> 1;
+                                        pixel = stored_depth + ((colour >> 1) & half) + ((previous >> 1) & half);
+                                        break;
+                                    }
+                                    case 0xc0:
+                                    {
+                                        unsigned int half = static_cast<unsigned int>(render_half_mask) >> 1;
+                                        unsigned int quarter = static_cast<unsigned int>(render_quarter_mask) >> 2;
+                                        pixel = stored_depth
+                                              + ((((previous >> 1) & half) + ((previous >> 2) & quarter)) & 0xffffu)
+                                              + ((colour >> 2) & quarter);
