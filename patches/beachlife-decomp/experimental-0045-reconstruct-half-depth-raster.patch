+                    packet = static_cast<signed char>(-packet);
+                    while (remaining_left != 0 && packet != 0)
+                    {
+                        --remaining_left;
+                        ++column;
+                        packet = static_cast<signed char>(packet - 1);
+                    }
+                    output += (static_cast<int>(packet) / 2) * 4;
+                    column += packet;
+                }
+            }
+        }
+        return;
+    }
+
+    for (int row = 0; row < rows; ++row)
+    {
+        bool sampled_row = (row & 1) != 0;
+        unsigned char* output = first_row + (row / 2) * static_cast<int>(stride) * 4;
+        if ((frame++ & 0x80000000u) != 0)
+            depth -= 0x80000u;
