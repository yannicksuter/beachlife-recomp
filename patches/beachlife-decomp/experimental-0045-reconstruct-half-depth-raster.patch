+    unsigned int depth = ((flags & 0xffffu) - frame * 8u) << 16;
+
+    if (left <= 0 && top <= 0 && right >= width && bottom >= height)
+    {
+        for (int row = 0; row < height; ++row)
+        {
+            if ((frame++ & 0x80000000u) != 0)
+                depth -= 0x80000u;
+            else
+                depth += 0x100000u;
+            unsigned char* output = first_row + (row / 2) * static_cast<int>(stride) * 4;
+            bool sampled_row = (row & 1) == 0;
+            int column = 0;
+            while (column < width)
+            {
+                int packet = static_cast<signed char>(*source++);
+                if (packet > 0)
+                {
+                    int count = packet;
+                    do
+                    {
+                        if ((column & 1) != 0 && sampled_row)
+                        {
+                            unsigned int stored;
+                            memcpy(&stored, output, sizeof(stored));
+                            unsigned int stored_depth = stored & 0xffff0000u;
+                            if (stored_depth <= depth)
+                            {
+                                unsigned int payload = *source;
+                                unsigned int mode = payload & 0xc0u;
+                                unsigned short previous;
+                                memcpy(&previous, output, sizeof(previous));
+                                unsigned int colour = palette[payload - mode];
+                                unsigned int pixel = (frame != 0 && (frame & 0x80000000u) == 0
+                                                             ? stored_depth
+                                                             : depth)
+                                                   + colour;
+                                switch (mode)
+                                {
+                                case 0x40:
+                                {
