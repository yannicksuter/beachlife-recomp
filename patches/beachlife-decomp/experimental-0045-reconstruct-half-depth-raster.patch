+                                    unsigned int pixel = (frame != 0 && (frame & 0x80000000u) == 0
+                                                                 ? stored_depth
+                                                                 : depth)
+                                                       + colour;
+                                    switch (mode)
+                                    {
+                                    case 0x40:
+                                    {
+                                        unsigned int half = static_cast<unsigned int>(render_half_mask) >> 1;
+                                        unsigned int quarter = static_cast<unsigned int>(render_quarter_mask) >> 2;
