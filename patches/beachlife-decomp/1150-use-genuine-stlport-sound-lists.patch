diff --git a/src/startup_world_list.h b/src/startup_world_list.h
new file mode 100644
index 0000000..b225ccf
--- /dev/null
+++ b/src/startup_world_list.h
@@ -0,0 +1,52 @@
+#ifndef STARTUP_WORLD_LIST_H
+#define STARTUP_WORLD_LIST_H
+
+#include <new>
+
+#ifdef _STLPORT_VERSION
+#include <list>
+
+template <class T>
+struct WorldList
+{
+    typedef std::list<T> Type;
+    typedef typename std::list<T>::iterator Iterator;
+    typedef std::_List_node<T> Node;
+};
+#else
+struct WorldListLayout
+{
+private:
+    WorldListLayout();
+    WorldListLayout(const WorldListLayout&);
+    ~WorldListLayout();
+    WorldListLayout& operator=(const WorldListLayout&);
+    void* head_;
+};
+
+struct WorldListIteratorLayout
+{
+private:
+    WorldListIteratorLayout();
+    WorldListIteratorLayout(const WorldListIteratorLayout&);
+    ~WorldListIteratorLayout();
+    WorldListIteratorLayout& operator=(const WorldListIteratorLayout&);
+    void* node_;
+};
+
+struct WorldListNodeLayout
+{
+    void* words_[3];
+};
+
+// Declaration-only units retain the x86 layout, not a second implementation.
+template <class T>
+struct WorldList
+{
+    typedef WorldListLayout Type;
+    typedef WorldListIteratorLayout Iterator;
+    typedef WorldListNodeLayout Node;
+};
+#endif
+
+#endif
