+#include "startup_config_owner.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004ecd40
+bool StartupConfig::FindNode(StartupConfigNode** result, const char* name)
+{
+    StartupConfigNode* node = head;
+    *result = 0;
+    for (;;)
+    {
+        if (strcmp(node->name, name) == 0)
+        {
+            *result = node;
+            return true;
+        }
+        if (!node->next)
+            return false;
+        node = node->next;
+    }
+}
