+// Descriptive name; the original symbol is unknown.
+// FUNCTION: BEACHLIFE 0x004ec360
+int SkipConfigSeparators(const char* buffer, int size)
+{
+    int index = 0;
+    for (; index < size; ++index)
+    {
+        signed char value = (signed char)buffer[index];
+        if (value > 32 && value < 122)
+            break;
+    }
+    return index;
+}
