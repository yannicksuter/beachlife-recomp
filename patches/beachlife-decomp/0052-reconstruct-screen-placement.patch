+#include "startup_screen_placement.h"
+
+// FUNCTION: BEACHLIFE 0x004e68b0
+bool ScreenPlacementStore::FindPlacement(int group, int* x, int* y)
+{
+    bool found = false;
+    for (CircularListNode* current = saved.head->next; current != saved.head; current = current->next)
+    {
+        SavedScreenPlacement* placement = static_cast<SavedScreenPlacementNode*>(current)->placement;
+        if (placement->group == group)
+        {
+            *x = placement->x;
+            *y = placement->y;
+            found = true;
+            break;
+        }
+    }
+    return found;
+}
