+#ifndef STARTUP_ANIMATION_SOUND_COMMENTS_INLINES_H
+#define STARTUP_ANIMATION_SOUND_COMMENTS_INLINES_H
+
+#include "startup_animation_sound_inlines.h"
+
+inline int AnimationSoundLookup::SkipComments(const char* data)
+{
+    int offset = SkipWhitespace(data);
+    if (data[offset] == '/')
+    {
+        ++offset;
+        while (data[offset] != '\n')
+            ++offset;
+        offset += SkipWhitespace(data + offset);
+        offset += SkipComments(data + offset);
+        offset += SkipWhitespace(data + offset);
+    }
+    return offset;
+}
+
+#endif
