+static float AdvanceDayHistory(unsigned int* history, float value, unsigned int day)
+{
+    // The retail loop copies forwards, propagating the previous first entry.
+    for (unsigned int i = 1; i < 128; ++i)
+        history[i] = history[i - 1];
+    std::memcpy(history, &value, sizeof(value));
+    if (day == 0)
+        return value;
+    double sum = 0.0;
+    for (unsigned int i = 0; i < day && i < 128; ++i)
+    {
+        float entry;
+        std::memcpy(&entry, history + i, sizeof(entry));
+        sum += entry;
+    }
+    return static_cast<float>(sum / day);
+}
+
