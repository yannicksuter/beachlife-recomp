diff --git a/src/startup_game_update_pair_destructor.cpp b/src/startup_game_update_pair_destructor.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_game_update_pair_destructor.cpp
@@ -0,0 +1,52 @@
+#include "startup_game_update_pair.h"
+
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004d2630
+GameUpdatePair::~GameUpdatePair()
+{
+    GameSoundNode* point_end = point_sounds_04.head;
+    GameSoundNode* point = point_sounds_04.head->next;
+    while (point != point_end)
+    {
+        void* sound = point->sound;
+        if (sound != 0)
+            ::operator delete(sound);
+        point = point->next;
+    }
+
+    GameSoundNode* object_end = object_sounds_08.head;
+    GameSoundNode* object = object_sounds_08.head->next;
+    while (object != object_end)
+    {
+        void* sound = object->sound;
+        if (sound != 0)
+            ::operator delete(sound);
+        object = object->next;
+    }
+
+    GameSoundNode* node = point_sounds_04.head->next;
+    while (node != point_sounds_04.head)
+    {
+        GameSoundNode* released = node;
+        node = node->next;
+        if (released != 0)
+            ReturnPool(released, sizeof(GameSoundNode));
+    }
+    point_sounds_04.head->next = point_sounds_04.head;
+    point_sounds_04.head->previous = point_sounds_04.head;
+
+    node = object_sounds_08.head->next;
+    while (node != object_sounds_08.head)
+    {
+        GameSoundNode* released = node;
+        node = node->next;
+        if (released != 0)
+            ReturnPool(released, sizeof(GameSoundNode));
+    }
+    object_sounds_08.head->next = object_sounds_08.head;
+    object_sounds_08.head->previous = object_sounds_08.head;
+
+    // Real automatic cleanup releases object-list storage, point-list storage,
+    // then the registration base. Neither sound record stops an audio voice.
+}
