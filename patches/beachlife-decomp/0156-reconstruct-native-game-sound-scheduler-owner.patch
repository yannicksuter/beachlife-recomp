new file mode 100644
--- /dev/null
+++ b/src/pool_platform.h
@@ -0,0 +1,14 @@
+#ifndef BEACHLIFE_NATIVE_POOL_PLATFORM_H
+#define BEACHLIFE_NATIVE_POOL_PLATFORM_H
+
+// Native declarations for the existing real atomic exchange and thread wait.
+// Legacy C symbol names are retained for ABI compatibility with the host file.
+using LONG = int;
+using DWORD = unsigned int;
+static_assert(sizeof(LONG) == 4 && sizeof(DWORD) == 4);
+#define InterlockedExchange BeachlifePoolLockTestExchange
+#define Sleep               BeachlifePoolLockTestSleep
+extern "C" LONG InterlockedExchange(LONG* target, LONG value);
+extern "C" void Sleep(DWORD milliseconds);
+
+#endif
diff --git a/src/startup_game_object_sound_list_destructor.cpp b/src/startup_game_object_sound_list_destructor.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_game_object_sound_list_destructor.cpp
@@ -0,0 +1,19 @@
+#include "startup_game_update_pair.h"
+
+// FUNCTION: BEACHLIFE 0x004d2e00
+GameObjectSoundList::~GameObjectSoundList()
+{
+    GameSoundNode* node = head->next;
+    while (node != head)
+    {
+        GameSoundNode* released = node;
+        node = node->next;
+        if (released != 0)
+            ReturnPool(released, sizeof(GameSoundNode));
+    }
+    head->next = head;
+    head->previous = head;
+    GameSoundNode* released = head;
+    if (released != 0)
+        ReturnPool(released, sizeof(GameSoundNode));
+}
