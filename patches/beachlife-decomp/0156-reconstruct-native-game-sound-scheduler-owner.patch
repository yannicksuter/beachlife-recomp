diff --git a/src/startup_game_update_pair.h b/src/startup_game_update_pair.h
new file mode 100644
--- /dev/null
+++ b/src/startup_game_update_pair.h
@@ -0,0 +1,215 @@
+#ifndef STARTUP_GAME_UPDATE_PAIR_H
+#define STARTUP_GAME_UPDATE_PAIR_H
+
+#include "pool_allocate.h"
+#include "pool_lock_acquire.h"
+#include "pool_return.h"
+#include "startup_sound_position.h"
+
+#include <new>
+
+// Observed object-sound record (list at scheduler +8).
+struct GameObjectSound
+{
+    unsigned int object_id;
+    float volume_04;
+    char name_08[0x20];
+    unsigned char playing_28;
+    // Nonzero: keep playing while loud music runs.
+    unsigned char ignores_music_29;
+    unsigned char unknown_2a[2];
+    int voice_2c;
+};
+
+// Observed point-sound record (list at scheduler +4).
+struct GamePointSound
+{
+    char name_00[0x20];
+    WindowAudioVector position_20;
+    float volume_2c;
+    int limit_30;
+    int voice_34;
+    unsigned char retrying_38;
+    unsigned char unknown_39[3];
+    float retry_delay_3c;
+};
+
+// Observed node/sentinel shapes of the two sound lists; allocator unknown.
+struct GameSoundNode
+{
+    GameSoundNode* next;
+    GameSoundNode* previous;
+    void* sound;
+};
+
+struct GameSoundIterator
+{
+    GameSoundNode* node;
+
+    GameSoundIterator() { }
+    GameSoundIterator(const GameSoundIterator& other)
+        : node(other.node)
+    {
+    }
+
+    GameSoundIterator operator++(int)
+    {
+        GameSoundIterator old(*this);
+        node = node->next;
+        return old;
+    }
+};
+
+struct GameSoundList
+{
+    GameSoundNode* head;
+
+    // Folded list erase 0x004209d0 (also CircularList::Erase); hidden iterator
+    // result plus position, RET8.
+    GameSoundIterator Erase(GameSoundIterator position);
+};
+
+// Empty default-argument allocator of both sound lists; its real (empty)
+// destructor is the folded 0x00437d10 named by the constructor's unwind map.
+struct GameSoundAllocator
+{
+    GameSoundAllocator() { }
+    ~GameSoundAllocator() { }
+};
+
+// Head holder of the point-sound list. Its two-argument constructor is a real
+// out-of-line call (folded 0x00437de0, stores the head, RET8); empty destructor.
+struct GamePointSoundListBase : GameSoundList
+{
+    GamePointSoundListBase(const GameSoundAllocator& allocator, GameSoundNode* initial);
+    ~GamePointSoundListBase() { }
+};
+
+// Head holder of the object-sound list; its constructor is expanded inline.
+struct GameObjectSoundListBase : GameSoundList
+{
+    explicit GameObjectSoundListBase(const GameSoundAllocator&) { head = 0; }
+    ~GameObjectSoundListBase() { }
+};
+
+// Point-sound list (+4): 12-byte pool nodes, released through an inline pool
+// return under the out-of-line pool lock. Real destructor 0x004d2d60.
+struct GamePointSoundList : GamePointSoundListBase
+{
+    explicit GamePointSoundList(const GameSoundAllocator& allocator = GameSoundAllocator())
+        : GamePointSoundListBase(allocator, 0)
+    {
+        // Native storage has held a PoolChunkLink; begin the real node lifetime.
+        GameSoundNode* sentinel = ::new (AllocatePoolBytes(sizeof(GameSoundNode))) GameSoundNode;
+        sentinel->next = sentinel;
+        sentinel->previous = sentinel;
+        head = sentinel;
+    }
+    ~GamePointSoundList();
+
+    static void FreeNode(GameSoundNode* node)
+    {
+        if (node)
+        {
+            AcquirePoolLock(&pool_lock_word);
+            PoolChunkLink* link = ::new (static_cast<void*>(node)) PoolChunkLink;
+            link->next = pool_chunk_buckets[(sizeof(GameSoundNode) - 1) / 8];
+            pool_chunk_buckets[(sizeof(GameSoundNode) - 1) / 8] = link;
+            pool_lock_word = 0;
+        }
+    }
+
+    void Clear()
+    {
+        GameSoundNode* node = head->next;
+        while (node != head)
+        {
+            GameSoundNode* current = node;
+            node = node->next;
+            FreeNode(current);
+        }
+        head->next = head;
+        head->previous = head;
+    }
+};
+
+// Object-sound list (+8): 12-byte pool nodes released through the real
+// ReturnPool 0x004123f0. Real destructor 0x004d2e00.
+struct GameObjectSoundList : GameObjectSoundListBase
+{
+    explicit GameObjectSoundList(const GameSoundAllocator& allocator = GameSoundAllocator())
+        : GameObjectSoundListBase(allocator)
+    {
+        // Native storage has held a PoolChunkLink; begin the real node lifetime.
+        GameSoundNode* sentinel = ::new (AllocatePoolBytes(sizeof(GameSoundNode))) GameSoundNode;
+        sentinel->next = sentinel;
+        sentinel->previous = sentinel;
+        head = sentinel;
+    }
+    ~GameObjectSoundList();
+
+    static void FreeNode(GameSoundNode* node)
+    {
+        if (node)
+            ReturnPool(node, sizeof(GameSoundNode));
+    }
+
+    void Clear()
+    {
+        GameSoundNode* node = head->next;
+        while (node != head)
+        {
+            GameSoundNode* current = node;
+            node = node->next;
+            FreeNode(current);
+        }
+        head->next = head;
+        head->previous = head;
+    }
+};
+
+struct GameUpdatePair;
+
+// Actual slot 0x005baefc.
+extern GameUpdatePair* game_update_pair;
+
+// Empty first base that publishes the scheduler while it is constructed; its
+// out-of-line destructor 0x004d3080 clears the slot again.
+struct GameUpdatePairRegistration
+{
+    GameUpdatePairRegistration();
+    ~GameUpdatePairRegistration();
+};
+
+// Actual 12-byte x86 positional-sound scheduler at Game+0x50.
+struct GameUpdatePair : GameUpdatePairRegistration
+{
+    unsigned char enabled_00;
+    unsigned char unknown_01[3];
+    GamePointSoundList point_sounds_04;
+    GameObjectSoundList object_sounds_08;
+
+    // Actual 0x004d2510, RET4.
+    explicit GameUpdatePair(unsigned char enabled);
+
+    // Actual 0x004d2760; calls 0x004d2990 then 0x004d2bd0 with the same float.
+    void Update(float delta);
+    // Actual 0x004d2990 (sounds attached to world objects, list at +8) and
+    // 0x004d2bd0 (sounds at fixed points, list at +4); RET4 each.
+    void UpdateObjectSounds(float delta);
+    void UpdatePointSounds(float delta);
+
+    // Native host ownership exposes ordinary destruction without inventing a Game
+    // friend implementation. This changes access only, not layout or cleanup.
+public:
+    // The real enclosing Game directly calls ordinary cleanup 0x004d2630.
+    friend struct ScreenRequestGamePrefix;
+    ~GameUpdatePair();
+};
+
+inline GameUpdatePairRegistration::GameUpdatePairRegistration()
+{
+    game_update_pair = static_cast<GameUpdatePair*>(this);
+}
+
+#endif
