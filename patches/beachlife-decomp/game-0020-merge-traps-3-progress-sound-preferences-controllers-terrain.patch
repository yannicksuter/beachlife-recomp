diff --git a/src/startup_wide_text.h b/src/startup_wide_text.h
new file mode 100644
index 0000000000000000000000000000000000000000..7db830198554160638ce0453c5d0910bf293e59d
--- /dev/null
+++ b/src/startup_wide_text.h
@@ -0,0 +1,42 @@
+#ifndef STARTUP_WIDE_TEXT_H
+#define STARTUP_WIDE_TEXT_H
+
+#include <cwchar>
+#include <string>
+
+// The retail CRT consumes UTF-16; the host CRT may use wider wchar_t units.
+inline std::wstring ScreenNativeWideText(const unsigned short* text)
+{
+    std::wstring result;
+    while (*text)
+    {
+        unsigned int value = *text++;
+        if constexpr (sizeof(wchar_t) > 2)
+        {
+            if (value >= 0xd800 && value <= 0xdbff && *text >= 0xdc00 && *text <= 0xdfff)
+                value = 0x10000 + ((value - 0xd800) << 10) + (*text++ - 0xdc00);
+        }
+        result.push_back(static_cast<wchar_t>(value));
+    }
+    return result;
+}
+
+inline int ScreenTextInteger(const unsigned short* text)
+{
+#if defined(_wtol)
+    return _wtol(text);
+#else
+    return static_cast<int>(std::wcstol(ScreenNativeWideText(text).c_str(), 0, 10));
+#endif
+}
+
+inline double ScreenTextNumber(const unsigned short* text)
+{
+#if defined(wcstod)
+    return wcstod(text, static_cast<unsigned short**>(0));
+#else
+    return std::wcstod(ScreenNativeWideText(text).c_str(), 0);
+#endif
+}
+
+#endif
