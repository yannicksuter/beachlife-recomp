+// FUNCTION: BEACHLIFE 0x004ea1a0
+void ShowFatalWindowMessage(void* window, const unsigned short* message)
+{
+    char text[512];
+    WideCharToMultiByte(CP_ACP, 0, reinterpret_cast<LPCWSTR>(message), -1, text, sizeof(text), 0, 0);
