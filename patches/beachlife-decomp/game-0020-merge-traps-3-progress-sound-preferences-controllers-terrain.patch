+ScreenPoint OverlayMapPrefix::WorldToScreen(const ScreenWorldPosition& point)
+{
+    int x = static_cast<int>(point.x);
+    int y = static_cast<int>(static_cast<double>(point.y) * 0.5f);
+    int height = static_cast<int>(HeightAt(x, y));
