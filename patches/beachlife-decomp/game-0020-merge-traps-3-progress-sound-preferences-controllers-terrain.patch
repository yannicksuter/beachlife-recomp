+++ b/src/startup_trivial_range_overflow.h
@@ -0,0 +1,56 @@
+#ifndef STARTUP_TRIVIAL_RANGE_OVERFLOW_H
+#define STARTUP_TRIVIAL_RANGE_OVERFLOW_H
+
+#include "node_storage.h"
+#include "pool_allocate.h"
+#include "copy_trivial.h"
+
+template <class Value>
+void InsertTrivialRangeOverflow(Value*& begin, Value*& end, Value*& capacity, Value* position, const Value& value, unsigned int count, bool at_end)
+{
+    unsigned int size = static_cast<unsigned int>(end - begin);
+    unsigned int length = size + MaxUnsigned(size, count);
+    Value* storage;
+    if (length != 0)
+    {
+        unsigned int bytes = length * sizeof(Value);
+        storage = static_cast<Value*>(
+            bytes > 128 ? ::operator new(bytes) : AllocatePoolBytes(bytes));
+    }
+    else
+    {
+        storage = 0;
+    }
+
+    Value* next = static_cast<Value*>(CopyTrivial(begin, position, storage));
+    for (unsigned int remaining = count; remaining != 0; --remaining)
+    {
+        // The reference is read on every iteration, including an aliased value.
+        ::new (next) Value(value);
+        ++next;
+    }
+    if (!at_end)
+    {
+        next = static_cast<Value*>(CopyTrivial(position, end, next));
+    }
+
+    Value* old_begin = begin;
+    if (old_begin)
+    {
+        unsigned int bytes = static_cast<unsigned int>(capacity - old_begin) * sizeof(Value);
+        if (bytes > 128)
+        {
+            ::operator delete(old_begin);
+        }
+        else
+        {
+            ReturnPool(old_begin, bytes);
+        }
+    }
+
+    end = next;
+    begin = storage;
+    capacity = storage + length;
+}
+
+#endif
