+
+// FUNCTION: BEACHLIFE 0x0041b360
+ScreenWorldPosition OverlayMapPrefix::ScreenToWorld(const ScreenPoint& point)
+{
+    float height = static_cast<int>(static_cast<double>(screen_terrain_grid->height_scale_14) * 255.0f) * 0.5f;
+    float step = height;
+    for (int iteration = 0; iteration < 100; ++iteration)
+    {
+        double sampled = HeightAt(point.x, point.y + static_cast<int>(height));
+        if (!(std::fabs(sampled - height) > 3.0))
+            break;
+        step *= 0.5f;
+        if (sampled > height)
