+void ScreenDialogResource::BurnBuildingFootprint(const ScreenWorldPosition* position, unsigned int width, unsigned int height)
+{
+    ScreenDialogResourceRecord* resource = record;
+    if (resource->format_18 != 5)
+        return;
+    ScreenPoint screen = overlay_map->WorldToScreen(*position);
+    if (word_10)
+    {
+        word_10 = 0;
+        word_14 = 0;
