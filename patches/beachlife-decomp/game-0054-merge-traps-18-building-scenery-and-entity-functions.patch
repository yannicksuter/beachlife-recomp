+                             : strcmp(key, "BUILDING_GUESTDEPTODAY") == 0 ? world->departed_758
+                             : strcmp(key, "BUILDING_GUESTUNTOTAL") == 0  ? world->unhappy_760
+                                                                          : world->unhappy_768;
+        unsigned int first = values[0], second = values[1];
+        swprintf(output, screen_text_lookup->LookupText("FP_GUEST_FORMAT"), first + second, first, second);
+    }
+    else if (strcmp(key, "BUILDING_CONFIRM_DEMOLISH") == 0)
+    {
+        unsigned int cost;
+        memcpy(&cost, building_60->unknown_1d0, sizeof(cost));
+        swprintf(output, screen_text_lookup->LookupText("BI_CONFIRM_DEMOLISH"), cost);
+    }
+    else if (strcmp(key, "CONSTRUCT_AMOUNT%") == 0)
+        swprintf(output, L"%d%%", static_cast<int>(static_cast<long double>(window_deactivation_state->building_status_48->ConstructionProgress(id_28)) * 100.0f));
+    else if (strcmp(key, "CONSTRUCT_AMOUNT") == 0)
+        swprintf(output, L"%f", static_cast<double>(window_deactivation_state->building_status_48->ConstructionProgress(id_28)));
+    else if (strcmp(key, "DEMOLISH_AMOUNT%") == 0)
+        swprintf(output, L"%d%%", static_cast<int>(static_cast<long double>(window_deactivation_state->building_status_48->DemolitionProgress(id_28)) * 100.0f));
+    else if (strcmp(key, "DEMOLISH_AMOUNT") == 0)
+        swprintf(output, L"%f", static_cast<double>(window_deactivation_state->building_status_48->DemolitionProgress(id_28)));
+    else if (strncmp(key, "EVENT", 5) == 0)
+    {
+        int index = static_cast<signed char>(key[5]) - '0';
+        const char* suffix = key + 6;
+        if (strncmp(suffix, "_PRICE", 6) == 0)
+            swprintf(output, L"%f", static_cast<double>(events_170->Price(index)));
+        else if (strcmp(suffix, "_PROFIT") == 0)
+            swprintf(output, L"%f", static_cast<double>(events_170->Profit(index)));
+        else if (strcmp(suffix, "_START_TIME") == 0)
+        {
+            float time = events_170->StartTime(index);
+            ScreenRequestGamePrefix* game = screen_request_game;
+            ScreenTextLookup* lookup = screen_text_lookup;
+            int minutes = game->TimeMinutes(time);
+            int hours = game->TimeHours(time);
+            swprintf(output, lookup->LookupText("BI_EVENT_TIME"), index + 1, hours, minutes);
+        }
+    }
+    else if (strcmp(key, "STAFF_BEACH_OPEN") == 0)
+        number(screen_terrain_grid->RouteEnabled(0, word_450) && screen_terrain_grid->RouteEnabled(1, word_450));
+    else if (strncmp(key, "STAFF_BEACH_OPEN_STATUS_", 24) == 0)
+        number(pending_staff_90 + staff_count_8c != 0);
+    else
+        StartupFatal("BuildingObject::GetVariable - data keyword not recognised - %s", key);
+}
