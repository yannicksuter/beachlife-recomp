+                    keyline_state_44->SetAnimation(vehicle_type_f8 == 0 ? vehicle_offset_animation : speedboat_offset_animation, 0.0f, &point);
+                    SelectVehicleVariant(keyline_state_44, facing / 2);
+                }
+                else
+                    keyline_state_44->SetAnimation(vehicle_type_f8 == 0 ? vehicle_normal_animation : speedboat_normal_animation, 0.0f, &point);
+                SelectVehicleVariant(keyline_state_44, facing / 2);
+            }
+            if (vehicle_type_f8 == 0)
+                SelectVehicleVariant(resource_fc, keyline_state_44->word_18);
+        }
+        if (flag_900)
+            UpdateVehicleTurn(time);
+        else
+            for (unsigned int i = 0; i < passenger_count_5bc; ++i)
+            {
+                WorldMovingEntity* guest = variable_world->FindObject(passengers_10c[i])->AsMoving();
+                guest->SetMovementPosition({ x_30, y_34, z_38 });
+                SelectVehicleVariant(guest->keyline_state_44, keyline_state_44->word_18);
+            }
+        break;
+    case 0x46:
+        if (flag_900)
+            UpdateVehicleTurn(time);
+        else
+        {
+            queue_state(0x43);
+            word_8d8 = (static_cast<int>(word_8d8) + 1) % static_cast<int>(route_count_8d4);
+        }
+        break;
+    case 0x47:
+    case 0x48:
+    {
+        long double movement = static_cast<long double>(window_deactivation_state->value_16c) * speed_80;
+        int heading = state_3c == 0x47 ? arrival_heading_958 : departure_heading_95c;
+        float x;
+        long double y;
+        switch (heading)
+        {
+        case 0:
+            x = 0.0f;
+            y = -movement;
+            break;
+        case 1:
+            x = movement * 0.5L;
+            y = movement * -0.5L;
+            break;
+        case 2:
+            x = movement;
+            y = 0.0L;
+            break;
+        case 3:
+            x = movement * 0.5L;
+            y = movement * 0.5L;
+            break;
+        case 4:
+            x = 0.0f;
+            y = movement;
+            break;
+        case 5:
+            x = movement * -0.5L;
+            y = movement * 0.5L;
+            break;
+        case 6:
+            x = -movement;
+            y = 0.0L;
+            break;
+        case 7:
+            x = movement * -0.5L;
+            y = movement * -0.5L;
+            break;
+        }
+        float old_x = std::bit_cast<float>(arrival_tile_948.x);
+        float old_y = std::bit_cast<float>(arrival_tile_948.y);
+        ScreenPoint* offsets = state_3c == 0x47 ? &arrival_tile_948 : &departure_tile_950;
+        offsets->x = std::bit_cast<int>(std::bit_cast<float>(offsets->x) - x);
+        offsets->y = std::bit_cast<int>(static_cast<float>(static_cast<long double>(std::bit_cast<float>(offsets->y)) - y));
+        auto crossed = [](float before, float after)
+        {
+            return (before >= 0.0f && !(after > 0.0f)) || (!(before > 0.0f) && after >= 0.0f);
+        };
+        // The exit branch also compares the entry offsets in the retail code.
+        if (crossed(old_x, std::bit_cast<float>(arrival_tile_948.x)) && crossed(old_y, std::bit_cast<float>(arrival_tile_948.y)))
+        {
+            if (state_3c == 0x47)
+            {
+                SetMovementPosition(route_5d4[0]);
+                queue_state(0x42);
+            }
+            else
+                inactive_04 = 1;
+        }
+        break;
+    }
+    }
+    if (_stricmp(name_06, "BOAT") == 0)
+        SelectVehicleVariant(keyline_state_44, 0);
+    ScreenWorldPosition position = { x_30, y_34, z_38 };
+    ScreenPoint tile = overlay_map->WorldToTile(&position);
+    word_964 = tile.x;
+    word_968 = tile.y;
+    if (vehicle_type_f8 == 6)
+    {
+        neighbours(true);
+        flag_960 = 1;
+    }
+    return true;
+}
