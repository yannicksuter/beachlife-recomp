+    int first_depth = map->DepthAt(&point);
+    map = overlay_map;
+    point = screen_terrain_grid->TilePosition(first.x, first.y, 1);
+    int last_depth = map->DepthAt(&point);
+    resource->frames[0]->time_04 = window_deactivation_state->clock_158;
+    resource->frames[1]->time_04 = window_deactivation_state->clock_158;
+    float depth_step = static_cast<long double>(last_depth - first_depth) / resource->unknown_20[word_18];
+    int tile_size = overlay_map->tile_size_dc;
