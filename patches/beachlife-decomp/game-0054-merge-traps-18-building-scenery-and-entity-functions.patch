+#include "startup_world_entities.h"
+#include "startup_screen_mode_world.h"
+#include "window_activation.h"
+#include <stdlib.h>
+
+// GLOBAL: BEACHLIFE 0x00578048
+const char* catwalk_animations[9] = {
+    "D_CATWALK", "D_CATWALK_IDLE", "D_CATWALK_POSE", "D_CATWALK_POSE1", "D_CATWALK_POSE2", "D_CATWALK_WAIT1", "D_CATWALK_WAIT2", "D_CATWALK_WAIT3", "D_CATWALK_TRIP1"
+};
+
+// FUNCTION: BEACHLIFE 0x00463d40
+bool WorldEntity17::Unknown14(ScreenModeCommand* incoming)
+{
+    int code = incoming->words[2];
+    if (code == 0x3b)
+    {
+        // This branch returns an unwritten local byte in the retail body.
+        unsigned char result;
+        flag_104 = 1;
+        return result != 0;
+    }
+    ScreenModeCommand command;
+    auto queue = [&](int type, int next, float delay, bool delayed)
+    {
+        command.words[0] = id_28;
+        command.words[1] = id_28;
+        command.words[2] = type;
+        command.words[3] = 0;
+        command.words[4] = next;
+        if (delayed)
+            screen_mode_commands->QueueDelayed(&command, delay);
+        else
+            screen_mode_commands->QueueCommand(&command);
+    };
+    auto animate = [&](unsigned int index)
+    {
+        ScreenWorldPosition position = { x_30, y_34, z_38 };
+        return keyline_state_44->SetAnimation(catwalk_animations[index], window_deactivation_state->clock_158, &position);
+    };
+    auto face_owner = [&]
+    {
+        VariableEntity* owner = variable_world->FindObject(owner_fc);
+        keyline_state_44->SelectVariant((11 - 2 * static_cast<int>(owner->keyline_state_44->word_18)) % 8);
+    };
+    if (code == 0x16 || code == 0x3c)
+    {
+        if (state_3c == 0)
+        {
+            float duration = animate(5 + rand() % 3);
+            face_owner();
+            keyline_state_44->word_08 = 2;
+            queue(0x3c, 0, duration, true);
+        }
+        else if (code == 0x16)
+        {
+            if (state_3c == 6)
+            {
+                if (variant_f8 == 0)
+                {
+                    command.words[0] = id_28;
+                    command.words[1] = owner_fc;
+                    command.words[2] = 0x3b;
+                    command.words[3] = 0;
+                    command.words[4] = 0;
+                    screen_mode_commands->QueueCommand(&command);
+                }
+                inactive_04 = 1;
+            }
+            else if (action_f4 == 0)
+            {
+                float duration = animate(2);
+                keyline_state_44->word_08 = 2;
+                face_owner();
+                action_f4 = 1;
+                queue(0x39, 0, duration, true);
+            }
+        }
+        return true;
+    }
+    if (code != 0x39)
+        return WorldPedestrianEntity::Unknown14(incoming);
+    if (action_f4 == 1)
+    {
+        int choice = rand() % 7;
+        action_f4 = choice == 6 ? 3 : 2;
+        float duration = animate(choice < 3 ? 3 : choice < 6 ? 4
+                                                             : 8);
+        keyline_state_44->word_08 = 2;
+        queue(0x39, 0, duration, true);
+    }
+    else if (action_f4 == 2)
+    {
+        float duration = animate(rand() % 2 == 0 ? 3 : 4);
+        keyline_state_44->word_08 = 2;
+        action_f4 = 3;
+        queue(0x39, 0, duration, true);
+    }
+    else if (!flag_104)
+    {
+        queue(3, 0, 0.0f, false);
+        unsigned int count;
+        VariableEntity** objects = variable_world->ByType(17, &count);
+        for (unsigned int i = 0; i < count; ++i)
+        {
+            WorldEntity17* other = static_cast<WorldEntity17*>(objects[i]);
+            if (other->owner_fc == owner_fc && other->variant_f8 == static_cast<unsigned int>((static_cast<int>(variant_f8) + 1) % 3))
+            {
+                command.words[1] = other->id_28;
+                command.words[4] = 4;
+                break;
+            }
+        }
+        screen_mode_commands->QueueCommand(&command);
+    }
+    else
+    {
+        unsigned int count;
+        VariableEntity** objects = variable_world->ByType(17, &count);
+        command.words[0] = id_28;
+        command.words[1] = 0;
+        command.words[2] = 3;
+        command.words[3] = 0;
+        command.words[4] = 6;
+        for (unsigned int i = 0; i < count; ++i)
+        {
+            WorldEntity17* other = static_cast<WorldEntity17*>(objects[i]);
+            if (other->owner_fc == owner_fc)
+            {
+                command.words[1] = other->id_28;
+                screen_mode_commands->QueueCommand(&command);
+            }
+        }
+    }
+    return true;
+}
