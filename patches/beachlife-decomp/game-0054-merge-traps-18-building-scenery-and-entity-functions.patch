+#include "startup_screen_dialog_resource.h"
+#include "startup_screen_point.h"
+#include "startup_square_root_table.h"
+#include <bit>
+
+// FUNCTION: BEACHLIFE 0x00416710
+void ScreenDialogResource::FacePositions(ScreenWorldPosition first, ScreenWorldPosition second)
+{
+    ScreenMapPosition direction;
+    direction.x = first.x - second.x;
+    long double delta_y = static_cast<long double>(first.y) - second.y;
+    direction.y = delta_y;
+    float squared = delta_y * direction.y + static_cast<long double>(direction.x) * direction.x;
+    unsigned int bits = std::bit_cast<unsigned int>(squared);
+    float magnitude;
+    if (bits == 0)
+        magnitude = 0.0f;
+    else
+    {
+        unsigned int exponent = (((bits + 0xc0800000u) >> 1) + 0x3f800000u) & 0x7f800000u;
+        magnitude = std::bit_cast<float>(square_root_mantissas[(bits >> 8) & 0xffff] | exponent);
+    }
+    float reciprocal = std::bit_cast<float>(0x7f000000u - std::bit_cast<unsigned int>(magnitude));
+    reciprocal = (2.0L - static_cast<long double>(magnitude) * reciprocal) * reciprocal;
+    direction.x = static_cast<long double>(reciprocal) * direction.x;
+    direction.y = static_cast<long double>(reciprocal) * direction.y;
+    FaceDirection(direction);
+}
