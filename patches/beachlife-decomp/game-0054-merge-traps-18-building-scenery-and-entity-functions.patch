+
+void ResourceLightMask(unsigned char* light, const unsigned char* source,
+    unsigned int stride, int x, int y, int width, int height,
+    const ScreenRectangle* rectangle); // 0x00408ce0.
+
+// FUNCTION: BEACHLIFE 0x0045f260
+void WorldBuildingEntity::DrawLighting(unsigned char* light)
+{
+    if (pick_frame_418 != -1 && keyline_state_44->word_10 != static_cast<unsigned int>(pick_frame_418))
+    {
+        keyline_state_44->word_10 = pick_frame_418;
+        keyline_state_44->word_14 = 0;
+    }
+    int width = screen_request_renderer->width;
+    int height = screen_request_renderer->height;
+    int scroll_x = overlay_map->scroll_x_c4;
+    int scroll_y = overlay_map->scroll_y_c8;
+    ScreenWorldPosition position = { x_30, y_34, z_38 };
+    ScreenPoint point = overlay_map->WorldToScreen(position);
+    point.x += scroll_x;
+    point.y += scroll_y;
+    point.x += keyline_state_44->CurrentFrameValue();
+    point.y += keyline_state_44->SelectedFrame()->word_14;
+    ScreenRectangle bounds = { point.x, point.y, point.x + keyline_state_44->SelectedFrame()->width_0e, point.y + keyline_state_44->SelectedFrame()->height_10 };
+    ScreenRectangle viewport = { scroll_x, scroll_y, scroll_x + width, scroll_y + height };
+    ScreenRectangle intersection;
+    if (!ScreenRectanglesOverlap(&bounds, &viewport, &intersection))
+        return;
+    int count = variable_world->buildings_04;
+    VariableEntity** buildings = variable_world->buildings_12120;
+    int index = 0;
+    while (buildings[index] != this && index < count)
+        ++index;
+    for (--index; index >= 0; --index)
+    {
+        WorldBuildingEntity* building = buildings[index]->AsBuilding();
+        int light_frame = building->light_frame_41c;
+        bool lit = building->building_state_19c == 0
+                && (window_deactivation_state->render_value_160 >= building->value_180
+                    || !(window_deactivation_state->render_value_160 > building->value_184));
+        if (light_frame == -1 || !lit)
+            continue;
+        unsigned int previous = building->keyline_state_44->word_10;
+        if (previous != static_cast<unsigned int>(light_frame))
+        {
+            building->keyline_state_44->word_10 = light_frame;
+            building->keyline_state_44->word_14 = 0;
+        }
+        ScreenWorldPosition other_position = { building->x_30, building->y_34, building->z_38 };
+        ScreenPoint other = overlay_map->WorldToScreen(other_position);
+        other.x += scroll_x;
+        other.y += scroll_y;
+        other.x += building->keyline_state_44->CurrentFrameValue();
+        other.y += building->keyline_state_44->SelectedFrame()->word_14;
+        ScreenRectangle other_bounds = { other.x, other.y, other.x + building->keyline_state_44->SelectedFrame()->width_0e, other.y + building->keyline_state_44->SelectedFrame()->height_10 };
+        if (ScreenRectanglesOverlap(&bounds, &other_bounds, &intersection))
+        {
+            intersection.left -= point.x;
+            intersection.right -= point.x;
+            intersection.top -= point.y;
+            intersection.bottom -= point.y;
+            int x = intersection.left - scroll_x + point.x;
+            int y = intersection.top - scroll_y + point.y;
+            if (intersection.right - intersection.left + x < 0
+                || intersection.bottom - intersection.top + y < 0
+                || x > width - 1 || y > height - 1)
+                continue;
+            if (x < 0)
+            {
+                intersection.left -= x;
+                x = 0;
+            }
+            if (y < 0)
+            {
+                intersection.top -= y;
+                y = 0;
+            }
+            if (intersection.right - intersection.left + x >= width)
+                intersection.right = intersection.left - x + width;
+            if (intersection.bottom + y >= height)
+                intersection.bottom = intersection.top - y + height;
+            if (intersection.left == intersection.right || intersection.top == intersection.bottom)
+                continue;
+            const unsigned char* data = keyline_state_44->record->frames[pick_frame_418]->SelectData(
+                keyline_state_44->word_14, keyline_state_44->word_18);
+            ScreenDialogResourceFrame* frame = keyline_state_44->SelectedFrame();
+            if (intersection.bottom > frame->height_10)
+                intersection.bottom = frame->height_10;
+            if (intersection.right > frame->width_0e)
+                intersection.right = frame->width_0e;
+            ResourceLightMask(light, data, width, x, y, frame->width_0e, frame->height_10, &intersection);
+        }
+        if (building->keyline_state_44->word_10 != previous)
+        {
+            building->keyline_state_44->word_10 = previous;
+            building->keyline_state_44->word_14 = 0;
+        }
+    }
+}
