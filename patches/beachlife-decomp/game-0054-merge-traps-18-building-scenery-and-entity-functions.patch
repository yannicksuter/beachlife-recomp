+    screen.y += overlay_map->scroll_y_c8;
+    ScreenRectangle rectangle = { 0, 0, SelectedFrame()->width_0e, SelectedFrame()->height_10 };
+    bool clipped = false;
+    if (screen.x < 0)
+    {
+        rectangle.left = -screen.x;
+        screen.x = 0;
+        clipped = true;
+    }
+    if (screen.y < 0)
+    {
+        rectangle.top = -screen.y;
+        screen.y = 0;
+        clipped = true;
+    }
+    ScreenPoint first = CurrentScreenTerrain()->WorldToTile(*position);
+    ScreenPoint last = first;
+    for (int count = static_cast<int>(width - 1); count > 0; --count)
