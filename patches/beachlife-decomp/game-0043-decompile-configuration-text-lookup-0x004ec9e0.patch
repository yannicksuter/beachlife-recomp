+#include "startup_config_tokens.h"
+
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004ec9e0
+const char* ConfigTokenBuffer::FindText(const char* name)
+{
+    // Later definitions win: search from the last token backwards.
+    for (unsigned int index = count; index-- != 0;)
+    {
+        if (_stricmp(tokens[index].name, name) == 0)
+        {
+            return tokens[index].kind == 1 ? tokens[index].text : 0;
+        }
+    }
+    return 0;
+}
