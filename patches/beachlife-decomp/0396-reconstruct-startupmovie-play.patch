@@ -0,0 +1,55 @@
+#ifndef STARTUP_MOVIE_H
+#define STARTUP_MOVIE_H
+
+struct IDirectDraw;
+struct IDirectDraw4;
+struct IDirectDrawSurface4;
+struct IDirectDrawSurface;
+struct IAMMultiMediaStream;
+
+// Actual 48-byte x86 temporary owner that WinMain's Game constructor builds to
+// play the startup movie. Names are descriptive.
+struct StartupMovie
+{
+    void* window;           // HWND for the cooperative level.
+    int value_04;           // Zero at the only caller; users not yet audited.
+    int value_08;           // Zero at the only caller; users not yet audited.
+    int width;              // Display mode width when not windowed.
+    int height;             // Display mode height when not windowed.
+    unsigned char windowed; // Nonzero: DDSCL_NORMAL and no mode change.
+    unsigned char ready;    // Cleared when DirectDraw setup fails.
+    unsigned char flag_16;  // Passed on by the destructor.
+    unsigned char unknown_17;
+    IDirectDraw* direct_draw;         // DirectDrawCreate result.
+    IDirectDraw4* direct_draw4;       // Queried IDirectDraw4.
+    IDirectDrawSurface4* primary;     // Primary flipping surface.
+    IDirectDrawSurface4* back_buffer; // Attached back buffer.
+    IDirectDrawSurface* stream_surface_28;
+    IAMMultiMediaStream* stream_2c;
+
+    // Actual 0x004ed0d0, RET 0x1c: stores the arguments and calls Initialize.
+    StartupMovie(void* window,
+        int value_04,
+        int value_08,
+        int width,
+        int height,
+        unsigned char windowed,
+        unsigned char flag_16);
+    // Actual 0x004ed130 (body separate).
+    ~StartupMovie();
+    // Actual 0x004ed190, RET4: opens and renders the movie while ready.
+    void Play(const char* path);
+    // Actual 0x004ed1c0: DirectDraw, cooperative level, display mode, surfaces.
+    void Initialize();
+    // Actual 0x004ed260 (primary flipping surface and clipper) and 0x004ed310
+    // (attached back buffer); both clear ready on failure. Bodies separate.
+    void CreatePrimarySurface();
+    void AttachBackBuffer();
+    // Actual 0x004ed390, RET4 (CoCreateInstance, wide path, stream open) and
+    // 0x004ed450 (renders the opened stream to the surfaces); both clear ready
+    // on failure. Bodies separate; descriptive names.
+    void OpenStream(const char* path);
+    void RenderStream();
+};
+
+#endif
diff --git a/src/startup_movie_play.cpp b/src/startup_movie_play.cpp
new file mode 100644
index 0000000..0838464
--- /dev/null
+++ b/src/startup_movie_play.cpp
@@ -0,0 +1,14 @@
+#include "startup_movie.h"
+
+// FUNCTION: BEACHLIFE 0x004ed190
+void StartupMovie::Play(const char* path)
+{
+    if (ready)
+    {
+        OpenStream(path);
+        if (ready)
+        {
+            RenderStream();
+        }
+    }
+}
