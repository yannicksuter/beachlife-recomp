diff --git a/src/startup_gui_parse_tga.cpp b/src/startup_gui_parse_tga.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_gui_parse_tga.cpp
@@ -0,0 +1,26 @@
+#include "startup_gui_parser.h"
+#include "startup_tga_screen_item.h"
+
+void StartupFatal(const char* format, ...);
+
+// FUNCTION: BEACHLIFE 0x004abc10
+void GuiParserState::ParseTGA()
+{
+    if (buffer[cursor] != '(')
+    {
+        StartupFatal("GUIManager::process_tga - Script Error \r\nNo open bracket found at file offset - %u", cursor);
+        return;
+    }
+    ++cursor;
+    while (buffer[cursor] == ' ' || buffer[cursor] == '\r' || buffer[cursor] == '\n' || buffer[cursor] == '\t')
+    {
+        ++cursor;
+    }
+
+    ScreenRectangle rectangle;
+    ReadRectangle(rectangle, current_context);
+    char filename[64];
+    ReadText(filename);
+    TgaScreenItem* item = new TgaScreenItem(rectangle, filename);
+    RegisterItem(item, 0);
+}
