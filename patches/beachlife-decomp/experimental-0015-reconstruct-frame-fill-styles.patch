--- /dev/null
+++ b/src/startup_screen_frame_style2.cpp
@@ -0,0 +1,32 @@
+#include "startup_screen_frame_draw.h"
+#include "startup_screen_item.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x004c7990
+void DrawFrameStyle2(const ScreenRectangle& rectangle)
+{
+    ScreenRequestRenderer* renderer = screen_request_renderer;
+    unsigned int colour = renderer->ConvertColour(122, 152, 250);
+    ScreenRectangle fill;
+    fill.bottom = rectangle.bottom;
+    fill.left = rectangle.left;
+    fill.right = fill.left + 2;
+    fill.top = rectangle.top;
+    renderer->FillRectangle(fill, colour);
+
+    fill.right = rectangle.right;
+    fill.left = fill.right - 2;
+    renderer->FillRectangle(fill, colour);
+
+    fill.left = rectangle.left;
+    fill.right = rectangle.right;
+    fill.top = rectangle.bottom - 2;
+    renderer->FillRectangle(fill, colour);
+
+    colour = renderer->ConvertColour(235, 233, 249);
+    fill.left = rectangle.left + 2;
+    fill.right = rectangle.right - 2;
+    fill.top = rectangle.top;
+    fill.bottom = rectangle.bottom - 2;
+    renderer->FillRectangle(fill, colour);
+}
