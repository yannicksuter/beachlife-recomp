+
+// FUNCTION: BEACHLIFE 0x0040f2e0
+void ScreenRequestRenderer::ResizeSurfaceImageEntries(
+    ScreenSurfacePosition* source, ScreenSurfacePosition* destination)
+{
+    if (software_mode)
+    {
+        TgaImage from(source->width, source->height);
+        TgaImage to(destination->width, destination->height);
+        from.pixels = reinterpret_cast<unsigned char*>(source->pixels);
+        to.pixels = reinterpret_cast<unsigned char*>(destination->pixels);
+        ResizeImages(&from, &to);
+        from.pixels = 0;
+        to.pixels = 0;
+        return;
+    }
+
+    SurfaceDescription from_description = { };
+    SurfaceDescription to_description = { };
+    from_description.size = 0x7c;
+    to_description.size = 0x7c;
+    if (source->native_surface)
+        from_description.pixels = source->native_surface->lock().data();
+    else if (source->surface->vtable->Lock(source->surface, 0, &from_description, 0, 0) < 0)
+        return;
+    if (destination->native_surface)
+        to_description.pixels = destination->native_surface->lock().data();
+    else if (destination->surface->vtable->Lock(destination->surface, 0, &to_description, 0, 0) < 0)
+        return;
+
+    TgaImage from(source->pitch >> 1, source->height);
+    TgaImage to(destination->pitch >> 1, destination->height);
+    from.pixels = static_cast<unsigned char*>(from_description.pixels);
+    to.pixels = static_cast<unsigned char*>(to_description.pixels);
+    ResizeImages(&from, &to);
+    if (source->native_surface)
+        source->native_surface->unlock();
+    else
+        source->surface->vtable->Unlock(source->surface, 0);
+    if (destination->native_surface)
+        destination->native_surface->unlock();
+    else
+        destination->surface->vtable->Unlock(destination->surface, 0);
+    from.pixels = 0;
+    to.pixels = 0;
+}
diff --git a/src/startup_renderer_save_jpeg.cpp b/src/startup_renderer_save_jpeg.cpp
