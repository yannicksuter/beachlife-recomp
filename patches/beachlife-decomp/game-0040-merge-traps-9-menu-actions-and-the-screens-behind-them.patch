@@ -0,0 +1,71 @@
+#include "startup_screen_renderer.h"
+#include "startup_jpeg_export.h"
+#include "tga_image.h"
+#include "runtime/renderer_word_surface.h"
+
+#include <stdexcept>
+
+// FUNCTION: BEACHLIFE 0x00411200
+void ScreenRequestRenderer::SaveSurfaceAsJpeg(int surface, const char* path)
+{
+    ScreenSurfacePosition* entry = surface_storage[surface];
+    int columns = entry->width;
+    int rows = entry->height;
+    TgaImage* image = new TgaImage(columns, rows, 24, 0);
+    current_surface = surface;
+    if (format_44 == 0)
+    {
+        // The retail temporary system-memory surface uses the existing host
+        // surface service; its copy and lock precede RGB565 conversion.
+        if (!entry->native_surface)
+            throw std::logic_error("SaveSurfaceAsJpeg requires a native capture surface");
+        using namespace beachlife::runtime::renderer_display;
+        WordSurface16 temporary(columns, rows, entry->native_surface->description().format);
+        temporary.copy_from(*entry->native_surface, { 0, 0, columns, rows }, 0, 0);
+        const unsigned short* source = temporary.lock().data();
+        unsigned int stride = temporary.description().pitch / 2;
+        unsigned char* output = image->pixels;
+        for (int y = 0; y < rows; ++y)
+        {
+            for (int x = 0; x < columns; ++x)
+            {
+                unsigned int pixel = source[x];
+                unsigned int red = (pixel >> 8) & 0xf8;
+                unsigned int green = (pixel >> 3) & 0xfc;
+                unsigned int blue = (pixel << 3) & 0xff;
+                output[x * 3] = red + (red >> 5);
+                output[x * 3 + 1] = green + (green >> 6);
+                output[x * 3 + 2] = blue + (blue >> 5);
+            }
+            source += stride;
+            output += columns * 3;
+        }
+    }
+    else
+    {
+        const unsigned short* source = AccessPixels();
+        if (source)
+        {
+            unsigned char* output = image->pixels;
+            for (int y = 0; y < rows; ++y)
+            {
+                for (int x = 0; x < columns; ++x)
+                {
+                    unsigned int pixel = source[x];
+                    unsigned int red = (pixel >> 7) & 0xf8;
+                    unsigned int green = (pixel >> 2) & 0xf8;
+                    unsigned int blue = (pixel << 3) & 0xff;
+                    output[x * 3] = red + (red >> 5);
+                    output[x * 3 + 1] = green + (green >> 5);
+                    output[x * 3 + 2] = blue + (blue >> 5);
+                }
+                source += columns;
+                output += columns * 3;
+            }
+        }
+        UnlockPixels();
+    }
+    ScreenRectangle bounds = { 0, 0, columns, rows };
+    ExportJpegImage(&bounds, image->pixels, path, 80);
+    delete image;
+}
