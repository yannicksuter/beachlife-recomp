+
+// These pointer-list projections reuse the existing shared 0x004b2fb0 body.
+CircularListIterator CircularList::Insert(CircularListIterator position, WorldCleaningRequest* const& record)
+{
+    ActiveScreenEntry* value = reinterpret_cast<ActiveScreenEntry*>(record);
+    return Insert(position, value);
+}
+
+CircularListIterator CircularList::Insert(CircularListIterator position, WorldTransportRecord* const& record)
+{
+    ActiveScreenEntry* value = reinterpret_cast<ActiveScreenEntry*>(record);
+    CircularListIterator result = Insert(position, value);
+    CircularListNode* next = result.node->next;
+    CircularListNode* previous = result.node->previous;
+    // The native transport readers use a typed payload node. Start that
+    // lifetime after the shared allocator and splice have completed.
+    WorldTransportNode* node = ::new (static_cast<void*>(result.node)) WorldTransportNode;
+    node->next = next;
+    node->previous = previous;
+    node->record = record;
+    result.node = node;
+    return result;
+}
+
+CircularListIterator CircularList::Insert(CircularListIterator position, WorldCleaningAssignment* const& record)
+{
+    ActiveScreenEntry* value = reinterpret_cast<ActiveScreenEntry*>(record);
+    return Insert(position, value);
+}
+
+// Native typed projection of the same pointer-node allocator and link splice.
+template <class Node, class Entry>
+static CircularListIterator InsertWorldNode(CircularListIterator position, Entry* const& entry)
+{
+    const unsigned int bytes = (sizeof(Node) + 7u) & ~7u;
+    Node* node = ::new (AllocateNodeStorage(bytes)) Node;
+    node->entry = entry;
+    CircularListNode* previous = position.node->previous;
+    node->next = position.node;
+    node->previous = previous;
+    previous->next = node;
+    position.node->previous = node;
+    CircularListIterator result;
+    result.node = node;
+    return result;
+}
+
+// FUNCTION: BEACHLIFE 0x00437b00
+CircularListIterator WorldRepairList::Insert(CircularListIterator position, WorldRepairEntry* const& entry)
+{
+    return InsertWorldNode<WorldRepairNode<WorldRepairEntry> >(position, entry);
+}
+
+// FUNCTION: BEACHLIFE 0x00437ce0
+CircularListIterator WorldRepairAssignmentList::Insert(CircularListIterator position, WorldRepairAssignment* const& entry)
+{
+    return InsertWorldNode<WorldRepairNode<WorldRepairAssignment> >(position, entry);
+}
+
+// FUNCTION: BEACHLIFE 0x00424540
+CircularListIterator VariableBuildingStatus::Insert(CircularListIterator position, BuildingStatusEntry* const& entry)
+{
+    return InsertWorldNode<BuildingStatusNode>(position, entry);
+}
