+
+// FUNCTION: BEACHLIFE 0x004d0c20
+inline int AnimationSoundLookup::SkipWhitespace(const char* data)
+{
+    int offset = 0;
+    while (data[offset] == ' ' || data[offset] == '\r' || data[offset] == '\n' || data[offset] == '\t')
+        ++offset;
+    return offset;
+}
