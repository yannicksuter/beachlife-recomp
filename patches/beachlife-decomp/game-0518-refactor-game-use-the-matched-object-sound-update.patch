+static float ScaleLevel(long double level, float volume)
+{
+    float scaled = static_cast<float>(level * volume);
+    return scaled;
+}
+
+static float ListenerDistance(WindowAudioVector listener, VariableWorldObject* object)
+{
+    float dx = listener.x - object->X();
+    float dy = listener.y - object->Y();
+    // x87: the height difference stays unrounded until the root is stored
+    // (fild; fsubr at 0x004d2a2b..0x004d2a34; fsqrt; fstp at 0x004d2a48).
+    long double vertical = dy - static_cast<long double>(object->Unknown44());
+    float distance = static_cast<float>(std::sqrt(vertical * vertical + static_cast<long double>(dx) * dx));
+    return distance;
+}
+
+// x87: 1 - (distance - near) / (far - near) is not rounded before ScaleLevel.
+static long double FadeLevel(float distance, float near_distance, float far_distance)
+{
+    return 1.0f - (static_cast<long double>(distance) - near_distance) / (static_cast<long double>(far_distance) - near_distance);
+}
