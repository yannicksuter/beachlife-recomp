@@ -0,0 +1,15 @@
+#include "startup_debug_font.h"
+#include "tga_image.h"
+
+#include <new>
+
+// Shared retail body at 0x004183f0, also used by ScreenFontData's destructor.
+DebugFont::~DebugFont()
+{
+    TgaImage* released = image;
+    if (released)
+    {
+        released->~TgaImage();
+        ::operator delete(released);
+    }
+}
