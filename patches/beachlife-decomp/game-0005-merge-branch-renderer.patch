index 0000000000000000000000000000000000000000..cf7e1500dbdb9d049cc3425cd760c0ee5c4037cc
--- /dev/null
+++ b/src/startup_debug_font.h
@@ -0,0 +1,33 @@
+#ifndef STARTUP_DEBUG_FONT_H
+#define STARTUP_DEBUG_FONT_H
+
+#include <cstddef>
+
+struct TgaImage;
+
+void StartupFatal(const char* format, ...);
+
+// The 0x440c-byte x86 GDI font owner is distinct from ScreenFontData's
+// 0x1080c-byte file font: their glyph and kerning tables have different extents.
+// Both image-only destructors share the retail implementation at 0x004183f0.
+struct DebugFont
+{
+    TgaImage* image;               // Original +0x0000: owned 8-bit atlas.
+    unsigned short glyphs[128][4]; // Original +0x0004: left, top, right, bottom.
+    signed char kerning[128][128]; // Original +0x0404: GDI delta minus one.
+    unsigned int size;             // Original +0x4404: requested point size.
+    unsigned int flags;            // Original +0x4408: bit 0 bold, bit 1 italic.
+
+    DebugFont(const char* face, unsigned int point_size, unsigned int style);
+    ~DebugFont();
+};
+
+#if defined(_M_IX86) || defined(__i386__)
+static_assert(offsetof(DebugFont, glyphs) == 0x0004);
+static_assert(offsetof(DebugFont, kerning) == 0x0404);
+static_assert(offsetof(DebugFont, size) == 0x4404);
+static_assert(offsetof(DebugFont, flags) == 0x4408);
+static_assert(sizeof(DebugFont) == 0x440c);
+#endif
+
+#endif
diff --git a/src/startup_debug_font_constructor.cpp b/src/startup_debug_font_constructor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5f17c007a1312d19fe1c7bd8dc417b9923c0850a
--- /dev/null
+++ b/src/startup_debug_font_constructor.cpp
@@ -0,0 +1,193 @@
+#include <windows.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "startup_debug_font.h"
+#include "startup_screen_renderer.h"
+#include "tga_image.h"
+
+// FUNCTION: BEACHLIFE 0x00417df0
+DebugFont::DebugFont(const char* face, unsigned int point_size, unsigned int style)
+{
+    size = point_size;
+    flags = style;
+
+    // The middle size class leaves the atlas height unset, as in the original.
+    unsigned int width;
+    unsigned int height;
+    if (point_size > 40)
+    {
+        width = 1024;
+        height = 1024;
+    }
+    else if (point_size > 20)
+    {
+        width = 512;
+    }
+    else
+    {
+        width = 256;
+        height = 256;
+    }
+    image = new TgaImage(width, height, 8, 1);
+
+    BITMAPINFOHEADER header;
+    memset(&header, 0, sizeof(header));
+    header.biSize = sizeof(header);
+    header.biWidth = width;
+    header.biHeight = height;
+    header.biPlanes = 1;
+    header.biCompression = BI_RGB;
+    header.biBitCount = 32;
+
+    HDC dc = CreateCompatibleDC(0);
+    void* bits;
+    HBITMAP bitmap =
+        CreateDIBSection(dc, reinterpret_cast<BITMAPINFO*>(&header), DIB_RGB_COLORS, &bits, 0, 0);
+    SetMapMode(dc, MM_TEXT);
+    int logical_height = MulDiv(size, GetDeviceCaps(dc, LOGPIXELSY), 72);
+    unsigned char style_bits = static_cast<unsigned char>(style);
+    HFONT font = CreateFont(-logical_height,
+        0,
+        0,
+        0,
+        (style_bits & 1) ? FW_BOLD : FW_NORMAL,
+        (style_bits >> 1) & 1,
+        FALSE,
+        FALSE,
+        DEFAULT_CHARSET,
+        OUT_DEFAULT_PRECIS,
+        CLIP_DEFAULT_PRECIS,
+        DEFAULT_QUALITY,
+        VARIABLE_PITCH,
+        face);
+    if (font == 0)
+    {
+        StartupFatal("Font::Font - error calling CreateFont");
+    }
+    SelectObject(dc, bitmap);
+    SelectObject(dc, font);
+    SetTextColor(dc, 0xffffff);
+    SetBkColor(dc, 0);
+    SetTextAlign(dc, TA_LEFT | TA_TOP);
+
+    // Draw each printable character into the DIB, recording its cell.
+    char text[] = "x";
+    memset(glyphs, 0, sizeof(glyphs));
+    int x = 0;
+    int y = 0;
+    for (char character = ' '; character < 127; ++character)
+    {
+        text[0] = character;
+        SIZE extent;
+        GetTextExtentPoint32(dc, text, 1, &extent);
+        if (static_cast<unsigned int>(x + extent.cx + 1) > width)
+        {
+            y += extent.cy + 1;
+            x = 0;
+        }
+        ExtTextOut(dc, x, y, ETO_OPAQUE, 0, text, 1, 0);
+        glyphs[character][0] = static_cast<unsigned short>(x);
+        glyphs[character][1] = static_cast<unsigned short>(y);
+        glyphs[character][2] = static_cast<unsigned short>(x + extent.cx);
+        glyphs[character][3] = static_cast<unsigned short>(y + extent.cy + 1);
+        x += extent.cx + 2;
+    }
+
+    memset(kerning, 0, sizeof(kerning));
+    KERNINGPAIR* pairs = new KERNINGPAIR[0x4000];
+    int count = GetKerningPairs(dc, 0x4000, pairs);
+    for (int index = 0; index < count; ++index)
+    {
+        KERNINGPAIR& pair = pairs[index];
+        if (pair.wFirst > 31 && pair.wFirst < 127 && pair.wSecond > 31 && pair.wSecond < 127)
+        {
+            if (abs(pair.iKernAmount) < 127)
+            {
+                kerning[pair.wFirst][pair.wSecond] = static_cast<signed char>(pair.iKernAmount - 1);
+            }
+            else
+            {
+                StartupFatal("Font::Font - a kerning delta over 127?!?!?! - craaaazy");
+            }
+        }
+    }
+
+    // Any pixel with a lit green/blue nibble is glyph coverage.
+    unsigned int bytes = height * width;
+    unsigned char* coverage = new unsigned char[bytes];
+    memset(coverage, 0, bytes);
+    for (unsigned int row = 0; row < height; ++row)
+    {
+        for (unsigned int column = 0; column < width; ++column)
+        {
+            unsigned char level =
+                (static_cast<unsigned int*>(bits)[row * width + column] >> 4) & 0xf;
+            if (level > 0)
+            {
+                coverage[row * width + column] = 0xff;
+            }
+        }
+    }
+    memcpy(image->pixels, coverage, bytes);
+
+    // Coverage becomes 0xff; uncovered pixels touching coverage (wrapping at
+    // the atlas edges) become the 0xfe outline.
+    unsigned char* out = image->pixels;
+    for (unsigned int y_index = 0; y_index < height; ++y_index)
+    {
+        for (unsigned int x_index = 0; x_index < width; ++x_index, ++out)
+        {
+            unsigned int middle = (y_index % height) * width;
+            unsigned int centre = x_index % width;
+            if (coverage[middle + centre])
+            {
+                *out = 0xff;
+            }
+            else
+            {
+                unsigned int above = ((y_index - 1) % height) * width;
+                unsigned int left = (x_index - 1) % width;
+                unsigned int right = (x_index + 1) % width;
+                unsigned int below = ((y_index + 1) % height) * width;
+                if (coverage[above + left] || coverage[above + centre] || coverage[above + right] ||
+                    coverage[middle + left] || coverage[middle + right] || coverage[below + left] ||
+                    coverage[below + centre] || coverage[below + right])
+                {
+                    *out = 0xfe;
+                }
+            }
+        }
+    }
+    delete[] coverage;
+
+    unsigned char* white = image->palette + 255 * 3;
+    white[0] = 0xff;
+    white[1] = 0xff;
+    white[2] = 0xff;
+    unsigned char rgb555 = 0;
+    if (screen_request_renderer->format_44 == 1)
+    {
+        rgb555 = 1;
+    }
+    image->ConvertPalette(rgb555);
+    delete[] pairs;
+
+    DeleteObject(bitmap);
+    DeleteDC(dc);
+    DeleteObject(font);
+
+    // Flip the atlas vertically (the DIB is bottom-up).
+    unsigned char* line = static_cast<unsigned char*>(malloc(width));
+    unsigned char* top = image->pixels;
+    unsigned char* bottom = image->pixels + (height - 1) * width;
+    do
+    {
+        memcpy(line, top, width);
+        memcpy(top, bottom, width);
+        memcpy(bottom, line, width);
+        top += width;
+        bottom -= width;
+    } while (top < bottom);
+    free(line);
+}
