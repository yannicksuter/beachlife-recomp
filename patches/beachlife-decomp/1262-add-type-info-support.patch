--- /dev/null
+++ b/support/type_info_support.cpp
@@ -0,0 +1,25 @@
+// VC6 MSVCRT static runtime support: the one type_info vftable and its scalar
+// deleting destructor (retail 0x004f53ac and 0x004ee702), which the C++ throw
+// type descriptors reference. The destructor itself stays the MSVCRT import.
+// The class layout and the two private members follow the VC6 runtime's own
+// declaration; their definitions are what emits the vftable in this unit.
+class type_info
+{
+public:
+    virtual ~type_info();
+
+private:
+    void* _m_data;
+    char _m_d_name[1];
+    type_info(const type_info& rhs);
+    type_info& operator=(const type_info& rhs);
+};
+
+type_info::type_info(const type_info& rhs)
+{
+}
+
+type_info& type_info::operator=(const type_info& rhs)
+{
+    return *this;
+}
