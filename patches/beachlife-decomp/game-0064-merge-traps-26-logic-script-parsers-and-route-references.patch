+static void TestNestedBranches()
+{
+    WorldSubsystem20 parser;
+    Parse(parser,
+        "If (1 != \"visitor\") Function PauseGame; "
+        "Else If (2 >= 3) Function LockMap; End "
+        "Function ResumeGame; End Function NoLitter;",
+        2);
+    assert(captured.size() == 6);
+    auto* outer = static_cast<WorldActionBranchData*>(captured[0].action->data_08);
+    auto* inner = static_cast<WorldActionBranchData*>(captured[2].action->data_08);
+    assert(outer->comparison_18 == 6 && inner->comparison_18 == 6);
+    assert(outer->right_10.kind == 0x36);
+    assert(std::strcmp(reinterpret_cast<const char*>(outer->right_10.data), "visitor") == 0);
+    assert(captured[1].parent == outer && !captured[1].otherwise);
+    assert(captured[2].parent == outer && captured[2].otherwise);
+    assert(captured[3].parent == inner && !captured[3].otherwise);
+    assert(captured[4].parent == outer && captured[4].otherwise);
+    assert(captured.back().parent == 0);
+    for (const CapturedAction& action : captured)
+        assert(action.phase == 2);
+    ClearActions();
+    Parse(parser, "If (1) Function Debug; End");
+    auto* unary = static_cast<WorldActionBranchData*>(captured[0].action->data_08);
+    assert(unary->right_10.kind == 0x110);
+    ClearActions();
+}
