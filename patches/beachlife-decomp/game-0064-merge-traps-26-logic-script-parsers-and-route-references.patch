+
+// Keep the tokenizer, dispatcher, payloads and destructors real. Capture the
+// append boundary and substitute numeric operands for the missing decoder.
+struct CapturedAction
+{
+    WorldSubsystem20::Action* action;
+    WorldActionBranchData* parent;
+    bool otherwise;
+    unsigned int phase;
+};
+
+static std::vector<CapturedAction> captured;
+
+void WorldSubsystem20::AppendAction(Action* action)
+{
+    captured.push_back({ action, word_04, word_04 && word_04->parsing_else_1c != 0, word_358 });
+}
+
+WorldScriptOperand WorldSubsystem20::ParseOperand(const char* token)
+{
+    char* end;
+    long value = std::strtol(token, &end, 10);
+    assert(*end == 0);
+    return { 2, static_cast<unsigned int>(value) };
+}
+
+VariableCatalog* variable_catalog = 0;
+
+unsigned int VariableCatalog::FindUnlock(const char*)
+{
+    throw std::runtime_error("Unexpected catalog lookup");
+}
+
+void StartupFatal(const char* format, ...)
+{
+    char message[512];
+    va_list arguments;
+    va_start(arguments, format);
+    std::vsnprintf(message, sizeof(message), format, arguments);
+    va_end(arguments);
+    throw std::runtime_error(message);
+}
+
+static void ClearActions()
+{
+    for (const CapturedAction& entry : captured)
+        delete entry.action;
+    captured.clear();
+}
+
+static void Parse(WorldSubsystem20& parser, std::string body, unsigned int phase = 0)
+{
+    body += " End sentinel ";
+    parser.cursor_00 = body.data();
+    int count = parser.ParseStateActions(phase);
+    assert(count == parser.cursor_00 - body.data());
+    assert(std::strcmp(parser.cursor_00, " sentinel ") == 0);
+    assert(parser.word_04 == 0);
+    for (WorldActionBranchData* saved : world_script_state_words)
+        assert(saved == 0);
+}
+
+static void TestActions()
+{
+    WorldSubsystem20 parser;
+    Parse(parser,
+        "LoadScript visitor visitor.lgc; "
+        "Function pausegame; "
+        "Message UnknownMessage 1 2 3 Time 1.5 MaxTime 4; "
+        "Add 1 2; Minus 3 4; Divide 5 6; Multiply 7 8; Set 9 10; "
+        "ChangeState Finish Time 2.5; "
+        "Path 4 5 3 ne; Grass 8 9 2 sw; "
+        "Area Beach 2 1 2 3 4 10 11 12 13 14 15 16 17; "
+        "BoatPoint 1.25 2.5 Unload Destroy; "
+        "BoatEntry 3.5 4.5 6 5.25 6.25; "
+        "BoatExit 7.5 8.5 2 9.25 10.25; "
+        "CircuitPoint powerboat -2 5; "
