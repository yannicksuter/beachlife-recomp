+        "PlaySound bell.wav; MoveCamera 1.25 2.5 3.75; "
+        "ShowMenu greeting portrait; ShowMenu plain;");
+    const unsigned int kinds[] = { 15, 0, 1, 6, 7, 8, 9, 10, 2, 13, 14, 16, 17, 18, 19, 21, 20, 22, 23, 11, 24, 25, 25 };
+    assert(captured.size() == sizeof(kinds) / sizeof(kinds[0]));
+    for (unsigned int index = 0; index < captured.size(); ++index)
+    {
+        assert(captured[index].action->kind_04 == kinds[index]);
+        assert(captured[index].action->next == 0);
+        assert(captured[index].parent == 0);
+    }
+    auto* script = static_cast<WorldActionNamedData*>(captured[0].action->data_08);
+    assert(std::strcmp(script->name_00, "visitor") == 0);
+    assert(std::strcmp(script->text_04, "visitor.lgc") == 0);
+    assert(*static_cast<unsigned int*>(captured[1].action->data_08) == 0);
+    auto* message = static_cast<WorldActionCommandData*>(captured[2].action->data_08);
+    assert(message->word_00 == 0);
+    assert(message->operands_04[2].data == 3);
+    assert(message->operands_04[5].kind == 0x110);
+    assert(message->minimum_34 == 1.5f && message->maximum_38 == 4.0f);
+    auto* arithmetic = static_cast<WorldActionArithmeticData*>(captured[7].action->data_08);
+    assert(arithmetic->left_00.data == 9 && arithmetic->right_08.data == 10);
+    auto* state = static_cast<WorldActionStateData*>(captured[8].action->data_08);
+    assert(std::strcmp(state->name_00, "Finish") == 0 && state->delay_04 == 2.5f);
+    auto* path = static_cast<WorldActionStripData*>(captured[9].action->data_08);
+    assert(path->point_00.x == 4 && path->point_00.y == 5);
+    assert(path->direction_08 == 1 && path->count_0c == 3);
+    auto* area = static_cast<WorldActionRouteData*>(captured[11].action->data_08);
+    assert(area->kind_00 == 1 && area->count_04 == 2);
+    assert(area->points_08[1].x == 3 && area->points_08[1].y == 4);
+    assert(area->words_0c[0] == 10 && area->words_0c[7] == 17);
+    auto* boat = static_cast<WorldActionPositionData*>(captured[12].action->data_08);
+    assert(boat->word_0c == 2 && boat->position_00.z == 0.0f);
+    auto* entry = static_cast<WorldActionEndpointData*>(captured[13].action->data_08);
+    assert(entry->heading_14 == 6);
+    assert(std::bit_cast<float>(entry->tile_0c.x) == 5.25f);
+    auto* circuit = static_cast<WorldActionEntryData*>(captured[15].action->data_08);
+    assert(circuit->kind_08 == 1 && circuit->first_00 == 0xfffffffeu);
+    auto* transport = static_cast<WorldActionTransportData*>(captured[16].action->data_08);
+    assert(transport->repeat_08 == 2 && transport->day_04 == 2);
+    assert(transport->kind_0c == 2 && transport->time_00 == 12.5f);
+    assert(transport->count_5b0 == 0 && transport->random_560[0] == 1);
+    assert(transport->counts_510[0] == 3 && transport->counts_510[1] == 4);
+    assert(transport->names_10[2][0] == 0);
+    auto* disaster = static_cast<WorldEventRecord*>(captured[17].action->data_08);
+    assert(disaster->kind_00 == 0 && disaster->duration_14 == 4.5f);
+    assert(disaster->value_30 == 0.5f && disaster->bounds_04.bottom == 4);
