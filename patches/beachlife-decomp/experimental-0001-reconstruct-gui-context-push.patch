--- /dev/null
+++ b/src/startup_gui_context.cpp
@@ -0,0 +1,30 @@
+#include "startup_gui_parser.h"
+#include "startup_screen_child_link.h"
+
+// FUNCTION: BEACHLIFE 0x004ab790
+void GuiParserState::PushContext(ScreenItem* item)
+{
+    if (current_context)
+    {
+        previous_context = current_context;
+        if (context_head)
+        {
+            ScreenChildLink* last = context_head;
+            while (last->next)
+            {
+                last = last->next;
+            }
+            last->next = new ScreenChildLink(current_context);
+        }
+        else
+        {
+            context_head = new ScreenChildLink(current_context);
+        }
+        current_context = item;
+    }
+    else
+    {
+        current_context = item;
+        previous_context = item;
+    }
+}
