+// FUNCTION: BEACHLIFE 0x00446080
+inline void ScreenTerrainGrid::Step(int x, int y, int direction, ScreenPoint* result)
+{
+    unsigned int column = x;
+    unsigned int row = y;
+    if (x & 1)
+    {
+        switch (direction)
+        {
+        case 0:
+            column = x + 1;
+            break;
+        case 1:
+            column = x + 2;
+            break;
+        case 2:
+            row = y + 1;
+            column = x + 1;
+            break;
+        case 3:
+            row = y + 1;
+            break;
+        case 4:
+            row = y + 1;
+            column = x - 1;
+            break;
+        case 5:
+            column = x - 2;
+            break;
+        case 6:
+            column = x - 1;
+            break;
+        case 7:
+            row = y - 1;
+            break;
+        }
+    }
+    else
+    {
+        switch (direction)
+        {
+        case 0:
+            column = x + 1;
+            row = y - 1;
+            break;
+        case 1:
+            column = x + 2;
+            break;
+        case 2:
+            column = x + 1;
+            break;
+        case 3:
+            row = y + 1;
+            break;
+        case 4:
+            column = x - 1;
+            break;
+        case 5:
+            column = x - 2;
+            break;
+        case 6:
+            column = x - 1;
+            row = y - 1;
+            break;
+        case 7:
+            row = y - 1;
+            break;
+        }
+    }
+    result->x = column % width_04;
+    result->y = row % height_08;
+}
+
+#endif
