+// Descriptive name; this checks delimiter count, not complete name syntax.
+// FUNCTION: BEACHLIFE 0x004ec390
+int HasConfigNameDelimiters(const char* buffer, int size)
+{
+    int remaining = 2;
+    for (int index = 0; index < size; ++index)
+    {
+        if (buffer[index] == '\'')
+        {
+            --remaining;
+            if (!remaining)
+                return 1;
+        }
+    }
+    return 0;
+}
