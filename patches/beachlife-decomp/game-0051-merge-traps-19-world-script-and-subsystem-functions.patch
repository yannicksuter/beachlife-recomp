+            next.words[0] = id_28;
+            next.words[1] = id_28;
+            next.words[2] = 0x39;
+            next.words[3] = 0;
+            next.words[4] = 0;
+            screen_mode_commands->QueueDelayed(&next, duration);
+        }
+        else if (state_3c == 6)
+        {
+            inactive_04 = 1;
+            ScreenModeCommand next;
+            next.words[0] = id_28;
+            next.words[1] = owner_id_fc;
+            next.words[2] = 0x3b;
+            next.words[3] = 0;
+            next.words[4] = 0;
+            screen_mode_commands->QueueCommand(&next);
+        }
+        return true;
+    }
+    return WorldPedestrianEntity::Unknown14(command);
+}
