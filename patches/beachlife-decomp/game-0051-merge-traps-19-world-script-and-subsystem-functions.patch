diff --git a/src/startup_world_lifeguard_sea_points.cpp b/src/startup_world_lifeguard_sea_points.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e410c3c755f0760b44c5b5bef1568183eb7e1cd1
--- /dev/null
+++ b/src/startup_world_lifeguard_sea_points.cpp
@@ -0,0 +1,123 @@
+#include "startup_world_entities.h"
+#include "startup_game_file.h"
+#include "startup_screen_mode_world.h"
+#include "window_activation.h"
+#include <cmath>
+
+namespace
+{
+inline void SeaPointNeighbours(ScreenPoint point, ScreenPoint* neighbours)
+{
+    screen_terrain_grid->Step(point.x, point.y, 0, &neighbours[0]);
+    screen_terrain_grid->Step(point.x, point.y, 2, &neighbours[1]);
+    screen_terrain_grid->Step(point.x, point.y, 4, &neighbours[2]);
+    screen_terrain_grid->Step(point.x, point.y, 6, &neighbours[3]);
+}
+
+inline bool SeaPointClear(ScreenPoint point, const ScreenPoint* neighbours)
+{
+    unsigned int index = screen_terrain_grid->TileIndex(point.x, point.y);
+    if (screen_terrain_grid->cells_0c[index].flags_48 & 0x10)
+        return false;
+    for (unsigned int i = 0; i < 4; ++i)
+    {
+        index = screen_terrain_grid->TileIndex(neighbours[i].x, neighbours[i].y);
+        if (screen_terrain_grid->cells_0c[index].flags_48 & 0x10)
+            return false;
+    }
+    return true;
+}
+
+inline bool SeaPointCloser(WorldLifeguardEntity* lifeguard, ScreenPoint point, ScreenPoint closest)
+{
+    ScreenWorldPosition position = screen_terrain_grid->TileOrigin(point.x, point.y);
+    float x = position.x - lifeguard->x_30;
+    float y = position.y - lifeguard->y_34;
+    float z = position.z - lifeguard->z_38;
+    ScreenWorldPosition previous = screen_terrain_grid->TileOrigin(closest.x, closest.y);
+    float previous_x = previous.x - lifeguard->x_30;
+    float previous_y = previous.y - lifeguard->y_34;
+    float previous_z = previous.z - lifeguard->z_38;
+    return std::sqrt(previous_x * previous_x + previous_z * previous_z + previous_y * previous_y)
+         > std::sqrt(x * x + z * z + y * y);
+}
+
+inline ScreenTerrainRouteNode* NearestSeaPoint(WorldLifeguardEntity* lifeguard, ScreenPoint* closest)
+{
+    ScreenTerrainRouteNode* nearest = screen_terrain_grid->routes_20;
+    unsigned int count;
+    ScreenPoint* points = nearest->Points(&count);
+    unsigned int index = 0;
+    ScreenPoint neighbours[4];
+    SeaPointNeighbours(points[index], neighbours);
+    while (!SeaPointClear(points[index], neighbours))
+    {
+        if (++index == count)
+        {
+            nearest = nearest->Next();
+            if (!nearest)
+                StartupFatal("I hope This Never Happens ( Cant Get Sea Entry Point)");
+            points = nearest->Points(&count);
+            index = 0;
+        }
+        SeaPointNeighbours(points[index], neighbours);
+    }
+    *closest = points[index];
+    for (++index; index < count; ++index)
