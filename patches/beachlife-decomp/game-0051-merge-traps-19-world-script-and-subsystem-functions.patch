+#include "startup_world_entities.h"
+#include "startup_screen_manager.h"
+#include "window_activation.h"
+
+namespace
+{
+inline void PublishLifeguardFeedback(WorldLifeguardEntity* lifeguard)
+{
+    lifeguard->feedback_7fc[2] = lifeguard->feedback_7fc[1];
+    lifeguard->feedback_7fc[1] = 0;
+    const char* message = lifeguard->Notification(lifeguard->feedback_7fc[2]);
+    if (message)
+        window_deactivation_state->ticker_30->AddMessage(message, lifeguard->id_28, 8);
+    lifeguard->AddThought(lifeguard->feedback_7fc[2]);
+    screen_manager->SetNamedItemFlag("LifeguardIcon", 0);
+}
+} // namespace
+
+// FUNCTION: BEACHLIFE 0x0047cfc0
+void WorldLifeguardEntity::UpdateFeedback()
+{
+    if (feedback_7fc[1])
+        return;
+    if (flag_818 && !(feedback_7fc[0] & 2))
+    {
+        feedback_7fc[0] |= 2;
+        feedback_7fc[1] = 2;
+        window_deactivation_state->ticker_30->AddFeedback(2, 7);
+        PublishLifeguardFeedback(this);
+        flag_818 = 0;
+    }
+    if (!(feedback_7fc[0] & 4))
+    {
+        feedback_7fc[0] |= 4;
+        if (!(window_deactivation_state->ticker_30->Feedback(7) & 4) && word_81c > 8)
+        {
+            feedback_7fc[1] |= 4;
+            window_deactivation_state->ticker_30->AddFeedback(4, 7);
+            PublishLifeguardFeedback(this);
+        }
+    }
+    if (!(feedback_7fc[0] & 8))
+    {
+        feedback_7fc[0] |= 8;
+        if (flag_766)
+        {
+            feedback_7fc[1] |= 8;
+            PublishLifeguardFeedback(this);
+        }
+    }
+    if (!(feedback_7fc[0] & 0x10))
+    {
+        feedback_7fc[0] |= 0x10;
+        if (flag_766)
+        {
+            feedback_7fc[1] |= 0x10;
+            PublishLifeguardFeedback(this);
+        }
+    }
+    if (!(feedback_7fc[0] & 0x20))
+    {
+        feedback_7fc[0] |= 0x20;
+        if (flag_766)
+        {
+            feedback_7fc[1] |= 0x20;
+            PublishLifeguardFeedback(this);
+        }
+    }
+    if (!(feedback_7fc[0] & 0x800000) && !(morale_10c >= 0.6f))
+    {
+        feedback_7fc[0] |= 0x800000;
+        feedback_7fc[1] |= 0x800000;
+        window_deactivation_state->ticker_30->AddMessage(Notification(0x100000), id_28, 7);
+        AddThought(0x800000);
+    }
+}
diff --git a/src/startup_world_lifeguard_patrol.cpp b/src/startup_world_lifeguard_patrol.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2f71930cf35aa3678b9e4c91bcee446f0cfd0412
--- /dev/null
+++ b/src/startup_world_lifeguard_patrol.cpp
@@ -0,0 +1,91 @@
+#include "startup_world_entities.h"
+#include "startup_screen_mode_world.h"
+#include <cmath>
+#include <cstdlib>
+
+namespace
+{
+inline float BeachPointDistance(ScreenPoint point, ScreenWorldPosition position)
+{
+    ScreenWorldPosition tile = screen_terrain_grid->TileOrigin(point.x, point.y);
+    float x = tile.x - position.x;
+    float y = tile.y - position.y;
+    float z = tile.z - position.z;
+    return std::sqrt(z * z + y * y + x * x);
+}
+} // namespace
+
+// FUNCTION: BEACHLIFE 0x0047e930
+void WorldLifeguardEntity::FindBeachArea()
+{
+    float distance = 0.0f;
+    unsigned int area = 0;
+    unsigned int nearest_area = 0;
+    ScreenWorldPosition position = { x_30, y_34, z_38 };
+    ScreenTerrainRouteNode* nearest = screen_terrain_grid->routes_1c;
+    unsigned int count;
+    ScreenPoint* points = nearest->Points(&count);
+    ScreenPoint closest = points[0];
+    // The first scan's closest point is discarded by the original routine.
+    for (unsigned int i = 1; i < count; ++i)
+    {
+        float candidate_distance = BeachPointDistance(points[i], position);
+        float closest_distance = BeachPointDistance(closest, position);
+        if (closest_distance > candidate_distance)
+            closest = points[i];
+    }
+    for (ScreenTerrainRouteNode* route = nearest; route; route = route->Next(), ++area)
+    {
+        points = route->Points(&count);
+        for (unsigned int i = 0; i < count; ++i)
+        {
+            float candidate_distance = BeachPointDistance(points[i], position);
+            if (!(candidate_distance >= distance) || distance == 0.0f)
+            {
+                nearest_area = area;
+                nearest = route;
+                distance = BeachPointDistance(points[i], position);
+            }
+        }
+    }
+    beach_route_780 = nearest;
+    beach_area_784 = nearest_area;
+}
+
+// FUNCTION: BEACHLIFE 0x0047ed60
+void WorldLifeguardEntity::PatrolBeach()
+{
+    ScreenPoint first = beach_route_780->Bounds()[0];
+    ScreenPoint last = beach_route_780->Bounds()[3];
+    float width = static_cast<float>(last.x - first.x);
+    float left = static_cast<float>(first.x);
+    int x = static_cast<int>(static_cast<float>(std::rand()) * 0.000030518509447574615f * width + left);
+    float height = static_cast<float>(last.y - first.y);
+    float top = static_cast<float>(first.y);
+    int y = static_cast<int>(static_cast<float>(std::rand()) * 0.000030518509447574615f * height + top);
+    for (;;)
+    {
+        unsigned int index = (static_cast<unsigned int>(y) % screen_terrain_grid->height_08) * screen_terrain_grid->width_04
+                           + static_cast<unsigned int>(x) % screen_terrain_grid->width_04;
+        unsigned int flags = screen_terrain_grid->cells_0c[index].flags_48;
+        if ((flags & 2) && !(flags & 0x10))
+            break;
+        x = static_cast<int>(static_cast<float>(std::rand()) * 0.000030518509447574615f * width + left);
+        y = static_cast<int>(static_cast<float>(std::rand()) * 0.000030518509447574615f * height + top);
+    }
+    ScreenWorldPosition position = screen_terrain_grid->TileOrigin(x, y);
+    ScreenModeCommand command;
+    command.words[0] = id_28;
+    command.words[1] = id_28;
+    if (word_820 < 10)
+        command.words[2] = 8;
+    else
+    {
+        unsigned int mode = word_820;
+        word_820 = 0;
+        command.words[2] = mode == 20 ? 0x0d : 5;
+    }
+    command.words[3] = static_cast<int>(position.x);
+    command.words[4] = static_cast<int>(position.y);
+    screen_mode_commands->QueueCommand(&command);
+}
