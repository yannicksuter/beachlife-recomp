+#include "startup_game_file.h"
+#include <cstring>
+#include <new>
+
+static int SkipObjectScriptWhitespace(char*& cursor)
+{
+    int count = 0;
+    while (*cursor == ' ' || *cursor == '\r' || *cursor == '\n' || *cursor == '\t')
+    {
+        ++count;
+        ++cursor;
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x004d5800
+void WorldSubsystemScript::LoadScript(const char* path)
+{
+    unsigned int length = std::strlen(path);
+    char* filename = static_cast<char*>(::operator new(length + 1));
+    std::strcpy(filename, path);
+    filename[length - 4] = '.';
+    filename[length - 3] = 'b';
+    filename[length - 2] = 'l';
+    filename[length - 1] = 'e';
+    int size = GetFileSize(filename);
+    cursor_591c = LoadBleFile(filename);
+    ::operator delete(filename);
+    char* buffer = cursor_591c;
+    int consumed = 0;
+    char token[52];
+    while (consumed < size)
+    {
+        consumed += SkipObjectScriptWhitespace(cursor_591c);
+        consumed += SkipComments();
+        if (consumed >= size)
+            break;
+        consumed += ReadToken(token);
+        if (!std::strcmp(token, "State"))
+            consumed += ParseState();
+        else if (token[0] == '/')
+            consumed += SkipComments();
+        else
+            StartupFatal("Invalid Command Recieved in ObjectScript %s", token);
+    }
+    ::operator delete(buffer);
+}
