+// FUNCTION: BEACHLIFE 0x0047f0b0
+void WorldLifeguardEntity::DirectTo(unsigned int id)
+{
+    VariableEntity* target = variable_world->FindObject(id);
+    unsigned int feedback = 0;
+    ScreenModeCommand command;
+    if (!target)
+        feedback = 8;
+    else
+    {
+        if (target->state_3c == 0x13)
+        {
+            saving_id_77c = id;
+            WorldGuestEntity* guest = variable_world->FindObject(id)->AsGuest();
+            if (!guest->lightning_state_318)
+            {
+                saving_id_77c = id;
+                flag_778 = 1;
+                command.words[0] = id_28;
+                command.words[1] = id_28;
+                command.words[2] = 0x3c;
+                command.words[3] = 0;
+                command.words[4] = 1;
+                command.words[5] = 0x83;
+                command.words[6] = 0;
+                screen_mode_commands->QueueCommand(&command);
+            }
+            else
+            {
+                saving_id_77c = 0xffffffff;
+                flag_778 = 0;
+                feedback = 0x10;
+            }
+        }
+        else
+            feedback = 0x20;
+        flag_766 = 0;
+    }
+    if (feedback)
+    {
+        feedback_7fc[0] &= ~feedback;
+        flag_766 = 1;
+        feedback_7fc[1] = 0;
+        command.words[0] = id_28;
+        command.words[1] = id_28;
+        command.words[2] = 0x3c;
+        command.words[3] = 0;
+        command.words[4] = 0;
+        command.words[5] = 0x83;
+        command.words[6] = 0;
+        screen_mode_commands->QueueCommand(&command);
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x0047f6b0
+void WorldLifeguardEntity::EndRescue()
+{
+    if (flag_778)
+    {
+        if (action_state_7ec == 0 || action_state_7ec == 1)
+        {
+            variable_world->FindObject(saving_id_77c)->AsGuest()->lightning_state_318 = 2;
+            ScreenModeCommand command;
+            command.words[0] = id_28;
+            command.words[1] = id_28;
+            command.words[2] = 3;
+            command.words[3] = 0;
+            command.words[4] = 0x4c;
+            screen_mode_commands->QueueCommand(&command);
+        }
+        else
+            flag_779 = 1;
+    }
+    else
+    {
+        SetMovementMode(0x4c);
+        Unknown08(0x4c);
+    }
