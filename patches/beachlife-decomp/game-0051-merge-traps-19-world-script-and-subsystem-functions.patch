+#include "startup_animation_sound.h"
+
+// FUNCTION: BEACHLIFE 0x004d0c20
+int AnimationSoundLookup::SkipWhitespace(const char* data)
+{
+    int offset = 0;
+    while (data[offset] == ' ' || data[offset] == '\r' || data[offset] == '\n' || data[offset] == '\t')
+        ++offset;
+    return offset;
+}
+
+// FUNCTION: BEACHLIFE 0x004d0d40
+int AnimationSoundLookup::SkipComments(const char* data)
+{
+    int offset = SkipWhitespace(data);
+    if (data[offset] == '/')
+    {
+        do
+            ++offset;
+        while (data[offset] != '\n');
+        offset += SkipWhitespace(data + offset);
+        offset += SkipComments(data + offset);
+        offset += SkipWhitespace(data + offset);
+    }
+    return offset;
+}
+
+// FUNCTION: BEACHLIFE 0x004d0c50
+int AnimationSoundLookup::ReadToken(char* token, const char* data)
+{
+    int offset = SkipWhitespace(data);
+    offset += SkipComments(data + offset);
+    if (data[offset] == ';')
+    {
+        token[0] = ';';
+        token[1] = 0;
+        return offset + 1;
+    }
+    while (data[offset] != ' ' && data[offset] != '\n' && data[offset] != '\t'
+           && data[offset] != '\r' && data[offset] != ';')
+        *token++ = data[offset++];
+    *token = 0;
+    return offset;
+}
