+        ScreenWorldPosition position = { x_30, y_34, z_38 };
+        float duration = keyline_state_44->SetAnimation(animation, window_deactivation_state->time_158, &position);
+        resource_104->SetAnimation(microphone, window_deactivation_state->time_158, &position);
+        ScreenModeCommand next;
+        next.words[0] = id_28;
+        next.words[1] = id_28;
+        next.words[2] = 0x39;
+        next.words[3] = 0;
+        next.words[4] = 0;
+        screen_mode_commands->QueueDelayed(&next, duration);
+        return true;
+    }
+    if (kind == 0x16)
