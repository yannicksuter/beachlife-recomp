@@ -0,0 +1,202 @@
+#include "startup_world_entities.h"
+#include "window_activation.h"
+
+// FUNCTION: BEACHLIFE 0x0049b180
+bool WorldEntity16::Unknown14(ScreenModeCommand* command)
+{
+    unsigned int kind = command->words[2];
+    if (kind == 0x3b)
+    {
+        flag_108 = 1;
+        unsigned char result;
+        return result != 0;
+    }
+    if (kind == 0x39)
+    {
+        float duration;
+        ScreenWorldPosition position = { x_30, y_34, z_38 };
+        if (action_state_f4 == 0)
+        {
+            action_state_f4 = 2;
+            duration = keyline_state_44->SetAnimation("D_WEIGHT_BIG_JOY", window_deactivation_state->time_158, &position);
+            ScreenModeCommand broadcast;
+            broadcast.words[0] = id_28;
+            broadcast.words[1] = id_28;
+            broadcast.words[2] = 0x3c;
+            broadcast.words[3] = 0;
+            broadcast.words[4] = 2;
+            broadcast.words[5] = 0x3e;
+            broadcast.words[6] = 0;
+            variable_world->FindObject(owner_id_fc)->AsBuilding()->events_170->BroadcastGuests(&broadcast, 0.0f);
+        }
+        else if (action_state_f4 == 1)
+        {
+            switch (type_f8)
+            {
+            case 0:
+                action_state_f4 = 2;
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_THIN_WEIGHT", window_deactivation_state->time_158, &position);
+                resource_104->SetAnimation("D_WEIGHT_THINBAR_WEIGHT", window_deactivation_state->time_158, &position);
+                break;
+            case 1:
+                action_state_f4 = 2;
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_FAT_WEIGHT", window_deactivation_state->time_158, &position);
+                resource_104->SetAnimation("D_WEIGHT_FATBAR_WEIGHT", window_deactivation_state->time_158, &position);
+                break;
+            case 2:
+                action_state_f4 = 0;
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_BIG_WEIGHT", window_deactivation_state->time_158, &position);
+                resource_104->SetAnimation("D_WEIGHT_BIGBAR_WEIGHT", window_deactivation_state->time_158, &position);
+                break;
+            }
+            if (type_f8 == 0 || type_f8 == 1)
+            {
+                ScreenModeCommand broadcast;
+                broadcast.words[0] = id_28;
+                broadcast.words[1] = id_28;
+                broadcast.words[2] = 0x3c;
+                broadcast.words[3] = 0;
+                broadcast.words[4] = 1;
+                broadcast.words[5] = 0x3e;
+                broadcast.words[6] = 0;
+                variable_world->FindObject(owner_id_fc)->AsBuilding()->events_170->BroadcastGuests(&broadcast, duration);
+            }
+            keyline_state_44->word_08 = 2;
+        }
+        else if (action_state_f4 == 2)
+        {
+            switch (type_f8)
+            {
+            case 0:
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_THIN_TOWALK", window_deactivation_state->time_158, &position);
+                break;
+            case 1:
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_FAT_TOWALK", window_deactivation_state->time_158, &position);
+                break;
+            case 2:
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_BIG_TOWALK", window_deactivation_state->time_158, &position);
+                break;
+            }
+            keyline_state_44->word_08 = 2;
+            action_state_f4 = 3;
+        }
+        else
+        {
+            unsigned int count;
+            ScreenModeCommand next;
+            if (!flag_108)
+            {
+                next.words[0] = id_28;
+                next.words[1] = id_28;
+                next.words[2] = 3;
+                next.words[3] = 0;
+                next.words[4] = 0;
+                screen_mode_commands->QueueCommand(&next);
+                VariableEntity** performers = variable_world->ByType(0x10, &count);
+                for (unsigned int index = 0; index < count; ++index)
+                {
+                    WorldEntity16* performer = static_cast<WorldEntity16*>(performers[index]);
+                    if (performer->owner_id_fc == owner_id_fc && performer->type_f8 == (type_f8 + 1) % 3)
+                    {
+                        next.words[1] = performer->id_28;
+                        next.words[4] = 4;
+                        break;
+                    }
+                }
+                screen_mode_commands->QueueCommand(&next);
+            }
+            else
+            {
+                VariableEntity** performers = variable_world->ByType(0x10, &count);
+                next.words[0] = id_28;
+                next.words[1] = 0;
+                next.words[2] = 3;
+                next.words[3] = 0;
+                next.words[4] = 6;
+                for (unsigned int index = 0; index < count; ++index)
+                {
+                    WorldEntity16* performer = static_cast<WorldEntity16*>(performers[index]);
+                    if (performer->owner_id_fc == owner_id_fc)
+                    {
+                        next.words[1] = performer->id_28;
+                        screen_mode_commands->QueueCommand(&next);
+                    }
+                }
+            }
+            return true;
+        }
+        ScreenModeCommand next;
+        next.words[0] = id_28;
+        next.words[1] = id_28;
+        next.words[2] = 0x39;
+        next.words[3] = 0;
+        next.words[4] = 0;
+        screen_mode_commands->QueueDelayed(&next, duration);
+        return true;
+    }
+    if (kind == 0x16)
+    {
+        ScreenWorldPosition position = { x_30, y_34, z_38 };
+        if (state_3c == 0)
+        {
+            switch (type_f8)
+            {
+            case 0:
+                keyline_state_44->SetAnimation("D_WEIGHT_THIN_WAIT", window_deactivation_state->time_158, &position);
+                break;
+            case 1:
+                keyline_state_44->SetAnimation("D_WEIGHT_FAT_WAIT", window_deactivation_state->time_158, &position);
+                break;
+            case 2:
+                keyline_state_44->SetAnimation("D_WEIGHT_BIG_WAIT", window_deactivation_state->time_158, &position);
+                break;
+            }
+            int rotation = variable_world->FindObject(owner_id_fc)->keyline_state_44->word_18;
+            keyline_state_44->SelectVariant((11 - rotation * 2) % 8);
+            keyline_state_44->word_08 = 0;
+        }
+        else if (state_3c == 6)
+        {
+            if (type_f8 == 0)
+            {
+                ScreenModeCommand next;
+                next.words[0] = id_28;
+                next.words[1] = owner_id_fc;
+                next.words[2] = 0x3b;
+                next.words[3] = 0;
+                next.words[4] = 0;
+                screen_mode_commands->QueueCommand(&next);
+            }
+            inactive_04 = 1;
+        }
+        else if (action_state_f4 == 0)
+        {
+            float duration;
+            switch (type_f8)
+            {
+            case 0:
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_THIN_POSE", window_deactivation_state->time_158, &position);
+                break;
+            case 1:
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_FAT_POSE", window_deactivation_state->time_158, &position);
+                break;
+            case 2:
+                duration = keyline_state_44->SetAnimation("D_WEIGHT_BIG_POSE", window_deactivation_state->time_158, &position);
+                break;
+            }
+            keyline_state_44->word_08 = 2;
+            int rotation = variable_world->FindObject(owner_id_fc)->keyline_state_44->word_18;
+            keyline_state_44->SelectVariant((11 - rotation * 2) % 8);
+            action_state_f4 = 1;
+            ScreenModeCommand next;
+            next.words[0] = id_28;
+            next.words[1] = id_28;
+            next.words[2] = 0x39;
+            next.words[3] = 0;
+            next.words[4] = 0;
+            screen_mode_commands->QueueDelayed(&next, duration);
+        }
+        return true;
+    }
+    return WorldPedestrianEntity::Unknown14(command);
+}
