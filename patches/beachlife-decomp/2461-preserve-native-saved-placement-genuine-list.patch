+// LIBRARY: BEACHLIFE 0x004e80a0
+// ?Insert@CircularList@@QAE?AUCircularListIterator@@U2@ABQAUSavedScreenPlacement@@@Z
+CircularListIterator CircularList::Insert(CircularListIterator position, SavedScreenPlacement* const& placement)
+{
+    SavedScreenPlacementNode* node = CreateNode(placement);
+    CircularListNode* previous = position.node->previous;
+    node->next = position.node;
+    node->previous = previous;
+    previous->next = node;
+    position.node->previous = node;
+    CircularListIterator result;
+    result.node = node;
+    return result;
+}
