+++ b/src/startup_tga_screen_item_activation.cpp
@@ -0,0 +1,36 @@
+#include "startup_tga_screen_item.h"
+#include "startup_screen_renderer.h"
+#include "tga_image.h"
+#include <string.h>
+
+// GLOBAL: BEACHLIFE 0x005816f8
+const char* tga_screen_path_prefix = "data\\screens\\";
+
+// FUNCTION: BEACHLIFE 0x004c8620
+void TgaScreenItem::Unresolved24(unsigned char enabled)
+{
+    ScreenItem::Unresolved24(enabled);
+    if (enabled)
+    {
+        if (!image)
+        {
+            char path[128];
+            strcpy(path, tga_screen_path_prefix);
+            strcat(path, filename);
+            image = LoadTgaFile(path);
+            if (screen_request_renderer->format_44 == 1)
+            {
+                image->ConvertPalette(1);
+            }
+            else
+            {
+                image->ConvertPalette(0);
+            }
+        }
+    }
+    else if (image)
+    {
+        delete image;
+        image = 0;
+    }
+}
