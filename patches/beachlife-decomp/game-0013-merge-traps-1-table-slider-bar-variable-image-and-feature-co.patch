+#ifndef STARTUP_SCREEN_DIALOG_METADATA_H
+#define STARTUP_SCREEN_DIALOG_METADATA_H
+
+#include "startup_resource_binary_read.h"
+#include "startup_resource_stream_read.h"
+#include "startup_screen_dialog_resource.h"
+
