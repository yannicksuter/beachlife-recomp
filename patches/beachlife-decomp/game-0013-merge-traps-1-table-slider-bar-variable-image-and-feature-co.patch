+++ b/src/startup_string_key_lookup.h
@@ -0,0 +1,47 @@
+#ifndef STARTUP_STRING_KEY_LOOKUP_H
+#define STARTUP_STRING_KEY_LOOKUP_H
+
+#include <string.h>
+#if !defined(_WIN32)
+#include <strings.h>
+#define _stricmp strcasecmp
+#endif
+
+// The text and sound lookup specializations share these folded retail bodies.
+// Keep both owners and bucket types intact instead of casting their layouts.
+template <class Lookup, class Key, class Iterator>
+inline Iterator FindStringKey(Lookup& lookup, const Key& key, Iterator end)
+{
+    const char* cursor = key.text;
+    unsigned int hash = 0;
+    while (*cursor != 0)
+    {
+        hash = hash * 5 + static_cast<signed char>(*cursor);
+        ++cursor;
+    }
+
+    int first = static_cast<int>(hash % static_cast<unsigned int>(lookup.bucket_count));
+    int index = first;
+    do
+    {
+        if (lookup.buckets[index].unavailable == 0
+            && _stricmp(lookup.buckets[index].key, key.text) == 0)
+        {
+            Iterator found = { lookup.buckets + index, &lookup };
+            return found;
+        }
+        ++index;
+        if (index >= lookup.bucket_count)
+            index = 0;
+    } while (index != first);
+    return end;
+}
+
+template <class Iterator, class Lookup>
+inline Iterator StringKeyEnd(Lookup& lookup)
+{
+    Iterator end = { lookup.buckets + lookup.end_index, &lookup };
+    return end;
+}
+
+#endif
