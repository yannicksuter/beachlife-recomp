+#include <strings.h>
+#define _stricmp strcasecmp
+#endif
+
+// One metadata implementation for the original FILE and native stream ABIs.
+template <class Stream>
+inline void ReadScreenFrameMetadata(ScreenDialogResourceFrame& frame, Stream* stream)
+{
+    unsigned char length = ReadResourceByte(stream);
+    frame.name = static_cast<char*>(::operator new(length));
+    for (int i = 0; i < length; ++i)
+    {
+        unsigned char value = ReadResourceByte(stream);
+        const_cast<char*>(frame.name)[i] = static_cast<char>(value);
+    }
+
+    frame.count_0a = ReadResourceWord(stream);
+    frame.plane_count_0c = ReadResourceByte(stream);
+    frame.width_0e = ReadResourceWord(stream);
+    frame.height_10 = ReadResourceWord(stream);
+    unsigned short word = ReadResourceWord(stream);
+    frame.unknown_12[0] = static_cast<unsigned char>(word);
+    frame.unknown_12[1] = static_cast<unsigned char>(word >> 8);
+    frame.word_14 = static_cast<short>(ReadResourceWord(stream));
+    frame.file_offset_1c = ReadResourceDword(stream);
+    frame.data_size_18 = static_cast<int>(ReadResourceDword(stream));
+    frame.offset_count_40 = ReadResourceWord(stream);
+}
+
+template <class Stream>
+inline void ReadScreenRecordMetadata(ScreenDialogResourceRecord& record, Stream* stream, unsigned int surface_format)
+{
+    unsigned char length = ReadResourceByte(stream);
+    record.name = static_cast<char*>(::operator new(length));
+    for (int i = 0; i < length; ++i)
+    {
+        unsigned char value = ReadResourceByte(stream);
+        const_cast<char*>(record.name)[i] = static_cast<char>(value);
+    }
+
+    record.format_18 = ReadResourceDword(stream);
+    if (record.format_18 == 5)
+    {
+        record.unknown_20[0] = ReadResourceByte(stream);
+        record.unknown_20[1] = ReadResourceByte(stream);
+        record.unknown_20[2] = ReadResourceByte(stream);
+        record.unknown_20[3] = ReadResourceByte(stream);
+    }
+
+    record.palette_count = static_cast<int>(ReadResourceDword(stream));
+    record.palettes = static_cast<unsigned short**>(::operator new(record.palette_count * sizeof(unsigned short*)));
+    if (!_stricmp(record.name, "fat_bloke"))
+        record.word_1c = 1;
+    else if (!_stricmp(record.name, "fit_bloke"))
+        record.word_1c = 2;
+    else if (!_stricmp(record.name, "gail"))
+        record.word_1c = 3;
+    else if (!_stricmp(record.name, "shaz"))
+        record.word_1c = 4;
+    else
+        record.word_1c = 0;
+
+    for (int palette = 0; palette < record.palette_count; ++palette)
+    {
+        switch (record.format_18)
+        {
+        case 1:
+        case 2:
+        case 5:
+        case 11:
+        {
+            record.palettes[palette] = static_cast<unsigned short*>(::operator new(512));
+            unsigned short* output = record.palettes[palette];
+            for (int colour = 0; colour < 256; ++colour)
+            {
+                unsigned char red = ReadResourceByte(stream);
+                unsigned char green = ReadResourceByte(stream);
+                unsigned char blue = ReadResourceByte(stream);
+                if (surface_format == 0)
+                    *output++ = static_cast<unsigned short>(
+                        (((red & 0xf8) << 5) | (green & 0xfc)) << 3 | (blue >> 3));
+                else
+                    *output++ = static_cast<unsigned short>(
+                        (((red & 0xf8) << 5) | (green & 0xf8)) << 2 | (blue >> 3));
+            }
+            break;
+        }
+        case 3:
+        case 6:
+        {
+            record.palettes[palette] = static_cast<unsigned short*>(::operator new(128));
+            unsigned short* output = record.palettes[palette];
+            for (int colour = 0; colour < 64; ++colour)
+            {
+                unsigned char red = ReadResourceByte(stream);
+                unsigned char green = ReadResourceByte(stream);
+                unsigned char blue = ReadResourceByte(stream);
+                if (surface_format == 0)
+                    *output++ = static_cast<unsigned short>(
+                        (((red & 0xf8) << 5) | (green & 0xfc)) << 3 | (blue >> 3));
+                else
+                    *output++ = static_cast<unsigned short>(
+                        (((red & 0xf8) << 5) | (green & 0xf8)) << 2 | (blue >> 3));
+            }
+            for (int discarded = 0; discarded < 192; ++discarded)
+            {
+                ReadResourceByte(stream);
+                ReadResourceByte(stream);
+                ReadResourceByte(stream);
+            }
+            break;
+        }
+        }
+    }
+
+    record.frame_count = static_cast<int>(ReadResourceDword(stream));
+    record.frames = static_cast<ScreenDialogResourceFrame**>(::operator new(record.frame_count * sizeof(ScreenDialogResourceFrame*)));
+    for (int frame = 0; frame < record.frame_count; ++frame)
+    {
+        record.frames[frame] = new ScreenDialogResourceFrame;
+        record.frames[frame]->ReadMetadata(stream);
+    }
+}
+
+#endif
