+++ b/src/startup_font_fit_text_to_width.cpp
@@ -0,0 +1,49 @@
+#include "startup_screen_text.h"
+
+#include <cstddef>
+
+namespace
+{
+// The retail CRT's wide strings contain 16-bit units. Host wchar_t may have
+// four bytes, so retain the unchecked wcslen/wcscat operations on actual units.
+std::size_t TextLength16(const unsigned short* text)
+{
+    const unsigned short* end = text;
+    while (*end != 0)
+    {
+        ++end;
+    }
+    return static_cast<std::size_t>(end - text);
+}
+
+void AppendText16(unsigned short* destination, const unsigned short* source)
+{
+    while (*destination != 0)
+    {
+        ++destination;
+    }
+    do
+    {
+        *destination++ = *source;
+    } while (*source++ != 0);
+}
+} // namespace
+
+// FUNCTION: BEACHLIFE 0x004a05e0
+void ScreenFontRenderer::FitTextToWidth(unsigned short* text, int width)
+{
+    int measured = MeasureText(text);
+    if (measured > width)
+    {
+        unsigned short* cut = text + TextLength16(text) - 1;
+        do
+        {
+            --cut;
+            *cut = 0;
+            const unsigned short ellipsis[] = {'.', '.', '.', 0};
+            // The retail call passes the newly terminated cut position.
+            AppendText16(cut, ellipsis);
+            measured = MeasureText(text);
+        } while (measured > width);
+    }
+}
