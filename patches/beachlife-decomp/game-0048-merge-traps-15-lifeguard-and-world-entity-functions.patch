+        choices[1] = "FEEDBACK_CLEANER_INNERTOUGHT_CLEANTOILET_02";
+        choices[2] = "FEEDBACK_CLEANER_INNERTOUGHT_CLEANTOILET_03";
+    }
+    else if (flags & 0x40)
+    {
+        choices[0] = "FEEDBACK_CLEANER_INNERTOUGHT_CLEANLITTER_01";
+        choices[1] = "FEEDBACK_CLEANER_INNERTOUGHT_CLEANLITTER_02";
+        choices[2] = "FEEDBACK_CLEANER_INNERTOUGHT_CLEANLITTER_03";
+    }
+    else if (flags & 0x20)
+    {
+        choices[0] = "FEEDBACK_CLEANER_INNERTOUGHT_GOSTROLL_01";
+        choices[1] = "FEEDBACK_CLEANER_INNERTOUGHT_GOSTROLL_02";
+        choices[2] = "FEEDBACK_CLEANER_INNERTOUGHT_GOSTROLL_03";
+    }
+    else if (flags & 0x20000000)
+    {
+        choices[0] = "FEEDBACK_CLEANER_INNERTOUGHT_STANDIDLE_01";
+        choices[1] = "FEEDBACK_CLEANER_INNERTOUGHT_STANDIDLE_02";
+        choices[2] = "FEEDBACK_CLEANER_INNERTOUGHT_STANDIDLE_03";
+    }
+    else
+        return result;
+    int index = rand() % 3;
+    return index >= 0 && index < 3 ? choices[index] : result;
+}
