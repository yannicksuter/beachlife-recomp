+    if (flags & 2)
+        return "FEEDBACK_CLEANER_TOILETS_BUSY";
+    if (flags & 0x100000)
+        return "FEEDBACK_CLEANER_UNHAPPY";
+    const char* choices[3];
+    if (flags & 8)
+    {
+        choices[0] = "FEEDBACK_CLEANER_INNERTOUGHT_EMPTYBIN_01";
+        choices[1] = "FEEDBACK_CLEANER_INNERTOUGHT_EMPTYBIN_02";
+        choices[2] = "FEEDBACK_CLEANER_INNERTOUGHT_EMPTYBIN_03";
+    }
+    else if (flags & 0x10)
