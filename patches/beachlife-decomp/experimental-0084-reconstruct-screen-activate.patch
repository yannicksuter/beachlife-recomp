diff --git a/src/startup_screen_activate.cpp b/src/startup_screen_activate.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_screen_activate.cpp
@@ -0,0 +1,18 @@
+#include "startup_screen_manager.h"
+#include "startup_screen_name_search.h"
+
+// FUNCTION: BEACHLIFE 0x004ae8f0
+void ScreenManager::ActivateScreens()
+{
+    CircularList& screens = active;
+    CircularListIterator found;
+    CircularListNode* node = FindScreenByName(&found, screens.Begin(), screens.End(), "ScenarioWon")->node;
+    if (node != screens.head)
+        return;
+
+    node = FindScreenByName(&found, screens.Begin(), screens.End(), "ScenarioLost")->node;
+    if (node != screens.head)
+        return;
+
+    RequestScreen("PauseBox", 0, 1);
+}
