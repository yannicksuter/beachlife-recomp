+#include "startup_screen_manager.h"
+#include <stdio.h>
+
+// FUNCTION: BEACHLIFE 0x004e4000
+void ScreenRequestGamePrefix::LoadScenarioProgress()
+{
+    unsigned int* words = words_70;
+    for (int i = 0; i < 12; ++i)
+        words[i] = 1;
+    words[0] = 4;
+    words[1] = 4;
+    words[2] = 2;
+    scenario_a0 = 0;
+
+    FILE* file = fopen(startup_game_state_path, "rb");
+    if (file)
+    {
+        if (fread(words, 0x30, 1, file) != 1)
+        {
+            for (int i = 0; i < 12; ++i)
+                words[i] = 1;
+            words[0] = 4;
+            words[1] = 4;
+            words[2] = 2;
+            scenario_a0 = 0;
+        }
+        fclose(file);
+    }
+
+    if (byte_a4)
+    {
+        scenario_a0 = 0;
+        return;
+    }
+
+    int last = -1;
+    for (int i = 0; i < 12; ++i)
+    {
+        if (static_cast<unsigned char>(words[i]) & 0x08)
+            last = i;
+    }
+    if (last == -1)
+    {
+        scenario_a0 = 0;
+        return;
+    }
+
+    scenario_a0 = last + 1;
+    if (scenario_a0 > 11)
+        scenario_a0 = 11;
+}
