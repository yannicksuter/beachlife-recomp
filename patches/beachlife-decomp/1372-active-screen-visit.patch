+#include "startup_active_screen_visit.h"
+
+// Folded traversal 0x004e8200, shared with VisitSavedPlacements.
+// FUNCTION: BEACHLIFE 0x004e8200 FOLDED
+ActiveScreenCallback VisitActiveScreens(CircularListIterator first,
+    CircularListIterator last, ActiveScreenCallback callback)
+{
+    while (first.node != last.node)
+    {
+        callback(static_cast<CircularListValueNode*>(first.node)->entry);
+        first.node = first.node->next;
+    }
+    return callback;
+}
