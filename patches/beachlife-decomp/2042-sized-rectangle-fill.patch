+// The rectangle FillSizedRectangle fills: the same fields as RenderRectangle,
+// but its callers' locals carry an empty destructor (an EH state of its own),
+// which the clip rectangles of SetScreenSize and friends do not have.
+struct SizedRectangle
+{
+    ~SizedRectangle()
+    {
+    }
+    int x;
+    int y;
+    int width;
+    int height;
+};
