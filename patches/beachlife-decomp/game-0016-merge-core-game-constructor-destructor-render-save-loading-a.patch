+#ifndef STARTUP_DIRECT_DRAW4_H
+#define STARTUP_DIRECT_DRAW4_H
+
+#include <windows.h>
+#include <ddraw.h>
+
+// DirectDraw 6 platform ABI used by the movie player (DDRAW.dll, dxguid). The
+// pinned VC6 SDK only declares interfaces up to IDirectDraw2; DX6-only
+// parameter structures stay opaque here.
+#ifndef DDSCL_FPUSETUP
+#define DDSCL_FPUSETUP 0x00000800
+#endif
+
+// IDirectDraw4 in DDRAW.dll slot order (slot offsets after IUnknown's three).
+struct IDirectDraw4 : public IUnknown
+{
+    STDMETHOD(Compact)() PURE;
+    STDMETHOD(CreateClipper)(DWORD flags, LPDIRECTDRAWCLIPPER* clipper, IUnknown* outer) PURE;
+    STDMETHOD(CreatePalette)(
+        DWORD flags, LPPALETTEENTRY entries, LPDIRECTDRAWPALETTE* palette, IUnknown* outer) PURE;
+    STDMETHOD(CreateSurface)(void* description, void** surface, IUnknown* outer) PURE;
+    STDMETHOD(DuplicateSurface)(void* surface, void** duplicate) PURE;
+    STDMETHOD(EnumDisplayModes)(
+        DWORD flags, void* description, LPVOID context, void* callback) PURE;
+    STDMETHOD(EnumSurfaces)(DWORD flags, void* description, LPVOID context, void* callback) PURE;
+    STDMETHOD(FlipToGDISurface)() PURE;
+    STDMETHOD(GetCaps)(LPDDCAPS driver, LPDDCAPS emulation) PURE;
+    STDMETHOD(GetDisplayMode)(void* description) PURE;
+    STDMETHOD(GetFourCCCodes)(LPDWORD count, LPDWORD codes) PURE;
+    STDMETHOD(GetGDISurface)(void** surface) PURE;
+    STDMETHOD(GetMonitorFrequency)(LPDWORD frequency) PURE;
+    STDMETHOD(GetScanLine)(LPDWORD line) PURE;
+    STDMETHOD(GetVerticalBlankStatus)(LPBOOL in_blank) PURE;
+    STDMETHOD(Initialize)(GUID* guid) PURE;
+    STDMETHOD(RestoreDisplayMode)() PURE;
+    STDMETHOD(SetCooperativeLevel)(HWND window, DWORD flags) PURE;
+    STDMETHOD(SetDisplayMode)(
+        DWORD width, DWORD height, DWORD bpp, DWORD refresh, DWORD flags) PURE;
+};
+
+// IDirectDrawSurface4 (DDRAW.dll). Only the IUnknown prefix is declared here;
+// its DX6 surface slots belong to the surface bodies that use them.
+struct IDirectDrawSurface4 : public IUnknown
+{
+};
+
+extern "C" const GUID IID_IDirectDraw4;
+
+#endif
