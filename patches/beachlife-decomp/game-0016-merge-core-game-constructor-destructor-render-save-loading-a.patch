+++ b/src/game_save_record_range_destructor.cpp
@@ -0,0 +1,31 @@
+#include "pool_chunk_acquire.h"
+#include "pool_lock_acquire.h"
+#include "pool_lock_guard.h"
+#include "startup_screen_manager.h"
+
+#include <new>
+
+// FUNCTION: BEACHLIFE 0x004e5400
+GameSaveRecordRange::~GameSaveRecordRange()
+{
+    // Library pointer-vector storage release; the save records are not freed here.
+    GameSaveRecord** storage = begin;
+    if (storage)
+    {
+        unsigned int bytes = static_cast<unsigned int>(capacity.data - storage) * sizeof(*storage);
+        if (bytes > 128)
+        {
+            ::operator delete(storage);
+        }
+        else
+        {
+            PoolChunkLink* volatile* bucket = pool_chunk_buckets + (bytes - 1) / 8;
+            AcquirePoolLock(&pool_lock_word);
+            // The returned pointer slots now become a live pool link.
+            PoolChunkLink* link = ::new (static_cast<void*>(storage)) PoolChunkLink;
+            link->next = *bucket;
+            *bucket = link;
+            pool_lock_word = 0;
+        }
+    }
+}
