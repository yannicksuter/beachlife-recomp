+
+// FUNCTION: BEACHLIFE 0x004e44e0
+void ScreenRequestGamePrefix::ProcessWordB4()
+{
+    // Load the save selected at word_b4; the listed records are released first.
+    unsigned int number = saves.begin[word_b4]->word_00;
+    for (GameSaveRecord** record = saves.begin; record != saves.end; ++record)
+    {
+        if (*record)
+            delete *record;
+    }
+    saves.Erase(saves.begin, saves.end);
+    save_info_enabled = 0;
+    word_b4 = -1;
+
+    char path[128];
+    sprintf(path, "%s/save%d.dat", startup_save_directory, number);
+    GameFileReader* file = new GameFileReader(0, path);
+
+    char text[128];
+    file->ReadString(text, 128);
+    if (strcmp(text, startup_save_signature) != 0)
+        StartupFatal("Attempted to load incorrect file");
+
+    float version;
+    file->ReadFloat(&version);
+    if (fabs(version - startup_save_version) > FLT_EPSILON)
+        StartupFatal("Save file has incorrect version number");
+
+    int header;
+    file->ReadInt(&header);
+    controller_selection.active->Exit();
+
+    int scenario;
+    int value;
+    float time;
+    file->ReadInt(&scenario);
+    file->ReadInt(&value);
+    file->ReadFloat(&time);
+    file->ReadFloat(&time);
+    file->ReadInt(&value);
+    file->ReadText(text, 64);
+    unsigned char flag;
+    file->ReadByte(&flag);
+    byte_a4 = flag;
+    LoadScenarioProgress();
+
+    controller_selection.active = controller_selection.first_controller;
+    scenario_a0 = scenario;
+    controller_selection.pending = controller_selection.first_controller;
+    controller_selection.first_controller->byte_9c = 1;
+    controller_selection.active->Enter();
+    screen_request_renderer->SetWord60(0);
+    window_deactivation_state->LoadState(file);
+    controller_selection.active->ControllerSlot24();
+    screen_manager->ApplyScreenLayout();
+    screen_manager->ApplyLoadedScenario();
+    delete file;
+}
