+#include <windows.h>
+
+#include "startup_direct_draw4.h"
+#include "startup_movie.h"
+
+// FUNCTION: BEACHLIFE 0x004ed1c0
+void StartupMovie::Initialize()
+{
+    if (DirectDrawCreate(0, &direct_draw, 0) != DD_OK)
+    {
+        return;
+    }
+    direct_draw->QueryInterface(IID_IDirectDraw4, reinterpret_cast<void**>(&direct_draw4));
+    DWORD flags = windowed ? DDSCL_NORMAL : DDSCL_FULLSCREEN | DDSCL_EXCLUSIVE;
+    if (direct_draw4->SetCooperativeLevel(static_cast<HWND>(window), flags | DDSCL_FPUSETUP) ==
+        DD_OK)
+    {
+        if (!windowed)
+        {
+            direct_draw4->SetDisplayMode(width, height, 16, 0, 0);
+        }
+    }
+    else
+    {
+        // The released interface pointer is kept (original quirk).
+        direct_draw4->Release();
+        ready = 0;
+    }
+    if (ready)
+    {
+        CreatePrimarySurface();
+        if (ready)
+        {
+            AttachBackBuffer();
+        }
+    }
+}
