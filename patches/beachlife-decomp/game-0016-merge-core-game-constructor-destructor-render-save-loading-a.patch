+#include <string.h>
+
+// LIBRARY: BEACHLIFE 0x004e80d0
+GameSaveRecord** GameSaveRecordRange::Erase(GameSaveRecord** first, GameSaveRecord** last)
+{
+    GameSaveRecord** old_end = end;
+    if (old_end == last)
+    {
+        end = first;
+        return first;
+    }
+
+    ptrdiff_t suffix_count = old_end - last;
+    GameSaveRecord** copied =
+        static_cast<GameSaveRecord**>(memmove(first, last, suffix_count * sizeof(*first)));
+    end = copied + suffix_count;
+    return first;
+}
