+    float far_distance = window_audio_state->FarDistance();
+    for (GameSoundNode* node = object_sounds_08.head->next; node != object_sounds_08.head;
+        node = node->next)
+    {
+        GameObjectSound* sound = static_cast<GameObjectSound*>(node->sound);
+        VariableWorldObject* object = variable_world->FindObject(sound->object_id);
+        if (!object)
+        {
+            continue;
+        }
+
+        WindowAudioVector listener = window_audio_state->position_e0;
+        float dx = listener.x - object->X();
+        float dy = listener.y - object->Y();
+        float vertical = dy - object->Unknown44();
+        float distance = static_cast<float>(sqrt(vertical * vertical + dx * dx));
+        if (sound->playing_28)
+        {
+            bool out_of_range = distance > far_distance;
+            if ((!sound->ignores_music_29 && window_audio_state->IsStreamPlaying() &&
+                    window_audio_state->stream_volume_10 > game_sound_music_level) ||
+                out_of_range)
+            {
+                window_audio_state->StopSound(sound->voice_2c, game_sound_stop_fade);
+                sound->playing_28 = 0;
+            }
+            else
+            {
+                float level =
+                    distance > far_distance ? 0.0f
+                    : distance < near_distance
+                        ? 1.0f
+                        : 1.0f - (distance - near_distance) / (far_distance - near_distance);
+                window_audio_state->FadeSoundLevel(
+                    sound->voice_2c, level * sound->volume_04, game_sound_level_fade);
+            }
+        }
+        else if (distance < far_distance)
+        {
+            if (sound->ignores_music_29 || !window_audio_state->IsStreamPlaying() ||
+                !(window_audio_state->stream_volume_10 > game_sound_music_level))
+            {
+                float level = distance < near_distance ? 1.0f
+                                                       : 1.0f - (distance - near_distance) /
+                                                                    (far_distance - near_distance);
+                float volume = level * sound->volume_04;
+                int voice = window_audio_state->PlaySoundAtLevel(
+                    sound->name_08, volume, 2, game_sound_start_fade);
+                sound->voice_2c = voice;
+                if (voice != -1)
+                {
+                    sound->playing_28 = 1;
+                }
+            }
+        }
+    }
+}
diff --git a/src/startup_game_point_sounds.cpp b/src/startup_game_point_sounds.cpp
