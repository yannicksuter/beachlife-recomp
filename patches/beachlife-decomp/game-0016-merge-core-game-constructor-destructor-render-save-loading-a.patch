+#include "startup_config_owner.h"
+#include "copy_trivial.h"
+
+#include <io.h>
+#include <new>
+#include <stdio.h>
+#include <windows.h>
+
+// The original reuses this 280-byte automatic storage first for the movie
+// pathname and later for the MSVCRT find record. Character access changes only
+// its object representation; no find-record member is read before _findfirst.
+typedef char GameConstructorFindRecordSize[(sizeof(_finddata_t) == 280) ? 1 : -1];
+
+// FUNCTION: BEACHLIFE 0x004e2530
+ScreenRequestGamePrefix::ScreenRequestGamePrefix(void* instance, void* window)
+    : ScreenGameRegistration(this)
+{
+    _finddata_t file_information;
+
+    inactive_c5 = 0;
+    controller_selection.instance = instance;
+    controller_selection.window = window;
+    reload_screen = 0;
+    word_b4 = -1;
+    save_info_enabled = 0;
+    byte_a4 = 0;
+    selected_save = 0;
+
+    scenario_names.end = static_cast<unsigned short**>(
+        CopyTrivial(scenario_names.end, scenario_names.end, scenario_names.begin));
+    saves.end = static_cast<GameSaveRecord**>(CopyTrivial(saves.end, saves.end, saves.begin));
+
+    placement = new ScreenPlacementStore;
+    switch (placement->menu_script_variant_3c)
+    {
+    case 0:
+        text = new ScreenTextLookup("data/text_uk.uni");
+        break;
+    case 1:
+        text = new ScreenTextLookup("data/text_french.uni");
+        break;
+    case 2:
+        text = new ScreenTextLookup("data/text_italian.uni");
+        break;
+    case 3:
+        text = new ScreenTextLookup("data/text_german.uni");
+        break;
+    case 4:
+        text = new ScreenTextLookup("data/text_spanish.uni");
+        break;
+    case 5:
+        text = new ScreenTextLookup("data/text_polish.uni");
+        break;
+    default:
+        text = new ScreenTextLookup("data/text_uk.uni");
+        break;
+    }
+
+    SetFatalWindow(window);
+    bool play_movie;
+    startup_config_owner->GetBool(&play_movie, "bPLAY_MOVIE");
+    if (play_movie)
+    {
+        while (ShowCursor(FALSE) >= 0)
+        {
+        }
+
+        char* movie_path = reinterpret_cast<char*>(&file_information);
+        sprintf(movie_path, "%s%s", startup_movie_directory, startup_movie_filename);
+        StartupMovie* movie = new StartupMovie(controller_selection.window, 0, 0, 640, 480, 0, 0);
+        movie->Play(movie_path);
+        if (movie)
+        {
+            movie->~StartupMovie();
+            ::operator delete(movie);
+        }
+
+        while (ShowCursor(TRUE) < 0)
+        {
+        }
+    }
+
+    // Game's window is Play's Video.
+    renderer = new ScreenRequestRenderer(*static_cast<beachlife::platform::Video*>(window), 800, 600, 0);
+    if (!renderer->initialized_168)
+        ShowFatalWindowMessage(controller_selection.window, screen_text_lookup->LookupText("ERROR_DIRECTX"));
+
+    const char* font_filename;
+    const char* font_name;
+    int font_size;
+    startup_config_owner->GetString(&font_filename, "sDEBUGFONT_FILENAME");
+    startup_config_owner->GetString(&font_name, "sDEBUGFONT_NAME");
+    startup_config_owner->GetInteger(&font_size, "iDEBUGFONT_SIZE");
+    if (*font_filename != 'X')
+        AddFontResourceA(font_filename);
+    debug_font = new DebugFont(font_name, static_cast<unsigned int>(font_size), 0);
+    if (*font_filename != 'X')
+        RemoveFontResourceA(font_filename);
+
+    input = new InputState(static_cast<int>(screen_request_renderer->width),
+        static_cast<int>(screen_request_renderer->height),
+        renderer->software_mode);
+    if (!input->Initialize(instance, window))
+        ShowFatalWindowMessage(controller_selection.window, screen_text_lookup->LookupText("ERROR_DIRECTX"));
+    if (!placement->byte_38)
+        startup_input_state->SetSystemCursor(0);
+
+    input_motion = new InputMotionState("data/cursor.tga", window);
+    clock = new FrameClock(static_cast<int>(GetTickCount()));
+    profiler = new StartupProfiler;
+    resources = new ScreenDialogResourceLookup;
+    word_60 = 0;
+
+    bool sound_enabled;
+    startup_config_owner->GetBool(&sound_enabled, "bSOUND_ENABLED");
+    audio = new WindowAudioState(static_cast<unsigned char>(sound_enabled), placement->provider_name_10, startup_sound_bank_name);
+    audio->SetStreamVolume(placement->sound_volume_08);
+    audio->SetEffectsVolume(placement->music_volume_0c);
+    update_pair = new GameUpdatePair(static_cast<unsigned char>(sound_enabled));
+    screens = new ScreenManager;
+
+    controller_selection.first_controller = new WorldTestController("WorldTest");
+    controller_selection.controllers[0] = new MainMenuController("MainMenu");
+    controller_selection.controllers[1] = new IntroController("Intro");
+    controller_selection.controllers[2] = new ExitGameController("ExitGame");
+    controller_selection.controllers[3] = new ResetGameController("ResetGame");
+    controller_selection.controllers[4] = new LoadGameController("LoadGame");
+    controller_selection.controllers[5] = new GameWonController("GameWon");
+
+    LoadScenarioNames();
+    LoadScenarioProgress();
+    controller_selection.active = controller_selection.controllers[1];
+    controller_selection.pending = controller_selection.controllers[1];
+    screen_request_renderer->SetUnscaledClip(0);
+
+    long find_handle = _findfirst("photos", &file_information);
+    if (find_handle == -1)
+        CreateDirectoryA("photos", 0);
+    _findclose(find_handle);
