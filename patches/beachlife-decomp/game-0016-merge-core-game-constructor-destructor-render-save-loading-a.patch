@@ -0,0 +1,66 @@
+#include "startup_game_update_pair.h"
+#include "window_audio.h"
+#include "window_audio_initialization.h"
+
+// Retry window for a point sound that could not start, 0.25 (0x004f4d30).
+extern const float game_sound_retry_delay;
+
+// FUNCTION: BEACHLIFE 0x004d2bd0
+void GameUpdatePair::UpdatePointSounds(float delta)
+{
+    if (!enabled_00)
+    {
+        return;
+    }
+
+    float far_distance = window_audio_state->FarDistance();
+    float far_squared = far_distance * far_distance;
+    WindowAudioVector listener = window_audio_state->position_e0;
+    GameSoundIterator it;
+    it.node = point_sounds_04.head->next;
+    while (it.node != point_sounds_04.head)
+    {
+        GamePointSound* sound = static_cast<GamePointSound*>(it.node->sound);
+        float dx = listener.x - sound->position_20.x;
+        float dy = listener.y - sound->position_20.y;
+        bool expired = true;
+        if (!(dy * dy + dx * dx > far_squared))
+        {
+            int voice = sound->voice_34;
+            if (voice == -1 || window_audio_state->VoiceStatus(voice) < sound->limit_30)
+            {
+                if (window_audio_state->PlaySoundAtPosition(
+                        sound->name_00, sound->volume_2c, &sound->position_20, 1, voice) == -1)
+                {
+                    // Keep a sound that could not start until its retry delay ends.
+                    if (sound->retrying_38)
+                    {
+                        if ((sound->retry_delay_3c -= delta) > 0.0f)
+                        {
+                            expired = false;
+                        }
+                    }
+                    else
+                    {
+                        sound->retrying_38 = 1;
+                        sound->retry_delay_3c = game_sound_retry_delay;
+                        expired = false;
+                    }
+                }
+            }
+        }
+
+        if (expired)
+        {
+            if (sound)
+            {
+                delete sound;
+            }
+            point_sounds_04.Erase(it++);
+        }
+        else
+        {
+            it.node = it.node->next;
+        }
+    }
+}
diff --git a/src/startup_game_refresh_save_records.cpp b/src/startup_game_refresh_save_records.cpp
