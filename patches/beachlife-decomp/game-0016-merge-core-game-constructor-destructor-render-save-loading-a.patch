diff --git a/src/game_load_scenario_names.cpp b/src/game_load_scenario_names.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9f922d46b370fe0d5f20bf559f3d13b3be798abb
--- /dev/null
+++ b/src/game_load_scenario_names.cpp
@@ -0,0 +1,92 @@
+#include <windows.h>
+#include <io.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <new>
+
+#include "copy_trivial.h"
+#include "pool_allocate.h"
+#include "pool_return.h"
+#include "startup_screen_manager.h"
+
+// Library max: the larger count by reference.
+inline const unsigned int& LargerCount(const unsigned int& left, const unsigned int& right)
+{
+    return left < right ? right : left;
+}
+
+// FUNCTION: BEACHLIFE 0x004e3dd0
+void ScreenRequestGamePrefix::LoadScenarioNames()
+{
+    // Library clear(): erase(begin, end) keeps the storage. The previous name
+    // strings are not freed (original leak).
+    scenario_names.end = static_cast<unsigned short**>(
+        CopyTrivial(scenario_names.end, scenario_names.end, scenario_names.begin));
+
+    char pattern[128];
+    _finddata_t found;
+    sprintf(pattern, "%s*.*", scenario_directory);
+    long handle = _findfirst(pattern, &found);
+    if (handle != -1)
+    {
+        do
+        {
+            if ((found.attrib & _A_SUBDIR) && strcmp(".", found.name) != 0 &&
+                strcmp("..", found.name) != 0)
+            {
+                unsigned short* name = new unsigned short[128];
+                MultiByteToWideChar(CP_ACP,
+                    MB_PRECOMPOSED,
+                    found.name,
+                    -1,
+                    name,
+                    static_cast<int>(strlen(found.name) + 1));
+
+                // Library push_back with the pooled allocator.
+                unsigned short** position = scenario_names.end;
+                if (position != scenario_names.capacity.data)
+                {
+                    ::new (position) unsigned short*(name);
+                    ++scenario_names.end;
+                }
+                else
+                {
+                    unsigned int size = static_cast<unsigned int>(position - scenario_names.begin);
+                    unsigned int one = 1;
+                    unsigned int length = size + LargerCount(size, one);
+                    unsigned short** storage = 0;
+                    if (length != 0)
+                    {
+                        unsigned int bytes = length * sizeof(unsigned short*);
+                        storage = static_cast<unsigned short**>(
+                            bytes > 128 ? ::operator new(bytes) : AllocatePoolBytes(bytes));
+                    }
+                    unsigned short** stored = static_cast<unsigned short**>(
+                        CopyTrivial(scenario_names.begin, position, storage));
+                    *stored = name;
+                    ++stored;
+                    unsigned short** previous = scenario_names.begin;
+                    if (previous)
+                    {
+                        unsigned int previous_bytes =
+                            static_cast<unsigned int>(scenario_names.capacity.data - previous) *
+                            sizeof(unsigned short*);
+                        if (previous_bytes > 128)
+                        {
+                            ::operator delete(previous);
+                        }
+                        else
+                        {
+                            ReturnPool(previous, previous_bytes);
+                        }
+                    }
+                    scenario_names.begin = storage;
+                    scenario_names.end = stored;
+                    scenario_names.capacity.data = storage + length;
+                }
+            }
+        } while (_findnext(handle, &found) != -1);
+    }
+    _findclose(handle);
+}
diff --git a/src/game_save_record_range_destructor.cpp b/src/game_save_record_range_destructor.cpp
