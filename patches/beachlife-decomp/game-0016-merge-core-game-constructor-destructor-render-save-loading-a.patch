+
+namespace
+{
+// The original expanded sort compares the +04 words unsigned, descending.
+struct SaveRecordNewer
+{
+    bool operator()(const GameSaveRecord* left, const GameSaveRecord* right) const
+    {
+        return static_cast<unsigned int>(left->time_04) > static_cast<unsigned int>(right->time_04);
+    }
+};
+} // namespace
+
+// FUNCTION: BEACHLIFE 0x004e4740
+void ScreenRequestGamePrefix::RefreshSaveRecords()
+{
+    GameSaveRecord** current = saves.begin;
+    while (current != saves.end)
+    {
+        GameSaveRecord* record = *current;
+        if (record)
+        {
+            ::operator delete(record);
+        }
+        ++current;
+    }
+    saves.Erase(saves.begin, saves.end);
+    save_info_enabled = 0;
+
+    char pattern[128];
+    _finddata_t found;
+    sprintf(pattern, "%s/save*.dat", startup_save_directory);
+    long handle = _findfirst(pattern, &found);
+    long status = handle;
+    while (status != -1)
+    {
+        // These original branches do not advance enumeration.
+        if (strcmp(found.name, ".") == 0 || strcmp(found.name, "..") == 0)
+        {
+            continue;
+        }
+
+        int number = atoi(found.name + 4);
+        char path[128];
+        sprintf(path, "%s/%s", startup_save_directory, found.name);
+        FILE* probe = fopen(path, "rb");
+        if (probe)
+        {
+            fclose(probe);
+            // Only a failed construction releases the pending allocation.
+            // Later read/append failures do not acquire a cleanup guard.
+            GameFileReader* file = new GameFileReader(0, path);
+            char signature[128];
+            file->ReadString(signature, 128);
+            bool signature_matches = strcmp(signature, startup_save_signature) == 0;
+            float version;
+            file->ReadFloat(&version);
+            // A NaN version is unordered and is not rejected by the original.
+            // Widen before subtraction to retain its unrounded comparison near
+            // the exact binary32 version and epsilon boundary.
+            if (!(fabs(static_cast<double>(version) - startup_save_version) > FLT_EPSILON) &&
+                signature_matches)
+            {
+                GameSaveRecord* record = new GameSaveRecord;
+                record->word_00 = static_cast<unsigned int>(number);
+                int timestamp;
+                file->ReadInt(&timestamp);
+                record->time_04 = timestamp;
+                int scenario;
+                file->ReadInt(&scenario);
+                record->word_08 = static_cast<unsigned int>(scenario);
+                int value;
+                file->ReadInt(&value);
+                record->day_0c = value;
+                float time;
+                file->ReadFloat(&time);
+                record->time_10 = time;
+                file->ReadFloat(&time);
+                record->cash_14 = time;
+                file->ReadInt(&value);
+                record->guests_18 = value;
+                file->ReadText(record->name_1c, 64);
+                unsigned char ignored_flag;
+                file->ReadByte(&ignored_flag);
+
+                GameSaveRecord** position = saves.end;
+                if (position != saves.capacity.data)
+                {
+                    if (position)
+                    {
+                        ::new (position) GameSaveRecord*(record);
+                    }
+                    ++saves.end;
+                }
+                else
+                {
+                    saves.InsertOverflow(position, record, GameSaveRecordTrueType(), 1, true);
+                }
+            }
+            delete file;
+        }
+        status = _findnext(handle, &found);
+    }
+    _findclose(handle);
+
+    GameSaveRecord** last = saves.end;
+    GameSaveRecord** first = saves.begin;
+    if (first != last)
+    {
+        std::sort(first, last, SaveRecordNewer());
+    }
+}
