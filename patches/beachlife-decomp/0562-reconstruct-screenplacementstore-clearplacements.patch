diff --git a/src/startup_screen_placement_clear.cpp b/src/startup_screen_placement_clear.cpp
new file mode 100644
index 0000000..b698d11
--- /dev/null
+++ b/src/startup_screen_placement_clear.cpp
@@ -0,0 +1,22 @@
+#include "pool_return.h"
+#include "startup_screen_placement.h"
+#include "startup_screen_placement_visit.h"
+
+// FUNCTION: BEACHLIFE 0x004e68f0
+void ScreenPlacementStore::ClearPlacements()
+{
+    // Free every saved placement, then release the nodes but keep the sentinel.
+    VisitSavedPlacements(saved.Begin(), saved.End(), DeleteSavedPlacement);
+    CircularListNode* node = saved.head->next;
+    while (node != saved.head)
+    {
+        CircularListNode* released = node;
+        node = node->next;
+        if (released != 0)
+        {
+            ReturnPool(released, sizeof(SavedScreenPlacementNode));
+        }
+    }
+    saved.head->next = saved.head;
+    saved.head->previous = saved.head;
+}
