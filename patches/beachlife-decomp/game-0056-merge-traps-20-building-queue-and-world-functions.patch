+static void PostWorkerFeedback(WorldStaffEntity* staff, unsigned int& pending,
+    unsigned int& last, unsigned int mask, unsigned char message_kind, const char* icon)
+{
+    last = pending | mask;
+    pending = 0;
+    const char* message = staff->Notification(last);
+    if (message)
+        window_deactivation_state->ticker_30->AddMessage(message, staff->id_28, message_kind);
+    staff->AddThought(last);
+    screen_manager->SetNamedItemState(icon, 0);
+}
+
+static void PostLowMorale(WorldStaffEntity* staff, unsigned int& tested, unsigned int& pending)
+{
+    if (!(tested & 0x800000) && staff->morale_10c < 0.6f)
+    {
+        tested |= 0x800000;
+        pending |= 0x800000;
+        window_deactivation_state->ticker_30->AddMessage(staff->Notification(0x100000), staff->id_28, 7);
+        staff->AddThought(0x800000);
+    }
