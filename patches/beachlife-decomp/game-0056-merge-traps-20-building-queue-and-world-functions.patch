+}
+
+template <class Record>
+static CircularListNode* FindCleaningRecord(CircularList& list, unsigned int id)
+{
+    CircularListNode* node = list.head->next;
+    while (node != list.head && static_cast<unsigned int>(CleaningRecord<Record>(node)->id_00) != id)
