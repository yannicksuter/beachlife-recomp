+    unsigned char urgent = CleaningRecord<WorldCleaningAssignment>(node)->flag_05;
+    RemoveAssignment(id);
+    variable_world->FindObject(id)->SetFlag5a(0);
+    if (urgent)
+        RequestCleaning(id);
+    else
+        AddCleaningRequest(id);
+}
+
+// FUNCTION: BEACHLIFE 0x0041fe30
+unsigned int WorldCleaningManager::FindUrgentTask(const ScreenWorldPosition* position,
+    unsigned int* kind, unsigned char bins, unsigned char litter, unsigned char toilets)
+{
+    CircularListNode* selected = 0;
+    for (CircularListNode* node = requests_00.head->next; node != requests_00.head; node = node->next)
+    {
+        WorldCleaningRequest* request = CleaningRecord<WorldCleaningRequest>(node);
+        if (request->time_08 == 0.0f || !request->flag_0c)
+            continue;
+        WorldStaticEntity* entity = static_cast<WorldStaticEntity*>(variable_world->FindObject(request->id_00));
+        if (entity->NeedsCleaning())
+            continue;
+        if (std::strcmp(entity->name_06, "Bin") == 0)
+        {
+            if (!bins || static_cast<WorldSceneryEntity*>(entity)->byte_a0 || entity->NeedsRepair())
+                continue;
+        }
+        else if (entity->kind_2c == 2)
+        {
+            if (!toilets || entity->FlagAt00460310() || entity->FlagAt00460340())
+                continue;
+        }
+        else if (!litter)
+            continue;
+        selected = node;
+    }
+    if (!selected)
+        return ~0u;
+    unsigned int id = CleaningRecord<WorldCleaningRequest>(selected)->id_00;
+    *kind = ~0u;
+    VariableEntity* entity = variable_world->FindObject(id);
+    if (std::strcmp(entity->name_06, "Litter") == 0)
+        *kind = 0;
+    else if (std::strcmp(entity->name_06, "Bin") == 0)
+        *kind = 1;
+    else if (std::strcmp(entity->name_06, "LOO") == 0)
+        *kind = 2;
+    AddAssignment(id, 1);
+    entity->SetFlag5a(1);
+    delete CleaningRecord<WorldCleaningRequest>(selected);
+    CircularListIterator iterator;
+    iterator.node = selected;
+    requests_00.Erase(iterator);
+    return id;
+}
+
+// FUNCTION: BEACHLIFE 0x00420070
+unsigned int WorldCleaningManager::FindTask(const ScreenWorldPosition* position,
+    unsigned int* kind, unsigned char bins, unsigned char litter, unsigned char toilets)
+{
+    if (requests_00.Empty())
+        return ~0u;
+    ScreenPoint tile = overlay_map->WorldToTile(position);
+    int best_score = 99999;
+    int score;
+    unsigned int candidate_kind;
+    CircularListNode* selected = 0;
+    for (CircularListNode* node = requests_00.head->next; node != requests_00.head;)
+    {
+        WorldCleaningRequest* request = CleaningRecord<WorldCleaningRequest>(node);
+        WorldStaticEntity* entity = static_cast<WorldStaticEntity*>(variable_world->FindObject(request->id_00));
+        if (!entity)
+        {
+            delete request;
+            CircularListIterator iterator;
+            iterator.node = node;
+            node = node->next;
+            requests_00.Erase(iterator);
+            continue;
+        }
+        ScreenPoint target = entity->TilePosition();
+        int distance = std::abs(target.y - tile.y) + std::abs(target.x - tile.x);
+        if (std::strcmp(entity->name_06, "Litter") == 0)
+        {
+            score = distance - 50;
+            candidate_kind = 0;
+        }
+        else if (std::strcmp(entity->name_06, "Bin") == 0)
+        {
+            score = distance - 70;
+            candidate_kind = 1;
+        }
+        else if (std::strcmp(entity->name_06, "LOO") == 0)
+        {
+            score = distance - 100;
+            candidate_kind = 2;
+        }
+        if (score < best_score)
+        {
+            bool eligible = false;
+            switch (candidate_kind)
+            {
+            case 0:
+                eligible = litter && !entity->NeedsCleaning();
+                break;
+            case 1:
+                eligible = bins && !static_cast<WorldSceneryEntity*>(entity)->byte_a0
+                        && (!entity->NeedsCleaning() || !entity->NeedsRepair());
+                break;
+            case 2:
+                eligible = toilets && !entity->FlagAt00460310() && !entity->FlagAt00460340()
+                        && !entity->NeedsCleaning() && !entity->NeedsRepair();
+                break;
+            }
+            if (eligible)
+            {
+                selected = node;
+                best_score = score;
+                *kind = candidate_kind;
+            }
+        }
+        node = node->next;
+    }
+    if (!selected)
+        return ~0u;
+    unsigned int id = CleaningRecord<WorldCleaningRequest>(selected)->id_00;
+    AddAssignment(id, 0);
+    variable_world->FindObject(id)->SetFlag5a(1);
+    delete CleaningRecord<WorldCleaningRequest>(selected);
+    CircularListIterator iterator;
+    iterator.node = selected;
+    requests_00.Erase(iterator);
+    return id;
+}
