+
+static long double RoutePointDistance(ScreenWorldPosition origin, ScreenWorldPosition position,
+    bool round_components, bool forward_sum = false)
+{
+    long double x = static_cast<long double>(origin.x) - position.x;
+    long double y = static_cast<long double>(origin.y) - position.y;
+    long double z = static_cast<long double>(origin.z) - position.z;
+    if (round_components)
+    {
+        x = static_cast<float>(x);
+        y = static_cast<float>(y);
+        z = static_cast<float>(z);
+    }
+    if (forward_sum)
+        return std::sqrt(x * x + y * y + z * z);
+    return std::sqrt(z * z + y * y + x * x);
+}
+
+static unsigned int NearestTerrainRoute(ScreenTerrainGrid* terrain,
+    ScreenTerrainRouteNode* routes, ScreenWorldPosition position)
+{
+    ScreenPoint tile = terrain->WorldToTile(position);
+    unsigned int result = ~0u;
+    unsigned int index = 0;
+    for (ScreenTerrainRouteNode* route = routes; route; route = route->next_30, ++index)
+    {
+        if (tile.x >= static_cast<int>(route->words_04[0])
+            && tile.x <= static_cast<int>(route->words_04[6])
+            && tile.y >= static_cast<int>(route->words_04[1])
+            && tile.y <= static_cast<int>(route->words_04[7]))
+            result = index;
+    }
+    if (result != ~0u)
+        return result;
+
+    ScreenPoint* points = static_cast<ScreenPoint*>(routes->data_00);
+    ScreenPoint nearest = points[0];
+    result = 0;
+    for (unsigned int i = 1; i < routes->count_28; ++i)
+    {
+        float distance = static_cast<float>(RoutePointDistance(
+            terrain->TileOrigin(points[i].x, points[i].y), position, false));
+        if (RoutePointDistance(terrain->TileOrigin(nearest.x, nearest.y), position, true) > distance)
+            nearest = points[i];
+    }
+    index = 1;
+    for (ScreenTerrainRouteNode* route = routes->next_30; route; route = route->next_30, ++index)
+    {
+        points = static_cast<ScreenPoint*>(route->data_00);
+        for (unsigned int i = 0; i < route->count_28; ++i)
+        {
+            float distance = static_cast<float>(RoutePointDistance(
+                terrain->TileOrigin(points[i].x, points[i].y), position, true));
+            if (RoutePointDistance(terrain->TileOrigin(nearest.x, nearest.y), position, true, true) > distance)
+            {
+                nearest = points[i];
+                result = index;
+            }
+        }
+    }
+    return result;
+}
+
+// FUNCTION: BEACHLIFE 0x00446d90
+int ScreenTerrainGrid::NearestRouteIndex(ScreenWorldPosition position)
+{
+    return NearestTerrainRoute(this, routes_1c, position);
+}
+
+// FUNCTION: BEACHLIFE 0x00447120
+unsigned int ScreenTerrainGrid::InfluenceAreaAt(ScreenWorldPosition position)
+{
+    return NearestTerrainRoute(this, routes_20, position);
+}
