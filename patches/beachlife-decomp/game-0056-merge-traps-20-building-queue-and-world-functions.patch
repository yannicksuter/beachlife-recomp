+}
+
+// FUNCTION: BEACHLIFE 0x0042b9a0
+template <>
+ScreenContextRowIterator WorldDequeStorage<VariableThought*, ScreenContextRowIterator>::Erase(ScreenContextRowIterator position)
+{
+    int index = WorldDequeDistance(position, begin);
+    unsigned int size = WorldDequeDistance(end, begin);
+    if (static_cast<unsigned int>(index) < size / 2)
+    {
+        for (int i = index; i > 0; --i)
+            At(i) = At(i - 1);
+        if (begin.current == begin.last - 1)
+        {
+            FreeSlots(begin.first, 32 * sizeof(VariableThought*));
+            ++begin.node;
+            begin.first = *begin.node;
+            begin.last = begin.first + 32;
+            begin.current = begin.first;
+        }
+        else
+            ++begin.current;
+    }
+    else
+    {
+        for (unsigned int i = index; i + 1 < size; ++i)
+            At(i) = At(i + 1);
+        if (end.current == end.first)
+        {
+            FreeSlots(end.first, 32 * sizeof(VariableThought*));
+            --end.node;
+            end.first = *end.node;
+            end.last = end.first + 32;
+            end.current = end.last;
+        }
+        --end.current;
+    }
+    return WorldDequeAdvance(begin, index);
+}
+
+// FUNCTION: BEACHLIFE 0x00426a10
+template <>
+WorldDequeIterator<WorldEventRecord*> WorldDequeStorage<WorldEventRecord*>::Insert(
+    WorldDequeIterator<WorldEventRecord*> position, WorldEventRecord* const& source)
+{
+    if (position.current == begin.current)
+    {
+        WorldDequePushFront(*this, source);
+        return begin;
+    }
+    if (position.current == end.current)
+    {
+        WorldDequePushBack(*this, source);
+        return WorldDequeAdvance(end, -1);
+    }
+    WorldEventRecord* value = source;
+    int index = WorldDequeDistance(position, begin);
+    unsigned int size = WorldDequeDistance(end, begin);
+    if (index < static_cast<int>(size / 2))
+    {
+        WorldDequePushFront(*this, *begin.current);
+        for (int i = 1; i < index; ++i)
+            At(i) = At(i + 1);
+    }
+    else
+    {
+        WorldDequePushBack(*this, *WorldDequeAdvance(end, -1).current);
+        for (int i = size - 1; i > index; --i)
+            At(i) = At(i - 1);
+    }
+    position = WorldDequeAdvance(begin, index);
+    *position.current = value;
+    return position;
+}
