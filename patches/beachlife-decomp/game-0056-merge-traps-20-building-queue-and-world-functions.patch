+// FUNCTION: BEACHLIFE 0x0041fae0
+void WorldCleaningManager::AddCleaningRequest(unsigned int id)
+{
+    variable_world->FindObject(id);
+    CircularListNode* node = FindCleaningRecord<WorldCleaningRequest>(requests_00, id);
+    if (node != requests_00.head)
+    {
+        ++CleaningRecord<WorldCleaningRequest>(node)->count_04;
+        return;
+    }
+    WorldCleaningRequest* request = new (std::nothrow) WorldCleaningRequest;
+    request->count_04 = 0;
+    request->id_00 = id;
+    request->time_08 = window_deactivation_state->clock_158;
