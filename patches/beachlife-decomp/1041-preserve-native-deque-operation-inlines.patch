-template <class Iterator>
-static Iterator WorldDequeAdvance(Iterator position, int count)
-{
-    int offset = static_cast<int>(position.current - position.first) + count;
-    if (offset >= 0 && offset < 32)
-        position.current += count;
-    else
-    {
-        int block = offset > 0 ? offset / 32 : (offset + 1) / 32 - 1;
-        position.node += block;
-        position.first = *position.node;
-        position.last = position.first + 32;
-        position.current = position.first + offset - block * 32;
-    }
-    return position;
-}
