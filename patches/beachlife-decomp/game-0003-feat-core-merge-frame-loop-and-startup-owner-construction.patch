+++ b/src/startup_game_update.cpp
@@ -0,0 +1,68 @@
+#include <windows.h>
+#include "startup_frame_clock.h"
+#include "startup_game_update_pair.h"
+#include "startup_input_motion.h"
+#include "startup_input_state.h"
+#include "startup_screen_manager.h"
+#include "window_activation.h"
+#include <stdio.h>
+
+// FUNCTION: BEACHLIFE 0x004e3900
+void ScreenRequestGamePrefix::Update()
+{
+    if (controller_selection.active != controller_selection.pending)
+    {
+        controller_selection.active->Exit();
+        controller_selection.active = controller_selection.pending;
+        controller_selection.active->Enter();
+        unsigned long ticks = GetTickCount();
+        clock->Update(static_cast<int>(ticks));
+        startup_input_state->ResetTransition();
+    }
+
+    if (controller_selection.active == controller_selection.controllers[0] && word_b4 != -1)
+    {
+        ProcessWordB4();
+    }
+
+    UpdateBeforeInput();
+    unsigned long ticks = GetTickCount();
+    clock->Update(static_cast<int>(ticks));
+    input->Poll();
+    controller_selection.active->Update();
+    input_motion->Update();
+
+    float delta = startup_frame_clock->delta_seconds;
+    screens->Update(delta);
+    audio->Update(delta);
+    update_pair->Update(delta);
+
+    if (input->IsStateTwo(0x2a) && input->IsStateOne(0x16) && input->IsStateTwo(0x38) &&
+        !window_deactivation_state)
+    {
+        unsigned int* words = words_70;
+        if (!byte_a4)
+        {
+            for (int i = 0; i < 12; ++i)
+            {
+                words[i] = 2;
+            }
+            words[0] = 4;
+            words[1] = 4;
+        }
+        else
+        {
+            for (int i = 0; i < 12; ++i)
+            {
+                words[i] = 8;
+            }
+        }
+
+        FILE* file = fopen(startup_game_state_path, "wb");
+        if (file)
+        {
+            fwrite(words, 0x30, 1, file);
+            fclose(file);
+        }
+    }
+}
