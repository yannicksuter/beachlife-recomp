+#include "window_audio.h"
+#include "window_sound_voice.h"
+#include "miles_imports.h"
+
+#include <math.h>
+
+namespace
+{
+int SoundVolume(long double level)
+{
+    if (!(level >= 0.0L))
+        level = 0.0L;
+    else if (level > 1.0L)
+        level = 1.0L;
+    int volume = static_cast<int>(level * 127.0L);
+    if (volume < 3)
+        volume = 0;
+    return volume;
+}
+} // namespace
+
+// FUNCTION: BEACHLIFE 0x004cf740
+int WindowAudioState::PlaySoundAtLevel(const char* name, float level, unsigned int flags, float fade)
+{
+    int volume = SoundVolume(static_cast<long double>(level) * scale_d8);
+    return PlaySoundWithParameters(name, volume, flags, fade, level);
+}
+
+// FUNCTION: BEACHLIFE 0x004cf8f0
+int WindowAudioState::PlaySoundAtPosition(const char* name, float level,
+    const WindowAudioVector* position, unsigned int flags, int voice)
+{
+    long double adjusted = static_cast<long double>(level) * scale_d8;
+    int volume = SoundVolume(adjusted);
+    if (enabled_3d)
+        return Play3DSoundWithParameters(name, volume, position, flags, voice);
+
+    float far_distance = value_f0;
+    float near_distance = value_ec;
+    long double dx = static_cast<long double>(position_e0.x) - position->x;
+    long double dy = static_cast<long double>(position_e0.y) - position->y;
+    long double distance = sqrtl(dx * dx + dy * dy);
+    float stored_distance = static_cast<float>(distance);
+    long double attenuation;
+    bool audible = true;
+    if (distance > far_distance)
+    {
+        attenuation = 0.0L;
+        audible = false;
+    }
+    else if (!(stored_distance >= near_distance))
+        attenuation = 1.0L;
+    else
+        attenuation = 1.0L - (static_cast<long double>(stored_distance) - near_distance) / (static_cast<long double>(far_distance) - near_distance);
+
+    float attenuated = static_cast<float>(attenuation * adjusted);
+    if (!audible)
+        return -1;
+    volume = SoundVolume(attenuated);
+    return PlaySoundWithParameters(name, volume, flags, 0.0f, attenuated);
+}
+
+// FUNCTION: BEACHLIFE 0x004cfac0
+int WindowAudioState::VoiceStatus(int voice)
+{
+    if (!enabled)
+        return 0;
+    int count = 0;
+    for (int i = 0; i < 24; ++i)
+    {
+        WindowSoundVoice* current = i < 16 ? voices_74[i] : voices_b4[i - 16];
+        if (current && current->word_30 == voice)
+            ++count;
+    }
+    return count;
+}
+
+// FUNCTION: BEACHLIFE 0x004cfb90
+void WindowAudioState::FadeSoundLevel(int voice, float level, float fade)
+{
+    if (voice < 0)
+        return;
+    WindowSoundVoice* current = voice < 16 ? voices_74[voice] : voices_b4[voice - 16];
+    if (!current)
+        return;
+    int volume = SoundVolume(static_cast<long double>(level) * scale_d8);
+    current->volume_18 = static_cast<float>(volume);
+    current->scale_14 = level;
+    current->word_10 = 1;
+    current->fade_28 = fade;
+    current->fade_24 = fade;
+    int initial_volume = 0;
+    if (voice < 16 ? voices_74[voice] != 0 : voices_b4[voice - 16] != 0)
+    {
+        if (voice < 16)
+            initial_volume = AIL_sample_volume(samples_14[voice]);
+        else
+            initial_volume = AIL_3D_sample_volume(samples_54[voice - 16]);
+    }
+    current->word_1c = static_cast<float>(initial_volume);
+    current->word_20 = static_cast<float>(initial_volume);
+}
+
+// FUNCTION: BEACHLIFE 0x004cfc80
+void WindowAudioState::StopSound(int voice, float fade)
+{
+    if (voice < 0)
+        return;
+    WindowSoundVoice* current = voice < 16 ? voices_74[voice] : voices_b4[voice - 16];
+    if (!current)
+        return;
+    current->fade_28 = fade;
+    current->fade_24 = fade;
+    current->volume_18 = 0.0f;
+    current->word_10 = 2;
+    int initial_volume = 0;
+    if (voice < 16 ? voices_74[voice] != 0 : voices_b4[voice - 16] != 0)
+    {
+        if (voice < 16)
+            initial_volume = AIL_sample_volume(samples_14[voice]);
+        else
+            initial_volume = AIL_3D_sample_volume(samples_54[voice - 16]);
+    }
+    current->word_1c = static_cast<float>(initial_volume);
+    current->word_20 = static_cast<float>(initial_volume);
+}
+
+// FUNCTION: BEACHLIFE 0x004cfee0
+bool WindowAudioState::IsStreamPlaying()
+{
+    if (enabled && stream)
+    {
+        int status = AIL_stream_status(stream);
+        if (status == 4 || status == 8)
+            return true;
+    }
+    return false;
+}
