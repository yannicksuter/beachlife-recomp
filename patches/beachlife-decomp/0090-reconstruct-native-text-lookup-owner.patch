+// The existing BLE loader owns a char array. Read its little-endian code units
+// through bytes rather than imposing a wchar_t/unsigned-short array lifetime.
+unsigned short ReadUnit(const char* bytes)
+{
+    return static_cast<unsigned short>(static_cast<unsigned char>(bytes[0])
+                                       | (static_cast<unsigned int>(static_cast<unsigned char>(bytes[1])) << 8));
+}
