+    // temporary has a genuine wchar_t lifetime; Windows qualification is later.
+    std::unique_ptr<wchar_t[]> wide(new wchar_t[bytes]);
+    for (int index = 0; index < bytes; ++index)
+        wide[index] = static_cast<wchar_t>(ReadUnit(start + index * 2));
+    WideCharToMultiByte(CP_ACP, 0, wide.get(), -1, key, bytes, 0, 0);
+#else
+    // The non-Windows source domain is ASCII keys, not arbitrary CP_ACP.
+    // Reject unsupported conversion rather than silently replacing code units.
+    for (int index = 0; index < bytes; ++index)
+    {
+        unsigned short unit = ReadUnit(start + index * 2);
+        if (unit > 0x7f)
+            throw std::domain_error("language key requires Windows ACP conversion");
