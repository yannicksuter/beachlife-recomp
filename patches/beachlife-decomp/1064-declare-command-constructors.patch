+#include "startup_screen_command_inlines.h"
+#include <new>
+
+// Emits the shared out-of-line constructor bodies once, from an /Ob1 source.
+// Retail callers that do not expand them call these copies.
+#pragma inline_depth(0)
+
+void EmitScreenModeCommandConstructors(void* storage, int word, float number)
+{
+    new (storage) ScreenModeCommand(word, word, word, word, word);
+    new (storage) ScreenModeCommand(word, word, word, word, word, number, word);
+}
