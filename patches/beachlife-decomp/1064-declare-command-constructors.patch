+#ifndef STARTUP_SCREEN_COMMAND_INLINES_H
+#define STARTUP_SCREEN_COMMAND_INLINES_H
+
+#include "startup_screen_mode_world.h"
+
+// Include only from /Ob1 sources: an /Ob0 source would emit a different
+// out-of-line copy with a vector constructor call for the words.
+
+// FUNCTION: BEACHLIFE 0x00466030
+inline ScreenModeCommand::ScreenModeCommand(int sender, int recipient, int kind, int first, int second)
+{
+    words[0] = sender;
+    words[1] = recipient;
+    words[2] = kind;
+    words[3] = first;
+    words[4] = second;
+}
+
+// FUNCTION: BEACHLIFE 0x00472cb0
+inline ScreenModeCommand::ScreenModeCommand(
+    int sender, int recipient, int kind, int first, int second, float number, int activity)
+{
+    words[0] = sender;
+    words[1] = recipient;
+    words[2] = kind;
+    words[3] = first;
+    words[4] = second;
+    words[6].number = number;
+    words[5] = activity;
+}
+
+#endif
