diff --git a/src/startup_jpeg_export.cpp b/src/startup_jpeg_export.cpp
new file mode 100644
--- /dev/null
+++ b/src/startup_jpeg_export.cpp
@@ -0,0 +1,36 @@
+#include "startup_jpeg_export.h"
+#include "startup_screen_item.h"
+
+#include "runtime/jpeg_export.h"
+
+// Game globals 0x005bb0b0 and 0x005bb0a8, with native codec-state storage.
+JpegExportState jpeg_export_properties;
+int jpeg_export_result;
+
+// FUNCTION: BEACHLIFE 0x004ebfa0
+void ExportJpegImage(const ScreenRectangle* area, unsigned char* pixels, const char* path, int quality)
+{
+    // The real host encoder needs no IJL heap context. Preserve the original
+    // game's field publication order and both rectangle-extent evaluations.
+    jpeg_export_properties.dib_width = area->right - area->left;
+    jpeg_export_properties.dib_height = area->bottom - area->top;
+    jpeg_export_properties.dib_bytes = pixels;
+    jpeg_export_properties.dib_pad_bytes = 0;
+    jpeg_export_properties.dib_channels = 3;
+    jpeg_export_properties.dib_color = 1;
+    jpeg_export_properties.jpg_file = path;
+    jpeg_export_properties.jpg_width = area->right - area->left;
+    jpeg_export_properties.jpg_height = area->bottom - area->top;
+    jpeg_export_properties.jpg_channels = 3;
+    jpeg_export_properties.jpg_color = 3;
+    jpeg_export_properties.jpg_subsampling = 1;
+    jpeg_export_properties.quality = quality;
+    // Original IJL value1 is Y(2,2), Cb/Cr(1,1), commonly named 4:2:0.
+    // Encoding and real file cleanup complete before publishing the result.
+    jpeg_export_result = static_cast<int>(beachlife::runtime::jpeg::write_rgb420_file(
+        jpeg_export_properties.jpg_file,
+        jpeg_export_properties.dib_bytes,
+        jpeg_export_properties.jpg_width,
+        jpeg_export_properties.jpg_height,
+        jpeg_export_properties.quality));
+}
diff --git a/src/startup_jpeg_export.h b/src/startup_jpeg_export.h
new file mode 100644
--- /dev/null
+++ b/src/startup_jpeg_export.h
@@ -0,0 +1,34 @@
+#ifndef STARTUP_JPEG_EXPORT_H
+#define STARTUP_JPEG_EXPORT_H
+
+struct ScreenRectangle;
+
+// Native storage for the game's observed export settings. This is not the
+// original IJL structure, whose private codec state is larger than this prefix.
+// The codec service uses its real stack state and FILE ownership separately.
+struct JpegExportState
+{
+    unsigned char* dib_bytes;
+    unsigned int dib_width;
+    int dib_height;
+    unsigned int dib_pad_bytes;
+    unsigned int dib_channels;
+    int dib_color;
+    const char* jpg_file;
+    unsigned int jpg_width;
+    unsigned int jpg_height;
+    unsigned int jpg_channels;
+    int jpg_color;
+    int jpg_subsampling;
+    unsigned int quality;
+};
+
+extern JpegExportState jpeg_export_properties;
+extern int jpeg_export_result;
+
+// Actual cdecl 0x004ebfa0. The native codec boundary preserves the capture
+// caller's positive tightly packed RGB dimensions, quality100 and 2x2 sampling.
+// Input pointers are borrowed and remain recorded after return, as originally.
+void ExportJpegImage(const ScreenRectangle* area, unsigned char* pixels, const char* path, int quality);
+
+#endif
