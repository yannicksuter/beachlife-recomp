+namespace
+{
+// Appends to the end of a singly linked action list.
+inline void AppendToList(WorldSubsystem20::Action*& list, WorldSubsystem20::Action* action)
+{
+    if (!list)
+    {
+        list = action;
+        return;
+    }
+    WorldSubsystem20::Action* last = list;
+    while (last->next)
+        last = last->next;
+    last->next = action;
+}
+} // namespace
+
+// FUNCTION: BEACHLIFE 0x004db030
+void WorldSubsystem20::Group::AddCommand(Action* action, unsigned int list)
+{
+    switch (list)
+    {
+    case 0:
+        AppendToList(start_44, action);
+        break;
+    case 1:
+        AppendToList(reset_48, action);
+        break;
+    case 2:
+        AppendToList(actions_4c, action);
+        break;
+    case 3:
+        AppendToList(commands_04[count_40].actions_04, action);
+        break;
+    case 4:
+        AppendToList(commands_04[count_40].actions_08, action);
+        break;
+    default:
+        StartupFatal("State::AddCommand - Invalid Command List has been specified");
+        break;
+    }
+}
+
+// FUNCTION: BEACHLIFE 0x004e2490
+void WorldSubsystem20::AppendAction(Action* action)
+{
+    if (word_04)
+    {
+        if (!word_04->parsing_else_1c)
+            AppendToList(word_04->first_00, action);
+        else
+            AppendToList(word_04->second_04, action);
+        return;
+    }
+    groups_0c[index_35c].AddCommand(action, word_358);
+}
