@@ -0,0 +1,48 @@
+#include "startup_screen_palette_modifiers.h"
+#include "startup_screen_renderer.h"
+
+#include <stdio.h>
+
+// FUNCTION: BEACHLIFE 0x00409870
+void ScreenDialogPaletteModifiers::Load()
+{
+    FILE* stream = fopen(screen_dialog_palette_file_path, "rb");
+    if (!stream)
+        return;
+
+    if (screen_request_renderer->format_44 == 0)
+    {
+        for (int bank = 0; bank < 12; ++bank)
+        {
+            unsigned char red;
+            unsigned char green;
+            unsigned char blue;
+            for (int colour = 0; colour < 64; ++colour)
+            {
+                fread(&red, 1, 1, stream);
+                fread(&green, 1, 1, stream);
+                fread(&blue, 1, 1, stream);
+                colours[bank][colour] = static_cast<unsigned short>(
+                    (((red & 0xf8) << 5) | (green & 0xfc)) << 3 | (blue >> 3));
+            }
+        }
+    }
+    else
+    {
+        for (int bank = 0; bank < 12; ++bank)
+        {
+            unsigned char red;
+            unsigned char green;
+            unsigned char blue;
+            for (int colour = 0; colour < 64; ++colour)
+            {
+                fread(&red, 1, 1, stream);
+                fread(&green, 1, 1, stream);
+                fread(&blue, 1, 1, stream);
+                colours[bank][colour] = static_cast<unsigned short>(
+                    (((red & 0xf8) << 5) | (green & 0xf8)) << 2 | (blue >> 3));
+            }
+        }
+    }
+    fclose(stream);
+}
