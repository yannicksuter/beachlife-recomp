@@ -0,0 +1,25 @@
+#ifndef STARTUP_SCREEN_PALETTE_MODIFIERS_H
+#define STARTUP_SCREEN_PALETTE_MODIFIERS_H
+
+// The actual owner is allocated as 0x680 bytes on x86. This initializer writes
+// twelve consecutive 64-word banks; the final 0x80 bytes remain unresolved.
+struct ScreenDialogPaletteModifiers
+{
+    unsigned short colours[12][64];
+    unsigned char unknown_600[0x80];
+
+    // Actual 0x00409810 and 0x00409860; source-level registration cleanup.
+    ScreenDialogPaletteModifiers();
+    ~ScreenDialogPaletteModifiers();
+
+    // Actual 0x00409870, RET0; callers do not consume the incidental EAX value.
+    void Load();
+};
+
+// Actual zero-initialized registration slot at 0x005a8840.
+extern ScreenDialogPaletteModifiers* screen_dialog_palette_modifiers;
+
+// Actual pointer slot at 0x004fc260. The loader captures it once before fopen.
+extern const char* screen_dialog_palette_file_path;
+
+#endif
