+++ b/src/startup_screen_palette_modifiers_constructor.cpp
@@ -0,0 +1,16 @@
+#include "startup_screen_palette_modifiers.h"
+
+// FUNCTION: BEACHLIFE 0x00409810
+ScreenDialogPaletteModifiers::ScreenDialogPaletteModifiers()
+{
+    screen_dialog_palette_modifiers = this;
+    try
+    {
+        Load();
+    }
+    catch (...)
+    {
+        screen_dialog_palette_modifiers = 0;
+        throw;
+    }
+}
