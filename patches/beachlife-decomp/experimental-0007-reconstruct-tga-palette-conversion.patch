--- /dev/null
+++ b/src/tga_palette_convert.cpp
@@ -0,0 +1,28 @@
+#include "tga_image.h"
+
+// Descriptive name; the original symbol and exact declaration are unknown.
+// FUNCTION: BEACHLIFE 0x004ea320
+void TgaImage::ConvertPalette(unsigned char use_rgb555)
+{
+    converted_palette = new unsigned short[256];
+    if (use_rgb555)
+    {
+        for (int index = 0; index < 256; ++index)
+        {
+            unsigned char green = palette[index * 3 + 1] & 0xf8;
+            unsigned char red = palette[index * 3] & 0xf8;
+            unsigned char blue = palette[index * 3 + 2] >> 3;
+            converted_palette[index] = ((unsigned short)red << 7) | ((unsigned short)green << 2) | (unsigned short)blue;
+        }
+    }
+    else
+    {
+        for (int index = 0; index < 256; ++index)
+        {
+            unsigned char green = palette[index * 3 + 1] & 0xfc;
+            unsigned char red = palette[index * 3] & 0xf8;
+            unsigned char blue = palette[index * 3 + 2] >> 3;
+            converted_palette[index] = ((unsigned short)red << 8) | ((unsigned short)green << 3) | (unsigned short)blue;
+        }
+    }
+}
