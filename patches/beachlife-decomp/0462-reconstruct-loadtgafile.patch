+
+// Descriptive name; the original symbol and declaration are unknown.
+// FUNCTION: BEACHLIFE 0x004ea6c0
+TgaImage* ParseTgaBuffer(unsigned char* buffer)
+{
+    unsigned char* cursor = buffer;
+    unsigned char id_length = *cursor++;
+    unsigned char create_palette = 0;
+    unsigned char color_map_type = *cursor++;
+    unsigned char image_type = *cursor++;
+    unsigned short palette_first = static_cast<unsigned short>(cursor[0] | (static_cast<unsigned int>(cursor[1]) << 8));
+    cursor += 2;
+    unsigned short palette_length = static_cast<unsigned short>(cursor[0] | (static_cast<unsigned int>(cursor[1]) << 8));
+    cursor += 2;
+    unsigned char palette_depth = *cursor++;
+    cursor += 4;
+    unsigned short width = static_cast<unsigned short>(cursor[0] | (static_cast<unsigned int>(cursor[1]) << 8));
+    cursor += 2;
+    unsigned short height = static_cast<unsigned short>(cursor[0] | (static_cast<unsigned int>(cursor[1]) << 8));
+    cursor += 2;
+    unsigned char depth = *cursor++;
+    unsigned char descriptor = *cursor++;
+
+    switch (depth)
+    {
+    case 8:
+        if (color_map_type)
+        {
+            create_palette = 1;
+            if (palette_depth != 24)
+            {
+                return 0;
+            }
+        }
+        break;
+    case 24:
+    case 32:
+        if (color_map_type)
+        {
+            return 0;
+        }
+        break;
+    default:
+        return 0;
+    }
+    if (palette_first)
+    {
+        return 0;
+    }
+    unsigned char orientation = descriptor & 0x30;
+    if (orientation)
+    {
+        return 0;
+    }
+
+    TgaImage* image = new TgaImage(width, height, depth, create_palette);
+    if (!image)
+    {
+        return 0;
+    }
+    switch (image_type)
+    {
+    case 1:
+    {
+        unsigned char* palette_data = GetTgaPaletteData(buffer, id_length, color_map_type);
+        CopyTgaPalette(palette_data, image, palette_length);
+    }
+    case 2:
+    {
+        unsigned char* pixel_data = GetTgaPixelData(buffer, id_length, palette_length, color_map_type);
+        CopyTgaPixels(pixel_data, image);
+        break;
+    }
+    case 9:
+    {
+        unsigned char* palette_data = GetTgaPaletteData(buffer, id_length, color_map_type);
+        CopyTgaPalette(palette_data, image, palette_length);
+    }
+    case 10:
+    {
+        unsigned char* pixel_data = GetTgaPixelData(buffer, id_length, palette_length, color_map_type);
+        ExpandTgaRle(pixel_data, image);
+        break;
+    }
+    case 0:
+    case 3:
+    case 11:
+        return 0;
+    }
+    return image;
+}
