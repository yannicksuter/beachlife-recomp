+#include "startup_screen_dialog.h"
+#include "startup_screen_manager.h"
+#include "startup_screen_renderer.h"
+
+// FUNCTION: BEACHLIFE 0x004b1260
+void ScreenManager::PrepareActiveScreens(unsigned char prepare_surface)
+{
+    CircularListNode* head = active.head;
+    CircularListNode* node = head->next;
+    if (node != head)
+    {
+        do
+        {
+            ActiveScreenEntry* entry = static_cast<CircularListValueNode*>(node)->entry;
+            if (prepare_surface)
+            {
+                int surface = entry->surface;
+                ScreenRequestRenderer* current_renderer = renderer;
+                current_renderer->PrepareSurface(surface);
+            }
+            entry->item->MarkPrepared();
+            node = node->next;
+        } while (node != active.head);
+    }
+}
