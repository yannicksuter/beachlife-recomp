+static ScreenWorldPosition GuestBuildingWalkPosition(ScreenWorldPosition origin, float span,
+    float half_span, unsigned int allowed, unsigned int blocked)
+{
+    int attempts = 0;
+    ScreenWorldPosition position;
+    for (;;)
+    {
+        float x = static_cast<float>(static_cast<long double>(std::rand()) * 3.0518509447574615e-5f * span - half_span);
+        long double y = static_cast<long double>(std::rand()) * 3.0518509447574615e-5f * span - half_span;
+        position = { static_cast<float>(static_cast<long double>(origin.x) + x),
+            static_cast<float>(y + origin.y),
+            origin.z };
+        bool accepted = false;
+        if (CurrentScreenTerrain()->CellAt(position)->flags_48 & allowed)
+            accepted = !(CurrentScreenTerrain()->CellAt(position)->flags_48 & blocked);
+        if ((accepted || attempts >= 1000) && position.x < 4096.0f && position.x >= 0.0f
+            && position.y < 8192.0f && position.y >= 0.0f)
+            break;
+        ++attempts;
+    }
+    if (attempts == 1000)
+    {
+        position.x = origin.x;
+        position.y = origin.y;
+    }
+    return position;
+}
