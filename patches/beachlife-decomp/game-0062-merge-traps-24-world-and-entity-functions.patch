@@ -0,0 +1,125 @@
+#include "startup_world_guest_action_helpers.h"
+#include "startup_game_file.h"
+#include <cmath>
+
+// FUNCTION: BEACHLIFE 0x00469520
+ScreenWorldPosition* WorldGuestEntity::FindLandWalkpoints(ScreenWorldPosition position)
+{
+    static ScreenWorldPosition result[2];
+    ScreenTerrainGrid* terrain = screen_terrain_grid;
+    ScreenTerrainRouteNode* selected = terrain->routes_20;
+    unsigned int count;
+    ScreenPoint* points = selected->Points(&count);
+    auto neighbours_of = [&](ScreenPoint tile, ScreenPoint* neighbours)
+    {
+        for (int i = 0; i < 4; ++i)
+            terrain->Step(tile.x, tile.y, i * 2, &neighbours[i]);
+    };
+    auto unblocked = [&](ScreenPoint tile, const ScreenPoint* neighbours)
+    {
+        if (terrain->cells_0c[terrain->TileIndex(tile.x, tile.y)].flags_48 & 0x10)
+            return false;
+        for (int i = 0; i < 4; ++i)
+            if (terrain->cells_0c[terrain->TileIndex(neighbours[i].x, neighbours[i].y)].flags_48 & 0x10)
+                return false;
+        return true;
+    };
+    unsigned int index = 0;
+    for (;;)
+    {
+        ScreenPoint neighbours[4];
+        neighbours_of(points[index], neighbours);
+        if (unblocked(points[index], neighbours))
+            break;
+        if (++index == count)
+        {
+            selected = selected->Next();
+            if (!selected)
+                StartupFatal("I hope This Never Happens ( Cant Get Sea Entry Point)");
+            points = selected->Points(&count);
+            index = 0;
+        }
+    }
+    ScreenPoint nearest = points[index++];
+    auto nearer = [&](ScreenPoint candidate, bool first_route)
+    {
+        ScreenPoint neighbours[4];
+        neighbours_of(candidate, neighbours);
+        ScreenWorldPosition candidate_position = terrain->TileOrigin(candidate.x, candidate.y);
+        float x = static_cast<float>(static_cast<long double>(candidate_position.x) - position.x);
+        float y = static_cast<float>(static_cast<long double>(candidate_position.y) - position.y);
+        float z = candidate_position.z;
+        ScreenWorldPosition nearest_position = terrain->TileOrigin(nearest.x, nearest.y);
+        long double nearest_x = static_cast<long double>(nearest_position.x) - position.x;
+        long double nearest_y = static_cast<long double>(nearest_position.y) - position.y;
+        long double nearest_z = nearest_position.z;
+        long double distance;
+        long double nearest_distance;
+        if (first_route)
+        {
+            distance = std::sqrt(static_cast<long double>(x) * x + static_cast<long double>(z) * z + static_cast<long double>(y) * y);
+            nearest_distance = std::sqrt(nearest_x * nearest_x + nearest_z * nearest_z + nearest_y * nearest_y);
+        }
+        else
+        {
+            distance = std::sqrt(static_cast<long double>(z) * z + static_cast<long double>(y) * y + static_cast<long double>(x) * x);
+            nearest_distance = std::sqrt(nearest_z * nearest_z + nearest_y * nearest_y + nearest_x * nearest_x);
+        }
+        return nearest_distance > distance && unblocked(candidate, neighbours);
+    };
+    for (; index < count; ++index)
+        if (nearer(points[index], true))
+            nearest = points[index];
+    for (ScreenTerrainRouteNode* route = selected->Next(); route; route = route->Next())
+    {
+        points = route->Points(&count);
+        for (unsigned int i = 0; i < count; ++i)
+        {
+            if (nearer(points[i], false))
+            {
+                nearest = points[i];
+                selected = route;
+            }
+        }
+    }
+    if (selected)
+    {
+        ScreenPoint lower = selected->Bounds()[0];
+        ScreenPoint upper = selected->Bounds()[3];
+        float width = static_cast<float>(upper.x - lower.x);
+        float height = static_cast<float>(upper.y - lower.y);
+        ScreenPoint tile;
+        bool first_attempt = true;
+        for (;;)
+        {
+            tile.x = lower.x + static_cast<int>(static_cast<long double>(std::rand()) * 3.0518509447574615e-5f * width);
+            tile.y = lower.y + static_cast<int>(static_cast<long double>(std::rand()) * 3.0518509447574615e-5f * height);
+            ScreenPoint neighbours[4];
+            for (int i = 0; i < 4; ++i)
+            {
+                terrain->Step(tile.x, tile.y, i * 2, &neighbours[i]);
+                // Retail retries check only one step in direction six.
+                if (first_attempt || i != 3)
+                    terrain->Step(neighbours[i].x, neighbours[i].y, i * 2, &neighbours[i]);
+            }
+            first_attempt = false;
+            unsigned int flags = terrain->cells_0c[terrain->TileIndex(tile.x, tile.y)].flags_48;
+            if (!(flags & 4) || (flags & 0x10))
+                continue;
+            bool valid = true;
+            for (int i = 0; i < 4; ++i)
+            {
+                if (!(terrain->cells_0c[terrain->TileIndex(neighbours[i].x, neighbours[i].y)].flags_48 & 0xc))
+                {
+                    valid = false;
+                    break;
+                }
+            }
+            if (valid)
+                break;
+        }
+        result[0] = terrain->TilePosition(nearest.x, nearest.y, 4);
+        result[1] = terrain->TileOrigin(tile.x, tile.y);
+    }
+    return result;
+}
