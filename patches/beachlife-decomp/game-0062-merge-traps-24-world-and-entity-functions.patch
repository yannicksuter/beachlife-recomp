+#include "startup_world_guest_action_helpers.h"
+#include <cmath>
+
+// FUNCTION: BEACHLIFE 0x00468000
+ScreenWorldPosition* WorldGuestEntity::FindWaterWalkpoints()
+{
+    static ScreenWorldPosition result[2];
+    ScreenWorldPosition position = { x_30, y_34, z_38 };
+    ScreenTerrainRouteNode* selected = screen_terrain_grid->routes_1c;
+    unsigned int count;
+    ScreenPoint* points = selected->Points(&count);
+    ScreenPoint nearest = points[0];
+    auto nearer = [&](ScreenPoint candidate)
+    {
+        ScreenWorldPosition candidate_position = screen_terrain_grid->TileOrigin(candidate.x, candidate.y);
+        float x = static_cast<float>(static_cast<long double>(candidate_position.x) - position.x);
+        float y = static_cast<float>(static_cast<long double>(candidate_position.y) - position.y);
+        float z = static_cast<float>(static_cast<long double>(candidate_position.z) - position.z);
+        ScreenWorldPosition nearest_position = screen_terrain_grid->TileOrigin(nearest.x, nearest.y);
+        long double nearest_x = static_cast<long double>(nearest_position.x) - position.x;
+        long double nearest_y = static_cast<long double>(nearest_position.y) - position.y;
+        long double nearest_z = static_cast<long double>(nearest_position.z) - position.z;
+        long double distance = std::sqrt(static_cast<long double>(x) * x + static_cast<long double>(z) * z + static_cast<long double>(y) * y);
+        return std::sqrt(nearest_x * nearest_x + nearest_z * nearest_z + nearest_y * nearest_y) > distance;
+    };
+    for (unsigned int i = 1; i < count; ++i)
+        if (nearer(points[i]))
+            nearest = points[i];
+    for (ScreenTerrainRouteNode* route = selected->Next(); route; route = route->Next())
+    {
+        points = route->Points(&count);
+        for (unsigned int i = 0; i < count; ++i)
+        {
+            if (nearer(points[i]))
+            {
+                nearest = points[i];
+                selected = route;
+            }
+        }
+    }
+    if (selected)
+    {
+        ScreenPoint lower = selected->Bounds()[0];
+        ScreenPoint upper = selected->Bounds()[3];
+        float width = static_cast<float>(upper.x - lower.x);
+        float height = static_cast<float>(upper.y - lower.y);
+        ScreenPoint tile;
+        auto choose_tile = [&]
+        {
+            tile.x = lower.x + static_cast<int>(static_cast<long double>(std::rand()) * 3.0518509447574615e-5f * width);
+            tile.y = lower.y + static_cast<int>(static_cast<long double>(std::rand()) * 3.0518509447574615e-5f * height);
+            ScreenPoint neighbours[8];
+            for (int i = 0; i < 8; ++i)
+                screen_terrain_grid->Step(tile.x, tile.y, i, &neighbours[i]);
+            unsigned int flags[9];
+            flags[0] = screen_terrain_grid->cells_0c[screen_terrain_grid->TileIndex(tile.x, tile.y)].flags_48;
+            for (int i = 0; i < 8; ++i)
+                flags[i + 1] = screen_terrain_grid->cells_0c[screen_terrain_grid->TileIndex(neighbours[i].x, neighbours[i].y)].flags_48;
+            for (unsigned int flag : flags)
+                if (!(flag & 2) || (flag & 0x8110))
+                    return false;
+            return true;
+        };
+        bool valid = choose_tile();
+        unsigned int attempts = 0;
+        while (!valid && attempts < 1000)
+        {
+            valid = choose_tile();
+            ++attempts;
+        }
+        result[0] = screen_terrain_grid->TilePosition(nearest.x, nearest.y, 4);
+        result[1] = attempts == 1000
+                      ? screen_terrain_grid->TilePosition(nearest.x, nearest.y, 4)
+                      : screen_terrain_grid->TilePosition(tile.x, tile.y, 4);
+    }
+    return result;
+}
