+#include <new>
+
+// FUNCTION: BEACHLIFE 0x0040e3d0
+unsigned char ScreenRequestRenderer::ResizeSurface(
+    int index, int requested_width, int requested_height)
+{
+    unsigned char changed = 0;
+    if (software_mode)
+    {
+        ScreenSurfacePosition* entry = surfaces[index];
+        if (entry->width != static_cast<unsigned int>(requested_width) || entry->height != static_cast<unsigned int>(requested_height))
+        {
+            delete[] entry->pixels;
+            InitializeSurface(requested_width, requested_height, entry, 0);
+            changed = 1;
+        }
+    }
+    else
+    {
+        ScreenSurfacePosition* entry = surfaces[index];
+        if (entry->width != static_cast<unsigned int>(requested_width) || entry->height != static_cast<unsigned int>(requested_height))
+        {
+            DirectDrawSurface7Prefix* surface = entry->surface;
+            surface->vtable->Release(surface);
+            InitializeSurface(requested_width, requested_height, surfaces[index], 0);
+            changed = 1;
+        }
+    }
+    return changed;
+}
