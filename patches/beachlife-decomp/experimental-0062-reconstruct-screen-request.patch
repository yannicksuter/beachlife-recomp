+#include "startup_screen_request.h"
+#include <string.h>
+
+// FUNCTION: BEACHLIFE 0x004b1320
+bool ScreenManager::RequestScreen(const char* name, ScreenRequestContext* context, unsigned char flag)
+{
+    bool result = false;
+    ScreenChildLink* node = registry;
+    if (node)
+    {
+        for (;;)
+        {
+            if (strcmp(static_cast<ScreenDialog*>(node->item)->name, name) == 0)
+            {
+                break;
+            }
+            node = node->next;
+            if (!node)
+            {
+                return false;
+            }
+        }
+
+        ScreenDialog* screen = static_cast<ScreenDialog*>(node->item);
+        bool create = true;
+        if (context)
+        {
+            for (CircularListNode* current = active.head->next; current != active.head; current = current->next)
+            {
+                ActiveScreenEntry* entry = static_cast<CircularListValueNode*>(current)->entry;
+                if (entry->item == screen && entry->context == context)
+                {
+                    create = false;
+                }
+            }
+        }
+
+        if (create)
+        {
+            int group = screen->group_7c;
+            for (CircularListNode* current = active.head->next; current != active.head; current = current->next)
+            {
+                ActiveScreenEntry* entry = static_cast<CircularListValueNode*>(current)->entry;
+                if (entry->item->group_7c == group)
+                {
+                    entry->state = 2;
+                    if (entry->context)
+                    {
+                        entry->context->Replaced();
+                    }
+                    break;
+                }
+            }
+
+            ActiveScreenEntry* entry = new ActiveScreenEntry;
+            entry->item = screen;
+            entry->state = 0;
+            ScreenRectangle rectangle;
+            rectangle = screen->GetRectangle();
+            int width = rectangle.right - rectangle.left;
+            int height = rectangle.bottom - rectangle.top;
+            if (!flag && screen->flag_60)
+            {
+                bool place = false;
+                int x;
+                int y;
+                if (mode != 6 && previous_mode != 6)
+                {
+                    place = screen_request_game->placement->FindPlacement(screen->group_7c, &x, &y);
+                    if (place)
+                    {
+                        if (x + width >= screen_request_renderer->width)
+                        {
+                            place = false;
+                        }
+                        if (y + height >= screen_request_renderer->height)
+                        {
+                            place = false;
+                        }
+                    }
+                }
+                if (place)
+                {
+                    rectangle = screen->GetRectangle();
+                    screen->MoveRectangle(x - rectangle.left, y - rectangle.top);
+                }
+            }
+            rectangle = screen->GetRectangle();
+            int surface = renderer->CreateSurface(width, height, 0);
+            renderer->PrepareSurface(surface);
+            entry->surface = surface;
+            ScreenPoint position = { rectangle.left, rectangle.top };
+            renderer->PositionSurface(surface, position);
+            active.Insert(active.Begin(), entry);
+            entry->context = context;
+            screen->MarkPrepared();
+            screen->ApplyPosition(0, 0);
+            screen->state_59 = flag;
+        }
+        result = true;
+    }
+    return result;
+}
