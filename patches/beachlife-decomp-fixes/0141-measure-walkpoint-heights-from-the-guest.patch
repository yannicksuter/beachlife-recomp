diff --git a/src/startup_world_guest_beach_walkpoints.cpp b/src/startup_world_guest_beach_walkpoints.cpp
index 8b979a5..18eb626 100644
--- a/src/startup_world_guest_beach_walkpoints.cpp
+++ b/src/startup_world_guest_beach_walkpoints.cpp
@@ -16,12 +16,13 @@ static void DestroyBeachWalkpoints()
 }
 
 // The candidate offsets are stored as floats (fstp at 0x00468da7..0x00468dbf); the nearest point's offsets stay on
-// the x87 stack. Retail subtracts x and y only: z is the tile origin's own height (fld [eax+8] without fsub).
+// the x87 stack. Retail subtracted x and y only and kept the tile origin's own height as z; the height
+// difference to the guest is measured as in the water and lifeguard searches.
 static inline ScreenWorldPosition Difference(const ScreenWorldPosition& a, const ScreenWorldPosition& b)
 {
     return ScreenWorldPosition(static_cast<float>(static_cast<long double>(a.x) - b.x),
         static_cast<float>(static_cast<long double>(a.y) - b.y),
-        a.z);
+        static_cast<float>(static_cast<long double>(a.z) - b.z));
 }
 
 struct BeachOffset
@@ -33,7 +34,7 @@ struct BeachOffset
 
 static inline BeachOffset UnroundedDifference(const ScreenWorldPosition& a, const ScreenWorldPosition& b)
 {
-    BeachOffset offset = { static_cast<long double>(a.x) - b.x, static_cast<long double>(a.y) - b.y, a.z };
+    BeachOffset offset = { static_cast<long double>(a.x) - b.x, static_cast<long double>(a.y) - b.y, static_cast<long double>(a.z) - b.z };
     return offset;
 }
 
