index 0000000000000000000000000000000000000000..a7f781a216d97df947b637ee61712d9fa5bd53f8
--- /dev/null
+++ b/src/tweak_wheel_zoom.cpp
@@ -0,0 +1,16 @@
+#include "startup_screen_renderer.h"
+#include "window_activation.h"
+
+// Optional tweak, not in the original game and off unless the player enables
+// it: in the world the mouse wheel zooms like Page Up (in) and Page Down (out).
+void TweakWheelZoom(int wheel)
+{
+    WindowDeactivationState* world = window_deactivation_state;
+    if (!world)
+        return;
+    unsigned int level = screen_request_renderer->clip_mode_54;
+    if (wheel > 0 && level > 0)
+        world->zoom_6f8 = level - 1;
+    else if (wheel < 0 && level < 2)
+        world->zoom_6f8 = level + 1;
+}
